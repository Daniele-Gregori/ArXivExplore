Cell["ArXivCitationsAuthor", "ObjectName",
 CellID->1700475370,ExpressionUUID->"d3485080-2aa3-4767-88dc-5faf02ce1a86"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3334a117-967c-4332-a79b-5a97475f67b9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ArXivCitationsAuthor",
    BaseStyle->"Link",
    ButtonData->"paclet:DanieleGregoriArXivExplore/ref/ArXivCitationsAuthor"],
    "[", 
   StyleBox["author_Entity", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "2000b325-8135-483d-b777-00b44fd5f743"],
 "\[LineSeparator]returns all pairs of ids of which the first is an article \
of a given author entity - on all ArXiv - and the last is another paper that \
cites it; \n",
 Cell["   ", "ModInfo",ExpressionUUID->"fbce2f57-1f86-4daf-b4a5-2bb88052691d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ArXivCitationsAuthor",
    BaseStyle->"Link",
    ButtonData->"paclet:DanieleGregoriArXivExplore/ref/ArXivCitationsAuthor"],
    "[", 
   StyleBox["author_String", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "e321bed3-434a-4799-ab92-6414960eac1d"],
 "\[LineSeparator]returns all pairs of ids of which the first is an article \
of a given author - on all ArXiv - and the last is another paper that cites \
it; \n",
 Cell["   ", "ModInfo",ExpressionUUID->"e3c5c145-09c8-486f-8d11-b4b67090413f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ArXivCitationsAuthor",
    BaseStyle->"Link",
    ButtonData->"paclet:DanieleGregoriArXivExplore/ref/ArXivCitationsAuthor"],
    "[", 
   RowBox[{
    StyleBox["author_String", "TI"], ",", 
    StyleBox["cat", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "3e5f0ccf-5276-436f-ab06-11f3ea4a2b3a"],
 "\[LineSeparator]returns all pairs of ids of which the first is an article \
of a given author - in category 'cat' - and the last is another paper that \
cites it; \n",
 Cell["   ", "ModInfo",ExpressionUUID->"1e66e178-0b5c-4a5f-8fee-c062fe630854"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ArXivCitationsAuthor",
    BaseStyle->"Link",
    ButtonData->"paclet:DanieleGregoriArXivExplore/ref/ArXivCitationsAuthor"],
    "[", 
   RowBox[{
    StyleBox["authorL_List", "TI"], ",", 
    StyleBox["cat", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "763f678b-e0b2-458d-a7c5-bbe96842644a"],
 "\[LineSeparator]returns all pairs of ids of which the first is an article \
of a given list of authors 'authorL' - in category 'cat' - and the last is \
another paper that cites it; \n",
 Cell["   ", "ModInfo",ExpressionUUID->"bc000a43-3ff2-4baa-983a-0b0613e1684e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ArXivCitationsAuthor",
    BaseStyle->"Link",
    ButtonData->"paclet:DanieleGregoriArXivExplore/ref/ArXivCitationsAuthor"],
    "[", 
   RowBox[{
    StyleBox["authorL_List", "TI"], ",", 
    StyleBox["catL_List", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "0be4f799-d6bb-42f2-bad9-66cd55566975"],
 "\[LineSeparator]returns all pairs of ids of which the first is an article \
of a given the two lists 'doubleL' - the first made of author names and the \
second of corresponding categories - and the last is another paper that cites \
it."
}], "Usage",
