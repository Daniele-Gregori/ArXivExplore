      "\[Rule]", "\<\"Loop equations for generalised eigenvalue models\"\>"}],
      ",", 
     RowBox[{"\<\"comments\"\>", 
      "\[Rule]", "\<\"61 pages, 6 figures, Mathematica notebooks with \
perturbative solution\\n  of loop equations are included as ancillary files; \
v2: refs added; v3: more\\n  refs added\"\>"}], ",", 
     RowBox[{"\<\"journal-ref\"\>", "\[Rule]", "Null"}], ",", 
     RowBox[{"\<\"doi\"\>", "\[Rule]", "Null"}], ",", 
     RowBox[{"\<\"report-no\"\>", "\[Rule]", "Null"}], ",", 
     RowBox[{"\<\"categories\"\>", "\[Rule]", "\<\"hep-th\"\>"}], ",", 
