   RowBox[{"{", 
    RowBox[{
     RowBox[{"\<\"id\"\>", "\[Rule]", "\<\"2101.05117\"\>"}], ",", 
     RowBox[{"\<\"submitter\"\>", "\[Rule]", "\<\"Edoardo Vescovi\"\>"}], ",", 
     RowBox[{"\<\"authors\"\>", "\[Rule]", "\<\"Edoardo Vescovi\"\>"}], ",", 
     RowBox[{"\<\"title\"\>", 
      "\[Rule]", "\<\"The four-point function of determinant operators in $\\\
\\mathcal{N}=4$ SYM\"\>"}], ",", 
     RowBox[{"\<\"comments\"\>", 
      "\[Rule]", "\<\"9 pages, 1 figure, matching published version\"\>"}], 
     ",", 
     RowBox[{"\<\"journal-ref\"\>", 
      "\[Rule]", "\<\"Phys. Rev. D 103, 106001 (2021)\"\>"}], ",", 
     RowBox[{"\<\"doi\"\>", 
      "\[Rule]", "\<\"10.1103/PhysRevD.103.106001\"\>"}], ",", 
     RowBox[{"\<\"report-no\"\>", "\[Rule]", "Null"}], ",", 
     RowBox[{"\<\"categories\"\>", "\[Rule]", "\<\"hep-th\"\>"}], ",", 
     RowBox[{"\<\"license\"\>", 
      "\[Rule]", \
"\<\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\"\>"}], ",", 
     RowBox[{"\<\"abstract\"\>", 
      "\[Rule]", "\<\"  We calculate the four-point function of $1/2$-BPS \
determinant operators in\\n$\\\\mathcal{N}=4$ SYM at next-to-leading order at \
weak coupling. We use two\\ncomplementary methods recently developed for a \
class of determinant three-point\\nfunctions: one is based on Feynman \
diagrams and it extracts perturbative data\\nat finite $N$, while the other \
one expresses a generic correlator of\\ndeterminants as the zero-dimensional \
integral over an auxiliary matrix field.\\nWe generalise the latter approach \
to calculate one-loop corrections and we\\nsolve the four-point function in a \
semi-classical approach at large $N$. The\\nresults allow to comment on the \
order of the phase transition that the\\nfour-point function is expected to \
exhibit in an exact integrability-based\\ndescription.\\n\"\>"}], ",", 
     RowBox[{"\<\"versions\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
