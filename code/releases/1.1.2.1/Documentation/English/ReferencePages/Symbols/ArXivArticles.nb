\>"}], ",", 
     RowBox[{"\<\"journal-ref\"\>", "\[Rule]", "Null"}], ",", 
     RowBox[{"\<\"doi\"\>", "\[Rule]", "\<\"10.1007/JHEP07(2018)060\"\>"}], 
