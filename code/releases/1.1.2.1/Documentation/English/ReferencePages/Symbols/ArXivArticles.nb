Cell[BoxData[
 TagBox[
  TagBox[GridBox[{
     {
      RowBox[{"\<\"id\"\>", "\[Rule]", "\<\"1908.08030\"\>"}]},
     {
      RowBox[{"\<\"submitter\"\>", "\[Rule]", "\<\"Davide Fioravanti\"\>"}]},
     {
      RowBox[{"\<\"authors\"\>", 
       "\[Rule]", "\<\"Davide Fioravanti, Daniele Gregori\"\>"}]},
     {
      RowBox[{"\<\"title\"\>", 
       "\[Rule]", "\<\"Integrability and cycles of deformed ${\\\\cal N}=2$ \
gauge theory\"\>"}]},
     {
      RowBox[{"\<\"comments\"\>", "\[Rule]", "\<\"15 pages, Latex\"\>"}]},
     {
      RowBox[{"\<\"journal-ref\"\>", "\[Rule]", "Null"}]},
     {
      RowBox[{"\<\"doi\"\>", 
       "\[Rule]", "\<\"10.1016/j.physletb.2020.135376\"\>"}]},
     {
      RowBox[{"\<\"report-no\"\>", "\[Rule]", "Null"}]},
     {
      RowBox[{"\<\"categories\"\>", 
       "\[Rule]", "\<\"hep-th math-ph math.MP nlin.SI\"\>"}]},
     {
      RowBox[{"\<\"license\"\>", 
       "\[Rule]", \
"\<\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\"\>"}]},
     {
      RowBox[{"\<\"abstract\"\>", 
       "\[Rule]", "\<\"  To analyse pure ${\\\\cal N}=2$ $SU(2)$ gauge theory \
in the Nekrasov-Shatashvili\\n(NS) limit (or deformed Seiberg-Witten (SW)), \
we use the Ordinary Differential\\nEquation/Integrable Model (ODE/IM) \
correspondence, and in particular its\\n(broken) discrete symmetry in its \
extended version with {\\\\it two} singular\\nirregular points. Actually, \
this symmetry appears to be 'manifestation' of the\\nspontaneously broken $\\\
\\mathbb{Z}_2$ R-symmetry of the original gauge problem\\nand the two \
deformed SW cycles are simply connected to the Baxter's $T$ and \
$Q$\\nfunctions, respectively, of the Liouville conformal field theory at the\
\\nself-dual point. The liaison is realised via a second order \
differential\\noperator which is essentially the 'quantum' version of the \
square of the SW\\ndifferential. Moreover, the constraints imposed by the \
broken $\\\\mathbb{Z}_2$\\nR-symmetry acting on the moduli space \
(Bilal-Ferrari equations) seem to have\\ntheir quantum counterpart in the \
$TQ$ and the $T$ periodicity relations, and\\nintegrability yields also a \
useful Thermodynamic Bethe Ansatz (TBA) for the\\ncycles ($Y(\\\\theta,\\\\pm \
u)$ or their square roots, $Q(\\\\theta,\\\\pm u)$). A latere,\\ntwo \
efficient asymptotic expansion techniques are presented. Clearly, the \
whole\\nconstruction is extendable to gauge theories with matter and/or \
higher rank\\ngroups.\\n\"\>"}]},
     {
      RowBox[{"\<\"versions\"\>", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\<\"version\"\>", "\[Rule]", "\<\"v1\"\>"}], ",", 
          
          RowBox[{"\<\"created\"\>", 
           "\[Rule]", "\<\"Wed, 21 Aug 2019 17:52:33 GMT\"\>"}]}], "}"}], 
        "}"}]}]},
     {
      RowBox[{"\<\"update_date\"\>", "\[Rule]", "\<\"2020-03-25\"\>"}]},
     {
      RowBox[{"\<\"authors_parsed\"\>", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          
          RowBox[{"\<\"Fioravanti\"\>", ",", "\<\"Davide\"\>", 
           ",", "\<\"\"\>"}], "}"}], ",", 
         RowBox[{"{", 
          
          RowBox[{"\<\"Gregori\"\>", ",", "\<\"Daniele\"\>", 
           ",", "\<\"\"\>"}], "}"}]}], "}"}]}]}
    },
    GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
