     RowBox[{"\<\"title\"\>", 
      "\[Rule]", "\<\"Structure Constants in $\\\\mathcal{N}=4$ SYM at Finite \
Coupling as\\n  Worldsheet $g$-Function\"\>"}], ",", 
     RowBox[{"\<\"comments\"\>", 
      "\[Rule]", "\<\"224 pages; v3 new results, appendices, and references \
added\"\>"}], ",", 
     RowBox[{"\<\"journal-ref\"\>", "\[Rule]", "Null"}], ",", 
     RowBox[{"\<\"doi\"\>", "\[Rule]", "\<\"10.1007/JHEP07(2020)037\"\>"}], 
