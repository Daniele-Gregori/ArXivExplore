    RowBox[{
     RowBox[{"\<\"id\"\>", "\[Rule]", "\<\"1409.8674\"\>"}], ",", 
     RowBox[{"\<\"submitter\"\>", "\[Rule]", "\<\"Valentina Forini\"\>"}], 
     ",", 
     RowBox[{"\<\"authors\"\>", 
      "\[Rule]", "\<\"V. Forini, V. Giangreco M. Puletti, M. Pawellek, E. \
Vescovi\"\>"}], ",", 
     RowBox[{"\<\"title\"\>", 
      "\[Rule]", "\<\"One-loop spectroscopy of semiclassically quantized \
strings: bosonic\\n  sector\"\>"}], ",", 
     RowBox[{"\<\"comments\"\>", 
      "\[Rule]", "\<\"v2, references and two footnotes added\"\>"}], ",", 
     RowBox[{"\<\"journal-ref\"\>", "\[Rule]", "Null"}], ",", 
     RowBox[{"\<\"doi\"\>", 
      "\[Rule]", "\<\"10.1088/1751-8113/48/8/085401\"\>"}], ",", 
     RowBox[{"\<\"report-no\"\>", "\[Rule]", "\<\"HU-EP-14/29\"\>"}], ",", 
     RowBox[{"\<\"categories\"\>", "\[Rule]", "\<\"hep-th\"\>"}], ",", 
     RowBox[{"\<\"license\"\>", 
      "\[Rule]", \
"\<\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\"\>"}], ",", 
     RowBox[{"\<\"abstract\"\>", 
      "\[Rule]", "\<\"  We make a further step in the analytically exact \
quantization of spinning\\nstring states in semiclassical approximation, by \
evaluating the exact one-loop\\npartition function for a class of two-spin \
string solutions for which quadratic\\nfluctuations form a non-trivial system \
of coupled modes. This is the case of a\\nfolded string in the $SU(2)$ \
sector, in the limit described by a quantum\\nLandau-Lifshitz model. The same \
applies to the full bosonic sector of\\nfluctuations over the folded spinning \
string in $AdS_5$ with an angular\\nmomentum $J$ in $S^5$. Fluctuations are \
governed by a special class of\\nfourth-order differential operators, with \
coefficients being meromorphic\\nfunctions on the torus, which we are able to \
solve exactly.\\n\"\>"}], ",", 
     RowBox[{"\<\"versions\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\<\"version\"\>", "\[Rule]", "\<\"v1\"\>"}], ",", 
          
          RowBox[{"\<\"created\"\>", 
           "\[Rule]", "\<\"Tue, 30 Sep 2014 19:58:43 GMT\"\>"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\<\"version\"\>", "\[Rule]", "\<\"v2\"\>"}], ",", 
          
          RowBox[{"\<\"created\"\>", 
           "\[Rule]", "\<\"Mon, 22 Dec 2014 17:02:02 GMT\"\>"}]}], "}"}]}], 
       "}"}]}], ",", 
     RowBox[{"\<\"update_date\"\>", "\[Rule]", "\<\"2015-06-23\"\>"}], ",", 
     RowBox[{"\<\"authors_parsed\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\<\"Forini\"\>", ",", "\<\"V.\"\>", ",", "\<\"\"\>"}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\<\"Puletti\"\>", ",", "\<\"V. Giangreco M.\"\>", 
          ",", "\<\"\"\>"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\<\"Pawellek\"\>", ",", "\<\"M.\"\>", ",", "\<\"\"\>"}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\<\"Vescovi\"\>", ",", "\<\"E.\"\>", ",", "\<\"\"\>"}], 
         "}"}]}], "}"}]}]}], "}"}]}, {3,"3"->
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\<\"id\"\>", "\[Rule]", "\<\"1702.02164\"\>"}], ",", 
     RowBox[{"\<\"submitter\"\>", "\[Rule]", "\<\"Edoardo Vescovi\"\>"}], ",", 
     RowBox[{"\<\"authors\"\>", 
      "\[Rule]", "\<\"V. Forini, A.A. Tseytlin, E. Vescovi\"\>"}], ",", 
     RowBox[{"\<\"title\"\>", 
      "\[Rule]", "\<\"Perturbative computation of string one-loop corrections \
to Wilson loop\\n  minimal surfaces in $AdS_5 \\\\times S^5$\"\>"}], ",", 
     RowBox[{"\<\"comments\"\>", 
      "\[Rule]", "\<\"32 pages, one reference added, typos corrected\"\>"}], 
     ",", 
     RowBox[{"\<\"journal-ref\"\>", "\[Rule]", "Null"}], ",", 
     RowBox[{"\<\"doi\"\>", "\[Rule]", "\<\"10.1007/JHEP03(2017)003\"\>"}], 
     ",", 
     RowBox[{"\<\"report-no\"\>", 
      "\[Rule]", "\<\"HU-EP-17/02, Imperial-TP-AAT-2017-03\"\>"}], ",", 
     RowBox[{"\<\"categories\"\>", "\[Rule]", "\<\"hep-th\"\>"}], ",", 
     RowBox[{"\<\"license\"\>", 
      "\[Rule]", \
"\<\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\"\>"}], ",", 
     RowBox[{"\<\"abstract\"\>", 
      "\[Rule]", "\<\"  We revisit the computation of the 1-loop string \
correction to the \\\"latitude\\\"\\nminimal surface in $AdS_5 \\\\times S^5$ \
representing 1/4 BPS Wilson loop in\\nplanar $\\\\cal N$=4 SYM theory \
previously addressed in arXiv:1512.00841 and\\narXiv:1601.04708. We resolve \
the problem of matching with the subleading term\\nin the strong coupling \
expansion of the exact gauge theory result (derived\\npreviously from \
localization) using a different method to compute determinants\\nof 2d string \
fluctuation operators. We apply perturbation theory in a small\\nparameter \
(angle of the latitude) corresponding to an expansion near the\\n$AdS_2$ \
minimal surface representing 1/2 BPS circular Wilson loop. This allows\\nus \
to compute the corrections to the heat kernels and zeta-functions of \
the\\noperators in terms of the known heat kernels on $AdS_2$. We apply the \
same\\nmethod also to two other examples of Wilson loop surfaces: generalized \
cusp and\\n$k$-wound circle.\\n\"\>"}], ",", 
     RowBox[{"\<\"versions\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\<\"version\"\>", "\[Rule]", "\<\"v1\"\>"}], ",", 
          
          RowBox[{"\<\"created\"\>", 
           "\[Rule]", "\<\"Tue, 7 Feb 2017 19:08:09 GMT\"\>"}]}], "}"}], ",", 
        
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\<\"version\"\>", "\[Rule]", "\<\"v2\"\>"}], ",", 
          
          RowBox[{"\<\"created\"\>", 
           "\[Rule]", "\<\"Fri, 24 Feb 2017 19:36:31 GMT\"\>"}]}], "}"}]}], 
       "}"}]}], ",", 
     RowBox[{"\<\"update_date\"\>", "\[Rule]", "\<\"2017-04-05\"\>"}], ",", 
     RowBox[{"\<\"authors_parsed\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\<\"Forini\"\>", ",", "\<\"V.\"\>", ",", "\<\"\"\>"}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\<\"Tseytlin\"\>", ",", "\<\"A. A.\"\>", ",", "\<\"\"\>"}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\<\"Vescovi\"\>", ",", "\<\"E.\"\>", ",", "\<\"\"\>"}], 
         "}"}]}], "}"}]}]}], "}"}]}}, 1]}}, 1]], "Output",
