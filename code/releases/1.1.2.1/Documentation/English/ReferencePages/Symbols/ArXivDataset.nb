          RowBox[{"\<\"Romiti\"\>", ",", "\<\"S.\"\>", ",", "\<\"\"\>"}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\<\"Simula\"\>", ",", "\<\"S.\"\>", ",", "\<\"\"\>"}], 
          "}"}]}], "}"}]}]}
    },
