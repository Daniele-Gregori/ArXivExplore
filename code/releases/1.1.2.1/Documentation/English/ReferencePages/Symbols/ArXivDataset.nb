Notebook[{

Cell[CellGroupData[{
Cell["ArXivDataset", "ObjectName",
 CellID->2081262576,ExpressionUUID->"c94ef858-76f7-4fc8-9032-3e3b39169d04"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"35e3f9bc-e0d0-4f63-8bae-fc151d7b21d7"],
 "ArXivDataset[All]",
 "\[LineSeparator]returns the whole ArXiv dataset cleaned and ordered by date \
of first version; \t\t\t\t\t\t\n",
 Cell["   ", "ModInfo",ExpressionUUID->"bac26159-efa2-4574-bd39-6ea10719dcb9"],
 "ArXivDataset[cat]",
 "\[LineSeparator]returns only the dataset for a specified primary category \
'cat'; \t\t\t\t\t\t\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1f137644-f56a-4cd7-8f8f-c954d10b5d48"],
 "ArXivDataset[[cat,All}]",
 "\[LineSeparator]returns the dataset of all articles sharing (as primary or \
as cross-list) the category 'cat'."
}], "Usage",
 CellChangeTimes->{3.931060675262562*^9},
 CellID->1566472496,ExpressionUUID->"a6927285-4ce7-4ddd-aad6-a13181304691"],

Cell["\<\
