                "\"title\"", "\[Rule]", 
                 "\"Euclidean Black Saddles and AdS$_4$ Black Holes\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"78 pages, 7 figures. v2: references added, minor typos \
fixed. v3: a\\n  few more minor typos fixed\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP10(2020)073\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
