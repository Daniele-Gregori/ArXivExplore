               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Higher-dimensional invariants in $6D$ super Yang-Mills \
theory\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"0 + 31 pages, typos corrected, a footnote added, a \
reference updated;\\n  published version\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP07(2021)190\""}]}, {
