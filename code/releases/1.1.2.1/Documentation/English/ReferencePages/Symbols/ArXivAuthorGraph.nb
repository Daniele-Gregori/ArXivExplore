                "\"title\"", "\[Rule]", 
                 "\"Nonsinglet pentagons and NMHV amplitudes\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"58 pages, 5 figures; typos fixed, four-loop checks added \
to ancillary\\n  file\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.nuclphysb.2015.05.002\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
