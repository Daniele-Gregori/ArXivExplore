               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0607235\""}]}, {
               
               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Harold Steinacker\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Harald Grosse, Harold Steinacker\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Exact renormalization of a noncommutative \\\\phi^3 model \
in 6 dimensions\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"32 pages, 3 figures. V2: discussion added, minor \
stylistic changes\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Adv.Theor.Math.Phys.12:605,2008\""}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"UWThPh-2006-16\""}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", "\"hep-th math-ph math.MP\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  The noncommutative selfdual \\\\phi^3 model in 6 \
dimensions is quantized and\\nessentially solved, by mapping it to the \
Kontsevich model. The model is shown\\nto be renormalizable and \
asymptotically free, and solvable genus by genus. It\\nrequires both \
wavefunction and coupling constant renormalization. The exact\\n(all-order) \
renormalization of the bare parameters is determined explicitly,\\nwhich \
turns out to depend on the genus 0 sector only. The running \
coupling\\nconstant is also computed exactly, which decreases more rapidly \
than predicted\\nby the one-loop beta function. A phase transition to an \
unstable phase is\\nfound.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
