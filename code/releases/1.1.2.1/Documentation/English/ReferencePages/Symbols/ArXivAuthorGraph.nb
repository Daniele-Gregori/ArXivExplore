                RowBox[{"\"submitter\"", "\[Rule]", "\"Olav Tirkkonen\""}]}, {
               
                
                RowBox[{
                 "\"authors\"", "\[Rule]", 
                  "\"G. Semenoff, O. Tirkkonen and K. Zarembo\""}]}, {
                
                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Exact Solution of the One-Dimensional Non-Abelian \
Coulomb Gas at Large N\""}]}, {
                RowBox[{"\"comments\"", "\[Rule]", "\"8 pages, latex\""}]}, {
                
                RowBox[{
                 "\"journal-ref\"", "\[Rule]", 
                  "\"Phys.Rev.Lett. 77 (1996) 2174-2177\""}]}, {
                
                RowBox[{
                 "\"doi\"", "\[Rule]", "\"10.1103/PhysRevLett.77.2174\""}]}, {
               
                RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
                RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
                
                RowBox[{
                 "\"abstract\"", "\[Rule]", 
                  "\"  The problem of computing the thermodynamic properties \
of a one-dimensional\\ngas of particles which transform in the adjoint \
representation of the gauge\\ngroup and interact through non-Abelian electric \
fields is formulated and solved\\nin the large $N$ limit. The explicit \
solution exhibits a first order\\nconfinement-deconfinement phase transition \
with computable properties and\\ndescribes two dimensional adjoint QCD in the \
limit where matter field masses\\nare large.\\n\""}]}, {
                RowBox[{"\"versions\"", "\[Rule]", 
                  RowBox[{"{", 
                    RowBox[{"{", 
