                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Gorsky\"", ",", "\"A. S.\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Korchemsky\"", ",", "\"G. P.\"", ",", "\"\""}],
                     "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
