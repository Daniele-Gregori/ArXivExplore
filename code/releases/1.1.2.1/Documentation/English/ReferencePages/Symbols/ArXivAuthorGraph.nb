Muiden\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Precision Holography for $\\\\mathcal{N}=2^{*}$ on $S^4$ \
from type IIB\\n  Supergravity\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"28 pages, 4 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP04(2018)148\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
