                "\"title\"", "\[Rule]", 
                 "\"Integrable sigma models and 2-loop RG flow\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"28 pages; v3: minor comments and references added\""}]}, {
              
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP12(2019)146\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", "\"Imperial-TP-AT-2019-06\""}]}, {
              
