            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0510221\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Lisa Freyhult\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"L. Freyhult, C. Kristjansen, T. Mansson\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Integrable Spin Chains with U(1)^3 symmetry and \
generalized\\n  Lunin-Maldacena backgrounds\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"16 pages, 3 figures, references corrected\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0512 (2005) 008\""}]}, {
              
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2005/12/008\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"NORDITA-2005-68\""}]}, {
              
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We consider the most general three-state spin chain \
with U(1)^3 symmetry and\\nnearest neighbour interaction. Our model contains \
as a special case the spin\\nchain describing the holomorphic three scalar \
sector of the three parameter\\ncomplex deformation of N=4 SYM, dual to type \
IIB string theory in the\\ngeneralized Lunin-Maldacena backgrounds discovered \
by Frolov. We formulate the\\ncoordinate space Bethe ansatz, calculate the \
S-matrix and determine for which\\nchoices of parameters the S-matrix \
fulfills the Yang-Baxter equations. For\\nthese choices of parameters we \
furthermore write down the R-matrix. We find in\\ntotal four classes of \
integrable models. In particular, each already known\\nmodel of the above \
type is nothing but one in a family of such models.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 26 Oct 2005 08:03:07 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 31 Oct 2005 11:28:56 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2009-11-11\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
