                "\"authors\"", "\[Rule]", 
                 "\"R.N. Lee and A.I. Onishchenko\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"ABJM quantum spectral curve and Mellin transform\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"33 pages, typos corrected and clarifications added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP05(2018)179\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th hep-ph\""}]}, {
               
