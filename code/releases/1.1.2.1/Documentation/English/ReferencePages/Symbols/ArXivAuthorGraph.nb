                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Properties of D-Branes in Matrix Model of IIB \
Superstring\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", 
                  "\"15pp., Latex, v2: a few typos corrected, v3: coefficient \
in Eq.(3.19)\\n  corrected\""}]}, {
                
                RowBox[{
                 "\"journal-ref\"", "\[Rule]", 
                  "\"Phys.Lett. B400 (1997) 43-51\""}]}, {
                
                RowBox[{
                 "\"doi\"", "\[Rule]", 
                  "\"10.1016/S0370-2693(97)00323-7\""}]}, {
                
