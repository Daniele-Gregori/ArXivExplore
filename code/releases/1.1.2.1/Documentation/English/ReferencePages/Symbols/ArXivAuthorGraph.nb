                "\"journal-ref\"", "\[Rule]", "\"JHEP 09 (2013) 051\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP09(2013)051\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"LPT-13-04\""}]}, {
               
