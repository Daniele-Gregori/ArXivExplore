                 "\"Minkyoo Kim, Naoki Kiryu, Shota Komatsu, Takuya Nishimura\
\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Structure Constants of Defect Changing Operators on the \
1/2 BPS Wilson\\n  Loop\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"31 pages + appendices; v2 References added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP12(2017)055\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
