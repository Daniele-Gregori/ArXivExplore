                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Vernier\"", ",", "\"Eric\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Calabrese\"", ",", "\"Pasquale\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
