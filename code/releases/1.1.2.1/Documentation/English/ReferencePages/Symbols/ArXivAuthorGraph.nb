                    "\"Mon, 13 Sep 2021 17:58:44 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 7 Dec 2021 09:31:08 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2022-04-20\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
