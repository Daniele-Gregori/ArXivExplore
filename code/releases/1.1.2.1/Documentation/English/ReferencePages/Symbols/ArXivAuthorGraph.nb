                    "\"Wed, 6 Apr 2016 16:04:39 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 7 Apr 2016 10:35:31 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2017-02-15\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
