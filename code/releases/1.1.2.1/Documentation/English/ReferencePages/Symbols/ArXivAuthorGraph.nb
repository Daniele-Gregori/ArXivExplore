               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Nadav Drukker and Maxime Tr\\\\'epanier\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Observations on BPS observables in 6d\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"23 pages\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"J.Phys.A 54 (2021) 20, 205401\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1751-8121/abf38d\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
