                    RowBox[{"\"Lee\"", ",", "\"Hyun Kyu\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Rho\"", ",", "\"Mannque\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
