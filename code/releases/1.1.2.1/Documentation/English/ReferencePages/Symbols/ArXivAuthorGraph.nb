               "Fri, 15 May 2015 22:47:43 GMT"}}, "update_date" -> 
            "2015-12-09", 
            "authors_parsed" -> {{"Jiang", "Yunfeng", ""}, {
              "Kostov", "Ivan", ""}, {"Petrovskii", "Andrei", ""}, {
              "Serban", "Didina", ""}}}], "Tooltip"]& ], 
