               RowBox[{"\"id\"", "\[Rule]", "\"1412.1288\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Arsen Melikyan\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"A. Melikyan, E. Pereira and V. O. Rivelles\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On the equivalence theorem for integrable systems\""}]}, {
              
               RowBox[{"\"comments\"", "\[Rule]", "\"27 pages\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"J. Phys. A: Math. Theor. 48 (2015) 125204\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
