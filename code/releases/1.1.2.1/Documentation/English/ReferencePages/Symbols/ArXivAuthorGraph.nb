               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Connected correlator of 1/2 BPS Wilson loops in \
$\\\\mathcal{N}=4$ SYM\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"16 pages; v2:reference added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP10(2018)037\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
