               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Gluon scattering in AdS at finite string coupling from \
localization\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"26 pages plus appendices, v6 typo fixed\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
