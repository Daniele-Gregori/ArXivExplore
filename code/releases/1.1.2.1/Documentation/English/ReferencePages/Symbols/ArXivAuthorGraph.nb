               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"32 pages, 3 figures, 8 tables; v2: minor typos corrected, \
references\\n  added, acknowledgments made more precise\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP09(2021)007\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
