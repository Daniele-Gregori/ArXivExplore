            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"2008.09577\""}]}, {
               
               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Aleksandr Popolitov\""}]}, {
               
               RowBox[{
