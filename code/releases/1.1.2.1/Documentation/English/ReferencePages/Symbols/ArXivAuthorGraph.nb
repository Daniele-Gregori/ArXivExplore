               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Bootstrapping 4d $\\\\mathcal{N}=2$ gauge theories: the \
case of SQCD\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"23 pages plus appendix, 7 figures, v4 fixed typos\""}]}, {
              
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP01(2023)107\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
