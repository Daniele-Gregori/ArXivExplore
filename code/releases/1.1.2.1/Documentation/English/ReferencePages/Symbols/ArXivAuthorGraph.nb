               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Giant Magnon and Spike Solutions with Two Spins in \
AdS4xCP3\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"13pages, LaTeX, no figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0811:084,2008\""}]}, {
               
