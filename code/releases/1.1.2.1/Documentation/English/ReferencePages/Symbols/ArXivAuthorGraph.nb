                "\"authors\"", "\[Rule]", 
                 "\"Joakim Stromwall and Alessandro Torrielli\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"AdS3/CFT2 and q-Poincare' superalgebras\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"21 pages, no figures, pdfLaTeX; v2: typos corrected, \
references\\n  added; v3: matches journal version\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"DMUS-MP-16/12\""}]}, {
