                "\"comments\"", "\[Rule]", 
                 "\"1+35 pages, v3: further clarification provided in Section \
4, Section\\n  5 moved to an appendix, v4: improved arguments for the case of \
multi dyonic\\n  giant magnons, based on the published version\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0809:025,2008\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2008/09/025\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", "\"TCDMATH 08-09, UT-08-22\""}]}, {
