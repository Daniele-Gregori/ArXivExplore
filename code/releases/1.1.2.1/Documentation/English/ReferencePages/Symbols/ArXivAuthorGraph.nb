                 "\"Matthijs Hogervorst, Slava Rychkov, Balt C. van \
Rees\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"A Cheap Alternative to the Lattice?\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"56 pages, 22 figures; V2: defective figure file replaced; \
V3: minor\\n  corrections; refs added; V4: refs updated\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys. Rev. D 91, 025005 (2015)\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1103/PhysRevD.91.025005\""}]}, {
               
