                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 6 Jul 2018 09:33:27 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 12 Oct 2018 18:40:06 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2018-11-14\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
