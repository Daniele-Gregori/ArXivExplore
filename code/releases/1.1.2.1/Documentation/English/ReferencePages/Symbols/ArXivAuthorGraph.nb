               RowBox[{
                "\"authors\"", "\[Rule]", "\"Sridip Pal, Jaewon Song\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"New Dualities and Misleading Anomaly Matchings from \
Outer-automorphism\\n  Twists\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"28 pages, 18 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
