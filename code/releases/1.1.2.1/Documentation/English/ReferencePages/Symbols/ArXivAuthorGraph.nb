                "\"title\"", "\[Rule]", 
                 "\"A note on perturbation series in supersymmetric gauge \
theories\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"28 pages. V2: minor additions and reference added\""}]}, {
              
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP06(2012)038\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th hep-ph\""}]}, {
               
