               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Modeling Position and Momentum in Finite-Dimensional \
Hilbert Spaces via\\n  Generalized Pauli Operators\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"23 pages, 5 figures, comments welcome. v2 contains some \
change in\\n  terminology, added references\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"CALT-TH-2018-29\""}]}, {
              
               
