               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0512337\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Roberto Tateo\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Patrick Dorey, Anna Lishman, Chaiho Rim, Roberto \
Tateo\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Reflection factors and exact g-functions for purely \
elastic scattering\\n  theories\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"45 pages, 7 figures. v2: minor typos corrected, 3 new \
references and\\n  some further discussion of the massless boundary flows \
included\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys.B744:239-276,2006\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.nuclphysb.2006.02.043\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"DCPT-05/63\""}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", 
                 "\"hep-th cond-mat.stat-mech math-ph math.MP\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We discuss reflection factors for purely elastic \
scattering theories and\\nrelate them to perturbations of specific conformal \
boundary conditions, using\\nrecent results on exact off-critical \
g-functions. For the non-unitary cases, we\\nsupport our conjectures using a \
relationship with quantum group reductions of\\nthe sine-Gordon model. Our \
results imply the existence of a variety of new\\nflows between conformal \
boundary conditions, some of them driven by\\nboundary-changing operators.\\n\
\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 29 Dec 2005 13:02:30 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 24 Jan 2006 15:55:15 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
