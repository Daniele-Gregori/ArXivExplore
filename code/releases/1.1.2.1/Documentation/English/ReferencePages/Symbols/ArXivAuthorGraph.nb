               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  All symmetric space $AdS_n$ solutions of type II \
supergravity have recently\\nbeen found for $n>2$. For the supersymmetric \
solutions (and their T-duals) it\\nis known that the Green-Schwarz string is \
classically integrable. We complete\\nthe classification by ruling out \
integrability for the remaining\\nnon-supersymmetric solutions. This is \
achieved by showing that tree-level\\nscattering on the worldsheet of a GKP \
or BMN string fails to factorize for\\nthese cases.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
