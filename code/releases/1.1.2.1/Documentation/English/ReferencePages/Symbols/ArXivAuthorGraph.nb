                "\"title\"", "\[Rule]", 
                 "\"Duality Relations for Overlaps of Integrable Boundary \
States in AdS/dCFT\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"28 pages, 3 figures; v2: minor changes\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
