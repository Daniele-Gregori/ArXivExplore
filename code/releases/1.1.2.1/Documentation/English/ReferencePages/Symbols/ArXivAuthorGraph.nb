Wang, and\\n  Congkao Wen\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Modular Invariance in Superstring Theory From ${\\\\cal \
N} = 4$\\n  Super-Yang-Mills\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"33 pages + Appendices, 8 figures, Mathematica file \
attached; v2:\\n  typos fixed\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP11(2020)016\""}]}, {
               
