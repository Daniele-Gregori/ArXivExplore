               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Beta Function of k Deformed AdS_5 x S^5 String \
Theory\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"26 pages, some typos corrected\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP11(2015)095\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
