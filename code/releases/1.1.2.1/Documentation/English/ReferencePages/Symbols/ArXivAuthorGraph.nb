               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Fabrizio Pucci Dr.\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Fabrizio Pucci\""}]}, {
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"More on 't Hooft loops in N=4 SYM\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"30 pages\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 1211 (2012) 161\""}]}, {
              
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP11(2012)161\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"BI-TP 2012/34\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We study supersymmetric 't Hooft loop operators in N=4 \
super Yang-Mills,\\ngeneralizing the well-known circular 1/2 BPS case and \
investigating their\\nS-duality properties. We derive the BPS condition for a \
generic line operator\\ndescribing pointlike monopoles and discuss its \
solutions in some particular\\ncase. In particular, we present the explicit \
construction of the magnetic\\ncounterpart of Zarembo and DGRT Wilson loops \
and provide the general dyonic\\nconfigurations for an abelian gauge group. \
The quantum definition of these\\nsupersymmetric 't Hooft loop operators is \
carefully discussed and we attempt\\nsome computations to next-to-leading \
order in perturbation theory.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 27 Jul 2012 19:41:23 GMT\""}]}], "}"}], "}"}]}]}, {
