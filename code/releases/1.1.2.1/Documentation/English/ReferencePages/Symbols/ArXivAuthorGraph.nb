               RowBox[{"\"submitter\"", "\[Rule]", "\"Yunfeng Jiang\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Peihe Yang, Yunfeng Jiang, Shota Komatsu, Jun-Bao \
Wu\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Three-Point Functions in ABJM and Bethe Ansatz\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"Typos corrected, report number added, published \
version\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
