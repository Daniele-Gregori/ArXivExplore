               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"A Possible IIB Superstring Matrix Model with Euler \
Characteristic and a\\n  Double Scaling Limit\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"5 pages, LaTeX\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys.Lett. B405 (1997) 45\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1016/S0370-2693(97)00597-2\""}]}, {
