                "\"title\"", "\[Rule]", 
                 "\"A note on amplitudes in N=6 superconformal Chern-Simons \
theory\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"28 pages, 7 figures. v3: JHEP version\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP07(2012)160\""}]}, {
               
