\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys.B812:144-180,2009\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
