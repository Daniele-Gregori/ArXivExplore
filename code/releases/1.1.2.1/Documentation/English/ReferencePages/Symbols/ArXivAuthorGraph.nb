               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We show that the quantum corrected string Bethe ansatz \
passes an important\\nuniversality test by demonstrating that it correctly \
incorporates the\\nnon-analytical terms in the string sigma model one-loop \
correction for rational\\nthree-spin strings with two out of the three spins \
identical. Subsequently, we\\nuse the quantum corrected string Bethe ansatz \
to predict the exact form of the\\nnon-analytic terms for the generic \
rational three-spin string.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
