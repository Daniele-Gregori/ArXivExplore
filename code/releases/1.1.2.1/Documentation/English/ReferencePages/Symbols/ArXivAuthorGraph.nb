               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Four-point amplitudes in $\\\\mathcal{N}=2$ SCQCD\""}]}, {
              
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"38 pages, jheppub; v2: minor corrections, JHEP published \
version; v3:\\n  two-loop chiral propagator corrected, maximal \
transcendentality at two loops\\n  not respected anymore, JHEP Erratum\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP09(2014)017\""}]}, {
               
