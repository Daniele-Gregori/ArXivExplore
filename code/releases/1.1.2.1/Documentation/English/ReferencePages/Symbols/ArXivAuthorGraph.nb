                  "\"World-sheet scattering in AdS_5 x S^5 at two \
loops\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", "\"26pages, 3 figures\""}]}, {
                
                RowBox[{
                 "\"journal-ref\"", "\[Rule]", "\"JHEP0708:051,2007\""}]}, {
                
                RowBox[{
                 "\"doi\"", "\[Rule]", 
