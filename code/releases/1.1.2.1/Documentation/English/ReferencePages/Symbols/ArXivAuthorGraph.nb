                    RowBox[{"\"version\"", "\[Rule]", "\"v3\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 9 Dec 2010 15:54:44 GMT\""}]}], "}"}]}], 
