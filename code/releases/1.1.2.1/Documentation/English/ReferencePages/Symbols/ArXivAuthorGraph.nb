                "\"title\"", "\[Rule]", 
                 "\"New quantum toroidal algebras from 5D $\\\\mathcal{N}=1$ \
instantons on\\n  orbifolds\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"44 pages; v3. two appendices added: Relation with quantum \
toroidal\\n  gl(p) algebra & Examples of qq-characters\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP05(2020)127\""}]}, {
               
