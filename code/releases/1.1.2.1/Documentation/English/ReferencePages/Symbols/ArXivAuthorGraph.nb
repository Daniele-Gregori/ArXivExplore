                 "\"Vladimir Gritsev, Timofei Rostunov, Eugene Demler\""}]}, {
              
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Exact methods in analysis of nonequilibrium dynamics of \
integrable\\n  models: application to the study of correlation functions in \
nonequilibrium\\n  1D Bose gas\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"27 pages, 7 figures, minor corrections, refs added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"J. Stat. Mech. (2010) P05012\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
