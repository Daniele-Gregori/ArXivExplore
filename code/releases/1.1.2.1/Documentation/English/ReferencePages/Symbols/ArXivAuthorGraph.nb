               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Higher Charges in Dynamical Spin Chains for SYM \
Theory\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"14 pages; V2: Appendix added with diagrammatic expression \
for H_{3,2}\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0510 (2005) 051\""}]}, {
              
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2005/10/051\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We construct, to the first two non-trivial orders, the \
next conserved charge\\nin the su(2|3) sector of N=4 Super Yang-Mills theory. \
This represents a test of\\nintegrability in a sector where the interactions \
change the number of sites of\\nthe chain. The expression for the charge is \
completely determined by the\\nalgebra and can be written in a diagrammatic \
form in terms of the interactions\\nalready present in the Hamiltonian. It \
appears likely that this diagrammatic\\nexpression remains valid in the full \
theory and can be generalized to higher\\nloops and higher charges thus \
helping in establishing complete integrability\\nfor these dynamical \
chains.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
