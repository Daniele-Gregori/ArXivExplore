               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0409259\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Toni Mateos\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Toni Mateos\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"D-branes, gauge/string duality and noncommutative \
theories\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"PhD thesis, 281 pages, 41 figures. v2: added \
references\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  In this thesis we elaborate on the three subjects of \
the title. We first show\\nthat supertubes exist and still preserve some \
supersymmetry in a large variety\\nof curved backgrounds. Within the AdS/CFT \
correspondence we study the\\nsupersymmetry of rotating strings with 3 \
angular momenta, and we consider the\\npossibility of adding matter in a \
stable but non-supersymmetric way. We\\ncontribute to the extension of the \
duality to more realistic YM theories by\\nconstructing the sugra dual of an \
N=2 pure SYM in 3d, given in terms of a\\nCalabi-Yau four-fold in M-theory. \
We study the unitarity of noncommutative\\nnonrelativistic field theories, we \
construct the sugra dual of noncommutative\\npure SYM theories with N=1 in 4d \
and N=2 in 3d, and we study holographically\\nproperties like UV/IR mixing, \
confinement, chiral symmetry breaking and moduli\\nspaces.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 24 Sep 2004 17:26:19 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Sat, 13 Nov 2004 18:59:11 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2007-05-23\""}]}, {
