                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Komatsu\"", ",", "\"Shota\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Kostov\"", ",", "\"Ivan\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Serban\"", ",", "\"Didina\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
