               RowBox[{"\"submitter\"", "\[Rule]", "\"Ben Hoare\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Lorenzo Bianchi, Valentina Forini, Ben Hoare\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Two-dimensional S-matrices from unitarity cuts\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"23 pages, 1 figure; v2: 24 pages, minor corrections, \
reference and\\n  note added; v3: minor typos corrected\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP07(2013)088\""}]}, {
