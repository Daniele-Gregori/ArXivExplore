               RowBox[{"\"id\"", "\[Rule]", "\"0810.4127\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Alin Tirziu\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", "\"M. Beccaria and A. Tirziu\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On the short string limit of the folded spinning string \
in AdS5 x S5\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"24 pages, v2: minor changes, references added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
