               RowBox[{"\"id\"", "\[Rule]", "\"0711.4108\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Zurab Kakushadze\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Zurab Kakushadze\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Tachyon-Free Non-Supersymmetric Strings on \
Orbifolds\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"17 pages\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Int.J.Mod.Phys.A23:4371-4386,2008\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1142/S0217751X08042304\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We discuss tachyon-free examples of (Type IIB on) \
non-compact\\nnon-supersymmetric orbifolds. Tachyons are projected out by \
discrete torsion\\nbetween orbifold twists, while supersymmetry is broken by \
a Scherk-Schwarz\\nphase (+1/-1 when acting on space-time bosons/fermions) \
accompanying some even\\norder twists. The absence of tachyons is encouraging \
for constructing\\nnon-supersymmetric D3-brane gauge theories with stable \
infrared fixed points.\\nThe D3-brane gauge theories in our orbifold \
backgrounds have chiral N = 1\\nsupersymmetric spectra, but \
non-supersymmetric interactions.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 26 Nov 2007 21:00:01 GMT\""}]}], "}"}], "}"}]}]}, {
