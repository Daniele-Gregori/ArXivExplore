                    RowBox[{"{", 
                    RowBox[{"\"Festuccia\"", ",", "\"Guido\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Qiu\"", ",", "\"Jian\"", ",", "\"\""}], "}"}], 
                    ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Winding\"", ",", "\"Jacob\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
