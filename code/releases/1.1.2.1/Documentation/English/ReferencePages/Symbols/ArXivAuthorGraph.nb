                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 21 Sep 2020 20:29:00 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2020-12-02\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Giombi\"", ",", "\"Simone\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Tseytlin\"", ",", "\"Arkady A.\"", ",", "\"\""}], 
