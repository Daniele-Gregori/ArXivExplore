                "\"title\"", "\[Rule]", 
                 "\"String States on AdS_3 x S^3 from the Supergroup\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"38 pages, LaTeX; v2: explanations and references added; \
v3: typos\\n  corrected\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP10(2012)084\""}]}, {
