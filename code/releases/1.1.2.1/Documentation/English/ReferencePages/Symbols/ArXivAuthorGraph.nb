               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/9705114\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Jan Plefka\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Gernot Akemann and Jan C. Plefka\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"The Chiral Supereigenvalue Model\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"LateX2e, 15 pages\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Mod.Phys.Lett.A12:1745-1758,1997\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1142/S0217732397001783\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
                 "\"CPT-97/P.3483, NIKHEF 97-019\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  A supereigenvalue model with purely positive bosonic \
eigenvalues is presented\\nand solved by considering its superloop equations. \
This model represents the\\nsupersymmetric generalization of the complex one \
matrix model, in analogy to\\nthe relation between the supereigenvalue and \
the hermitian one matrix model.\\nClosed expressions for all planar \
multi-superloop correlation functions are\\nfound. Moreover an iterative \
scheme allows the calculation of higher genus\\ncontributions to the free \
energy and to the correlators. Explicit results for\\ngenus one are given.\\n\
\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 15 May 1997 11:42:46 GMT\""}]}], "}"}], "}"}]}]}, {
