Anton Nedelin\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"New 3d $\\\\mathcal{N}=2$ SCFT's with $N^{3/2}$ \
scaling\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"33+34 pages, 4 appendices, 7 figures, 3 tables; v2: \
references added,\\n  minor corrections; v3: version published in JHEP\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP12(2019)111\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
