               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/9903090\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Adi Armoni\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Adi Armoni, Ehud Fuchs and Jacob Sonnenschein\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Confinement in 4D Yang-Mills Theories from Non-Critical \
Type 0 String\\n  Theory\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"25 pages, Latex. 1 figure. v2: refs. added, minor \
corrections, note\\n  added in section 4\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 9906 (1999) 027\""}]}, {
              
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/1999/06/027\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"TAUP-2565-99\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We study five dimensional non critical type 0 string \
theory and its\\ncorrespondence to non supersymmetric Yang Mills theory in \
four dimensions. We\\nsolve the equations of motion of the low energy \
effective action and identify a\\nclass of solutions that translates into a \
confining behavior in the IR region\\nof the dual gauge theories. In \
particular we identify a setup which is dual to\\npure SU(N) Yang-Mills \
theory. Possible flows of the solutions to the UV region\\nare discussed. The \
validity of the solutions and potential sub-leading string\\ncorrections are \
also discussed.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 10 Mar 1999 20:06:07 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
