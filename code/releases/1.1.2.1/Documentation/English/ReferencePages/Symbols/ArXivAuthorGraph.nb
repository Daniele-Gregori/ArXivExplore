               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/9607099\""}]}, {
               
               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Vladimir Bazhanov\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"V.V.Bazhanov, S.L.Lukyanov, A.B.Zamolodchikov\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Integrable Quantum Field Theories in Finite Volume: \
Excited State\\n  Energies\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"54 pages, harvmac, epsf, TeX file and postscript figures \
packed in a\\n  single selfextracting uufile. Compiles only in the `Big' mode \
with harvmac\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys.B489:487-531,1997\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1016/S0550-3213(97)00022-9\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", "\"CLNS 96/1416, LPM-96/24\""}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", 
                 "\"hep-th cond-mat math.QA nlin.SI q-alg solv-int\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We develop a method of computing the excited state \
energies in Integrable\\nQuantum Field Theories (IQFT) in finite geometry, \
with spatial coordinate\\ncompactified on a circle of circumference R. The \
IQFT ``commuting\\ntransfer-matrices'' introduced by us (BLZ) for Conformal \
Field Theories (CFT)\\nare generalized to non-conformal IQFT obtained by \
perturbing CFT with the\\noperator $\\\\Phi_{1,3}$. We study the models in \
which the fusion relations for\\nthese ``transfer-matrices'' truncate and \
provide closed integral equations\\nwhich generalize the equations of \
Thermodynamic Bethe Ansatz to excited states.\\nThe explicit calculations are \
done for the first excited state in the ``Scaling\\nLee-Yang \
Model''.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
