               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0212235\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"David Tong\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"David Tong\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Comments on Condensates in Non-Supersymmetric Orbifold \
Field Theories\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"10 Pages. Added clarifying comments, computational steps \
and a nice\\n  pretty picture\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0303 (2003) 022\""}]}, {
              
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2003/03/022\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  Non-supersymmetric orbifolds of N=1 super Yang-Mills \
theories are conjectured\\nto inherit properties from their supersymmetric \
parent. We examine this\\nconjecture by compactifying the Z_2 orbifold \
theories on a spatial circle of\\nradius R. We point out that when the \
orbifold theory lies in the weakly coupled\\nvacuum of its parent, fractional \
instantons do give rise to the conjectured\\ncondensate of bi-fundamental \
fermions. Unfortunately, we show that quantum\\neffects render this vacuum \
unstable through the generation of twisted\\noperators. In the true vacuum \
state, no fermion condensate forms. Thus, in\\ncontrast to super Yang-Mills, \
the compactified orbifold theory undergoes a\\nchiral phase transition as R \
is varied.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 19 Dec 2002 12:50:45 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 25 Mar 2003 16:24:04 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2009-11-07\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{"\"Tong\"", ",", "\"David\"", ",", "\"\""}], 
                    "}"}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
