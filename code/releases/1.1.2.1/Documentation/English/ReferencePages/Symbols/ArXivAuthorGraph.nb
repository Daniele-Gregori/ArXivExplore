               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"From PT-symmetric quantum mechanics to conformal field \
theory\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"27 pages, 12 figures, contribution to the Proceedings of \
PHHQP VIII\\n  (Mumbai, January 2009)\""}]}, {
               
