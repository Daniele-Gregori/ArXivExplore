               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Joseph A. Minahan\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"J. A. Minahan, O. Ohlsson Sax\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Finite size effects for giant magnons on physical strings\
\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"24 pages, 7 figures; v2 typos fixed\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys.B801:97-117,2008\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.nuclphysb.2008.04.018\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"UUITP-20/07\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  Using finite gap methods, we find the leading order \
finite size corrections\\nfor an arbitrary number of giant magnons on \
physical strings, where the sum of\\nthe momenta is a multiple of 2\\\\pi. \
Our results are valid for the\\nHofman-Maldacena fundamental giant magnons as \
well as their dyonic\\ngeneralizations. The energy corrections turn out to be \
surprisingly simple,\\nespecially if all the magnons are fundamental, and at \
leading order are\\nindependent of the magnon flavors. We also show how to \
use the Bethe ansatz to\\nfind finite size corrections for dyonic giant \
magnons with large R-charges.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
