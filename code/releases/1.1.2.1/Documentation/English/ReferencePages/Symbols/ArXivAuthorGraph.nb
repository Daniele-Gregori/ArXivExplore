                "\"title\"", "\[Rule]", 
                 "\"T-functions and multi-gluon scattering amplitudes\""}]}, {
              
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"36 pages, 5 figures, v2: published version, v3: minor \
corrections\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP02(2012)003\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
