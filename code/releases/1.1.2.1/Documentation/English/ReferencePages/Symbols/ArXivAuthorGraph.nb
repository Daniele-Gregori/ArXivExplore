                "\"title\"", "\[Rule]", 
                 "\"Exciting the GKP string at any coupling\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"72 pages, 6 figures, references added, misprints \
corrected, minor\\n  revision of section 2 and 4\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.nuclphysb.2011.12.010\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
