         Annotation[#, 
          
          TableForm[{
           "id" -> "1907.02923", "submitter" -> "Constantinos Papageorgakis", 
            "authors" -> 
            "Gergely K\\'antor, Constantinos Papageorgakis, Paul Richmond", 
            "title" -> 
            "AdS$_7$ Black-Hole Entropy and 5D $\\mathcal{N}=2$ Yang-Mills", 
            "comments" -> 
            "35 pages; v2 field-theory discussion modified, appendix added \
and\n  typos corrected; v3 published version", "journal-ref" -> Null, "doi" -> 
            "10.1007/JHEP01(2020)017", "report-no" -> "QMUL-PH-19-17", 
            "categories" -> "hep-th", "license" -> 
            "http://arxiv.org/licenses/nonexclusive-distrib/1.0/", "abstract" -> 
            "  We generalise the work of 1810.11442 for the case of \
AdS$_7$/CFT$_6$.\nStarting from the 2-equivalent charge, 3-equivalent \
rotation non-extremal\nblack-hole solution in 7D gauged supergravity, we \
consider the supersymmetric\nand then the extremal limit and evaluate the \
associated thermodynamic\nquantities. Away from extremality, the black-hole \
solution becomes complex. The\nentropy is then given by the Legendre \
transform of the on-shell action with\nrespect to two complex chemical \
potentials subject to a constraint. At the\nconformal boundary we derive the \
dual background and evaluate the corresponding\npartition function for the \
$A_{N-1}$ 6D (2,0) theory at large $N$ in a\nCardy-like limit. This is \
carried out via a 5D $\\mathcal N=2$ super Yang-Mills\ncalculation on $S^5$. \
The gravitational on-shell action is found to be exactly\nreproduced by the \
boundary partition function at large $N$. We argue that this\nagreement puts \
strong constraints on the form of possible higher-derivative\ncorrections to \
the 5D gauge theory that is used in the $S^5$ evaluation.\n", 
            "versions" -> {{
              "version" -> "v1", "created" -> 
               "Fri, 5 Jul 2019 16:46:24 GMT"}, {
              "version" -> "v2", "created" -> 
               "Fri, 4 Oct 2019 09:54:21 GMT"}, {
              "version" -> "v3", "created" -> 
               "Thu, 2 Jan 2020 20:15:07 GMT"}}, "update_date" -> 
            "2020-01-29", 
            "authors_parsed" -> {{"K\[AAcute]ntor", "Gergely", ""}, {
              "Papageorgakis", "Constantinos", ""}, {
              "Richmond", "Paul", ""}}}], "Tooltip"]& ], 
