               RowBox[{"\"id\"", "\[Rule]", "\"0810.4548\""}]}, {
               
               RowBox[{
                "\"submitter\"", "\[Rule]", "\"In\\\\^es Aniceto\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"In\\\\^es Aniceto and Antal Jevicki\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"N-body Dynamics of Giant Magnons in RxS2\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"19 pages, no figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"BROWN-HET 1567\""}]}, {
