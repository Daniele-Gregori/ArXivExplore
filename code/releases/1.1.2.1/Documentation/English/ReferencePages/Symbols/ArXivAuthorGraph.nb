                "\"title\"", "\[Rule]", 
                 "\"Factorization of R-matrix and Baxter Q-operators for \
generic sl(N) spin\\n  chains\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"41 pages, 5 figures, published version\""}]}, {
               
