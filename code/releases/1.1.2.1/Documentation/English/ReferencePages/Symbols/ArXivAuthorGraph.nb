                "\"title\"", "\[Rule]", 
                 "\"g-Functions and gluon scattering amplitudes at strong \
coupling\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"51 pages, 4 figures, v2: some comments and references \
added, based on\\n  the published version, v3: minor changes\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 1104:100,2011\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP04(2011)100\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
