                 "\"Razvan Gurau, Jacques Magnen, Vincent Rivasseau, \
Fabien\\n  Vignes-Tourneret\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Renormalization of Non-Commutative Phi^4_4 Field Theory \
in x Space\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"32 pages, v2: correction of lemmas 3.1 and 3.2 with no \
consequence on\\n  the main result\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Commun.Math.Phys.267:515-542,2006\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/s00220-006-0055-8\""}]}, {
