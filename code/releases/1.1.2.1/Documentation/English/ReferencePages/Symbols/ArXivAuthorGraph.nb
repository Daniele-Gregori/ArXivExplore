               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Entanglement Entropy of the Klebanov-Strassler with \
dynamical flavors\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"17 pages, 6 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
