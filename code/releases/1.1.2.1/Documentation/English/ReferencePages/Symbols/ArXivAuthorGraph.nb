                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 8 Oct 1999 13:16:37 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2009-10-31\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
