                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 5 May 2004 23:32:16 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2007-05-23\""}]}, {
