               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Nikita Nekrasov and Samson L. Shatashvili\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On Non-Supersymmetric CFT in Four Dimensions\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"harvmac, 4 pp; v2. Z_4 field content corrected, \
references reworked\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys.Rept. 320 (1999) 127-129\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1016/S0370-1573(99)00059-9\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
                 "\"ITEP-TH-06/99, HUTP-99/A007\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We show that the $\\\\mathcal{N}=0$ theories on the \
self-dual D3-branes of Type\\n0 string theory are in the class of the \
previously considered tadpole-free\\norbifolds of $\\\\mathcal{N} = 4$ theory \
(although they have SO(6) global\\nsymmetry) and hence have vanishing beta \
function in the planar limit to all\\norders in 't Hooft coupling. Also, all \
planar amplitudes in this theory are\\nequal to those of $\\\\mathcal{N} = 4$ \
theory, up to a rescaling of the coupling.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
