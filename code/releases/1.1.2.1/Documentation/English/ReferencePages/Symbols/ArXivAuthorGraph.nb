at Large $N$\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", 
                  "\"13pp. LaTeX, no local preprint\""}]}, {
                RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
