               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Joseph A. Minahan\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Joseph A. Minahan\""}]}, {
              
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Localizing gauge theories on $S^d$\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"17 pages; v2: Typos corrected\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
