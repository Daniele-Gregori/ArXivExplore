               "Thu, 16 Sep 2004 16:05:04 GMT"}, {
              "version" -> "v4", "created" -> 
               "Sat, 22 Oct 2005 21:12:20 GMT"}}, "update_date" -> 
            "2011-03-23", "authors_parsed" -> {{"Beisert", "Niklas", ""}}}], 
          "Tooltip"]& ], 
        TagBox[
         TooltipBox[DiskBox[{17.258624156903945`, -2.6896567447027904`}, 0.],
          TagBox[
           TagBox[
            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0408014\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Kota Ideguchi\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Kota Ideguchi\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Semiclassical Strings on AdS_5 x S^5/Z_M and Operators in \
Orbifold Field\\n  Theories\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"LaTeX, 23 pages, 4 figures; v2 minor corrections, added \
references;\\n  v3 typos corrected, published version\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP0409:008,2004\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2004/09/008\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"UT-04-21\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We show agreements, at one-loop level of field theory, \
between energies of\\nsemiclassical string states on AdS_5 x S^5/Z_M and \
anomalous dimensions of\\noperators in N=0,1,2 orbifold field theories \
originating from N=4 SYM. On field\\ntheory side, one-loop anomalous \
dimension matrices can be regarded as\\nHamiltonians of spin chains with \
twisted boundary conditions. These are\\nsolvable by Bethe ansatz. On string \
side, twisted sectors emerge and we obtain\\nsome string configurations in \
twisted sectors. In SU(2) subsectors, we compare\\nanomalous dimensions with \
string energies and see agreements. We also see\\nagreements between sigma \
models of both sides in SU(2) and SU(3) subsectors.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 2 Aug 2004 19:14:21 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 13 Aug 2004 16:04:58 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
