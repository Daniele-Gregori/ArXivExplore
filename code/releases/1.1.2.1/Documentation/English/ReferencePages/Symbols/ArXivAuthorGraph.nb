               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"More on integrable structures of superstrings in AdS(4) x \
CP(3) and\\n  AdS(2) x S(2) x T(6) superbackgrounds\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"28 pages; v2: References added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP01(2012)004\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"MIFPA-11-50\""}]}, {
