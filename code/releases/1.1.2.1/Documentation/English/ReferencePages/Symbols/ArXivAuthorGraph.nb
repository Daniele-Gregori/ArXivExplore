                 "\"Leonardo Santilli and Miguel Tierz\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Complex (super)-matrix models with external sources and \
$q$-ensembles of\\n  Chern-Simons and ABJ(M) type\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"30 pages, 2 figures. v2: A correction made and several \
new results\\n  added; title changed. v3: Presentation reorganized, new \
results and\\n  references added, final version\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"J. Phys. A: Math. Theor. 53 425201 (2020)\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1751-8121/abb6b0\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", 
                 "\"hep-th cond-mat.stat-mech math-ph math.MP\""}]}, {
               
