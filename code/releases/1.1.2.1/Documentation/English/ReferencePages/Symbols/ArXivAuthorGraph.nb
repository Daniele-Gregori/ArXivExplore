               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Matching three-point functions of BMN operators at weak \
and strong\\n  coupling\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"14 pages, 1 figure\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
