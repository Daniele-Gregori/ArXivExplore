               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Structure Constants and Integrable Bootstrap in Planar \
N=4 SYM Theory\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"13 pages + several appendices\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
