               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Christof Gattringer\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"C.R. Gattringer, L.D. Paniak and G.W. Semenoff \
(University of British\\n  Columbia)\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Deconfinement Transition for Quarks on a Line\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"Reported problems with figures fixed; 38 pages, LaTeX, 5 \
figures,\\n  epsfig\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Annals Phys. 256 (1997) 74-113\""}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "\"10.1006/aphy.1997.5671\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", "\"hep-th hep-lat hep-ph\""}]}, {
              
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We examine the statistical mechanics of a 1-dimensional \
gas of both adjoint\\nand fundamental representation quarks which interact \
with each other through\\n1+1-dimensional U(N) gauge fields. Using large-N \
expansion we show that, when\\nthe density of fundamental quarks is small, \
there is a first order phase\\ntransition at a critical temperature and \
adjoint quark density which can be\\ninterpreted as deconfinement. When the \
fundamental quark density is comparable\\nto the adjoint quark density, the \
phase transition becomes a third order one.\\nWe formulate a way to \
distinguish the phases by considering the expectation\\nvalues of high \
winding number Polyakov loop operators.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
