               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Freidel-Maillet type presentations of $U_q(sl_2)$\""}]}, {
              
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"20 pages; v2: Abstract improved, footnote 2 added\""}]}, {
              
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nuclear Physics B 975 (2022) 115682\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.nuclphysb.2022.115682\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
