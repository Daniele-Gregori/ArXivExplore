               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On the Regularization of Extremal Three-point Functions \
Involving Giant\\n  Gravitons\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"5 pages, no figures. v2 updated references\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.physletb.2015.09.056\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"QMUL-PH-15-15\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  In the AdS_5/CFT_4 set-up, extremal three-point \
functions involving two giant\\n1/2 BPS gravitons and one point-like 1/2 BPS \
graviton, when calculated using\\nsemi-classical string theory methods, match \
the corresponding three-point\\nfunctions obtained in the tree-level gauge \
theory. The string theory\\ncomputation relies on a certain regularization \
procedure whose justification is\\nbased on the match between gauge and \
string theory. We revisit the\\nregularization procedure and reformulate it \
in a way which allows a\\ngeneralization to the ABJM set-up where three-point \
functions of 1/2 BPS\\noperators are not protected and where a match between \
tree-level gauge theory\\nand semi-classical string theory is hence not \
expected.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 14 Jul 2015 18:57:23 GMT\""}]}], "}"}], ",", 
