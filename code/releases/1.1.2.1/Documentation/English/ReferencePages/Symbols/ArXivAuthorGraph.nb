                    RowBox[{"{", 
                    RowBox[{"\"Closset\"", ",", "\"Cyril\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Kim\"", ",", "\"Heeyeon\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Willett\"", ",", "\"Brian\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
