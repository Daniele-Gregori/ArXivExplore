            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0601139\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Alin Tirziu\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"A. Tirziu\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Quantum Landau-Lifshitz model at four loops: 1/J and \
1/J^2 corrections\\n  to BMN energies\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"22 pages, references added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys.Rev.D73:106001,2006\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1103/PhysRevD.73.106001\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  In a previous paper (hep-th/0510080) the effective \
Landau-Lifshitz (LL)\\nLagrangians in the SU(2) sector coming from string \
theory and gauge theory have\\nbeen found to three loops in the effective \
expansion parameter\\n$\\\\tilde\\\\lambda=\\\\lambda/J^2$. In this paper we \
continue this study and find the\\neffective Landau-Lifshitz Lagrangians to \
four loops. We extend to four-loops\\n$\\\\tilde\\\\lambda^4$ the \
computations of 1/J and $1/J^2$ corrections to BMN\\nenergies done in \
hep-th/0510080 to three-loops. We compare these corrections\\nobtained from \
quantum ``gauge-theory'' LL action with the corrections obtained\\nfrom the \
conjectured Bethe ansatz for the long range spin chain \
representing\\nperturbative {large $N$} $\\\\NN=4$ Super Yang-Mills in the \
SU(2) sector and find\\nperfect matching to four loops \
$\\\\tilde\\\\lambda^4$. We compare also the 1/J and\\n$1/J^2$ corrections \
obtained from quantum ``string-theory'' LL action with\\nthose obtained from \
the \\\"quantum string\\\" Bethe ansatz and again find perfect\\nmatching to \
four-loops.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 19 Jan 2006 18:03:51 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 30 Jan 2006 16:43:42 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
