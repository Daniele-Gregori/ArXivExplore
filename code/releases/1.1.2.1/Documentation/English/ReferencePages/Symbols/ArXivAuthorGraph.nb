               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"16 pages. Latex. v2: Misprints corrected and references \
added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP0411:079,2004\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2004/11/079\""}]}, {
