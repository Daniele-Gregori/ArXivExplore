               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Relativistic corrections to the static energy in terms of \
Wilson loops\\n  at weak coupling\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"32 pages, 12 figures; v2: journal version\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Eur. Phys. J. C (2017) 77:681\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1140/epjc/s10052-017-5250-6\""}]}, {
