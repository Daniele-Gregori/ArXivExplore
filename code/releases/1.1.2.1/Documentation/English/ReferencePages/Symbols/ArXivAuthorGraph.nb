                 "\"Skyrmion approach to finite density and \
temperature\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"To appear in \\\"The Multifaceted Skyrmion\\\" (World \
Scientific) ed. G.E.\\n  Brown and M. Rho\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1142/9789814280709_0005\""}]}, {
