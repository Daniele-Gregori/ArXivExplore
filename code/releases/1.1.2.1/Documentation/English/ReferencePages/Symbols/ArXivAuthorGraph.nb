               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0205238\""}]}, {
               
               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Vladimir Bazhanov\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"R. M. Ellem, V. V. Bazhanov (ANU)\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Excited State TBA for the $\\\\phi_{2,1}$ perturbed \
$M_{3,5}$ model\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"LaTeX, 32 pages, 6 figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys.B647:404-432,2002\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1016/S0550-3213(02)00843-X\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We examine some excited state energies in the \
non-unitary integrable quantum\\nfield theory obtained from the perturbation \
of the minimal conformal field\\ntheory model $M_{3,5}$ by its operator \
$\\\\phi_{2,1}$. Using the correspondence\\nof this IQFT to the scaling limit \
of the dilute $A_2$ lattice model (in a\\nparticular regime) we derive the \
functional equations for the QFT commuting\\ntransfer matrices. These \
functional equations can be transformed to a closed\\nset of TBA-like \
integral equations which determine the excited state energies\\nin the \
finite-size system. In particular, we explicitly construct these\\nequations \
for the ground state and two lowest excited states. Numerical results\\nfor \
the associated energy gaps are compared with those obtained by \
the\\ntruncated conformal space approach (TCSA).\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 23 May 2002 07:20:00 GMT\""}]}], "}"}], "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2011-02-11\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
