               RowBox[{"\"submitter\"", "\[Rule]", "\"Bruno Le Floch\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Bruno Le Floch\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"A slow review of the AGT correspondence\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"106 pages plus 1309 refs. Published version\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"2022 J. Phys. A: Math. Theor. 55 353002\""}]}, {
               
