                    RowBox[{"{", 
                    RowBox[{"\"Bianchi\"", ",", "\"Massimo\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Green\"", ",", "\"Michael B.\"", ",", "\"\""}],
                     "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Kovacs\"", ",", "\"Stefano\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
