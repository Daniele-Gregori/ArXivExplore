                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Castro-Alvaredo\"", ",", "\"Olalla A.\"", ",", 
                    "\"\""}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Negro\"", ",", "\"Stefano\"", ",", "\"\""}], 
                    "}"}], ",", 
