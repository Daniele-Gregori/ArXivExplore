                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Feverati\"", ",", "\"Giovanni\"", ",", "\"\""}], "}"}],
                     ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Fioravanti\"", ",", "\"Davide\"", ",", "\"\""}], "}"}],
                     ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Grinza\"", ",", "\"Paolo\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Rossi\"", ",", "\"Marco\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
