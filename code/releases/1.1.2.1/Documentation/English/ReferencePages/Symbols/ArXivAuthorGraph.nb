          TagBox[
           TagBox[
            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0611151\""}]}, {
               
               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Pietro Antonio Grassi\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", "\"P.A. Grassi and J. Kluson\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Pure Spinor Strings in TsT Deformed Background\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"35 pages, no figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0703:033,2007\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2007/03/033\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"DISTA-UPO-06\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We consider pure spinor strings that propagate in the \
background generated by\\na sequence of TsT transformations. We use the fact \
that U(1) isometry variables\\nof TsT-transformed background are related to \
the isometry variables of the\\ninitial background in the universal way that \
is independent of the details of\\nthe background. We will argue that after \
redefinitions of pure spinors and the\\nfermionic variables we can construct \
pure spinor action with manifest U(1)\\nisometry. This fact implies that the \
pure spinor string in TsT-transformed\\nbackground is described by pure \
spinor string in the original background where\\nworld-volume modes are \
subject to twisted boundary conditions. We will argue\\nthat these twisted \
boundary conditions generally prevent to prove the quantum\\nconformal \
invariance of the pure spinor string in AdS_5 x S^5 background. \
We\\ndetermine the conditions under which this quantum conformal invariance \
can be\\nproved. We also determine the Lax pair for pure spinor strings in \
the\\nTsT-transformed background.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 14 Nov 2006 14:07:10 GMT\""}]}], "}"}], "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2010-10-27\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Grassi\"", ",", "\"P. A.\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Kluson\"", ",", "\"J.\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
             Left, ColumnAlignments -> Left], Column], 
           Function[BoxForm`e$, 
            TableForm[BoxForm`e$]]]],
         Annotation[#, 
          
          TableForm[{
           "id" -> "hep-th/0611151", "submitter" -> "Pietro Antonio Grassi", 
            "authors" -> "P.A. Grassi and J. Kluson", "title" -> 
            "Pure Spinor Strings in TsT Deformed Background", "comments" -> 
            "35 pages, no figures", "journal-ref" -> "JHEP 0703:033,2007", 
            "doi" -> "10.1088/1126-6708/2007/03/033", "report-no" -> 
            "DISTA-UPO-06", "categories" -> "hep-th", "license" -> Null, 
            "abstract" -> 
            "  We consider pure spinor strings that propagate in the \
background generated by\na sequence of TsT transformations. We use the fact \
that U(1) isometry variables\nof TsT-transformed background are related to \
the isometry variables of the\ninitial background in the universal way that \
is independent of the details of\nthe background. We will argue that after \
redefinitions of pure spinors and the\nfermionic variables we can construct \
pure spinor action with manifest U(1)\nisometry. This fact implies that the \
pure spinor string in TsT-transformed\nbackground is described by pure spinor \
string in the original background where\nworld-volume modes are subject to \
twisted boundary conditions. We will argue\nthat these twisted boundary \
conditions generally prevent to prove the quantum\nconformal invariance of \
the pure spinor string in AdS_5 x S^5 background. We\ndetermine the \
conditions under which this quantum conformal invariance can be\nproved. We \
also determine the Lax pair for pure spinor strings in the\nTsT-transformed \
background.\n", 
            "versions" -> {{
              "version" -> "v1", "created" -> 
               "Tue, 14 Nov 2006 14:07:10 GMT"}}, "update_date" -> 
            "2010-10-27", 
            "authors_parsed" -> {{"Grassi", "P. A.", ""}, {
              "Kluson", "J.", ""}}}], "Tooltip"]& ], 
