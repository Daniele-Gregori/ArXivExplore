            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"1804.00942\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Shinji Hirano\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Pawel Caputa and Shinji Hirano\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Airy Function and 4d Quantum Gravity\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"17 pages\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP06(2018)106\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"YITP-18-24\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th gr-qc\""}]}, {
               
