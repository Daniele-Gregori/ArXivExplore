                "\"comments\"", "\[Rule]", 
                 "\"96 pages, 15 figures; Some mathematica examples added in \
v2;\\n  Published version is v3\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 1509 (2015) 187\""}]}, {
              
               
