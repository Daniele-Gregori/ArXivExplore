               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Black hole spectra in holography: consequences for \
equilibration of dual\\n  gauge theories\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"34 pages, 6 figures; v2: NPB published version (31 pages, \
5 figures)\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.nuclphysb.2015.05.006\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
