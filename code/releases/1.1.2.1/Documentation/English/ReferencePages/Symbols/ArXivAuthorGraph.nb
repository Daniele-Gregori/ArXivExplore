               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"The 1/N correction in the D3-brane description of \
circular Wilson loop\\n  at strong coupling\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"20 pages; v2: reference added, misprints corrected; v3: \
minor\\n  corrections, reference added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys. Rev. D 89, 126008 (2014)\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1103/PhysRevD.89.126008\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
