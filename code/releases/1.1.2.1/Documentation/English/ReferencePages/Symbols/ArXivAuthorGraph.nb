               "Thu, 21 Dec 2023 06:32:12 GMT"}}, "update_date" -> 
            "2024-01-15", 
            "authors_parsed" -> {{"Prakash", "Shiroman", ""}, {
              "Sinha", "Shubham Kumar", ""}}}], "Tooltip"]& ], 
