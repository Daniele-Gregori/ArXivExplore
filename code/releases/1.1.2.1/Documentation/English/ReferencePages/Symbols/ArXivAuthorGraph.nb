                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 28 Oct 2005 09:49:14 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
