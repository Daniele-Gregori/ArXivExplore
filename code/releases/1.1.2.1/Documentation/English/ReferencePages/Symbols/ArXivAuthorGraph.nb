                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 8 Jan 2019 21:57:09 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
