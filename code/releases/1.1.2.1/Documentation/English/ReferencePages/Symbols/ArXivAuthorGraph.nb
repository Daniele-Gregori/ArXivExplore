                "\"title\"", "\[Rule]", 
                 "\"Two-point Correlators in N=2 Gauge Theories\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"42 pages, 11 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
