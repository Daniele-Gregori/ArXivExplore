               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"A Jordanian deformation of AdS space in type IIB \
supergravity\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"29 pages, no figure, LaTeX, typos corrected, references \
added,\\n  further clarification added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP06(2014)146\""}]}, {
               
