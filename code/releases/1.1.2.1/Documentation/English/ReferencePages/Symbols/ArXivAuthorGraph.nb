                "\"title\"", "\[Rule]", 
                 "\"Comment on Strings in AdS3 x S3 x S3 x S1 at One \
Loop\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"16+12 pages. v2 improves comparison to S-matrices, and \
adds\\n  references. v3 has small textual changes to match published \
version\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 02 (2013) 102\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP02(2013)102\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"TIFR/TH/12-35\""}]}, {
