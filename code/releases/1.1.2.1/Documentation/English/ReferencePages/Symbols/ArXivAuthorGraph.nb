               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"TTbar deformation and the light-cone gauge\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"26 pages, more comments, added refs, misprints \
corrected\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"TCD-MATH-19-06\""}]}, {
