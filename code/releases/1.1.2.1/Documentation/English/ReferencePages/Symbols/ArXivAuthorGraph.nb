               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"A Relation Between Approaches to Integrability in \
Superconformal\\n  Yang-Mills Theory\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"19 pages, harvmac\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0310:017,2003\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2003/10/017\""}]}, {
