               RowBox[{"\"authors\"", "\[Rule]", "\"Linus Wulff\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Integrability of the superstring in AdS(3) x S(2) x S(2) \
x T(3)\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"11 pages, 1 figure; v3: Minor clarifications, matches \
published\\n  version\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1751-8121/aa70b5\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
