               RowBox[{"\"submitter\"", "\[Rule]", "\"Niklas Beisert\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Niklas Beisert\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"The su(2|2) Dynamic S-Matrix\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"29 pages. v2: references added, minor corrections. v3: \
form of terms\\n  in table 1 improved, minor corrections, v4: missed to \
correct (D.3) in v3,\\n  footnote and reference added\""}]}, {
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Adv.Theor.Math.Phys.12:945,2008\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.4310/ATMP.2008.v12.n5.a1\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
                 "\"PUTP-2181, NSF-KITP-05-92\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We derive and investigate the S-matrix for the su(2|3) \
dynamic spin chain and\\nfor planar N=4 super Yang-Mills. Due to the large \
amount of residual symmetry\\nin the excitation picture, the S-matrix turns \
out to be fully constrained up to\\nan overall phase. We carry on by \
diagonalising it and obtain Bethe equations\\nfor periodic states. This \
proves an earlier proposal for the asymptotic Bethe\\nequations for the \
su(2|3) dynamic spin chain and for N=4 SYM.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
