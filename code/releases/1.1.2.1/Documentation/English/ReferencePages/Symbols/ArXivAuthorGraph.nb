                    RowBox[{"\"version\"", "\[Rule]", "\"v3\""}], ",", 
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Sat, 15 Oct 2016 17:58:46 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
