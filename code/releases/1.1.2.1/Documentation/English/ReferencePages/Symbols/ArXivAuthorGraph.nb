               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Fabien Vignes-Tourneret\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Ahmed Lakhoua, Fabien Vignes-Tourneret, Jean-Christophe \
Wallet\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"One-loop Beta Functions for the Orientable \
Non-commutative Gross-Neveu\\n  Model\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"16 pages, 9 figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Eur.Phys.J.C52:735-742,2007\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1140/epjc/s10052-007-0424-2\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We compute at the one-loop order the beta-functions for \
a renormalisable\\nnon-commutative analog of the Gross Neveu model defined on \
the Moyal plane. The\\ncalculation is performed within the so called x-space \
formalism. We find that\\nthis non-commutative field theory exhibits \
asymptotic freedom for any number of\\ncolors. The beta-function for the \
non-commutative counterpart of the Thirring\\nmodel is found to be non \
vanishing.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
