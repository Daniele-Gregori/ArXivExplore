               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Pietro Benetti Genolini, Juan Manuel P\\\\'erez \
Ipi\\\\~na, James Sparks\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Localization of the action in AdS/CFT\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"43 pages\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 1910 (2019) 252\""}]}, {
              
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP10(2019)252\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
