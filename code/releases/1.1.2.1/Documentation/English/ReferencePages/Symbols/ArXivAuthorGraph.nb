                "\"submitter\"", "\[Rule]", "\"Arne Lykke Larsen\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", "\"A.L. Larsen and A. Khan\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Novel Explicit Multi Spin String Solitons in \
AdS(5)\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"latex, 15 pages\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys. B686 (2004) 75-84\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.nuclphysb.2004.03.004\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We find new explicit solutions describing closed \
strings spinning with equal\\nangular momentum in two independent planes in \
AdS(5). These are 2N-folded\\nstrings in the radial direction and also \
winding M times around an angular\\ndirection. Thus in spacetime they consist \
of 2N segments. Solutions fulfilling\\nthe closed string periodicity \
conditions exist provided N/M>2, i.e. the strings\\nmust be folded at least \
six times in the radial coordinate. The strings are\\nspinning, or actually \
orbiting, similarly to solutions found previously in\\nblack hole spacetimes, \
but unlike the one-spin solutions in AdS which spin\\naround their center. \
For long strings we recover the logaritmic scaling\\nrelation between energy \
and spin known from the one-spin case, but different\\nfrom other known \
two-spin cases.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 16 Dec 2003 14:56:01 GMT\""}]}], "}"}], "}"}]}]}, {
