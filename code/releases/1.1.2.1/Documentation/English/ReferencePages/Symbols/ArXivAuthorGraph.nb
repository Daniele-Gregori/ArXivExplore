                "\"title\"", "\[Rule]", 
                 "\"Surprises from the resummation of ladders in the ABJ(M) \
cusp anomalous\\n  dimension\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"26 pages, 4 figures, references added, published \
version\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP05(2016)180\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
