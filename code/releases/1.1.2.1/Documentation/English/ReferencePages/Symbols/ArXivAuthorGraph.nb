               RowBox[{"\"id\"", "\[Rule]", "\"1311.1521\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Yuri Chervonyi\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Yuri Chervonyi and Oleg Lunin\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"(Non)-Integrability of Geodesics in D-brane \
Backgrounds\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"45+38 pages, 5 figures. V2: references added, typos fixed\
\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP02(2014)061\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  Motivated by the search for new backgrounds with \
integrable string theories,\\nwe classify the D-brane geometries leading to \
integrable geodesics. Our\\nanalysis demonstrates that the Hamilton-Jacobi \
equation for massless geodesics\\ncan only separate in elliptic or spherical \
coordinates, and all known\\nintegrable backgrounds are covered by this \
separation. In particular, we\\nidentify the standard parameterization of \
AdS_p X S^q with elliptic coordinates\\non a flat base. We also find new \
geometries admitting separation of the\\nHamilton-Jacobi equation in the \
elliptic coordinates. Since separability of\\nthis equation is a necessary \
condition for integrability of strings, our\\nanalysis gives severe \
restrictions on the potential candidates for integrable\\nstring theories.\\n\
\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 6 Nov 2013 21:03:07 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 22 Nov 2013 22:29:58 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2015-06-17\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Chervonyi\"", ",", "\"Yuri\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Lunin\"", ",", "\"Oleg\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
             Left, ColumnAlignments -> Left], Column], 
           Function[BoxForm`e$, 
            TableForm[BoxForm`e$]]]],
         Annotation[#, 
          
          TableForm[{
           "id" -> "1311.1521", "submitter" -> "Yuri Chervonyi", "authors" -> 
            "Yuri Chervonyi and Oleg Lunin", "title" -> 
            "(Non)-Integrability of Geodesics in D-brane Backgrounds", 
            "comments" -> 
            "45+38 pages, 5 figures. V2: references added, typos fixed", 
            "journal-ref" -> Null, "doi" -> "10.1007/JHEP02(2014)061", 
            "report-no" -> Null, "categories" -> "hep-th", "license" -> 
            "http://arxiv.org/licenses/nonexclusive-distrib/1.0/", "abstract" -> 
            "  Motivated by the search for new backgrounds with integrable \
string theories,\nwe classify the D-brane geometries leading to integrable \
geodesics. Our\nanalysis demonstrates that the Hamilton-Jacobi equation for \
massless geodesics\ncan only separate in elliptic or spherical coordinates, \
and all known\nintegrable backgrounds are covered by this separation. In \
particular, we\nidentify the standard parameterization of AdS_p X S^q with \
elliptic coordinates\non a flat base. We also find new geometries admitting \
separation of the\nHamilton-Jacobi equation in the elliptic coordinates. \
Since separability of\nthis equation is a necessary condition for \
integrability of strings, our\nanalysis gives severe restrictions on the \
potential candidates for integrable\nstring theories.\n", 
            "versions" -> {{
              "version" -> "v1", "created" -> 
