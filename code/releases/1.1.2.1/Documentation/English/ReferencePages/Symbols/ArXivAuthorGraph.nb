            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0701052\""}]}, {
               
               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Satoshi Yamaguchi\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Satoshi Yamaguchi\""}]}, {
              
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Semi-classical open string corrections and symmetric \
Wilson loops\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"14 pages, 4 figures. v2: explanation improved. v3: \
argument in\\n  section 2 is improved, result not changed\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0706:073,2007\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2007/06/073\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  In the AdS/CFT correspondence, an AdS_2 x S^2 D3-brane \
with electric flux in\\nAdS_5 x S^5 spacetime corresponds to a circular \
Wilson loop in the symmetric\\nrepresentation or a multiply wound one in N=4 \
super Yang-Mills theory. In order\\nto distinguish the symmetric loop and the \
multiply wound loop, one should see\\nan exponentially small correction in \
large 't Hooft coupling. We study\\nsemi-classically the disk open string \
attached to the D3-brane. We obtain the\\nexponent of the term and it agrees \
with the result of the matrix model\\ncalculation of the symmetric Wilson \
loop.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Sun, 7 Jan 2007 22:00:43 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
