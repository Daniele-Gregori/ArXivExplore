                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{"\"Stefanski\"", ",", "\"B.\"", ",", "\"Jr\""}], 
                    "}"}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
