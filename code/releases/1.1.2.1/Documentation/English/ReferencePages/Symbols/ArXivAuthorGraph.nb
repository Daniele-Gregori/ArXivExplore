               RowBox[{"\"id\"", "\[Rule]", "\"0902.4586\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Nadav Drukker\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
