               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Jesus Puente Penalba\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Jes\\\\'us Puente Pe\\\\~nalba\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"A Matrix Model for Type 0 Strings\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"13 pages, one figure. Also available at\\n  \
http://condmat1.ciencias.uniovi.es/\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 9908 (1999) 005\""}]}, {
              
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/1999/08/005\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"FFUOV-99/12\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  A matrix model for type 0 strings is proposed. It \
consists in making a\\nnon-supersymmetric orbifold projection in the \
Yang-Mills theory and identifying\\nthe infrared configurations of the system \
at infinite coupling with strings.\\nThe correct partition function is \
calculated. Also, the usual spectrum of\\nbranes is found. Both type A and B \
models are constructed. The model in a torus\\ncontains all the degrees of \
freedom and interpolates between the four string\\ntheories (IIA, IIB, 0A, \
0B) and the M theory as different limits are taken.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 12 Jul 1999 13:48:09 GMT\""}]}], "}"}], "}"}]}]}, {
