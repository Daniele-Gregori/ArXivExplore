                    "\"Thu, 24 Nov 2022 10:22:29 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 16 Mar 2023 10:41:28 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
