               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"An action variable of the sine-Gordon model\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"v3,4: added explanations, discussion of O(N) sigma-model \
in section 5\\n  v5: correction in the Introduction, small changes\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"J.Geom.Phys. 56 (2006) 2429-2445\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
