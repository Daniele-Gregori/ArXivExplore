                    "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Levkovich-Maslyuk\"", ",", "\"Fedor\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Macorini\"", ",", "\"Guido\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
