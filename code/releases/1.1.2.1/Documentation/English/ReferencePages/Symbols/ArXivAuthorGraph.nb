               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Nikolay Gromov, Victor Mikhaylov\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Comment on the Scaling Function in AdS4 x CP3\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"references added\""}]}, {
              
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0904:083,2009\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2009/04/083\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
