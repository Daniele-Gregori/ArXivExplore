               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"$\\\\alpha'$-expansion of Anti-Symmetric Wilson Loops in \
$\\\\mathcal{N}=4$\\n  SYM from Fermi Gas\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"9 pages, 2 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
