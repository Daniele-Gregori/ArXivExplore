               RowBox[{"\"authors\"", "\[Rule]", "\"Pedro Liendo\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Orientifold daughter of N=4 SYM and double-trace \
running\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"12 pages\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1103/PhysRevD.86.105032\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"YITP-SB-11-22\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We study the orientifold daughter of N=4 super \
Yang-Mills as a candidate\\nnon-supersymmetric large N conformal field \
theory. In a theory with vanishing\\nsingle-trace beta functions that \
contains scalars in the adjoint\\nrepresentation, conformal invariance might \
still be broken by renormalization\\nof double-trace terms to leading order \
at large N. In this note we perform a\\ndiagrammatic analysis and argue that \
the orientifold daughter does not suffer\\nfrom double-trace running. This \
implies an exact large N equivalence between\\nthis theory and a subsector of \
N=4 SYM.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 15 Jul 2011 18:29:18 GMT\""}]}], "}"}], "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2013-05-30\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{"\"Liendo\"", ",", "\"Pedro\"", ",", "\"\""}], 
                    "}"}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
