               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"(m,n)-Strings In IIB Matrix Model\""}]}, {
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"LaTeX file, 10 pages; the disccusion on weak electric \
field are\\n  expanded; to appear in PLB\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys.Lett. B473 (2000) 73-79\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1016/S0370-2693(99)01488-4\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  By adding gauge fields to the D-string classical \
solution, which have\\nnon-zero contribution to commutators in continuum \
limit (extreme large $N$), we\\nintroduced $(m,n)$-strings in IIB matrix \
model. It is found that the size of\\nmatrices depends on the value of the \
electric field. The tension of these\\nstrings appears in $SL(2,Z)$ invariant \
form. The interaction for parallel and\\nangled strings are found in \
agreement with the string theory for small electric\\nfields.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
