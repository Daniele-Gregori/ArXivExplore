                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 22 Jan 2003 11:31:54 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v3\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
