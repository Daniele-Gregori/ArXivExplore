added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Int. J. Mod. Phys. A, 38 (2023) 2330001\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1142/S0217751X23300016\""}]}, {
