               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  It is shown that the integration measure over the \
matrix $Y$ in the matrix\\nrepresentation of the Schild action can be fixed \
by comparing the Schild matrix\\nmodel with the random lattice string model \
for D=0. It is further checked that\\nthe given measure is consistent with \
the case D=1 as well.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
