               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  According to the Axionic String Anstaz (ASA) confining \
flux tubes in pure\\ngluodynamics are in the same equivalence class as a new \
family of integrable\\nnon-critical strings, called axionic strings. In \
addition to translational\\nmodes, axionic strings carry a set of worldsheet \
axions transforming as an\\nantisymmetric tensor under the group of \
transverse rotations. We initiate a\\nstudy of integrable axionic strings at \
general number of space-time dimensions\\n$D$. We show that in the infinite \
tension limit worldsheet axions should be\\ndescribed by a peculiar \
\\\"pseudofree\\\" theory---their $S$-matrix is trivial, but\\nthe \
corresponding action cannot be brought into a free form by a local \
field\\nredefinition. This requirement fixes the axionic action to take a \
form of the\\n$O(D-2)$ Wess--Zumino--Witten (WZW) model.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 17 Dec 2018 20:42:23 GMT\""}]}], "}"}], "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2019-05-01\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Donahue\"", ",", "\"John C.\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Dubovsky\"", ",", "\"Sergei\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Hern\[AAcute]ndez-Chifflet\"", ",", 
                    "\"Guzm\[AAcute]n\"", ",", "\"\""}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Monin\"", ",", "\"Sergey\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
