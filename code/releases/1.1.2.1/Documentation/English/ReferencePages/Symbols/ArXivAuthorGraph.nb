                 "\"Anomalies and Holomorphy in Supersymmetric \
Chern-Simons-Matter Theories\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"220 pages, tikz figures; v2: references added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
