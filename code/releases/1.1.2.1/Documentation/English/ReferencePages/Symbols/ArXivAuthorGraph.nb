               RowBox[{"\"submitter\"", "\[Rule]", "\"Arsen Melikyan\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", "\"A. Melikyan and G. Weber\""}]}, {
              
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"The r-matrix of the Alday-Arutyunov-Frolov model\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"39 pages; misprints corrected, references added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 1211 (2012) 165\""}]}, {
              
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP11(2012)165\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
