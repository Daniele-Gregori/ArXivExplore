                    RowBox[{"\"version\"", "\[Rule]", "\"v3\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 1 Sep 2006 14:50:54 GMT\""}]}], "}"}]}], 
