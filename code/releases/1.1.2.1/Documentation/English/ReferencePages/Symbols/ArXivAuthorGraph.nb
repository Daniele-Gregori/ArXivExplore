               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"Contribution to the memorial volume \\\"From the past to \
the future -\\n  the legacy of Lev Lipatov\\\", 28 pages, 7 figures; v2: \
references added, typos\\n  fixed\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
