                RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
                
                RowBox[{
                 "\"abstract\"", "\[Rule]", 
                  "\"  We generalize the dressing symmetry construction in \
mKdV hierarchy. This\\nleads to non-local vector fields (expressed in terms \
of vertex operators)\\nclosing a Virasoro algebra. We argue that this algebra \
realization should play\\nan important role in the study of 2D integrable \
field theories and in\\nparticular should be related to the Deformed Virasoro \
Algebra (DVA) when the\\nconstruction is perturbed out of the critical \
theory.\\n\""}]}, {
                RowBox[{"\"versions\"", "\[Rule]", 
                  RowBox[{"{", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 7 Oct 1998 13:59:12 GMT\""}]}], "}"}], "}"}]}]}, {
               
                RowBox[{"\"update_date\"", "\[Rule]", "\"2009-10-31\""}]}, {
                RowBox[{"\"authors_parsed\"", "\[Rule]", 
                  RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Fioravanti\"", ",", "\"Davide\"", ",", "\"\""}], "}"}],
                     ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Stanishkov\"", ",", "\"Marian\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
              Left, ColumnAlignments -> Left], Column], 
