\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Dyonic Giant Magnons in CP^3: Strings and Curves at \
Finite J\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"22 pages, 3 figures, 2 tables. v2 adds note on breather \
solution, and\\n  minor clarifications\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys.Rev.D80:026005,2009\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1103/PhysRevD.80.026005\""}]}, {
               
