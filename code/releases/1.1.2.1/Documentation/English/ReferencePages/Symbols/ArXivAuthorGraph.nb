                    RowBox[{"{", 
                    RowBox[{"\"Doyon\"", ",", "\"Benjamin\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Myers\"", ",", "\"Jason\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
