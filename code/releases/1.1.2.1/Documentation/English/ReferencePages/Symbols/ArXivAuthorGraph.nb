                    "\"Mart\[IAcute]nez-Montoya\"", ",", "\"Jairo\"", ",", 
                    "\"\""}], "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Fukelman\"", ",", "\"Alan Rios\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
