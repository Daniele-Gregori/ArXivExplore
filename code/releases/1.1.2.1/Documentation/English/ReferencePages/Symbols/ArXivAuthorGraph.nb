               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/9909109\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Igor R. Klebanov\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Igor R. Klebanov, Nikita A. Nekrasov and Samson L. \
Shatashvili\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"An Orbifold of Type 0B Strings and Non-supersymmetric \
Gauge Theories\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"15 pages, harvmac; v2: very minor corrections; v3: a \
comment about\\n  pure glue theory added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys. B591 (2000) 26-38\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1016/S0550-3213(00)00547-2\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
                 "\"PUPT-1891, ITEP-TH-48/99, NSF-ITP-99-27, \
YCTP-P24-99\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We study a ${{\\\\IZ}}_2$ orbifold of Type 0B string \
theory by reflection of six\\nof the coordinates (this theory may also be \
thought of as a ${{\\\\IZ}}_4$\\norbifold of Type IIB string theory by a \
rotation by $\\\\pi$ in three independent\\nplanes). We show that the only \
massless mode localized on the fixed fourplane\\n$\\\\IR^{3,1}$ is a U(1) \
gauge field. After introducing D3-branes parallel to the\\nfixed fourplane we \
find non-supersymmetric non-abelian gauge theories on their\\nworldvolume. \
One of our results is that the theory on equal numbers of electric\\nand \
magnetic D3-branes placed at the fourplane is the ${{\\\\IZ}}_4$ orbifold \
of\\n${\\\\cal N}=4$ supersymmetric Yang-Mills theory by the center of its \
R-symmetry\\ngroup.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
