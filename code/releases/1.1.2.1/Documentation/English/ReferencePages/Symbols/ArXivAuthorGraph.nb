                    "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Kormos\"", ",", "\"M\[AAcute]rton\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    
