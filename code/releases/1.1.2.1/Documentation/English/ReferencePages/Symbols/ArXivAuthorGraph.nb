                "\"comments\"", "\[Rule]", 
                 "\"34 pages, many figures. V2: minor corrections. V3: Two \
new comment\\n  sections added, accepted for publication in JHEP\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP06(2021)101\""}]}, {
