         Annotation[#, 
          
          TableForm[{
           "id" -> "1606.00394", "submitter" -> "Yuri Chervonyi", "authors" -> 
            "Yuri Chervonyi, Oleg Lunin", "title" -> 
            "Supergravity background of the lambda-deformed AdS_3 x S^3 \
supercoset", "comments" -> "31 pages, v2: references added", "journal-ref" -> 
            Null, "doi" -> "10.1016/j.nuclphysb.2016.07.023", "report-no" -> 
            Null, "categories" -> "hep-th gr-qc", "license" -> 
            "http://arxiv.org/licenses/nonexclusive-distrib/1.0/", "abstract" -> 
            "  We construct the solution of type IIB supergravity describing \
the integrable\nlambda-deformation of the AdS_3 x S^3 supercoset. While the \
geometry\ncorresponding to the deformation of the bosonic coset has been \
found in the\npast, our background is more natural for studying superstrings, \
and several\ninteresting features distinguish our solution from its bosonic \
counterpart. We\nalso report progress towards constructing the \
lambda-deformation of the AdS_5 x\nS^5 supercoset.\n", 
            "versions" -> {{
              "version" -> "v1", "created" -> 
               "Wed, 1 Jun 2016 18:50:21 GMT"}, {
              "version" -> "v2", "created" -> 
               "Mon, 27 Jun 2016 22:20:03 GMT"}}, "update_date" -> 
            "2016-08-24", 
            "authors_parsed" -> {{"Chervonyi", "Yuri", ""}, {
              "Lunin", "Oleg", ""}}}], "Tooltip"]& ], 
