               RowBox[{"\"authors\"", "\[Rule]", "\"Marco S. Bianchi\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On three-point functions in ABJM and the latitude Wilson \
loop\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"42 pages\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP10(2020)075\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
