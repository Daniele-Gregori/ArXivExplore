               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"A Note on Orientifolds and Dualities of Type 0B String \
Theory\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"12 pages, TeX, harvmac, minor changes, ref. added\""}]}, {
              
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys.Lett. B464 (1999) 46-52\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1016/S0370-2693(99)01002-3\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
                 "\"HUB-EP-99/29, CERN-TH/99-190\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We generalize the construction of four dimensional \
non-tachyonic orientifolds\\nof type 0B string theory to non-supersymmetric \
backgrounds. We construct a four\\ndimensional model containing self-dual D3 \
and D9-branes and leading to a chiral\\nanomaly-free massless spectrum. \
Moreover, we discuss a further tachyon-free six\\ndimensional model with only \
D5 branes. Eventually, we speculate about strong\\ncoupling dual models of \
the ten-dimensional orientifolds of type 0B.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
