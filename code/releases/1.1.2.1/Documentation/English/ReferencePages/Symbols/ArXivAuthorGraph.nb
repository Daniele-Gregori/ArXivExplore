limit\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"37 pages, 5 figures, v2: references added, v3: published \
version, a\\n  computational error in eq.(5.32) corrected\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP10(2014)038\""}]}, {
