                "\"title\"", "\[Rule]", 
                 "\"On the Fermionic Frequencies of Circular Strings\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"13 pages, 1 figure\""}]}, {
               
               RowBox[{
