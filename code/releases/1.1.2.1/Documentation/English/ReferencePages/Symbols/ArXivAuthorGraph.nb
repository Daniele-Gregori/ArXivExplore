               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"28 + 12 pages, added some corrections and \
clarifications\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"SciPost Phys. 11, 078 (2021)\""}]}, {
               
