            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"1904.07502\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Erez Y. Urbach\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Ofer Aharony, Erez Y. Urbach and Maya Weiss\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Generalized Hawking-Page transitions\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 1908:018,2019\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP08(2019)018\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th gr-qc\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We construct holographic backgrounds that are dual by \
the AdS/CFT\\ncorrespondence to Euclidean conformal field theories on \
products of spheres\\n$S^{d_1}\\\\times S^{d_2}$, for conformal field \
theories whose dual may be\\napproximated by classical Einstein gravity \
(typically these are large $N$\\nstrongly coupled theories). For $d_2=1$ \
these backgrounds correspond to thermal\\nfield theories on $S^{d_1}$, and \
Hawking and Page found that there are several\\npossible bulk solutions, with \
two different topologies, that compete with each\\nother, leading to a phase \
transition as the relative size of the spheres is\\nmodified. By numerically \
solving the Einstein equations we find similar results\\nalso for $d_2>1$, \
with bulk solutions in which either one or the other sphere\\nshrinks to zero \
smoothly at a minimal value of the radial coordinate, and with\\na first \
order phase transition (for $d_1+d_2 < 9$) between solutions of \
two\\ndifferent topologies as the relative radius changes. For a critical \
ratio of\\nthe radii there is a (sub-dominant) singular solution where both \
spheres\\nshrink, and we analytically analyze the behavior near this radius. \
For $d_1+d_2\\n< 9$ the number of solutions grows to infinity as the critical \
ratio is\\napproached.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 16 Apr 2019 07:29:17 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 15 May 2019 14:42:09 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v3\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 8 Aug 2019 11:19:20 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2019-08-09\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Aharony\"", ",", "\"Ofer\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Urbach\"", ",", "\"Erez Y.\"", ",", "\"\""}], 
