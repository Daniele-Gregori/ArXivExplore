                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Supersymmetric matrix models and branched \
polymers\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", 
                  "\"xx pages, Latex, no macros needed\""}]}, {
                
                RowBox[{
                 "\"journal-ref\"", "\[Rule]", 
