                "\"title\"", "\[Rule]", 
                 "\"One-Loop Corrections to Type IIA String Theory in AdS4 x \
CP3\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"58 pages, 3 figures; v3: minor changes and references \
added,\\n  published in JHEP\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 1004:059,2010\""}]}, {
               
