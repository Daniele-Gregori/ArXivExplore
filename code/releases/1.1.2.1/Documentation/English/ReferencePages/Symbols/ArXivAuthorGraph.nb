            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0108182\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Jan Plefka\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Jan Plefka and Matthias Staudacher\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Two Loops to Two Loops in N=4 Supersymmetric Yang-Mills \
Theory\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"21 pages, 1 figure\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0109:031,2001\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2001/09/031\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"AEI-2001-106\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We present a full two-loop O(g^6) perturbative field \
theoretic calculation of\\nthe expectation value of two circular \
Maldacena-Wilson loops in D=4 N=4\\nsupersymmetric U(N) gauge theory. It is \
demonstrated that, after taking into\\naccount very subtle cancellations of \
bulk and boundary divergences, the result\\nis completely finite without any \
renormalization. As opposed to previous lower\\norder calculations existing \
in the literature, internal vertex diagrams no\\nlonger cancel identically \
and lead to subleading corrections to the dominant\\nladder diagrams. Taking \
limits, we proceed to extract the two-loop static\\npotential corresponding \
to two infinite anti-parallel lines. Our result gives\\nsome evidence that \
the existing strong-coupling calculations using the AdS/CFT\\nconjecture \
might sum up the full set of large N planar Feynman diagrams.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 24 Aug 2001 11:25:31 GMT\""}]}], "}"}], "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2010-02-03\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Plefka\"", ",", "\"Jan\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Staudacher\"", ",", "\"Matthias\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
             Left, ColumnAlignments -> Left], Column], 
           Function[BoxForm`e$, 
            TableForm[BoxForm`e$]]]],
         Annotation[#, 
          
          TableForm[{
           "id" -> "hep-th/0108182", "submitter" -> "Jan Plefka", "authors" -> 
            "Jan Plefka and Matthias Staudacher", "title" -> 
            "Two Loops to Two Loops in N=4 Supersymmetric Yang-Mills Theory", 
            "comments" -> "21 pages, 1 figure", "journal-ref" -> 
            "JHEP 0109:031,2001", "doi" -> "10.1088/1126-6708/2001/09/031", 
            "report-no" -> "AEI-2001-106", "categories" -> "hep-th", 
            "license" -> Null, "abstract" -> 
            "  We present a full two-loop O(g^6) perturbative field theoretic \
calculation of\nthe expectation value of two circular Maldacena-Wilson loops \
in D=4 N=4\nsupersymmetric U(N) gauge theory. It is demonstrated that, after \
taking into\naccount very subtle cancellations of bulk and boundary \
divergences, the result\nis completely finite without any renormalization. As \
opposed to previous lower\norder calculations existing in the literature, \
internal vertex diagrams no\nlonger cancel identically and lead to subleading \
corrections to the dominant\nladder diagrams. Taking limits, we proceed to \
extract the two-loop static\npotential corresponding to two infinite \
anti-parallel lines. Our result gives\nsome evidence that the existing \
strong-coupling calculations using the AdS/CFT\nconjecture might sum up the \
full set of large N planar Feynman diagrams.\n", 
            "versions" -> {{
              "version" -> "v1", "created" -> 
               "Fri, 24 Aug 2001 11:25:31 GMT"}}, "update_date" -> 
            "2010-02-03", 
            "authors_parsed" -> {{"Plefka", "Jan", ""}, {
              "Staudacher", "Matthias", ""}}}], "Tooltip"]& ], 
