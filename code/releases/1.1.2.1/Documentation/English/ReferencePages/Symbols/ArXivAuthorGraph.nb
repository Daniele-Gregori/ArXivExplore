Giraldo-Rivera\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Circular Wilson loops in defect Conformal Field \
Theory\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"24 pages\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP03(2017)023\""}]}, {
