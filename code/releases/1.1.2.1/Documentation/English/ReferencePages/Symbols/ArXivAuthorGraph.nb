               RowBox[{"\"id\"", "\[Rule]", "\"1907.05430\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Fiona Seibold\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Fiona K. Seibold\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Two-parameter integrable deformations of the $AdS_3 \
\\\\times S^3 \\\\times\\n  T^4$ superstring\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"32 pages, 2 figures, published version\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP10(2019)049\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
