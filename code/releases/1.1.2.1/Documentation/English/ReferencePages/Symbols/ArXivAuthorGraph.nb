                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 7 Dec 2010 16:44:54 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
