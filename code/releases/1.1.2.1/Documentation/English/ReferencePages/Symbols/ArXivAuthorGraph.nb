               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On higher derivative gravity, c-theorems and \
cosmology\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 
                 "\"23 pages, v3: clarifications added, references \
added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Class.Quant.Grav.28:085002,2011\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/0264-9381/28/8/085002\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", 
