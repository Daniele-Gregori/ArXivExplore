                "\"title\"", "\[Rule]", 
                 "\"Closed star product on noncommutative $\\\\mathbb{R}^3$ \
and scalar field\\n  dynamics\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"19 pages\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 05 (2016) 146\""}]}, {
               
