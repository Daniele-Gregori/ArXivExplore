               "Wed, 21 Jan 2015 15:54:36 GMT"}}, "update_date" -> 
            "2015-01-22", 
            "authors_parsed" -> {{"Engelund", "Oluf Tang", ""}, {
              "Roiban", "Radu", ""}}}], "Tooltip"]& ], 
