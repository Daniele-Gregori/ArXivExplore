               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Lisa Freyhult and Charlotte Kristjansen\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Rational three-spin string duals and non-anomalous finite \
size effects\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"15 pages, v2: comparison to string theory changed, \
references added,\\n  v3: textual modifications and title changed\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0505:043,2005\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2005/05/043\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"NORDITA-2005-12\""}]}, {
              
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We determine by a one line computation the one-loop \
conformal dimension and\\nthe associated non-anomalous finite size correction \
for all operators dual to\\nspinning strings of rational type having three \
angular momenta (J_1,J_2,J_3) on\\nS^5. Finite size corrections are \
conjectured to encode information about string\\nsigma model loop corrections \
to the spectrum of type IIB superstrings on\\nAdS_5xS^5. We compare our \
result to the zero-mode contribution to the leading\\nquantum string \
correction derived for the stable three-spin string with two out\\nof the \
three spin labels identical and observe agreement. As a side result \
we\\nclarify the relation between the Bethe root description of three-spin \
strings\\nof the type (J,J',J') with respectively J>J' and J<J'.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
