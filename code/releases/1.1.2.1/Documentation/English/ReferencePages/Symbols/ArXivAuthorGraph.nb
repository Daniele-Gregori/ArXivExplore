                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys. Rev. D 100, 086019 (2019)\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1103/PhysRevD.100.086019\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
