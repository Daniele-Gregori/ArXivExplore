               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0703061\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Makoto Sakaguchi\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Makoto Sakaguchi and Kentaroh Yoshida\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Non-relativistic String and D-branes on AdS_5 x S^5 from \
Semiclassical\\n  Approximation\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"28+1 pages\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0705:051,2007\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2007/05/051\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", "\"KEK-TH-1125, OIQP-06-21\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We show that non-relativistic actions of string and \
D-branes on AdS_5 x S^5\\ncan be reproduced as a semiclassical approximation \
of the string and D-brane\\nactions around static 1/2 BPS configurations. \
This is contrastive to the\\nPenrose limit. For example, the pp-wave string \
can be recaptured as a\\nsemiclassical approximation around a 1/2 BPS \
particle rotating at the velocity\\nof light. We argue that small deformation \
of a straight Wilson line would give\\na composite operator in the \
gauge-theory side that corresponds to a\\nsemiclassical state of the \
non-relativistic string, according to the\\nsemiclassical \
interpretation.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
