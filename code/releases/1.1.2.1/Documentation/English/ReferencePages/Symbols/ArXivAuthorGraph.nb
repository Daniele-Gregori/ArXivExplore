               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Covariant field equations in supergravity\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"31 pages; v2: version to be published; extended \
introduction and\\n  typos corrected\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "\"10.1002/prop.201700071\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
