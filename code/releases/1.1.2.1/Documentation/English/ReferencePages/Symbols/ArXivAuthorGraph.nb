                    "\"Cavagli\[AGrave]\"", ",", "\"Andrea\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Gromov\"", ",", "\"Nikolay\"", ",", "\"\""}], 
