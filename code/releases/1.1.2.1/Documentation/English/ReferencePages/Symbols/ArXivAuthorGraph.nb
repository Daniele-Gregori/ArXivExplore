                RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
                
                RowBox[{
                 "\"abstract\"", "\[Rule]", 
                  "\"  Quantum monodromy matrices coming from a theory of two \
coupled (m)KdV\\nequations are modified in order to satisfy the usual \
Yang-Baxter relation. As a\\nconsequence, a general connection between \
braided and {\\\\it unbraided} (usual)\\nYang-Baxter algebras is derived and \
also analysed.\\n\""}]}, {
                RowBox[{"\"versions\"", "\[Rule]", 
                  RowBox[{"{", 
