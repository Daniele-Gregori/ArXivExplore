         Annotation[#, 
          
          TableForm[{
           "id" -> "1805.05338", "submitter" -> "Fri{\\dh}rik Freyr Gautason",
             "authors" -> 
            "Nikolay Bobev, Pieter Bomans and Fridrik Freyr Gautason", 
            "title" -> "Spherical Branes", "comments" -> 
            "57 pages, 4 figures; v2: minor corrections, appendix added", 
            "journal-ref" -> Null, "doi" -> "10.1007/JHEP08(2018)029", 
            "report-no" -> Null, "categories" -> "hep-th", "license" -> 
            "http://arxiv.org/licenses/nonexclusive-distrib/1.0/", "abstract" -> 
            "  We construct new solutions of ten-dimensional supergravity \
with sixteen\nsupercharges which describe the backreaction of D$p$-branes \
with spherical\nworldvolume. These solutions are holographically dual to the\n\
$(p+1)$-dimensional maximally supersymmetric Yang-Mills theory on $S^{p+1}$.\n\
The finite size of the sphere provides an IR cut-off for the gauge theory \
which\nis manifested in the supergravity solution as a smooth cap-off of the \
geometry.\nIn the UV the size of the sphere plays no role and the backgrounds \
asymptote to\nthe well-known supergravity solutions that describe the \
near-horizon limit of\nflat D$p$-branes. We compute the on-shell action of \
our spherical brane\nsolutions and show that it is in agreement with recent \
supersymmetric\nlocalization results for the free energy of maximal SYM \
theory on $S^{p+1}$.\n", 
            "versions" -> {{
              "version" -> "v1", "created" -> 
               "Mon, 14 May 2018 18:00:01 GMT"}, {
              "version" -> "v2", "created" -> 
               "Wed, 4 Jul 2018 13:07:47 GMT"}}, "update_date" -> 
            "2018-08-29", 
            "authors_parsed" -> {{"Bobev", "Nikolay", ""}, {
              "Bomans", "Pieter", ""}, {"Gautason", "Fridrik Freyr", ""}}}], 
          "Tooltip"]& ], 
