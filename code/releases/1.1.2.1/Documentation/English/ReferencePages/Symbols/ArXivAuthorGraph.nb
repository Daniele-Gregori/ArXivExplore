                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 4 May 2004 04:32:48 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
