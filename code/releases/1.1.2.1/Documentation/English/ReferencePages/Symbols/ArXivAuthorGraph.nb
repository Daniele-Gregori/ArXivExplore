                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 27 Jan 2011 14:53:28 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
