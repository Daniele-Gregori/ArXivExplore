                "\"journal-ref\"", "\[Rule]", "\"JHEP 1901 (2019) 076\""}]}, {
              
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP01(2019)076\""}]}, {
               
