               RowBox[{"\"submitter\"", "\[Rule]", "\"Jose F. Morales\""}]}, {
              
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"S. Bellucci, P.-Y. Casteill, J.F. Morales and C. \
Sochichiu\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"SL(2) spin chain and spinning strings on AdS_5xS^5\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"18 pages, 1 fig, References added. Earlier results in \
[38] are\\n  pointed out\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys. B707 (2005) 303-320\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.nuclphysb.2004.11.020\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We derive the coherent state representation of the \
integrable spin chain\\nHamiltonian with symmetry group SL(2,R). By passing \
to the continuum limit, we\\nfind a spin chain sigma model describing a \
string moving on the hyperboloid\\nSL(2,R)/U(1). The same sigma model is \
found by considering strings rotating\\nwith large angular momentum in \
AdS_5xS^5. The spinning strings are identified\\nwith semiclassical coherent \
states built out of SL(2,R) spin chain states.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
