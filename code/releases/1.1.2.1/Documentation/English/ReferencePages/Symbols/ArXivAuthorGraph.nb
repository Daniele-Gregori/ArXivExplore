                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 1 Oct 2019 19:06:37 GMT\""}]}], "}"}], ",", 
