               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Jun-Ichi Sakamoto\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Jun-ichi Sakamoto\""}]}, {
              
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Integrable deformations of string sigma models and \
generalized\\n  supergravity\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"Ph.D. Thesis, 227 pages\""}]}, {
              
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
