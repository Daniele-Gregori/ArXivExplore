               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"The non-planar contribution to the four-loop anomalous \
dimension of\\n  twist-2 operators: first moments in N=4 SYM and non-singlet \
QCD\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"9 pages, typos corrected\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys.B846:137-144,2011\""}]}, {
               
