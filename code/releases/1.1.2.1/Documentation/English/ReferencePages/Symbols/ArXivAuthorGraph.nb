               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"26 pages, 3 eps figures. v2: published version, minor \
changes,\\n  references added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0711:031,2007\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2007/11/031\""}]}, {
