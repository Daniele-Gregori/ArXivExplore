               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Multi-spike strings in $AdS_3$ with mixed three-form \
fluxes\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"18 pages\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
