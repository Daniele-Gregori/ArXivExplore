Zafrir\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"E-String Theory on Riemann Surfaces\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"85 pages, 25 figures, harvmac\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
