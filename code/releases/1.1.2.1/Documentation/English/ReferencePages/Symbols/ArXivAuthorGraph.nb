                RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0412029\""}]}, {
                RowBox[{"\"submitter\"", "\[Rule]", "\"Niklas Beisert\""}]}, {
               
                
                RowBox[{
                 "\"authors\"", "\[Rule]", 
                  "\"N. Beisert, G. Ferretti, R. Heise, K. Zarembo\""}]}, {
                
                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"One-Loop QCD Spin Chain and its Spectrum\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", 
                  "\"54 pages, v2: minor changes, references added\""}]}, {
                
                RowBox[{
