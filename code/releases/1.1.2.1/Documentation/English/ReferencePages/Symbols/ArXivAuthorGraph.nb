Calabrese\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Integrable quenches in the Hubbard model\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"28 pages, 5 figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"J. Stat. Mech. (2022) 103103\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1742-5468/ac98be\""}]}, {
