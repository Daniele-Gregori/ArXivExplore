               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Non-Linear Supersymmetry and $T\\\\bar T$-like \
Flows\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"43 pages\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
