               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Intersection theory of the complex quartic Kontsevich \
model\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"22 pages, 4 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"math-ph math.MP\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://creativecommons.org/licenses/by/4.0/\""}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We expand correlation functions of the \
Langmann-Szabo-Zarembo (LSZ) model in\\nterms of intersection numbers on the \
moduli space of complex curves. This\\nprovides an explicit, physically \
motivated example for the expansion of\\ncorrelation functions generated by \
Chekhov-Eynard-Orantin topological\\nrecursion. To this end, we unify \
notation as well as different conventions\\npresent in the literature and use \
a set of moduli of the spectral curve adapted\\nto the physically motivated \
model. The presentation focuses on an illustrative,\\nstep-by-step \
comprehension of the work.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 2 Dec 2022 18:38:53 GMT\""}]}], "}"}], "}"}]}]}, {
              
               RowBox[{"\"update_date\"", "\[Rule]", "\"2022-12-05\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
