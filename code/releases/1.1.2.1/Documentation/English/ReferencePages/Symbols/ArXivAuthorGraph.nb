               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"David\"", ",", "\"Justin R.\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Kalousios\"", ",", "\"Chrysostomos\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    
