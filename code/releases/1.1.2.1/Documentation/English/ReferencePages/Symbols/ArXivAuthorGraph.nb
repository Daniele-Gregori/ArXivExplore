               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"$1/N$ expansion of circular Wilson loop in $\\\\mathcal \
N=2$ superconformal\\n  $SU(N)\\\\times SU(N)$ quiver\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"29 pages, several pdf figures. v3: minor corrections and \
note added\\n  on recent exact results in arXiv:2207.11475\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP04(2021)265\""}]}, {
               
