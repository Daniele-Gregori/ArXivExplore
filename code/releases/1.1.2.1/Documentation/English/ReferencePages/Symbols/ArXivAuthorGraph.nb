               RowBox[{"\"id\"", "\[Rule]", "\"1111.2349\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Sever Amit\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Nikolay Gromov, Amit Sever and Pedro Vieira\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Tailoring Three-Point Functions and Integrability III. \
Classical\\n  Tunneling\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"37 pages, 10 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP07(2012)044\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", 
