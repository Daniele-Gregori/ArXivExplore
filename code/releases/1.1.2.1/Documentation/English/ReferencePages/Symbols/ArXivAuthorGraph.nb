                "\"title\"", "\[Rule]", "\"Open Spinning Strings\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0403 (2004) 057\""}]}, {
              
               
