            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0507217\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Thomas Klose\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Thomas Klose\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On the breakdown of perturbative integrability in large N \
matrix models\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"27 pages\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0510 (2005) 083\""}]}, {
              
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2005/10/083\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"AEI-2005-127\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We study the perturbative integrability of the planar \
sector of a massive\\nSU(N) matrix quantum mechanical theory with global \
SO(6) invariance and\\nYang-Mills-like interaction. This model arises as a \
consistent truncation of\\nmaximally supersymmetric Yang-Mills theory on a \
three-sphere to the lowest\\nmodes of the scalar fields. In fact, our studies \
mimic the current\\ninvestigations concerning the integrability properties of \
this gauge theory.\\nLike in the field theory we can prove the planar \
integrability of the SO(6)\\nmodel at first perturbative order. At higher \
orders we restrict ourselves to\\nthe widely studied SU(2) subsector spanned \
by two complexified scalar fields of\\nthe theory. We show that our toy model \
satisfies all commonly studied\\nintegrability requirements such as \
degeneracies in the spectrum, existence of\\nconserved charges and factorized \
scattering up to third perturbative order.\\nThese are the same qualitative \
features as the ones found in super Yang-Mills\\ntheory, which were enough to \
conjecture the all-loop integrability of that\\ntheory. For the SO(6) model, \
however, we show that these properties are not\\nsufficient to predict higher \
loop integrability. In fact, we explicitly\\ndemonstrate the breakdown of \
perturbative integrability at fourth order.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 21 Jul 2005 20:19:56 GMT\""}]}], "}"}], "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2009-11-11\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{"\"Klose\"", ",", "\"Thomas\"", ",", "\"\""}], 
                    "}"}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
             Left, ColumnAlignments -> Left], Column], 
           Function[BoxForm`e$, 
            TableForm[BoxForm`e$]]]],
         Annotation[#, 
          
          TableForm[{
           "id" -> "hep-th/0507217", "submitter" -> "Thomas Klose", "authors" -> 
            "Thomas Klose", "title" -> 
            "On the breakdown of perturbative integrability in large N matrix \
models", "comments" -> "27 pages", "journal-ref" -> "JHEP 0510 (2005) 083", 
            "doi" -> "10.1088/1126-6708/2005/10/083", "report-no" -> 
            "AEI-2005-127", "categories" -> "hep-th", "license" -> Null, 
            "abstract" -> 
            "  We study the perturbative integrability of the planar sector \
of a massive\nSU(N) matrix quantum mechanical theory with global SO(6) \
invariance and\nYang-Mills-like interaction. This model arises as a \
consistent truncation of\nmaximally supersymmetric Yang-Mills theory on a \
three-sphere to the lowest\nmodes of the scalar fields. In fact, our studies \
mimic the current\ninvestigations concerning the integrability properties of \
this gauge theory.\nLike in the field theory we can prove the planar \
integrability of the SO(6)\nmodel at first perturbative order. At higher \
orders we restrict ourselves to\nthe widely studied SU(2) subsector spanned \
by two complexified scalar fields of\nthe theory. We show that our toy model \
satisfies all commonly studied\nintegrability requirements such as \
degeneracies in the spectrum, existence of\nconserved charges and factorized \
scattering up to third perturbative order.\nThese are the same qualitative \
features as the ones found in super Yang-Mills\ntheory, which were enough to \
conjecture the all-loop integrability of that\ntheory. For the SO(6) model, \
however, we show that these properties are not\nsufficient to predict higher \
loop integrability. In fact, we explicitly\ndemonstrate the breakdown of \
perturbative integrability at fourth order.\n", 
            "versions" -> {{
              "version" -> "v1", "created" -> 
               "Thu, 21 Jul 2005 20:19:56 GMT"}}, "update_date" -> 
            "2009-11-11", "authors_parsed" -> {{"Klose", "Thomas", ""}}}], 
          "Tooltip"]& ], 
