               RowBox[{"\"id\"", "\[Rule]", "\"0704.2389\""}]}, {
               
               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Georgios Papathanasiou\""}]}, {
              
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Georgios Papathanasiou and Marcus Spradlin\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Semiclassical Quantization of the Giant Magnon\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"20 pages, JHEP3 style; v2: minor typos fixed and \
references added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0706:032,2007\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2007/06/032\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"BROWN-HET-1479\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  Solitons in field theory provide a window into regimes \
not directly\\naccessible by the fundamental perturbative degrees of freedom. \
Motivated by\\ninterest in the worldsheet S-matrix of string theory in AdS_5 \
x S^5 in the\\nlimit of infinite worldsheet volume we consider the \
semiclassical quantization\\nof a particular soliton of this theory: the \
Hofman-Maldacena `giant magnon'\\nspinning string. We obtain explicit \
formulas for the complete spectrum of\\nbosonic and fermionic fluctuations \
around the giant magnon. As an application\\nof these results we confirm that \
the one-loop correction to the classical\\nenergy vanishes as \
expected.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
