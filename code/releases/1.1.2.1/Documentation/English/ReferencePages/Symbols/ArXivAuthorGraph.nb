                "\"title\"", "\[Rule]", 
                 "\"Y-system for Y=0 brane in planar AdS/CFT\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"25 pages, minor corrections, references added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
