                "\"title\"", "\[Rule]", 
                 "\"The full spectrum of AdS$_5$/CFT$_4$ II: Weak coupling \
expansion via the\\n  quantum spectral curve\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"47 pages, 2 Mathematica notebooks\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
