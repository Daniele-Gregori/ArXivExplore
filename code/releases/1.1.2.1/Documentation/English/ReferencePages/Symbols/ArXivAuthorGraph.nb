                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 24 Jun 2003 15:48:49 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
