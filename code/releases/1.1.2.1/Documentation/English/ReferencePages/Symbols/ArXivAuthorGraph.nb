               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"New boundary monodromy matrices for classical sigma \
models\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"36 pages, the Poisson structure is developed\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.nuclphysb.2020.114949\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
