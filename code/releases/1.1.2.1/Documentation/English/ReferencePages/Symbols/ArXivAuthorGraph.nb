               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"A. Foerster and E. Ragoucy\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Exactly solvable models in atomic and molecular \
physics\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"33 pages\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys.B777:373-403,2007\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.nuclphysb.2007.03.039\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"LAPTH-1175/07\""}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", 
                 "\"cond-mat.str-el cond-mat.mes-hall\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We construct integrable generalised models in a \
systematic way exploring\\ndifferent representations of the gl(N) algebra. \
The models are then interpreted\\nin the context of atomic and molecular \
physics, most of them related to\\ndifferent types of Bose-Einstein \
condensates. The spectrum of the models is\\ngiven through the analytical \
Bethe ansatz method. We further extend these\\nresults to the case of the \
superalgebra gl(M|N), providing in this way models\\nwhich also include \
fermions.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 6 Feb 2007 08:39:20 GMT\""}]}], "}"}], "}"}]}]}, {
              
