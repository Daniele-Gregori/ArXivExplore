               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Spinning strings and minimal surfaces in $AdS_3$ with \
mixed 3-form\\n  fluxes\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"34 pages, Accepted for publication in JHEP\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP10(2014)049\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
