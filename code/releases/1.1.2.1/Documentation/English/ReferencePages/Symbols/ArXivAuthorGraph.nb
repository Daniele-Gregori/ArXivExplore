               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Frederic Van Wijland\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"C\\\\'ecile Appert-Rolland (LPT), Bernard Derrida (LPS), \
Vivien Lecomte\\n  (MSC), Fr\\\\'ed\\\\'eric Van Wijland (MSC)\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Universal cumulants of the current in diffusive systems \
on a ring\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"P.R.E. 78 (2008) p 021122\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1103/PhysRevE.78.021122\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", "\"cond-mat.stat-mech\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We calculate exactly the first cumulants of the \
integrated current and of the\\nactivity (which is the total number of \
changes of configurations) of the\\nsymmetric simple exclusion process (SSEP) \
on a ring with periodic boundary\\nconditions. Our results indicate that for \
large system sizes the large\\ndeviation functions of the current and of the \
activity take a universal scaling\\nform, with the same scaling function for \
both quantities. This scaling function\\ncan be understood either by an \
analysis of Bethe ansatz equations or in terms\\nof a theory based on \
fluctuating hydrodynamics or on the macroscopic\\nfluctuation theory of \
Bertini, De Sole, Gabrielli, Jona-Lasinio and Landim.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 16 Apr 2008 13:24:24 GMT\""}]}], "}"}], "}"}]}]}, {
