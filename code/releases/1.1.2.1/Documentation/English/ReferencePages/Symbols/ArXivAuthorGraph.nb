               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Dimitrios Katsinis\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Dimitrios Katsinis\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Solving formally the Auxiliary System of $O(N)$ Non \
Linear Sigma Model\""}]}, {
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"5 pages, v2 minor changes to match published \
version\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys.Rev.D 105 (2022) 10, 106005\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1103/PhysRevD.105.106005\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", 
                 "\"hep-th math-ph math.MP nlin.SI\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://creativecommons.org/licenses/by/4.0/\""}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We show that the integrability of the $SO(N)/SO(N-1)$ \
Principal Chiral Model\\n(PCM) originates from the Pohlmeyer reduction of the \
$O(N)$ Non Linear Sigma\\nModel (NLSM). In particular, we show that the Lax \
pair of the PCM is related\\nupon redefinitions and identification of \
parameters to the zero curvature\\ncondition, which is a consequence of the \
flatness of the enhanced space used in\\nthe Pohlmeyer reduction. This \
identification provides the solution of the\\nauxiliary system that \
corresponds to an arbitrary NLSM/PCM solution.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
