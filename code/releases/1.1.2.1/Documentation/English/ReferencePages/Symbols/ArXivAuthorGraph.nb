            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"1906.09886\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Hui-Huang Chen\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Hui-Huang Chen\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Asymptotic Bethe ansatz of ABJM open spin chain from \
giant graviton\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"16 pages, published version,typoes fixed\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP08(2019)109\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP08(2019)109\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
