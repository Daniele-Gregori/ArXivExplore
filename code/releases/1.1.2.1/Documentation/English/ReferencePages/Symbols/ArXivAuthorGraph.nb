               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Niklas Beisert, Rafael Hernandez, Esperanza Lopez\""}]}, {
              
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"A Crossing-Symmetric Phase for AdS_5 x S^5 Strings\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"34 pages, v2: references added, minor changes, to appear \
in JHEP\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0611:070,2006\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2006/11/070\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
                 "\"AEI-2006-068, CERN-PH-TH/2006-176, IFT-UAM/CSIC-06-44, \
PUTP-2208\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We propose an all-order perturbative expression for the \
dressing phase of the\\nAdS_5 x S^5 string S-matrix at strong coupling. \
Moreover, we are able to sum up\\nlarge parts of this expression. This allows \
us to start the investigation of\\nthe analytic structure of the phase at \
finite coupling revealing a few\\nsurprising features. The phase obeys all \
known constraints including the\\ncrossing relation and it matches with the \
known physical data at strong\\ncoupling. In particular, we recover the bound \
states of giant magnons recently\\nfound by Hofman and Maldacena as poles of \
the scattering matrix. At weak\\ncoupling our proposal seems to differ with \
gauge theory. A possible solution to\\nthis disagreement is the inclusion of \
additional pieces in the phase not\\ncontributing to crossing, which we also \
study.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
