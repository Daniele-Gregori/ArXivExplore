               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On the spectrum of AdS3 x S3 x T4 strings with \
Ramond-Ramond flux\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"6 pages, 4 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
