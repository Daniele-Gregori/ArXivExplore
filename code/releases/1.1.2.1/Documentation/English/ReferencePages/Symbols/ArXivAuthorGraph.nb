        TagBox[
         TooltipBox[DiskBox[{17.577368330523324`, -2.709229071819779}, 0.],
          TagBox[
           TagBox[
            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0409296\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Arkady Tseytlin\""}]}, {
              
               RowBox[{"\"authors\"", "\[Rule]", "\"A.A. Tseytlin\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Semiclassical strings and AdS/CFT\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"34 pages. Contribution to Proceedings of Cargese Summer \
School, June\\n  7-19, 2004, extended version of hep-th/0407218\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We discuss AdS/CFT duality in the sector of \
``semiclassical'' string states\\nwith large quantum numbers. We review the \
coherent-state effective action\\napproach, in which similar 2d sigma model \
actions appear from the AdS_5 x S^5\\nstring action and from the integrable \
spin chain Hamiltonian representing the\\nN=4 super Yang-Mills dilatation \
operator. We consider mostly the leading-order\\nterms in the \
energies/anomalous dimensions which match but comment also on\\nhigher-order \
corrections.\\n\""}]}, {
