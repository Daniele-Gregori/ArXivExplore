Alexandre Yale\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Mutual information and the F-theorem\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"80 pages, 16 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
