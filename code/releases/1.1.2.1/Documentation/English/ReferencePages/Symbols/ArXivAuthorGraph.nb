            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0210218\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Sean A. Hartnoll\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Sean A. Hartnoll and Carlos Nunez\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Rotating membranes on G_2 manifolds, logarithmic \
anomalous dimensions\\n  and N=1 duality\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"1+44 pages. Latex. No figures. Minor corrections to make \
all membrane\\n  configurations consistent. One configuration is now \
noncompact\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0302 (2003) 049\""}]}, {
              
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2003/02/049\""}]}, {
