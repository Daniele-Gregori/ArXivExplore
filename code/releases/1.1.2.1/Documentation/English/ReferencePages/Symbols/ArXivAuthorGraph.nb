               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"The AdS(5)xS(5) superstring quantum spectrum from the \
algebraic curve\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys.B789:175-208,2008\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.nuclphysb.2007.07.032\""}]}, {
