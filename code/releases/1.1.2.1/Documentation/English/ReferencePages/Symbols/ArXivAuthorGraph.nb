               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"The Classical Exchange Algebra of AdS5 x S5 String Theory\
\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"37 pages; v2: Result on Jacobi identity and Yang-Baxter \
equation\\n  added in section 3.3; v3: References added; v4: Comparison with \
ref [12]\\n  clarified in section 3.3\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0901:021,2009\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2009/01/021\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"AEI-2008-085\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  The classical exchange algebra satisfied by the \
monodromy matrix of AdS5 x S5\\nstring theory in the Green-Schwarz \
formulation is determined by using a\\nfirst-order Hamiltonian formulation \
and by adding to the Bena-Polchinski-Roiban\\nLax connection terms \
proportional to constraints. This enables in particular to\\nshow that the \
conserved charges of this theory are in involution. This result\\nis obtained \
for a general world-sheet metric. The same exchange algebra is\\nobtained \
within the pure spinor description of AdS5 x S5 string theory. \
These\\nresults are compared to the one obtained by A. Mikhailov and S. \
Schaefer-Nameki\\nfor the pure spinor formulation.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
