               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Marco S. Bianchi, Matias Leoni, Andrea Mauri, Silvia \
Penati and\\n  Alberto Santambrogio\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", "\"Scattering in ABJ theories\""}]}, {
              
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"1+54 pages, 8 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP12(2011)073\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
