               RowBox[{"\"id\"", "\[Rule]", "\"0805.4387\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Nick Dorey\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Nick Dorey\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"A Spin Chain from String Theory\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"37 Pages, 8 figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Acta Phys.Polon.B39:3081-3116,2008\""}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We study the semiclassical spectrum of bosonic string \
theory on AdS_3 x S^1\\nin the limit of large AdS angular momentum. At \
leading semiclassical order,\\nthis is a subsector of the IIB superstring on \
AdS_5 x S^5. The theory includes\\nstrings with K spikes which approach the \
boundary in this limit. We show that,\\nfor all K, the spectrum of these \
strings exactly matches that of the\\ncorresponding operators in the dual \
gauge theory up to a single universal\\nprefactor which can be identified \
with the cusp anomalous dimension. We propose\\na precise map between the \
dynamics of the spikes and the classical SL(2,R) spin\\nchain which arises in \
the large-spin limit of N=4 Super Yang-Mills theory.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 28 May 2008 17:20:36 GMT\""}]}], "}"}], "}"}]}]}, {
