               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"The one-loop worldsheet S-matrix for the AdS(n) x S(n) x \
T(10-2n)\\n  superstring\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"23 pages; v2: typos fixed in (C.2)-(C.4)\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP08(2014)160\""}]}, {
               
