                RowBox[{
                 "\"authors\"", "\[Rule]", 
                  "\"Vyacheslav Ivanovskiy, Shota Komatsu, Victor Mishnyakov, \
Nikolay\\n  Terziev, Nikita Zaigraev, Konstantin Zarembo\""}]}, {
                
                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Vacuum Condensates on the Coulomb Branch\""}]}, {
                RowBox[{"\"comments\"", "\[Rule]", "\"51 pages\""}]}, {
                RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
