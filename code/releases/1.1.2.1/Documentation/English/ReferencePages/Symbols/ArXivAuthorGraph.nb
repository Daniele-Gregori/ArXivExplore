               "Sun, 11 Nov 2018 12:40:17 GMT"}}, "update_date" -> 
            "2018-11-13", 
            "authors_parsed" -> {{"Alba", "Vincenzo", ""}, {
              "Calabrese", "Pasquale", ""}}}], "Tooltip"]& ], 
