               RowBox[{"\"submitter\"", "\[Rule]", "\"Simone Giombi\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Simone Giombi, Radu Roiban, Arkady A. Tseytlin\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Half-BPS Wilson loop and AdS$_2$/CFT$_1$\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"29 pages, 2 figures. v5: typos corrected\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.nuclphysb.2017.07.004\""}]}, {
               
