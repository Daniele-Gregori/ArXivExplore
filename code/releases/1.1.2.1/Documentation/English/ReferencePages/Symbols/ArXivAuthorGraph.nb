               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Tristan McLoughlin\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Tristan McLoughlin, Raul Pereira and Anne Spiering\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Quantum Chaos in Perturbative super-Yang-Mills \
Theory\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"8 pages, 12 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
                 "\"TCDMATH 20-13, SAGEX-20-25\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th nlin.CD\""}]}, {
              
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We provide numerical evidence that the perturbative \
spectrum of anomalous\\ndimensions in maximally supersymmetric SU(N) \
Yang-Mills theory is chaotic at\\nfinite values of N. We calculate the \
probability distribution of one-loop level\\nspacings for subsectors of the \
theory and show that for large N it is given by\\nthe Poisson distribution of \
integrable models, while at finite values it is the\\nWigner-Dyson \
distribution of the Gaussian orthogonal ensemble random matrix\\ntheory. We \
extend these results to two-loop order and to a one-parameter family\\nof \
deformations. We further study the spectral rigidity for these models \
and\\nshow that it is also well described by random matrix theory. Finally we\
\\ndemonstrate that the finite-N eigenvectors possess properties of \
chaotic\\nstates.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 9 Nov 2020 18:43:28 GMT\""}]}], "}"}], "}"}]}]}, {
              
               RowBox[{"\"update_date\"", "\[Rule]", "\"2020-11-10\""}]}, {
