                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 5 Jul 2019 15:29:52 GMT\""}]}], "}"}], ",", 
