               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/9706187\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Kenji Hamada\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Ken-ji Hamada\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Supersymmetric Wilson Loops in IIB Matrix Model\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"10 pages, Latex, minor typos corrected\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys.Rev.D56:7503-7506,1997\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1103/PhysRevD.56.R7503\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We show that the supersymmetric Wilson loops in IIB \
matrix model give a\\ntransition operator from reduced supersymmetric \
Yang-Mills theory to\\nsupersymmetric space-time theory. In comparison with \
Green-Schwarz superstring\\nwe identify the supersymmetric Wilson loops with \
the asymptotic states of IIB\\nsuperstring. It is pointed out that the \
supersymmetry transformation law of the\\nWilson loops is the inverse of that \
for the vertex operators of massless modes\\nin the U(N) open superstring \
with Dirichlet boundary condition.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 26 Jun 1997 10:11:47 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
