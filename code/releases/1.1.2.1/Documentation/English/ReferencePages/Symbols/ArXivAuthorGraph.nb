                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Gunnesson\"", ",", "\"Johan\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Hernandez\"", ",", "\"Rafael\"", ",", "\"\""}],
                     "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
