               RowBox[{"\"submitter\"", "\[Rule]", "\"Arsen Melikyan\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"A. Melikyan, A. Pinzul, V. O. Rivelles, and G. \
Weber\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Quantum integrability of the Alday-Arutyunov-Frolov model\
\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"40 pages; Replaced with published version. Appendix and \
comments\\n  added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 09(2011)092\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP09(2011)092\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
