               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We study the partition function of the six-vertex model \
in the rational limit\\non arbitrary Baxter lattices with reflecting \
boundary. Every such lattice is\\ninterpreted as an invariant of the twisted \
Yangian. This identification allows\\nus to relate the partition function of \
the vertex model to the Bethe wave\\nfunction of an open spin chain. We \
obtain the partition function in terms of\\ncreation operators on a reference \
state from the algebraic Bethe ansatz and as\\na sum of permutations and \
reflections from the coordinate Bethe ansatz.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
