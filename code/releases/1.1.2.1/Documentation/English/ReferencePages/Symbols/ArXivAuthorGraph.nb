                    RowBox[{"\"version\"", "\[Rule]", "\"v4\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 13 Nov 2015 11:46:25 GMT\""}]}], "}"}]}], 
