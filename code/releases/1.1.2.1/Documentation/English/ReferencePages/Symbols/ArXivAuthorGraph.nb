                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 8 Jul 2003 02:50:05 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
