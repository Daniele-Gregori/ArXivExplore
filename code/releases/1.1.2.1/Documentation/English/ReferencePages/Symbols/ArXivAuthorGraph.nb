               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Regge meets collinear in strongly-coupled $\\\\mathcal{N} \
= 4$ super\\n  Yang-Mills\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"27 pages, 2 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
