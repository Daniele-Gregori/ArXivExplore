                "\"authors\"", "\[Rule]", 
                 "\"Chih-Kai Chang, Christian Ferko, Savdeep Sethi, \
Alessandro Sfondrini,\\n  Gabriele Tartaglino-Mazzucchelli\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"$T\\\\bar{T}$ Flows and (2,2) Supersymmetry\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"39 pages\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys. Rev. D 101, 026008 (2020)\""}]}, {
               
