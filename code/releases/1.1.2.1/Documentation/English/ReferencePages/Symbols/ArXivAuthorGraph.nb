            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/9711040\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Alok Kumar\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Anindya K. Biswas, Alok Kumar and Gautam Sengupta\""}]}, {
              
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Oscillating D-Strings from IIB Matrix Theory\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"18 pages, minor corrections, references added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys.Rev. D57 (1998) 5141-5149\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1103/PhysRevD.57.5141\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
                 "\"IMSC/97/09/37, IP/BBSR/97-34, MRI-PHY/p970925\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We present a class of BPS solutions of the IIB Matrix \
Theory which preserve\\n1/4 supersymmetry. The solutions desrcibe D-string \
configurations with\\nleft-moving oscillations. We demonstrate that the \
one-loop quantum effective\\naction of Matrix Theory vanishes for this \
solution, confirming its BPS nature.\\nWe also study the world-volume gauge \
theory of oscillating strings and show its\\nconnection with static \
D-strings.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 6 Nov 1997 16:18:02 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
