               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Approaching the BFKL pomeron via integrable classical \
solutions\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"20 pages, 4 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP01(2014)074\""}]}, {
