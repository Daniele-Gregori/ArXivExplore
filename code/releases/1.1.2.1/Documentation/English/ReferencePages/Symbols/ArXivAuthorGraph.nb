               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0402203\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Gregory Braun\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Philip C. Argyres (1), Adel M. Awad (2), Gregory A. Braun \
(1), F. Paul\\n  Esposito (1) ((1) University of Cincinnati, (2) Ain Shams \
Univeristy)\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Higher-Derivative Terms in N=2 SUSY Effective \
Actions\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"5 pages. Talk given at SUSY '03 and QTS3 by G. \
Braun\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1142/9789812702340_0034\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"UCTP-105-04\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  Harmonic superspace can be used to construct higher \
derivative terms in N=2\\nsupersymmetric effective actions despite the \
infinite redundancy in their\\ndescription due to the infinite number of \
auxiliary fields. We are able to\\nwrite down all of the 3- and 4-derivative \
terms on the Higgs, Coulomb, and\\nmixed branches, modulo the possible \
existence of superspace Chern-Simons-like\\nterms, which we discuss. Many of \
the terms we find are holomorphic, and at\\nleast one is shown to not receive \
quantum corrections.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
