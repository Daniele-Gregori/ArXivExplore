                    "\"Wed, 14 Sep 2016 20:16:37 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 2 Mar 2017 19:38:16 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2017-04-05\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
