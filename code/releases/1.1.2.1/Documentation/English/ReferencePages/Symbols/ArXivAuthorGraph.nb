                "\"title\"", "\[Rule]", 
                 "\"Quantum spectral curve for arbitrary state/operator in \
AdS$_5$/CFT$_4$\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"96 pages, 15 figures; Some mathematica examples added in \
v2;\\n  Published version is v3\""}]}, {
               
