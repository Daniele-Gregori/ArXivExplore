Young\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Giant Gravitons on AdS_4 x CP^3 and their Holographic \
Three-point\\n  Functions\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"1+16 pages. v2 added a reference\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 1207 (2012) 006\""}]}, {
              
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP07(2012)006\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
