                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2006/03/018\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
                 "\"AEI-2005-164, SPhT-T05/190, NSF-KITP-05-84\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  Recently it was established that a certain integrable \
long-range spin chain\\ndescribes the dilatation operator of N=4 gauge theory \
in the su(2) sector to at\\nleast three-loop order, while exhibiting BMN \
scaling to all orders in\\nperturbation theory. Here we identify this spin \
chain as an approximation to an\\nintegrable short-ranged model of strongly \
correlated electrons: The Hubbard\\nmodel.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
