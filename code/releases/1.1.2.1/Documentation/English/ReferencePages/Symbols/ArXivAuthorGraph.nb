                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 23 Feb 2023 08:04:11 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
