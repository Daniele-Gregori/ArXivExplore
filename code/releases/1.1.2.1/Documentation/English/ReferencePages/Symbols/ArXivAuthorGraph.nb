               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"L\\\\\\\"uscher-corrections for 1-particle form-factors \
in non-diagonally\\n  scattering integrable quantum field theories\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"28 pages\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
