               RowBox[{"\"title\"", "\[Rule]", "\"Dyonic Giant Magnons\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"LaTeX file, 16 pages. One figure. Corrected \
references\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP0609:024,2006\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2006/09/024\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"DAMTP-06-38\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We study the classical spectrum of string theory on \
AdS_5 X S^5 in the\\nHofman-Maldacena limit. We find a family of classical \
solutions corresponding\\nto Giant Magnons with two independent angular \
momenta on S^5. These solutions\\nare related via Pohlmeyer's reduction \
procedure to the charged solitons of the\\nComplex sine-Gordon equation. The \
corresponding string states are dual to BPS\\nboundstates of many magnons in \
the spin-chain description of planar N=4 SUSY\\nYang-Mills. The exact \
dispersion relation for these states is obtained from a\\npurely classical \
calculation in string theory.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
