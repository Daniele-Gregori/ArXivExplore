SYM\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"35 pages, v2: references added, sign inconsistency \
resolved in\\n  (5.5,5.6), v3: Section 3.4 on Hamiltonian added, minor \
improvements, to\\n  appear in JHEP\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0710:031,2007\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2007/10/031\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", "\"AEI-2007-096, PUTP-2232\""}]}, {
