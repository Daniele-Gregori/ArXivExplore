                RowBox[{"\"id\"", "\[Rule]", "\"hep-th/9904149\""}]}, {
                RowBox[{"\"submitter\"", "\[Rule]", "\"Zarembo\""}]}, {
                RowBox[{"\"authors\"", "\[Rule]", "\"K. Zarembo\""}]}, {
                
                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Wilson Loop Correlator in the AdS/CFT \
Correspondence\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", "\"12 pages, 3 figures\""}]}, {
                
                RowBox[{
                 "\"journal-ref\"", "\[Rule]", 
                  "\"Phys.Lett. B459 (1999) 527-534\""}]}, {
                
                RowBox[{
                 "\"doi\"", "\[Rule]", 
                  "\"10.1016/S0370-2693(99)00717-0\""}]}, {
                RowBox[{"\"report-no\"", "\[Rule]", "\"ITEP-TH-17/99\""}]}, {
                RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
                RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
                
                RowBox[{
                 "\"abstract\"", "\[Rule]", 
                  "\"  The AdS/CFT correspondence predicts a phase transition \
in Wilson loop\\ncorrelators in the strong coupling N=4, D=4 SYM theory which \
arises due to\\ninstability of the classical string stretched between the \
loops. We study this\\ntransition in detail by solving equations of motion \
for the string in the\\nparticular case of two circular Wilson loops. The \
transition is argued to be\\nsmoothened at finite `t Hooft coupling by \
fluctuations of the string world\\nsheet and to be promoted to a sharp \
crossover. Some general comments about\\nWilson loop correlators in gauge \
theories are made.\\n\""}]}, {
                RowBox[{"\"versions\"", "\[Rule]", 
                  RowBox[{"{", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 21 Apr 1999 19:23:53 GMT\""}]}], "}"}], "}"}]}]}, {
                RowBox[{"\"update_date\"", "\[Rule]", "\"2009-10-31\""}]}, {
                RowBox[{"\"authors_parsed\"", "\[Rule]", 
                  RowBox[{"{", 
                    RowBox[{"{", 
                    RowBox[{"\"Zarembo\"", ",", "\"K.\"", ",", "\"\""}], 
                    "}"}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
