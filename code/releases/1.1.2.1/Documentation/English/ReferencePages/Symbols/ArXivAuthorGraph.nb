                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Basso\"", ",", "\"Benjamin\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Belitsky\"", ",", "\"Andrei V.\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
