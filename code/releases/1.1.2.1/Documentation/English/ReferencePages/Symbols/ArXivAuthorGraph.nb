           "id" -> "1807.07768", "submitter" -> "Giuseppe Dibitetto", 
            "authors" -> "Giuseppe Dibitetto and Nicol\\`o Petri", "title" -> 
            "Surface defects in the D4 $-$ D8 brane system", "comments" -> 
            "30 pages + 3 appendices, 6 tables", "journal-ref" -> Null, "doi" -> 
            "10.1007/JHEP01(2019)193", "report-no" -> "UUITP-32/18", 
