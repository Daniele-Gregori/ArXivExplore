               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Joseph A. Minahan and Usman Naseer\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Gauge theories on spheres with 16 supercharges and \
non-constant\\n  couplings\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"24 pages, two appendices\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1751-8121/ab1ab1\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
                 "\"UUITP-52/18, MIT-CTP/5084\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We construct a class of theories with 16 \
supersymmetries on spheres of\\ndimension nine and less. The gauge coupling \
and mass terms for the scalar\\nfields depend on the polar angle away from \
the north pole. Assuming finite\\ncoupling on the north pole, this leads to \
zero coupling at the south pole for\\n$d>4$ and infinite coupling at the \
south pole for $d<4$. The underlying\\nsupersymmetry algebra of these \
theories is shown to be isomorphic to the\\nPoincar\\\\'e superalgebra in \
$d$-dimensions. We also give a localization\\nprocedure which leads to \
nontrivial results for $d=2$.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
