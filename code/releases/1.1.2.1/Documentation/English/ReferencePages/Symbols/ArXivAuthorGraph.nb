                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v3\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 16 May 2005 17:39:16 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
