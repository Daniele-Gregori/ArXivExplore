             GridBox[{{
                RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0502226\""}]}, {
                RowBox[{"\"submitter\"", "\[Rule]", "\"Niklas Beisert\""}]}, {
               
                
                RowBox[{
                 "\"authors\"", "\[Rule]", 
                  "\"N. Beisert, V.A. Kazakov, K. Sakai, K. Zarembo\""}]}, {
                
                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"The Algebraic Curve of Classical Superstrings on \
AdS_5xS^5\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", 
                  "\"56 pages, v2: first local charge derived, minor \
improvements,\\n  references added, v3: minor corrections, reference added, \
to appear in\\n  Commun. Math. Phys\""}]}, {
                
                RowBox[{
                 "\"journal-ref\"", "\[Rule]", 
                  "\"Commun.Math.Phys.263:659-710,2006\""}]}, {
                
                RowBox[{
                 "\"doi\"", "\[Rule]", "\"10.1007/s00220-006-1529-4\""}]}, {
                
                RowBox[{
                 "\"report-no\"", "\[Rule]", 
                  "\"ITEP-TH-13/05, LPTENS-05/10, NSF-KITP-05-12, PUTP-2152, \
UUITP-03/05\""}]}, {
                RowBox[{"\"categories\"", "\[Rule]", "\"hep-th nlin.SI\""}]}, {
                RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
                
                RowBox[{
                 "\"abstract\"", "\[Rule]", 
                  "\"  We investigate the monodromy of the Lax connection for \
classical IIB\\nsuperstrings on AdS_5xS^5. For any solution of the equations \
of motion we\\nderive a spectral curve of degree 4+4. The curve consists \
purely of conserved\\nquantities, all gauge degrees of freedom have been \
eliminated in this form. The\\nmost relevant quantities of the solution, such \
as its energy, can be expressed\\nthrough certain holomorphic integrals on \
the curve. This allows for a\\nclassification of finite gap solutions \
analogous to the general solution of\\nstrings in flat space. The role of \
fermions in the context of the algebraic\\ncurve is clarified. Finally, we \
derive a set of integral equations which\\nreformulates the algebraic curve \
as a Riemann-Hilbert problem. They agree with\\nthe planar, one-loop N=4 \
supersymmetric gauge theory proving the complete\\nagreement of spectra in \
this approximation.\\n\""}]}, {
                RowBox[{"\"versions\"", "\[Rule]", 
                  RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 25 Feb 2005 20:57:11 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 25 Mar 2005 17:43:54 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v3\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 3 Oct 2005 19:35:37 GMT\""}]}], "}"}]}], 
                    "}"}]}]}, {
                RowBox[{"\"update_date\"", "\[Rule]", "\"2011-03-23\""}]}, {
                RowBox[{"\"authors_parsed\"", "\[Rule]", 
                  RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Beisert\"", ",", "\"N.\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
