               "Gudnason", "Sven Bjarke", ""}, {"Kedem", "Yaron", ""}, {
               "Krikun", "Alexander", ""}, {"Thorlacius", "Larus", ""}, {
               "Zarembo", "Konstantin", ""}}}], "Tooltip"]& ]}, 
