                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 18 Nov 2021 19:00:55 GMT\""}]}], "}"}], "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2022-05-11\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
