              "version" -> "v1", "created" -> 
               "Wed, 19 Jan 2011 16:16:09 GMT"}}, "update_date" -> 
            "2015-03-17", 
            "authors_parsed" -> {{"Feverati", "Giovanni", ""}}}], 
