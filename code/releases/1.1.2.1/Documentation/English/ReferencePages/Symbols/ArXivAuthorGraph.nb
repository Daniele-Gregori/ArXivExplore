          TableForm[{
           "id" -> "hep-th/0611014", "submitter" -> "Rafael Hernandez", 
            "authors" -> "Cesar Gomez, Rafael Hernandez", "title" -> 
            "Integrability and non-perturbative effects in the AdS/CFT \
correspondence", "comments" -> "8 pages. Latex", "journal-ref" -> 
            "Phys.Lett.B644:375-378,2007", "doi" -> 
            "10.1016/j.physletb.2006.12.007", "report-no" -> Null, 
            "categories" -> "hep-th", "license" -> Null, "abstract" -> 
            "  We present a non-perturbative resummation of the asymptotic \
strong-coupling\nexpansion for the dressing phase factor of the AdS_5xS^5 \
string S-matrix. The\nnon-perturbative resummation provides a general form \
for the coefficients in\nthe weak-coupling expansion, in agreement with \
crossing symmetry and\ntranscendentality. The ambiguities of the \
non-perturbative prescription are\ndiscussed together with the similarities \
with the non-perturbative definition\nof the c=1 matrix model.\n", 
            "versions" -> {{
              "version" -> "v1", "created" -> 
               "Wed, 1 Nov 2006 15:18:48 GMT"}}, "update_date" -> 
            "2008-11-26", 
            "authors_parsed" -> {{"Gomez", "Cesar", ""}, {
              "Hernandez", "Rafael", ""}}}], "Tooltip"]& ], 
