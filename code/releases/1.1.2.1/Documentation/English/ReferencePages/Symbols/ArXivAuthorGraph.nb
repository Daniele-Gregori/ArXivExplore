            "title" -> "$T\\bar{T}$ deformations and integrable spin chains", 
            "comments" -> 
            "6 pages, two columns; v2: typos corrected, refs added", 
            "journal-ref" -> "Phys. Rev. Lett. 124, 100601 (2020)", "doi" -> 
            "10.1103/PhysRevLett.124.100601", "report-no" -> Null, 
