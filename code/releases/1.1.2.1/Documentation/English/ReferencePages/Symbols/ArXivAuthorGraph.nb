               RowBox[{"\"id\"", "\[Rule]", "\"1307.3506\""}]}, {
               
               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Tristan McLoughlin\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Thomas Klose, Tristan McLoughlin\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Comments on World-Sheet Form Factors in AdS/CFT\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"28 pages, 1 figure\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1751-8113/47/5/055401\""}]}, {
               
