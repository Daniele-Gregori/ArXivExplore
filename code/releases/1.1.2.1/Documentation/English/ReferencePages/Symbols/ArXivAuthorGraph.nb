               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Generating functional of correlators of twist-$2$ \
operators in\\n  $\\\\mathcal{N} = 1$ SUSY Yang-Mills theory, II\""}]}, {
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"38 pages. arXiv admin note: substantial text overlap with\
\\n  arXiv:2403.09617\""}]}, {
