                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Worldsheet spectrum in AdS(4)/CFT(3) \
correspondence\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", 
                  "\"19 pages, 2 figures; v2: misprints in (2.3), (2.11) and \
(A.1)\\n  corrected, a reference added; v3: misprints in (B.6), (B.9) and \
(B.12)\\n  corrected; v4: footnote 4 added\""}]}, {
                RowBox[{
                 "\"journal-ref\"", "\[Rule]", "\"JHEP 0904:135,2009\""}]}, {
                
                RowBox[{
                 "\"doi\"", "\[Rule]", 
                  "\"10.1088/1126-6708/2009/04/135\""}]}, {
                
