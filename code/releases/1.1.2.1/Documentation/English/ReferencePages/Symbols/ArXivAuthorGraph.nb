                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"He\"", ",", "\"Yifei\"", ",", "\"\""}], "}"}], 
                    ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Kruczenski\"", ",", "\"Martin\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
