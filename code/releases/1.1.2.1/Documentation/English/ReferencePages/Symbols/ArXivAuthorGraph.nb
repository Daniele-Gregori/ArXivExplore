               RowBox[{"\"id\"", "\[Rule]", "\"1903.10759\""}]}, {
               
               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Andrea Fontanella\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Andrea Fontanella and Alessandro Torrielli\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Geometry of Massless Scattering in Integrable Superstring\
\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"Matching with the published version\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP06(2019)116\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
                 "\"DMUS--MP--19--05 , IFT-UAM/CSIC-19-33\""}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", "\"hep-th math-ph math.MP\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://creativecommons.org/licenses/by-nc-sa/4.0/\""}]}, {
              
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We consider the action of the $q$-deformed \
Poincar\\\\'e superalgebra on the\\nmassless non-relativistic R-matrix in \
ordinary (undeformed) integrable $AdS_2\\n\\\\times S^2 \\\\times T^6$ type \
IIB superstring theory. The boost generator acts\\nnon-trivially on the \
R-matrix, confirming the existence of a non-relativistic\\nrapidity \
$\\\\gamma$ with respect to which the R-matrix must be of difference\\nform. \
We conjecture that from a massless AdS/CFT integrable relativistic\\nR-matrix \
one can obtain the parental massless non-relativistic R-matrix simply\\nby \
replacing the relativistic rapidity with $\\\\gamma$. We check our conjecture\
\\nin ordinary (undeformed) $AdS_n \\\\times S^n \\\\times T^{10 - 2n}$, $n = \
2, 3$. In\\nthe case $n=3$, we check that the matrix part and the dressing \
factor - up to\\nnumerical accuracy for real momenta - obey our prescription. \
In the $n=2$ case,\\nwe check the matrix part and propose the \
non-relativistic dressing factor. We\\nthen start a programme of classifying \
R-matrices in terms of connections on\\nfibre bundles. The conditions \
obtained for the connection are tested on a set\\nof known integrable \
R-matrices.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 26 Mar 2019 09:44:54 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Sat, 6 Apr 2019 09:46:37 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v3\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 14 Jun 2019 16:00:32 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2022-10-12\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Fontanella\"", ",", "\"Andrea\"", ",", "\"\""}], "}"}],
                     ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Torrielli\"", ",", "\"Alessandro\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
             Left, ColumnAlignments -> Left], Column], 
