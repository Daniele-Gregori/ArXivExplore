           TagBox[
            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"1612.03795\""}]}, {
               
               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Guillermo A. Silva\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Dionysios Anninos and Guillermo A. Silva\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Solvable Quantum Grassmann Matrices\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"25 pages, 4 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1742-5468/aa668f\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We explore systems with a large number of fermionic \
degrees of freedom\\nsubject to non-local interactions. We study both vector \
and matrix-like models\\nwith quartic interactions. The exact thermal \
partition function is expressed in\\nterms of an ordinary bosonic integral, \
which has an eigenvalue repulsion term\\nin the matrix case. We calculate \
real time correlations at finite temperature\\nand analyze the thermal phase \
structure. When possible, calculations are\\nperformed in both the original \
Hilbert space as well as the bosonic picture,\\nand the exact map between the \
two is explained. At large $N$, there is a phase\\ntransition to a highly \
entropic high temperature phase from a low temperature\\nlow entropy phase. \
Thermal two-point functions decay in time in the high\\ntemperature phase.\\n\
\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 12 Dec 2016 17:16:48 GMT\""}]}], "}"}], "}"}]}]}, {
