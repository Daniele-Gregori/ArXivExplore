               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"D1 and D5-brane giant gravitons on $AdS_3 \\\\times S^3 \
\\\\times S^3 \\\\times\\n  S^1$\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"30 pages, 4 figures. reference and figure added, minor \
changes\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 12 (2014) 094\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP12(2014)094\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"DMUS-MP-14/06\""}]}, {
