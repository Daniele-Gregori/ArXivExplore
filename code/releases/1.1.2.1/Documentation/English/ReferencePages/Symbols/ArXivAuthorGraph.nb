               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Dressing phases of AdS3/CFT2\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"29 pages, 4 figures; v2: note added, minor changes\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
