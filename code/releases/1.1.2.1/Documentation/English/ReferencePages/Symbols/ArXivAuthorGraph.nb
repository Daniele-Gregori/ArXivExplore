               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  The standard unitarity-cut method is applied to several \
massive\\ntwo-dimensional models, including the world-sheet AdS$_5\\\\times \
S^5$\\nsuperstring, to compute $2\\\\to 2$ scattering S-matrices at one loop \
from tree\\nlevel amplitudes. Evidence is found for the cut-constructibility \
of\\nsupersymmetric integrable models, while for models without supersymmetry \
(but\\nintegrable) the missing rational terms can be interpreted as a shift \
in the\\ncoupling.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 2 Jan 2014 14:33:45 GMT\""}]}], "}"}], "}"}]}]}, {
              
