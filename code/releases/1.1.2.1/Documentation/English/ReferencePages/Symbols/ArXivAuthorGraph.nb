                    "\"Tue, 9 Dec 2008 18:57:05 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 17 Sep 2009 13:17:50 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2009-09-17\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
