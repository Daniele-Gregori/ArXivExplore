                "\"authors\"", "\[Rule]", 
                 "\"Simon Ekhammar, Joseph A. Minahan, Charles Thull\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"The ABJM Hagedorn Temperature from Integrability\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"19 pages, 5 figures, 2 ancillary files. V2: references \
added, typos\\n  corrected, updated numerical data\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
                 "\"UUITP-16/23, MIT-CTP/5574\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://creativecommons.org/licenses/by/4.0/\""}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We use the quantum spectral curve to compute the \
Hagedorn temperature for\\nABJM theory in terms of the interpolating function \
$h(\\\\lambda)$. At weak\\ncoupling we compute this temperature up to \
eight-loop order, showing that it\\nmatches the known tree-level and two-loop \
results. At strong coupling we\\ncompute the dependence numerically, showing \
that it is consistent with\\nexpectations from supergravity and the \
plane-wave limit for the four leading\\nterms in the strong coupling \
expansion, up to an overall shift of the\\nzero-point energy for type IIA \
string theory on AdS$_4\\\\times\\n\\\\mathbb{C}\\\\textrm{P}^3$. We \
conjecture an analytic form for this shift to\\nleading order that is \
consistent with our numerical results.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
