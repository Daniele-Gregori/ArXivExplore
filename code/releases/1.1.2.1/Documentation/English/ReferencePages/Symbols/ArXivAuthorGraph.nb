                    RowBox[{"\"Rej\"", ",", "\"Adam\"", ",", "\"\""}], "}"}], 
                    ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Staudacher\"", ",", "\"Matthias\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Zieme\"", ",", "\"Stefan\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
