               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"A Simple Worldsheet Black Hole\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"30 pages, 8 figures; v2: refs updated, typos corrected, \
several\\n  comments added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP07(2018)011\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
