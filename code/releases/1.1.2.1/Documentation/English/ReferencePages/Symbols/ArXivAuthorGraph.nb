               RowBox[{"\"authors\"", "\[Rule]", "\"Qingjun Jin\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"The Emergence of Supersymmetry in $\\\\gamma_i$-deformed \
${\\\\cal N}=4$\\n  super-Yang-Mills theory\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"24 pages, 4 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
