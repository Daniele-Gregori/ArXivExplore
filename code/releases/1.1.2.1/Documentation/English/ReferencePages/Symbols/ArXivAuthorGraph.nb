                 "\"Matrix models from localization of five-dimensional \
supersymmetric\\n  noncommutative U(1) gauge theory\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"50 pages, 2 figures; v2 corrected typos\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 1701:039,2017\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP01(2017)039\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
