               RowBox[{"\"id\"", "\[Rule]", "\"2307.13712\""}]}, {
               
               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Anirban Roy Chowdhury\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
