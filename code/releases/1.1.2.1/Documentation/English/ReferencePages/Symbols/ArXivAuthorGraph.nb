                    "\"Wed, 19 Jul 2023 17:10:16 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 16 Nov 2023 16:54:46 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2023-11-17\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
