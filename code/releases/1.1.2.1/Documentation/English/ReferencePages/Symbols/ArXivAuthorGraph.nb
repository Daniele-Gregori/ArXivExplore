               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Quantum Elliptic Calogero-Moser Systems from Gauge \
Origami\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"36 pages, added references\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP02(2020)108\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP02(2020)108\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
