                    "\"Thu, 17 Nov 2011 16:45:33 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 11 Jan 2012 16:00:04 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
