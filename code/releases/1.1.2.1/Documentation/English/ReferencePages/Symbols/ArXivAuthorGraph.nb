                 "\"Max Downing and Gerard Watts\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Free fermions, KdV charges, generalised Gibbs ensembles, \
modular\\n  transforms and line defects\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
