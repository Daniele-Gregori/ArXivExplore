                    RowBox[{
                    "\"Forbes\"", ",", "\"Michael McNeil\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Zhitnitsky\"", ",", "\"Ariel R.\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
