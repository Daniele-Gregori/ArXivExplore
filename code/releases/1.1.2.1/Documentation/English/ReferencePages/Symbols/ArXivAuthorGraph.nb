                "\"title\"", "\[Rule]", 
                 "\"Glueball and meson propagators of any spin in large-N QCD\
\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"31 pages; new references, added comments on infinite \
contact terms,\\n  minor changes\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl. Phys. B 875 (2013) 621\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.nuclphysb.2013.07.023\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
