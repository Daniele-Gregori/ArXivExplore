                "\"title\"", "\[Rule]", 
                 "\"Scattering of Giant Magnons in CP^3\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"29 pages; v2: minor corrections; v3: minor corrections, \
references\\n  added ; v4: minor corrections ; v5: minor corrections based on \
the published\\n  version\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 1002:085,2010\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP02(2010)085\""}]}, {
               
