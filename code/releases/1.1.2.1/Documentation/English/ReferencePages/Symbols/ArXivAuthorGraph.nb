               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Hypermultiplet dependence of one-loop effective action in \
the ${\\\\cal\\n  N}=2$ superconformal theories\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"29 pages, 1 figure, JHEP style\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0704:096,2007\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2007/04/096\""}]}, {
