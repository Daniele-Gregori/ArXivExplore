               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"B. Eden, C. Jarczak, and E. Sokatchev\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"A three-loop test of the dilatation operator in N=4 \
SYM\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"38 pages LaTeX, 4 figures, references added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys. B712 (2005) 157-195\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.nuclphysb.2005.01.036\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
                 "\"AEI-2004-067, ROM2F-04/09, LAPTH-1061/04\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We compute the three-loop anomalous dimension of the \
BMN operators with\\ncharges J=0 (the Konishi multiplet) and J=1 in N=4 \
super-Yang-Mills theory. We\\nemploy a method which effectively reduces the \
calculation to two loops. Instead\\nof using the superconformal primary \
states, we consider the ratio of the\\ntwo-point functions of suitable \
descendants of the corresponding multiplets.\\n  Our results unambiguously \
select the form of the N=4 SYM dilatation operator\\nwhich is compatible with \
BMN scaling. Thus, we provide evidence for BMN scaling\\nat three \
loops.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
