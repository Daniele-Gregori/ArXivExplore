               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Mass-deformed ABJM and Black Holes in AdS$_4$\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"67 pages, 7 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP03(2018)050\""}]}, {
