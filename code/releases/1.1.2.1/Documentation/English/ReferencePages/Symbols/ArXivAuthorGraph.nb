               RowBox[{"\"authors\"", "\[Rule]", "\"Shijong Ryang\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"The SU(1|2) and SU(2|2) Sectors from Superstrings in AdS5 \
x S5\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"17 pages, LaTeX, no figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0608:028,2006\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2006/08/028\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  For the \\\\kappa-symmetry gauge fixed superstring \
action in AdS_5 x S^5 we\\nconsider the fermionic fluctuations over a \
circular bosonic string background\\nwith two angular momenta and two winding \
numbers in S^5. The SU(2)-type\\nredefinitions of fermionic fields and the \
first-string limit generate a\\ntruncated fermionic action for the SU(1|2) \
sector. It is expressed in a\\ntwo-dimensional Lorentz-invariant form of a \
massive Dirac fermion and the\\nplane-wave spectrum for the fermionic \
excitations is derived. The fermionic\\nspectrum for the SU(2|2) sector is \
also analyzed.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 3 Apr 2006 02:37:53 GMT\""}]}], "}"}], "}"}]}]}, {
              
               RowBox[{"\"update_date\"", "\[Rule]", "\"2010-02-03\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{"\"Ryang\"", ",", "\"Shijong\"", ",", "\"\""}], 
                    "}"}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
             Left, ColumnAlignments -> Left], Column], 
