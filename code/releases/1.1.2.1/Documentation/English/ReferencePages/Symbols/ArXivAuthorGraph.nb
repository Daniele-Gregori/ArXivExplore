                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 13 Nov 2019 18:42:56 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2019-11-14\""}]}, {
