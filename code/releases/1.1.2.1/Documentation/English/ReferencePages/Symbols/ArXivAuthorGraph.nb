        TagBox[
         TooltipBox[DiskBox[{18.320481900810787`, -2.505016614958153}, 0.],
          TagBox[
           TagBox[
            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0402202\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Hong Lu\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Z.-W. Chong, H. Lu and C.N. Pope\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Rotating Strings in Massive Type IIA Supergravity\""}]}, {
              
               RowBox[{"\"comments\"", "\[Rule]", "\"Latex, 14 pages\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"MIFP-04-03\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  Massive type IIA supergravity admits a warped AdS_6 x \
S^4 vacuum solution,\\nwhich is expected to be dual to an N=2, D=5 \
super-conformal Yang-Mills theory.\\nWe study solutions for strings rotating \
or spinning in this background. The\\nwarp factor plays no essential role \
when the string spins in the AdS_6,\\nimplying a commonality in the leading \
Regge trajectories between the D=4 and\\nD=5 super-conformal field theories. \
The warp factor does, however, become\\nimportant when the string rotates in \
the S^4, in particular for long strings,\\nwhich have the the relation E- \
3J/2=c_1 + c_2/J^5+..., where the angular\\nmomentum J is large. This \
relation is qualitatively different from that for\\nlong strings in the AdS_5 \
x S^5 background. We also study Penrose limits of the\\nAdS_6 x S^4 solution, \
one of which gives rise to a free massive string theory\\nwith time-dependent \
masses.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 25 Feb 2004 17:58:03 GMT\""}]}], "}"}], "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2007-05-23\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Chong\"", ",", "\"Z. -W.\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Lu\"", ",", "\"H.\"", ",", "\"\""}], "}"}], 
                    ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Pope\"", ",", "\"C. N.\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
             Left, ColumnAlignments -> Left], Column], 
           Function[BoxForm`e$, 
            TableForm[BoxForm`e$]]]],
         Annotation[#, 
          
          TableForm[{
           "id" -> "hep-th/0402202", "submitter" -> "Hong Lu", "authors" -> 
            "Z.-W. Chong, H. Lu and C.N. Pope", "title" -> 
            "Rotating Strings in Massive Type IIA Supergravity", "comments" -> 
            "Latex, 14 pages", "journal-ref" -> Null, "doi" -> Null, 
            "report-no" -> "MIFP-04-03", "categories" -> "hep-th", "license" -> 
            Null, "abstract" -> 
            "  Massive type IIA supergravity admits a warped AdS_6 x S^4 \
vacuum solution,\nwhich is expected to be dual to an N=2, D=5 super-conformal \
Yang-Mills theory.\nWe study solutions for strings rotating or spinning in \
this background. The\nwarp factor plays no essential role when the string \
spins in the AdS_6,\nimplying a commonality in the leading Regge trajectories \
between the D=4 and\nD=5 super-conformal field theories. The warp factor \
does, however, become\nimportant when the string rotates in the S^4, in \
particular for long strings,\nwhich have the the relation E- 3J/2=c_1 + \
c_2/J^5+..., where the angular\nmomentum J is large. This relation is \
qualitatively different from that for\nlong strings in the AdS_5 x S^5 \
background. We also study Penrose limits of the\nAdS_6 x S^4 solution, one of \
which gives rise to a free massive string theory\nwith time-dependent masses.\
\n", "versions" -> {{
              "version" -> "v1", "created" -> 
               "Wed, 25 Feb 2004 17:58:03 GMT"}}, "update_date" -> 
            "2007-05-23", 
            "authors_parsed" -> {{"Chong", "Z. -W.", ""}, {"Lu", "H.", ""}, {
              "Pope", "C. N.", ""}}}], "Tooltip"]& ], 
