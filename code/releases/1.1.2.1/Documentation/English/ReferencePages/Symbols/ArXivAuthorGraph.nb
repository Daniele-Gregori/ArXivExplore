               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Alessandro Pini, Paolo Vallarino\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Integrated correlators at strong coupling in an orbifold \
of\\n  $\\\\mathcal{N}=4$ SYM\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
