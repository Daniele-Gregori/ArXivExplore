               RowBox[{"\"submitter\"", "\[Rule]", "\"Cyril Malyshev\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"C. Malyshev, N. M. Bogoliubov\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Heisenberg XX chain, non-homogeneously parameterised \
generating\\n  exponential, and diagonally restricted plane partitions\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"43 pages, 5 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
