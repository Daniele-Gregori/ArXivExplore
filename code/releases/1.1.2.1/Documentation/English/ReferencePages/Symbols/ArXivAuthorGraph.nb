            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0409217\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Shijong Ryang\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Shijong Ryang\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Circular and Folded Multi-Spin Strings in Spin Chain \
Sigma Models\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"16 pages, LaTeX, no figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP0410:059,2004\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2004/10/059\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  From the SU(2) spin chain sigma model at the one-loop \
and two-loop orders we\\nrecover the classical circular string solution with \
two S^5 spins (J_1, J_2) in\\nthe AdS_5 x S^5 string theory. In the SL(2) \
sector of the one-loop spin chain\\nsigma model we explicitly construct a \
solution which corresponds to the folded\\nstring solution with one AdS_5 \
spin S and one S^5 spin J. In the one-loop\\ngeneral sigma model we \
demonstrate that there exists a solution which\\nreproduces the energy of the \
circular constant-radii string solution with three\\nspins (S_1, S_2, \
J).\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 22 Sep 2004 02:26:51 GMT\""}]}], "}"}], "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2008-11-26\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{"\"Ryang\"", ",", "\"Shijong\"", ",", "\"\""}], 
                    "}"}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
