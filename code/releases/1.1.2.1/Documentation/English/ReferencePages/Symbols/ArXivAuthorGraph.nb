               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Yangian symmetry of scattering amplitudes in N=4 super \
Yang-Mills theory\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"23 pages, no figures; v2: typos corrected, references \
added; v3:\\n  minor changes, references added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0905:046,2009\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2009/05/046\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
                 "\"HU-EP-09/06; LAPTH-1308/09\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
