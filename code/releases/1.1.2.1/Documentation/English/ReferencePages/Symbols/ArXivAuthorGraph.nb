                 "\"Quantum Spectral Curve for a Cusped Wilson Line in N=4 \
SYM\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"42 pages, 4 figures; supplementary Mathematica files are \
attached\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 1604 (2016) 134\""}]}, {
              
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP04(2016)134\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
