               RowBox[{
                "\"authors\"", "\[Rule]", "\"Nathan Haouzi, Jihwan Oh\""}]}, {
              
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On the Quantization of Seiberg-Witten Geometry\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"60 pages, 2 figures; v2: some typos corrected, references \
added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP01(2021)184\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", 
                 "\"hep-th math-ph math.MP math.QA\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We propose a double quantization of four-dimensional ${\
\\\\cal N}=2$\\nSeiberg-Witten geometry, for all classical gauge groups and a \
wide variety of\\nmatter content. This can be understood as a set of certain \
non-perturbative\\nSchwinger-Dyson identities, following the program \
initiated by Nekrasov\\n[arXiv:1512.05388]. The construction relies on the \
computation of the instanton\\npartition function of the gauge theory on the \
so-called $\\\\Omega$-background on\\n$\\\\mathbb{R}^4$, in the presence of \
half-BPS codimension 4 defects. The two\\nquantization parameters are \
identified as the two parameters of this\\nbackground. The Seiberg-Witten \
curve of each theory is recovered in the flat\\nspace limit. Whenever \
possible, we motivate our construction from type IIA\\nstring \
theory.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
