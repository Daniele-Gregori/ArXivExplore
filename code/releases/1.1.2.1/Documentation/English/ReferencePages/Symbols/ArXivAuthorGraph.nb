               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Quantum folded string in S^5 and the Konishi multiplet at \
strong\\n  coupling\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"17 pages, 5 eps figures\""}]}, {
              
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP10(2011)040\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
