               RowBox[{"\"submitter\"", "\[Rule]", "\"Stefano Bellucci\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"S. Bellucci, P.-Y. Casteill\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Sigma model from SU(1,1|2) spin chain\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"20 pages, no figures, 4 tables, 1 appendix; typos \
corrected,\\n  references added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys.B741:297-312,2006\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
