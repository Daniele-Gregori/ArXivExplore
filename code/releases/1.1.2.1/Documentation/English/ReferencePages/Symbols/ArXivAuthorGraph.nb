               RowBox[{"\"id\"", "\[Rule]", "\"0801.3671\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Pedro Vieira G.\""}]}, {
              
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
