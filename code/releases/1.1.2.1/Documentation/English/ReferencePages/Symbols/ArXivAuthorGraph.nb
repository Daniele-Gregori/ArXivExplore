                "\"comments\"", "\[Rule]", 
                 "\"11 pages, no figures, incorrect subsection removed, typos \
fixed,\\n  references added and updated\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys. Rev. D 84, 086009 (2011)\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1103/PhysRevD.84.086009\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"TUW-11-11\""}]}, {
