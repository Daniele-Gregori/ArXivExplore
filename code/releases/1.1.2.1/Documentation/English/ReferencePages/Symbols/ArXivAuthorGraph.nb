                "\"title\"", "\[Rule]", 
                 "\"The low energy limit of the AdS(3) x S(3) x M(4) spinning \
string\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"13 pages\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP10(2013)111\""}]}, {
               
