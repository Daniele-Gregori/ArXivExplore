                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 24 Feb 1999 10:59:34 GMT\""}]}], "}"}]}], 
                    "}"}]}]}, {
                RowBox[{"\"update_date\"", "\[Rule]", "\"2009-09-17\""}]}, {
                RowBox[{"\"authors_parsed\"", "\[Rule]", 
                  RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
