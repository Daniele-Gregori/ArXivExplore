                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 26 Jul 1999 16:47:05 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
