               RowBox[{"\"authors\"", "\[Rule]", "\"Shijong Ryang\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Folded Three-Spin String Solutions in AdS_5 x S^5\""}]}, {
              
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"14 pages, LaTeX, no figures, a reference added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0404 (2004) 053\""}]}, {
              
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2004/04/053\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We construct a spinning closed string solution in AdS_5 \
x S^5 which is folded\\nin the radial direction and has two equal spins in \
AdS_5 and a spin in S^5. The\\nenergy expression of the three-spin solution \
specified by the folding and\\nwinding numbers for the small S^5 spin shows a \
logarithmic behavior and a\\none-third power behavior of the large total \
AdS_5 spin, in the long string and\\nin the short string located near the \
boundary of AdS_5 respectively. It\\nexhibits the non-regular expansion in \
the 't Hooft coupling constant, while it\\ntakes the regular one when the S^5 \
spin becomes large.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
