               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0412312\""}]}, {
               
               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Yoshihisa Kitazawa\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Y. Kitazawa, Y. Takayama and D. Tomino\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Wilson Line Correlators in N=4 Non-commutative Gauge \
Theory on S^2 x S^2\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"33 pages, latex file,references added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys.B715:665-694,2005\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.nuclphysb.2005.02.022\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"KEK-TH-1002\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We investigate the Wilson line correlators dual to \
supergravity multiplets in\\nN=4 non-commutative gauge theory on S^2 x S^2. \
We find additional non-analytic\\ncontributions to the correlators due to \
UV/IR mixing in comparison to ordinary\\ngauge theory. Although they are no \
longer BPS off shell, their renormalization\\neffects are finite as long as \
they carry finite momenta. We propose a\\nrenormalization procedure to obtain \
local operators with no anomalous\\ndimensions in perturbation theory. We \
reflect on our results from dual\\nsupergravity point of view. We show that \
supergravity can account for both IR\\nand UV/IR contributions.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
