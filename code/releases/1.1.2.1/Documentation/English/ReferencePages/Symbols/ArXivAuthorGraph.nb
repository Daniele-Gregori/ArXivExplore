                    "\"Tue, 7 Nov 2017 14:03:40 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 8 Nov 2017 18:33:57 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
