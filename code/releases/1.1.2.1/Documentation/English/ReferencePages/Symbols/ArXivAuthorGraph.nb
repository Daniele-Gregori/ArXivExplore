               RowBox[{"\"submitter\"", "\[Rule]", "\"Kasper Peeters\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Kasper Peeters, Jan Plefka and Marija Zamaklar\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Splitting spinning strings in AdS/CFT\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"22 pages, 5 figures; v2: typo corrected\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP0411:054,2004\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2004/11/054\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"AEI-2004-094\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We study the semiclassical decay of macroscopic \
spinning strings in AdS_5 x\\nS^5 through spontaneous splitting of the folded \
string worldsheet. Based on\\nsimilar considerations in flat space this decay \
channel is expected to dominate\\nthe full quantum computation. The outgoing \
strings are uniquely specified by an\\ninfinite set of conserved (local) \
charges with a regular expansion in inverse\\npowers of the initial angular \
momentum. We compute these charges and determine\\nfunctional relations \
between them. Finally, a preliminary discussion of the\\ncorresponding \
calculation in the non-planar sector of the dual gauge theory is\\npresented.\
\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
