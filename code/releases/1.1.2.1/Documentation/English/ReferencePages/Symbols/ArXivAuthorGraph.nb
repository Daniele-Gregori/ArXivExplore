reflection matrices\""}]}, {
                RowBox[{"\"comments\"", "\[Rule]", "\"19 pages\""}]}, {
                
                RowBox[{
                 "\"journal-ref\"", "\[Rule]", "\"JHEP 05 (2021) 203\""}]}, {
                
