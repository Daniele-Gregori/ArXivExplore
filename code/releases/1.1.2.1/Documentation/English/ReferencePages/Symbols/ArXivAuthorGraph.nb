               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Probing Near Extremal Black Holes with D-branes\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"12 pages, 1 figure. v2: References added. v3: Remark \
about the\\n  position of the horizon corrected\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys.Rev. D57 (1998) 3736-3741\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1103/PhysRevD.57.3736\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"RU-97-30\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We calculate the one loop effective action for D-brane \
probes moving in the\\npresence of near BPS D-branes. The $v^2$ term agrees \
with supergravity in all\\ncases and the static force agrees for a five \
dimensional black hole with two\\nlarge charges. It also agrees qualitatively \
in all the other cases. We make\\nsome comments on the M(atrix) theory \
interpretation of these results.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
