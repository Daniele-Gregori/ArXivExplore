               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Hiroaki Kanno, Katsuyuki Sugiyama, Yutaka Yoshida\""}]}, {
              
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Equivariant U(N) Verlinde algebra from Bethe/Gauge \
correspondence\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"45 pages, 4 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP02(2019)097\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"IPMU18-0106\""}]}, {
