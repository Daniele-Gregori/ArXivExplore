        TagBox[
         TooltipBox[DiskBox[{8.723389609165785, -6.383771739753376}, 0.],
          TagBox[
           TagBox[
            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"hep-ph/9705281\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Todd Fugleberg\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"T. Fugleberg, I. Halperin and A. Zhitnitsky\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Condensates and Vacuum Structure of Adjoint QCD_2\""}]}, {
              
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"17 pages, LaTeX2e, 3 figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys.B515:509-521,1998\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1016/S0550-3213(97)00776-1\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-ph hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We discuss a two dimensional SU(N) Yang-Mills theory \
coupled to massive\\nadjoint fermions for different worlds classified by the \
integer k=0,1,...N-1.\\nWe study the fermion condensate for these unconnected \
worlds as a function of\\nthe parameter k. We show that the condensate as \
well as the spectrum of the\\ntheory do depend on this vacuum parameter k. \
Technically, the value of the\\nfermion condensate is related to the value of \
the gluon condensate via the\\nOperator Product Expansion. We use this to \
find the leading dependence (in the\\nlimit of a heavy quark) of the fermion \
condensate on the nontrivial vacuum\\nangle k. We also determine the gluon \
condensate of the theory using low-energy\\ntheorems.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 9 May 1997 19:28:05 GMT\""}]}], "}"}], "}"}]}]}, {
              
               RowBox[{"\"update_date\"", "\[Rule]", "\"2010-02-09\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Fugleberg\"", ",", "\"T.\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Halperin\"", ",", "\"I.\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Zhitnitsky\"", ",", "\"A.\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
