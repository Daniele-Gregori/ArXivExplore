            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"2312.11085\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Roji Pius\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", "\"Krishna Jalan, Roji Pius\""}]}, {
              
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Half-sided Translations and Islands\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"31 pages, 14 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th gr-qc\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://creativecommons.org/licenses/by/4.0/\""}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  An AdS$_2$ black hole in equilibrium with a finite \
temperature\\nnon-gravitating bath comes with a Hawking-like information \
paradox. The\\nresolution of this paradox requires introducing an island for \
the bath after\\nthe Page time. Since the island region contains the black \
hole interior, the\\nconsistency of the island paradigm demands the failure \
of any interior\\nreconstruction proposal that uses only the operators in the \
AdS$_2$ region\\noutside the black hole horizon after the Page time. In this \
paper, we\\ninvestigate the consistency of the island paradigm using the \
black hole\\ninterior reconstruction proposal due to Leutheusser and Liu. \
They argued that\\nthe operators in the interior of a black hole can be \
reconstructed by the\\nhalf-sided translations of the operators outside the \
black hole horizon.\\nHowever, in order to illustrate the island paradigm we \
need to modify the\\nLeutheusser-Liu proposal by introducing the notion of \
the reduced half-sided\\ntranslations. The reduced half-sided translations, \
unlike the half-sided\\ntranslations, have non-trivial action only on the \
operators in the AdS$_2$\\nblack hole region. As a result, the reconstructed \
interior operators are\\nexpressed only using the operators in the AdS$_2$ \
region outside the black hole\\nhorizon. We demonstrate the consistency of \
the island paradigm by showing that\\nthe reduced half-sided translations \
which successfully reconstruct the\\noperators in the black hole interior \
before the Page time become trivial after\\nthe Page time, and hence fail to \
reconstruct the interior operators after the\\nPage time.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 18 Dec 2023 10:25:53 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 1 Apr 2024 07:18:10 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2024-04-02\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Jalan\"", ",", "\"Krishna\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Pius\"", ",", "\"Roji\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
             Left, ColumnAlignments -> Left], Column], 
           Function[BoxForm`e$, 
            TableForm[BoxForm`e$]]]],
         Annotation[#, 
          
          TableForm[{
           "id" -> "2312.11085", "submitter" -> "Roji Pius", "authors" -> 
            "Krishna Jalan, Roji Pius", "title" -> 
            "Half-sided Translations and Islands", "comments" -> 
            "31 pages, 14 figures", "journal-ref" -> Null, "doi" -> Null, 
            "report-no" -> Null, "categories" -> "hep-th gr-qc", "license" -> 
            "http://creativecommons.org/licenses/by/4.0/", "abstract" -> 
            "  An AdS$_2$ black hole in equilibrium with a finite temperature\
\nnon-gravitating bath comes with a Hawking-like information paradox. The\n\
resolution of this paradox requires introducing an island for the bath after\n\
the Page time. Since the island region contains the black hole interior, the\n\
consistency of the island paradigm demands the failure of any interior\n\
reconstruction proposal that uses only the operators in the AdS$_2$ region\n\
outside the black hole horizon after the Page time. In this paper, we\n\
investigate the consistency of the island paradigm using the black hole\n\
interior reconstruction proposal due to Leutheusser and Liu. They argued that\
\nthe operators in the interior of a black hole can be reconstructed by the\n\
half-sided translations of the operators outside the black hole horizon.\n\
However, in order to illustrate the island paradigm we need to modify the\n\
Leutheusser-Liu proposal by introducing the notion of the reduced half-sided\n\
translations. The reduced half-sided translations, unlike the half-sided\n\
translations, have non-trivial action only on the operators in the AdS$_2$\n\
black hole region. As a result, the reconstructed interior operators are\n\
expressed only using the operators in the AdS$_2$ region outside the black \
hole\nhorizon. We demonstrate the consistency of the island paradigm by \
showing that\nthe reduced half-sided translations which successfully \
reconstruct the\noperators in the black hole interior before the Page time \
become trivial after\nthe Page time, and hence fail to reconstruct the \
interior operators after the\nPage time.\n", 
            "versions" -> {{
              "version" -> "v1", "created" -> 
               "Mon, 18 Dec 2023 10:25:53 GMT"}, {
              "version" -> "v2", "created" -> 
               "Mon, 1 Apr 2024 07:18:10 GMT"}}, "update_date" -> 
            "2024-04-02", 
            "authors_parsed" -> {{"Jalan", "Krishna", ""}, {
              "Pius", "Roji", ""}}}], "Tooltip"]& ], 
