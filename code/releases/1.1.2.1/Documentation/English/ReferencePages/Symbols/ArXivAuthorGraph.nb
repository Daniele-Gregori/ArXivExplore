               "Tue, 29 Apr 2008 09:16:06 GMT"}}, "update_date" -> 
            "2008-12-18", 
            "authors_parsed" -> {{"Beisert", "N.", ""}, {
              "Spill", "F.", ""}}}], "Tooltip"]& ], 
