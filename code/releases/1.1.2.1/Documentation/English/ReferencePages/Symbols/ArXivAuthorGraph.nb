            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"1010.1264\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Joe Polchinski\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Idse Heemskerk and Joseph Polchinski\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Holographic and Wilsonian Renormalization Groups\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"31 pages, 3 figures. v2: Minor clarifications. Added \
references\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 1106:031,2011\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP06(2011)031\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
