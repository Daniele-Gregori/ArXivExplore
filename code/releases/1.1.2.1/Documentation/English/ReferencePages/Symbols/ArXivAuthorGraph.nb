                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Janik\"", ",", "\"Romuald A.\"", ",", "\"\""}],
                     "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Laskos-Grabowski\"", ",", "\"Pawel\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
