               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0210256\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Yuri Makeenko\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Yuri Makeenko\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Light-Cone Wilson Loops and the String/Gauge \
Correspondence\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"17pp., Latex, 4 figures; v.2: factors of 2 put \
right\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0301 (2003) 007\""}]}, {
              
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2003/01/007\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"ITEP-TH-54/02\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We investigate a \\\\Pi-shape Wilson loop in N=4 super \
Yang--Mills theory, which\\nlies partially at the light-cone, and consider an \
associated open superstring\\nin AdS_5 x S^5. We discuss how this Wilson loop \
determines the anomalous\\ndimensions of conformal operators with large \
Lorentz spin and present an\\nexplicit calculation in perturbation theory to \
order \\\\lambda. We find the\\nminimal surface in the supergravity \
approximation, that reproduces the Gubser,\\nKlebanov and Polyakov prediction \
for the anomalous dimensions at large\\n\\\\lambda=g_YM^2 N, and discuss its \
quantum-mechanical interpretation.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
