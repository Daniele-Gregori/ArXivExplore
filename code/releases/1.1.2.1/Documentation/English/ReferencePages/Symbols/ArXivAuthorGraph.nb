               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"$SL(2, Z)$ invariant rotating $(m,n)$ strings in $AdS_3\\\
\\times S^3$ with\\n  mixed flux\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"21 pages, added reference, minor changes\""}]}, {
