               RowBox[{"\"title\"", "\[Rule]", "\"The Quench Action\""}]}, {
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"Article for the JSTAT special issue: Quantum \
Integrability in Out of\\n  Equilibrium Systems\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"J. Stat. Mech. (2016) 064006\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1088/1742-5468/2016/06/064006\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
