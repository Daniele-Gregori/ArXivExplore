               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We prove the universality of the Hernandez-Lopez phase \
by deriving it from\\nfirst principles. We find a very simple integral \
representation for the phase\\nand discuss its possible origin from a nested \
Bethe ansatz structure.\\nHopefully, the same kind of derivation could be \
used to constrain higher orders\\nof the full quantum dressing \
factor.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
