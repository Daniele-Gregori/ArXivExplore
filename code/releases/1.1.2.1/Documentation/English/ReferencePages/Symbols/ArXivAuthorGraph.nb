                "\"title\"", "\[Rule]", 
                 "\"The planar limit of ${\\\\cal N}=2$ chiral \
correlators\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"25 pages. v2 : added reference\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
