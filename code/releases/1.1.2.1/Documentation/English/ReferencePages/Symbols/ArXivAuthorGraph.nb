               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"One-Loop Non-Planar Anomalous Dimensions in Super \
Yang-Mills Theory\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"41 pages, 10 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP10(2020)124\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
