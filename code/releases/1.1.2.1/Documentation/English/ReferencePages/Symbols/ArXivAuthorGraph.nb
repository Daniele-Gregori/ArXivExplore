                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 19 Aug 2014 17:09:07 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
