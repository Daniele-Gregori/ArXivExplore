                    RowBox[{"\"Wang\"", ",", "\"Yifan\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Wen\"", ",", "\"Congkao\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
             Left, ColumnAlignments -> Left], Column], 
           Function[BoxForm`e$, 
            TableForm[BoxForm`e$]]]],
         Annotation[#, 
          
          TableForm[{
           "id" -> "2008.02713", "submitter" -> "Shai Chester", "authors" -> 
            "Shai M. Chester, Michael B. Green, Silviu S. Pufu, Yifan Wang, \
and\n  Congkao Wen", "title" -> 
            "New Modular Invariants in $\\mathcal{N}=4$ Super-Yang-Mills \
Theory", "comments" -> "33 pages plus appendices, v2 accepted to JHEP", 
            "journal-ref" -> Null, "doi" -> "10.1007/JHEP04(2021)212", 
            "report-no" -> "PUPT-2620, QMUL-PH-20-16", "categories" -> 
            "hep-th", "license" -> 
            "http://arxiv.org/licenses/nonexclusive-distrib/1.0/", "abstract" -> 
            "  We study modular invariants arising in the four-point \
functions of the stress\ntensor multiplet operators of the ${\\cal N} = 4$ \
$SU(N)$ super-Yang-Mills\ntheory, in the limit where $N$ is taken to be large \
while the complexified\nYang-Mills coupling $\\tau$ is held fixed. The \
specific four-point functions we\nconsider are integrated correlators \
obtained by taking various combinations of\nfour derivatives of the squashed \
sphere partition function of the ${\\cal N} =\n2^*$ theory with respect to \
the squashing parameter $b$ and mass parameter $m$,\nevaluated at the values \
$b=1$ and $m=0$ that correspond to the ${\\cal N} = 4$\ntheory on a round \
sphere. At each order in the $1/N$ expansion, these fourth\nderivatives are \
modular invariant functions of $(\\tau, \\bar \\tau)$. We present\nevidence \
that at half-integer orders in $1/N$, these modular invariants are\nlinear \
combinations of non-holomorphic Eisenstein series, while at integer\norders \
in $1/N$, they are certain \"generalized Eisenstein series\" which satisfy\n\
inhomogeneous Laplace eigenvalue equations on the hyperbolic plane. These\n\
results reproduce known features of the low-energy expansion of the\n\
four-graviton amplitude in type IIB superstring theory in ten-dimensional \
flat\nspace and have interesting implications for the structure of the \
analogous\nexpansion in $AdS_5\\times S^5$.\n", 
            "versions" -> {{
              "version" -> "v1", "created" -> 
               "Thu, 6 Aug 2020 15:30:52 GMT"}, {
              "version" -> "v2", "created" -> 
               "Thu, 29 Apr 2021 07:22:42 GMT"}}, "update_date" -> 
            "2021-05-12", 
            "authors_parsed" -> {{"Chester", "Shai M.", ""}, {
              "Green", "Michael B.", ""}, {"Pufu", "Silviu S.", ""}, {
              "Wang", "Yifan", ""}, {"Wen", "Congkao", ""}}}], "Tooltip"]& ], 
        
