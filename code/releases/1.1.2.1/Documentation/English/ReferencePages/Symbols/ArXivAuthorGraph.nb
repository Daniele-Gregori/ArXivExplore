               RowBox[{"\"submitter\"", "\[Rule]", "\"James Edwards Dr\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Naser Ahmadiniaz, Olindo Corradini, James P. Edwards, \
Pablo Pisani\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"$U(N)$ Yang-Mills in non-commutative space time\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"38 pages\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP04(2019)067\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", "\"hep-th math-ph math.MP\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We present an approach to $U_\\\\star(N)$ Yang-Mills \
theory in non-commutative\\nspace based upon a novel phase-space analysis of \
the dynamical fields with\\nadditional auxiliary variables that generate \
Lorentz structure and colour\\ndegrees of freedom. To illustrate this \
formalism we compute the quadratic terms\\nin the effective action focusing \
on the planar divergences so as to extract the\\n$\\\\beta$-function for the \
Yang-Mills coupling constant. Nonetheless the method\\npresented is general \
and can be applied to calculate the effective action at\\narbitrary order of \
expansion in the coupling constant, including both planar\\nand non-planar \
contributions, and is well suited to the computation of low\\nenergy one-loop \
scattering amplitudes.\\n\""}]}, {
