               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"205 pages, lots of figures. PhD thesis, partially based \
on\\n  arXiv:1708.02894. Contains abstract in German. v2: updated references \
and\\n  fixed typos\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
