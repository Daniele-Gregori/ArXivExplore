          Annotation[#, 
           
           TableForm[{
            "id" -> "1502.01942", "submitter" -> "Xinyi Chen-Lin", "authors" -> 
             "Xinyi Chen-Lin and Konstantin Zarembo", "title" -> 
             "Higher Rank Wilson Loops in N = 2* Super-Yang-Mills Theory", 
             "comments" -> "33 pages, 6 figures. v2: a new reference added", 
             "journal-ref" -> Null, "doi" -> Null, "report-no" -> Null, 
             "categories" -> "hep-th", "license" -> 
             "http://arxiv.org/licenses/nonexclusive-distrib/1.0/", 
             "abstract" -> 
             "  The N=2* Super-Yang-Mills theory (SYM*) undergoes an infinite \
sequence of\nlarge-N quantum phase transitions. We compute expectation values \
of Wilson\nloops in k-symmetric and antisymmetric representations of the \
SU(N) gauge group\nin this theory and show that the same phenomenon that \
causes the phase\ntransitions at finite coupling leads to a non-analytic \
dependence of Wilson\nloops on k/N when the coupling is strictly infinite, \
thus making the\nhigher-representation Wilson loops ideal holographic probes \
of the non-trivial\nphase structure of SYM*.\n", 
             "versions" -> {{
               "version" -> "v1", "created" -> 
                "Fri, 6 Feb 2015 16:40:04 GMT"}, {
               "version" -> "v2", "created" -> 
                "Fri, 13 Feb 2015 14:58:29 GMT"}}, "update_date" -> 
             "2015-02-16", 
             "authors_parsed" -> {{"Chen-Lin", "Xinyi", ""}, {
               "Zarembo", "Konstantin", ""}}}], "Tooltip"]& ]}, 
