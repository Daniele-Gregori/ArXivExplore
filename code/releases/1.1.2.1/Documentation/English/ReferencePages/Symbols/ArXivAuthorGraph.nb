                "\"comments\"", "\[Rule]", 
                 "\"40 pages, 2 figures, LaTeX, typos corrected, references \
added,\\n  further clarification\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP08(2013)013\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"KUNS-2451\""}]}, {
               
