               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"14 pages. v2: minor changes, references added. v3: \
references added\\n  and updated\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0407:004,2004\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2004/07/004\""}]}, {
