                "\"authors\"", "\[Rule]", 
                 "\"Alejandro Barranco and Jorge G. Russo\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Large N phase transitions in supersymmetric Chern-Simons \
theory with\\n  massive matter\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"15 pages, 6 figures. V2: new equation for Wilson loop \
added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP03(2014)012\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"ICCUB-14-002\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We study three-dimensional {\\\\cal N}=2 U(N) \
Chern-Simons theory on S^3 coupled\\nto 2N_f chiral multiplets deformed by \
mass terms. The partition function\\nlocalizes to a matrix integral, which \
can be exactly computed in the large N\\nlimit. In a specific \
decompactification limit, the theory exhibits quantum\\n(third-order) phase \
transitions at finite critical values of the coupling. The\\ntheory presents \
three phases when 0 < N_f < N and two phases when N_f\\\\geq N.\\nThe vacuum \
expectation value of the supersymmetric circular Wilson loop has \
a\\ndiscontinuity in the first derivative.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 15 Jan 2014 17:03:20 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 21 Jan 2014 16:58:03 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2015-06-18\""}]}, {
