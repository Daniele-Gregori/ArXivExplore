                    RowBox[{"{", 
                    RowBox[{"\"Guica\"", ",", "\"Monica\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Monten\"", ",", "\"Ruben\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
