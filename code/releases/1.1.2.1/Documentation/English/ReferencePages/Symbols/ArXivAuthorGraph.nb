               RowBox[{"\"submitter\"", "\[Rule]", "\"Nathan Haouzi\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Nathan Haouzi\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Quantum Geometry and $\\\\theta$-Angle in \
Five-Dimensional Super Yang-Mills\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"36 pages, 4 figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 09 (2020) 35\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP09(2020)035\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
