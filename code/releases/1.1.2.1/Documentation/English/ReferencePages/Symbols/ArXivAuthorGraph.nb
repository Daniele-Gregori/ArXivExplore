                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 8 May 2006 13:54:50 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
