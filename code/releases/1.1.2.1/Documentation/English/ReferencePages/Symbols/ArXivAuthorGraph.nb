               RowBox[{"\"submitter\"", "\[Rule]", "\"Ian Moult\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Ian Moult and Hua Xing Zhu\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Simplicity from Recoil: The Three-Loop Soft Function and \
Factorization\\n  for the Energy-Energy Correlation\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"32 pages, 3 figures v2. Updated several typos in the \
text. v3. Final\\n  published version. Minor typos updated\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP08(2018)160\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", "\"hep-ph hep-th nucl-th\""}]}, {
              
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We derive an operator based factorization theorem for \
the energy-energy\\ncorrelation (EEC) observable in the back-to-back region, \
allowing the cross\\nsection to be written as a convolution of hard, jet and \
soft functions. We\\nprove the equivalence of the soft functions for the EEC \
and color singlet\\ntransverse-momentum resummation to all-loop order, and \
give their analytic\\nresult to three-loops. Large logarithms appearing in \
the perturbative expansion\\nof the EEC can be resummed to all orders using \
renormalization group evolution.\\nWe give analytic results for all required \
anomalous dimensions to three-loop\\norder, providing the first example of a \
transverse-momentum (recoil) sensitive\\n$e^+e^-$ event shape whose anomalous \
dimensions are known at this order. The\\nEEC can now be computed to \
next-to-next-to-next-to-leading logarithm matched \
to\\nnext-to-next-to-leading order, making it a prime candidate for precision \
QCD\\nstudies and extractions of the strong coupling constant. We anticipate \
that our\\nfactorization theorem will also be crucial for understanding \
non-perturbative\\npower corrections for the EEC, and their relationship to \
those appearing in\\nother observables.\\n\""}]}, {
