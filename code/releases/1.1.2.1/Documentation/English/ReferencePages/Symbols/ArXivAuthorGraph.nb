                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 8 May 2019 14:49:21 GMT\""}]}], "}"}], "}"}]}]}, {
              
