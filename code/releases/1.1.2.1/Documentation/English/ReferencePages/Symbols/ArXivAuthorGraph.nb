          Annotation[#, 
           
           TableForm[{
            "id" -> "1011.4005", "submitter" -> "Marco Rossi", "authors" -> 
             "Davide Fioravanti, Paolo Grinza and Marco Rossi", "title" -> 
             "Beyond cusp anomalous dimension from integrability in SYM$_4$", 
             "comments" -> 
             "5 pages, contribution to the proceedings of the workshop \
Diffraction\n  2010, Otranto, 10th-15th September, talk given by M.Rossi; v2: \
references\n  added", "journal-ref" -> "AIP Conf.Proc.1350:233-236,2011", 
             "doi" -> "10.1063/1.3601414", "report-no" -> Null, "categories" -> 
             "hep-th", "license" -> 
             "http://arxiv.org/licenses/nonexclusive-distrib/1.0/", 
             "abstract" -> 
             "  We study the first sub-leading correction $O((\\ln s)^0)$ to \
the cusp\nanomalous dimension in the high spin expansion of finite twist \
operators in\n${\\cal N}=4$ SYM theory. This term is still governed by a \
linear integral\nequation which we study in the weak and strong coupling \
regimes. In the strong\ncoupling regime we find agreement with the string \
theory computations\n", 
             "versions" -> {{
               "version" -> "v1", "created" -> 
                "Wed, 17 Nov 2010 17:27:32 GMT"}, {
               "version" -> "v2", "created" -> 
                "Tue, 5 Jul 2011 07:01:14 GMT"}}, "update_date" -> 
             "2011-07-26", 
             "authors_parsed" -> {{"Fioravanti", "Davide", ""}, {
               "Grinza", "Paolo", ""}, {"Rossi", "Marco", ""}}}], 
           "Tooltip"]& ]}, 
