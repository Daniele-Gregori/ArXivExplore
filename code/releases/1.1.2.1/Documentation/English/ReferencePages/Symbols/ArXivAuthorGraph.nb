                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Sun, 25 Sep 2011 14:15:15 GMT\""}]}], "}"}], "}"}]}]}, {
