               RowBox[{"\"authors\"", "\[Rule]", "\"Shijong Ryang\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Three-Spin Giant Magnons in AdS_5xS^5\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"12 pages, LaTeX, no figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP0612:043,2006\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2006/12/043\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  From the Polyakov string action using a conformal gauge \
we construct a\\nthree-spin giant magnon solution describing a long open \
string in AdS_5 \\\\times\\nS^5 which rotates both in two angular directions \
of S^5 and in one angular\\ndirection of AdS_5. Through the Virasoro \
constraints the string motion in AdS_5\\ntakes an effect from the string \
configuration in S^5. The dispersion relation\\nof the soliton solution is \
obtained as a superposition of two bound states of\\nmagnons. We show that \
there is a correspondence between a special giant magnon\\nin AdS_2 and the \
sinh-Gordon soliton.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 3 Oct 2006 02:39:14 GMT\""}]}], "}"}], "}"}]}]}, {
              
               RowBox[{"\"update_date\"", "\[Rule]", "\"2009-11-11\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{"\"Ryang\"", ",", "\"Shijong\"", ",", "\"\""}], 
                    "}"}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
