               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Sum Rules in the CFL Phase of QCD at finite \
density\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"13 pages, revtex, using epsfig. Typo in reference \
corrected\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
