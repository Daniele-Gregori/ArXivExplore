                "\"title\"", "\[Rule]", 
                 "\"Far Beyond the Planar Limit in Strongly-Coupled \
$\\\\mathcal{N}=4$ SYM\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"25 pages plus appendices, v2 submitted to JHEP, minor \
typos fixed\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
