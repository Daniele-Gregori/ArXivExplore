               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Daniel N. Blaschke, Harold Steinacker\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Curvature and Gravity Actions for Matrix Models II: the \
case of general\\n  Poisson structure\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"29 pages; v2 minor update\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Class.Quant.Grav.27:235019,2010\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1088/0264-9381/27/23/235019\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"UWThPh-2010-12\""}]}, {
