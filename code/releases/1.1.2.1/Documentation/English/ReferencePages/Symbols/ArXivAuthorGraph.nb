                 "\"Guzm\\\\'an Hern\\\\'andez-Chifflet\""}]}, {
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"John C. Donahue, Sergei Dubovsky, Guzm\\\\'an \
Hern\\\\'andez-Chifflet,\\n  Sergey Monin\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", "\"From QCD Strings to WZW\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"28 pages, 13 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP03(2019)120\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
