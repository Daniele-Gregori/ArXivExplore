               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Integrable deformations of AdS/CFT\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"v2: We corrected typos and added some references; v3: \
corrected\\n  crossing for AdS2 deformation\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP05(2022)012\""}]}, {
