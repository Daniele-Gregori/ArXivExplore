                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 3 Aug 2020 15:03:06 GMT\""}]}], "}"}], ",", 
