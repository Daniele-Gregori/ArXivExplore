                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  By direct calculation in classical theory we derive the \
central extension of\\nthe off-shell symmetry algebra for the string \
propagating in AdS_4 x CP^3. It\\nturns out to be the same as in the case of \
the AdS_5 x S^5 string. We also\\nelaborate on the kappa-symmetry gauge and \
explain, how it can be chosen in a\\nway which does not break bosonic \
symmetries.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
