                "\"submitter\"", "\[Rule]", "\"Michelangelo Preti\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Lorenzo Bianchi, Luca Griguolo, Michelangelo Preti, \
Domenico Seminara\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Wilson lines as superconformal defects in ABJM theory: a \
formula for the\\n  emitted radiation\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"37 pages, 4 figures, references added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP10(2017)050\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
