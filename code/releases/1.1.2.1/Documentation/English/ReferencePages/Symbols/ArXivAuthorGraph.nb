                "\"title\"", "\[Rule]", 
                 "\"Chromoelectric field correlator for quarkonium transport \
in the strongly\\n  coupled $\\\\mathcal{N}=4$ Yang-Mills plasma from AdS/CFT\
\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"82 pages, 11 figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP06(2023)007\""}]}, {
               
