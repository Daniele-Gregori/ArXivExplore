                    RowBox[{"\"He\"", ",", "\"Yifei\"", ",", "\"\""}], "}"}], 
                    ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Huang\"", ",", "\"Changyu\"", ",", "\"\""}], 
                    "}"}], ",", 
