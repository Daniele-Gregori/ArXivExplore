               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Nikolay Gromov, Sakura Schafer-Nameki, Pedro \
Vieira\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Efficient precision quantization in AdS/CFT\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"32 pages, 5 figures; v2: typos corrected, refs \
added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0812:013,2008\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2008/12/013\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"CALT-68-2695\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  Understanding finite-size effects is one of the key \
open questions in solving\\nplanar AdS/CFT. In this paper we discuss these \
effects in the AdS_5xS^5 string\\ntheory at one-loop in the world-sheet \
coupling. First we provide a very\\ngeneral, efficient way to compute the \
fluctuation frequencies, which allows to\\ndetermine the energy shift for \
very general multi-cut solutions. Then we apply\\nthis to two-cut solutions, \
in particular the giant magnon and determine the\\nfinite-size corrections at \
subleading order. The latter are then compared to\\nthe finite-size \
corrections from Luscher-Klassen-Melzer formulas and found to\\nbe in perfect \
agreement.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
