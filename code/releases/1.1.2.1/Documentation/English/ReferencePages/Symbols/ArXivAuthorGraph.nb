                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 17 Sep 2008 10:13:30 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2008-11-26\""}]}, {
