                    RowBox[{"{", 
                    RowBox[{"\"Arutyunov\"", ",", "\"Gleb\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"van Tongeren\"", ",", "\"Stijn J.\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
