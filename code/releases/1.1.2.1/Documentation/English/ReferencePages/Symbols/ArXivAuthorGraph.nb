                    RowBox[{"{", 
                    RowBox[{"\"Park\"", ",", "\"Chanyong\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Lee\"", ",", "\"Jung Hun\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
