               RowBox[{
                "\"comments\"", "\[Rule]", "\"34 pages, 9 figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0910:087,2009\""}]}, {
               
