               RowBox[{"\"id\"", "\[Rule]", "\"math-ph/0612014\""}]}, {
               
               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Fabien Vignes-Tourneret\""}]}, {
               RowBox[{
