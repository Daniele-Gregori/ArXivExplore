               RowBox[{"\"id\"", "\[Rule]", "\"1810.09048\""}]}, {
               
               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Rafael I. Nepomechie\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Rafael I. Nepomechie and Ana L. Retore\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"The spectrum of quantum-group-invariant transfer matrices\
\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"37 pages\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.nuclphysb.2018.11.017\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"UMTG-298\""}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", "\"hep-th math-ph math.MP\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  Integrable open quantum spin-chain transfer matrices \
constructed from\\ntrigonometric R-matrices associated to affine Lie algebras \
$\\\\hat g$, and from\\ncertain K-matrices (reflection matrices) depending on \
a discrete parameter p,\\nwere recently considered in arXiv:1802.04864 and \
arXiv:1805.10144. It was shown\\nthere that these transfer matrices have \
quantum group symmetry corresponding to\\nremoving the p-th node from the $\\\
\\hat g$ Dynkin diagram. Here we determine the\\nspectrum of these transfer \
matrices by using analytical Bethe ansatz, and we\\ndetermine the dependence \
of the corresponding Bethe equations on p. We propose\\nformulas for the \
Dynkin labels of the Bethe states in terms of the numbers of\\nBethe roots of \
each type.We also briefly study how duality transformations are\\nimplemented \
on the Bethe ansatz solutions.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 22 Oct 2018 01:16:42 GMT\""}]}], "}"}], "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2018-12-26\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Nepomechie\"", ",", "\"Rafael I.\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Retore\"", ",", "\"Ana L.\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
             Left, ColumnAlignments -> Left], Column], 
