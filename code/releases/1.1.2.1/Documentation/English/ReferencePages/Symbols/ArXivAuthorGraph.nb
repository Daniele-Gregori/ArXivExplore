                    RowBox[{"\"version\"", "\[Rule]", "\"v3\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 14 Feb 2019 17:58:42 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
