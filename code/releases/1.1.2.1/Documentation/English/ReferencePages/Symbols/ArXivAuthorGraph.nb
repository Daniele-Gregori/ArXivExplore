               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Gauge theories with 16 supersymmetries on spheres\""}]}, {
              
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"41 pages, refs added, typos corrected, extra material \
added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
