                "\"authors\"", "\[Rule]", 
                 "\"Amir H. Fatollahi, Kamran Kaviani and Shahrokh \
Parvizi\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"M-Branes and Their Interactions in Static Matrix \
Model\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"Latex file, 17 pages, No Figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys. B528 (1998) 156-170\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1016/S0550-3213(98)00353-8\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"IPM-96-252\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  Different BPS M-brane configurations including single \
and two parallel\\nM$p$-branes ($p$= even) and M5-branes are introduced as \
the classical solutions\\nof the recently proposed Static Matrix Model. Also \
the long range interactions\\nof two relatively rotated M$p$-branes (one and \
two angles) and\\nM$p$-brane--anti-M$p$-brane are calculated. The results are \
in agreement with\\n11 dimensional supergravity results.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
