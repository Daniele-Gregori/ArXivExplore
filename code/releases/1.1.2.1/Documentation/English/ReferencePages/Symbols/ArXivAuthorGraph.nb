               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On the Integrability of Planar N=2 Superconformal Gauge \
Theories\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"20 pages, 1 figure. v2: minor changes, JHEP \
version\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP08(2013)015\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"YITP-SB-12-38\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We study the integrability properties of planar N=2 \
superconformal field\\ntheories in four dimensions. We show that the spin \
chain associated to the\\nplanar dilation operator of N=2 superconformal QCD \
fails to be integrable at\\ntwo loops. In our analysis we focus on a closed \
SU(2|1) sector, whose two-loop\\nspin chain we fix by symmetry arguments (up \
to a few undetermined\\ncoefficients). It turns out that the Yang-Baxter \
equation for magnon scattering\\nis not satisfied in this sector. On the \
other hand, we suggest that the closed\\nSU(2,1|2) sector, which exists in \
any N=2 superconformal gauge theory, may be\\nintegrable to all \
loops.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
