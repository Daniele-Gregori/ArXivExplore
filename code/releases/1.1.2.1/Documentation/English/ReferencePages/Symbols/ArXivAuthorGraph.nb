supergravity\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"34 pages; v2: generalized analysis of flavor \
supersymmetry anomalies;\\n  references added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP09(2019)039\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"KIAS-P19022\""}]}, {
