               "Fri, 7 Sep 2001 17:19:05 GMT"}}, "update_date" -> 
            "2009-11-07", 
            "authors_parsed" -> {{"Adams", "A.", ""}, {
              "Polchinski", "J.", ""}, {"Silverstein", "E.", ""}}}], 
          "Tooltip"]& ], 
        TagBox[
         TooltipBox[DiskBox[{13.416129227183198`, -0.6009795318750637}, 0.],
          TagBox[
           TagBox[
            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0108140\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Arkady Tseytlin\""}]}, {
              
               RowBox[{"\"authors\"", "\[Rule]", "\"A.A. Tseytlin\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Magnetic backgrounds and tachyonic instabilities in \
closed string theory\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"12 pages, latex. Contribution to the proceedings of the \
10-th Tohwa\\n  International Symposium on String Theory, Fukuoka, Japan, \
July 3-7, 2001; v2:\\n  references added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "\"10.1063/1.1454381\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We discuss some aspects of closed superstrings in \
Melvin-type magnetic\\nbackgrounds. A 2-parameter family of such NS-NS \
backgrounds are exactly\\nsolvable as weakly coupled string models with the \
spectrum containing tachyonic\\nmodes. Magnetic field allows one to \
interpolate between free superstring\\ntheories with periodic and \
antiperiodic boundary conditions for the space-time\\nfermions around some \
compact direction, and, in particular, between type 0 and\\ntype II string \
theories. Using ``9-11'' flip, this interpolation can be\\nextended to \
M-theory and may be used to study the issue of tachyon in type 0\\nstring \
theory. We review, following hep-th/0104238, related duality \
proposals,\\nand, in particular, consider a description of type 0 theory in \
terms of\\nM-theory in a curved magnetic flux background in which the type 0 \
tachyon\\nappears to correspond to a state in $d=11$ supergravity fluctuation \
spectrum.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 20 Aug 2001 09:26:58 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 29 Aug 2001 07:30:25 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2009-11-07\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
