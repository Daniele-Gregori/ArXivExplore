               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Machiko Hatsuda and Shun'ya Mizoguchi\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Nonlocal charges of T-dual strings\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"23 pages, 1 figure\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP0607:029,2006\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2006/07/029\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We obtain sets of infinite number of conserved nonlocal \
charges of strings in\\na flat space and pp-wave backgrounds, and compare \
them before and after\\nT-duality transformation. In the flat background the \
set of nonlocal charges is\\nthe same before and after the T-duality \
transformation with interchanging odd\\nand even-order charges. In the IIB \
pp-wave background an infinite number of\\nnonlocal charges are independent, \
contrast to that in a flat background only\\nthe zero-th and first order \
charges are independent. In the IIA pp-wave\\nbackground, which is the \
T-dualized compactified IIB pp-wave background, the\\nzero-th order charges \
are included as a part of the set of nonlocal charges in\\nthe IIB \
background. To make this correspondence complete a variable conjugate\\nto \
the winding number is introduced as a Lagrange multiplier in the IIB \
action\\na la Buscher's transformation.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 13 Mar 2006 04:48:52 GMT\""}]}], "}"}], "}"}]}]}, {
