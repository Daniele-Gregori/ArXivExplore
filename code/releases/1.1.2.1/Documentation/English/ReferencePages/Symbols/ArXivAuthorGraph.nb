                "\"comments\"", "\[Rule]", 
                 "\"22 pages, 5 figures, v2: typos corrected, v3: final \
version in JHEP\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0702:035,2007\""}]}, {
               
