                 "\"Su Yu Ding, Joanna Karczmarek, Gordon W. Semenoff\""}]}, {
              
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On the infrared divergence and global colour in N=4 \
Yang-Mills theory\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
