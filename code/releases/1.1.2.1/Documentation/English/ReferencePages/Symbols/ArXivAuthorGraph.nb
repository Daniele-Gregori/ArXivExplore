               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Classifying integrable symmetric space strings via \
factorized scattering\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"17 pages; v2: Improvements to sec 1, results now \
summarized in Tab 1.\\n  Matches published version\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP02(2018)106\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
