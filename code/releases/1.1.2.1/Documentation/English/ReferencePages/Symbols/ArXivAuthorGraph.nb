                "\"submitter\"", "\[Rule]", "\"Giovanni Feverati\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", "\"G. Feverati and P. Grinza\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Integrals of motion from TBA and lattice-conformal \
dictionary\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"20 pages, 1 figure, LaTeX; v2: added references, improved \
conventions\\n  introduced in sections 4, 5 and related tables; v3: added \
references\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys. B702 (2004) 495-515\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
