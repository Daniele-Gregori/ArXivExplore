                "\"comments\"", "\[Rule]", 
                 "\"30 pages, 12 figures, v3: typos fixed, improved \
discussion of bound\\n  states and bound state axiom\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys.Rev. D87 (2013) 026004\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1103/PhysRevD.87.026004\""}]}, {
               
