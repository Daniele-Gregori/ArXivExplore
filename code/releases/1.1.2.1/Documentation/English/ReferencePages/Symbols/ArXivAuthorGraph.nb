               "Sun, 24 Jul 2016 10:46:31 GMT"}}, "update_date" -> 
            "2016-08-03", 
            "authors_parsed" -> {{"van Tongeren", "Stijn J.", ""}}}], 
          "Tooltip"]& ], 
        TagBox[
