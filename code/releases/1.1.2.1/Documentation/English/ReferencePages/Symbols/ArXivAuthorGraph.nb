               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Dark matter and dark energy in combinatorial quantum \
gravity\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Class. Quant. Gravity (2024)\""}]}, {
