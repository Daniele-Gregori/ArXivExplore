                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Arutyunov\"", ",", "\"Gleb\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Frolov\"", ",", "\"Sergey\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
