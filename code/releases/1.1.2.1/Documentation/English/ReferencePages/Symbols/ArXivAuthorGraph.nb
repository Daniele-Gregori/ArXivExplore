                RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0009210\""}]}, {
                RowBox[{"\"submitter\"", "\[Rule]", "\"Zarembo\""}]}, {
                
                RowBox[{
                 "\"authors\"", "\[Rule]", "\"P. Olesen, K. Zarembo\""}]}, {
                
                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Phase transition in Wilson loop correlator from AdS/CFT \
correspondence\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", "\"9 pages, 2 figures\""}]}, {
                RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
                RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
                
                RowBox[{
                 "\"abstract\"", "\[Rule]", 
                  "\"  A previous calculation of the phase transition in the \
Wilson loop correlator\\nin the zero temperature AdS/CFT correspondence is \
extended to the case where\\nthe loops are concentric circles of unequal \
radii. This phase transition occurs\\ndue to the instability of the classical \
string stretched between the loops. We\\ncompute the string action and its \
expansion in the distance h between the loops\\nfor small h. We also find \
that the connected minimal surface is subleading or\\ndoes not even exist \
when h=0 and the radii are considerably different. This\\nfeature has no \
analogue in flat space.\\n\""}]}, {
                RowBox[{"\"versions\"", "\[Rule]", 
                  RowBox[{"{", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 26 Sep 2000 20:20:04 GMT\""}]}], "}"}], "}"}]}]}, {
