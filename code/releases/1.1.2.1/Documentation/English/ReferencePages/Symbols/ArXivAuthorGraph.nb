               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Anshuman Dey, Aryeh Fortinsky\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Perturbative renormalization of the $T \
\\\\bar{T}$-deformed free massive\\n  Dirac fermion\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"1+61 pages, 14 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP12(2021)200\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://creativecommons.org/licenses/by/4.0/\""}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  In this paper we explicitly carry out the perturbative \
renormalization of the\\n$T\\\\bar{T}$-deformed free massive Dirac fermion in \
two dimensions up to second\\norder in the coupling constant. This is done by \
computing the two-to-two\\n$S$-matrix using the LSZ reduction formula and \
canceling out the divergences by\\nintroducing counterterms. We demonstrate \
that the renormalized Lagrangian is\\nunambiguously determined by demanding \
that it gives the correct $S$-matrix of a\\n$T\\\\bar{T}$-deformed integrable \
field theory. Remarkably, the renormalized\\nLagrangian is qualitatively very \
different from its classical counterpart.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 22 Sep 2021 06:03:50 GMT\""}]}], "}"}], "}"}]}]}, {
