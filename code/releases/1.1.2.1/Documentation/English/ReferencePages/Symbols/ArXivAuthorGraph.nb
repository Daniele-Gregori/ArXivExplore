               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Louise Anderson, Jorge G. Russo\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"ABJM Theory with mass and FI deformations and Quantum \
Phase Transitions\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"42 pages, 7 figures. Minor revisions of eq. (19) and \
section 6.2.2 to\\n  agree with JHEP-version\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP05(2015)064\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
