           TagBox[
            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0301055\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Yusuke Kimura\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", "\"Yusuke Kimura (RIKEN)\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On Higher Dimensional Fuzzy Spherical Branes\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"20 pages\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys. B664 (2003) 512-530\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1016/S0550-3213(03)00462-0\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  Matrix descriptions of higher dimensional spherical \
branes are investigated.\\nIt is known that a fuzzy 2k-sphere is described by \
the coset space\\nSO(2k+1)/U(k) and has some extra dimensions. It is shown \
that a fuzzy 2k-sphere\\nis comprised of n^{\\\\frac{k(k-1)}{2}} spherical \
D(2k-1)-branes and has a fuzzy\\n2(k-1)-sphere at each point. We can \
understand the relationship between these\\ntwo viewpoints by the dielectric \
effect. Contraction of the algebra is also\\ndiscussed.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
