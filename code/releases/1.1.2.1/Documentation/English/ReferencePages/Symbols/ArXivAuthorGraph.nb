                 "\"comments\"", "\[Rule]", 
                  "\"6 pages, 3 figures; v2: improved presentation, matches \
published\\n  version\""}]}, {
                RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
