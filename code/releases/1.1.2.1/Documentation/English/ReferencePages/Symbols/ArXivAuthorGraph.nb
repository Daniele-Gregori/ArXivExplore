                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 13 Jun 2001 22:30:49 GMT\""}]}], "}"}], ",", 
