                     ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Tirziu\"", ",", "\"A.\"", ",", "\"\""}], "}"}],
                     ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Tseytlin\"", ",", "\"A. A.\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
