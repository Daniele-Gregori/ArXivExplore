                    "\"Tue, 13 Jun 2017 17:12:09 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 14 Nov 2017 23:05:07 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
