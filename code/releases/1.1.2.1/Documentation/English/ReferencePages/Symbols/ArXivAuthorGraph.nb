               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/9906101\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Dieter Luest\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Ralph Blumenhagen, Anamaria Font, Dieter Lust\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Non-Supersymmetric Gauge Theories from D-Branes in Type 0 \
String Theory\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"32 pages, harvmac, replaced version: minor typos \
corrected, refs.\\n  added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys.B560:66-92,1999\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1016/S0550-3213(99)00443-5\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"HUB-EP-99/28\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We construct non-supersymmetric four dimensional gauge \
theories arising as\\neffective theories of D-branes placed on various \
singularities in Type 0B\\nstring theory. We mostly focus on models which are \
conformal in the large N\\nlimit and present both examples appearing on \
self-dual D3-branes on orbifold\\nsingularities and examples including \
orientifold planes. Moreover, we derive\\ntype 0 Hanany-Witten setups with NS \
5-branes intersected by D-branes and the\\ncorresponding rules for \
determining the massless spectra. Finally, we discuss\\npossible duality \
symmetries (Seiberg-duality) for non-supersymmetric gauge\\ntheories within \
this framework.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
