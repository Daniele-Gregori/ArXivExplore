                "\"title\"", "\[Rule]", 
                 "\"S-duality and supersymmetry on curved manifolds\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"51 pages\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP09(2020)128\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
