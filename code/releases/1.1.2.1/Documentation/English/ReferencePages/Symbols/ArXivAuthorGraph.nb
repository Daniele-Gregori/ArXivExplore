                    RowBox[{"{", 
                    RowBox[{"\"Frolov\"", ",", "\"Sergey\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Pribytok\"", ",", "\"Anton\"", ",", "\"\""}], 
                    "}"}], ",", 
