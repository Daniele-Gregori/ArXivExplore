Wulff\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Scattering in AdS(2)/CFT(1) and the BES Phase\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"21 pages. v2 corrects one sign error; version to appear \
in JHEP\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 1310:066, 2013\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP10(2013)066\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
                 "\"MIFPA-13-25, QGaSLAB-13-07\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
