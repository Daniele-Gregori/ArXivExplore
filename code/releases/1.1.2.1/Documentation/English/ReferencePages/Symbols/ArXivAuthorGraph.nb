               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Marco S. Bianchi and Andrea Mauri\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"ABJM $\\\\theta$-Bremsstrahlung at four loops and beyond: \
non-planar\\n  corrections\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"22 pages\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP11(2017)166\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We consider the Bremsstrahlung function associated to a \
1/6-BPS Wilson loop\\nin ABJM theory, with a cusp in the couplings to scalar \
fields. We non-trivially\\nextend its recent four-loop computation at weak \
coupling to include non-planar\\ncorrections. We have recently proposed a \
conjecture relating this object to\\nsupersymmetric circular Wilson loops \
with multiple windings, which can be\\ncomputed via localization. We find \
agreement between this proposal and the\\nperturbative computation of the \
Bremsstrahlung function, including color\\nsub-leading corrections. This \
supports the conjecture and hints at its validity\\nbeyond the planar \
approximation.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
