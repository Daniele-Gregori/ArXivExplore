               RowBox[{"\"submitter\"", "\[Rule]", "\"Arpad Hegedus\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Arpad Hegedus\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Finite volume expectation values in the sine-Gordon model\
\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
