            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"0709.4033\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Keisuke Okamura\""}]}, {
              
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Hirotaka Hayashi, Keisuke Okamura, Ryo Suzuki, Benoit \
Vicedo\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Large Winding Sector of AdS/CFT\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"1+52 pages, 10 figures, v2: references and comments \
added, v3: minor\\n  changes and a reference added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0711:033,2007\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2007/11/033\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", "\"UT-07-26, DAMTP-2007-83\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We study a family of classical strings on R x S^3 \
subspace of the AdS_5 x S^5\\nbackground that interpolates between pulsating \
strings and single-spike\\nstrings. They are obtained from the helical \
strings of hep-th/0609026 by\\ninterchanging worldsheet time and space \
coordinates, which maps\\nrotating/spinning string states with large spins to \
oscillating states with\\nlarge winding numbers. From a finite-gap \
perspective, this transformation is\\nrealised as an interchange of \
quasi-momentum and quasi-energy defined for the\\nalgebraic curve. The gauge \
theory duals are also discussed, and are identified\\nwith operators in the \
non-holomorphic sector of N=4 super Yang-Mills. They can\\nbe viewed as \
excited states above the ``antiferromagnetic'' state, which is\\n``the \
farthest from BPS'' in the spin-chain spectrum. Furthermore, we\\ninvestigate \
helical strings on AdS_3 x S^1 in an appendix.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 26 Sep 2007 10:28:33 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 2 Oct 2007 14:22:38 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v3\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 19 Nov 2007 17:05:28 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
