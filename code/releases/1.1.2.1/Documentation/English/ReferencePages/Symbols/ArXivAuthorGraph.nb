                 "\"25 pages, 5 figures; v2 references, minor corrections and\
\\n  clarifications added; published version\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP05(2018)168\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP05(2018)168\""}]}, {
