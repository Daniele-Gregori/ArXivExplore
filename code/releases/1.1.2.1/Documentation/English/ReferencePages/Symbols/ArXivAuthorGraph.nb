               RowBox[{"\"id\"", "\[Rule]", "\"1812.08142\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Sara Pasquetti\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Francesco Aprile, Sara Pasquetti, Yegor Zenkevich\""}]}, {
              
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Flipping the head of T[SU(N)]: mirror symmetry, spectral \
duality and\\n  monopoles\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"74 pages, 15 pictures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP04(2019)138\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We consider T[SU(N)] and its mirror, and we argue that \
there are two more\\ndual frames, which are obtained by adding flipping \
fields for the moment maps\\non the Higgs and Coulomb branch. Turning on a \
monopole deformation in T[SU(N)],\\nand following its effect on each dual \
frame, we obtain four new daughter\\ntheories dual to each other. We are then \
able to construct pairs of 3d spectral\\ndual theories by performing simple \
operations on the four dual frames of\\nT[SU(N)]. Engineering these 3d \
spectral pairs as codimension-two defect\\ntheories coupled to a trivial 5d \
theory, via Higgsing, we show that our 3d\\nspectral dual theories descends \
from the 5d spectral duality, or fiber base\\nduality in topological string. \
We provide further consistency checks about the\\nweb of dualities we \
constructed by matching partition functions on the three\\nsphere, and in the \
case of spectral duality, matching exactly topological\\nstring computations \
with holomorphic blocks.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 19 Dec 2018 18:35:24 GMT\""}]}], "}"}], "}"}]}]}, {
