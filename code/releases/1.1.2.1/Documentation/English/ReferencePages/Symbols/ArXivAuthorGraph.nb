                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Sat, 24 Jun 2006 08:14:19 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
