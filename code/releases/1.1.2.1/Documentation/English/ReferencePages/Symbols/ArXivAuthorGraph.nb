                "\"journal-ref\"", "\[Rule]", "\"JHEP 0506 (2005) 005\""}]}, {
              
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2005/06/005\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"UB-ECM-PF-05/10\""}]}, {
              
