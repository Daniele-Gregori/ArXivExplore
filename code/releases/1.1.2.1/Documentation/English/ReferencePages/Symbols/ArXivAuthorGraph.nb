               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On phase diagram and the pseudogap state in a linear \
chiral homopolymer\\n  model\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"Journal version of the paper, published in Phys. Rev. \
E\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys. Rev. E 92, 032602 (2015)\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1103/PhysRevE.92.032602\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
