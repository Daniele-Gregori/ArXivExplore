                    RowBox[{"\"Samsonov\"", ",", "\"I. B.\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Zupnik\"", ",", "\"B. M.\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
             Left, ColumnAlignments -> Left], Column], 
           Function[BoxForm`e$, 
            TableForm[BoxForm`e$]]]],
         Annotation[#, 
          
          TableForm[{
           "id" -> "1111.4145", "submitter" -> "Igor Samsonov", "authors" -> 
            "I. L. Buchbinder, E. A. Ivanov, I. B. Samsonov, B. M. Zupnik", 
            "title" -> "Superconformal N=3 SYM Low-Energy Effective Action", 
            "comments" -> "1+29 pages; v2: minor corrections, JHEP style", 
            "journal-ref" -> Null, "doi" -> "10.1007/JHEP01(2012)001", 
            "report-no" -> Null, "categories" -> "hep-th", "license" -> 
            "http://arxiv.org/licenses/nonexclusive-distrib/1.0/", "abstract" -> 
            "  We construct a manifestly N=3 supersymmetric low-energy \
effective action of\nN=3 super Yang-Mills theory. The effective action is \
written in the N=3\nharmonic superspace and respects the full N=3 \
superconformal symmetry. On mass\nshell this action is responsible for the \
four-derivative terms in the N=4 SYM\neffective action, such as F^4/X^4 and \
its supersymmetric completions, while off\nshell it involves also \
higher-derivative terms. For constant Maxwell and scalar\nfields its bosonic \
part coincides, up to the F^6/X^8 order, with the bosonic\npart of the D3 \
brane action in the AdS_5 x S^5 background. We also argue that\nin the sector \
of scalar fields it involves the correctly normalized Wess-Zumino\nterm with \
the implicit SU(3) symmetry.\n", 
