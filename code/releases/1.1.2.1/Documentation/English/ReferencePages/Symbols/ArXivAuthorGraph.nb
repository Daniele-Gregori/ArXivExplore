               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/9705128\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Asato Tsuchiya\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"M. Fukuma, H. Kawai, Y. Kitazawa and A. Tsuchiya\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"String Field Theory from IIB Matrix Model\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"21 pages, Latex, 1 figure\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys.B510:158-174,1998\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1016/S0550-3213(97)00584-1\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", "\"KEK-TH-518, TIT/HEP-369\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We derive Schwinger-Dyson equations for the Wilson \
loops of a type IIB matrix\\nmodel. Superstring coordinates are introduced \
through the construction of the\\nloop space. We show that the continuum \
limit of the loop equation reproduces\\nthe light-cone superstring field \
theory of type IIB superstring in the large-N\\nlimit. We find that the \
interacting string theory can be obtained in the double\\nscaling limit as it \
is expected.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Sat, 17 May 1997 07:34:45 GMT\""}]}], "}"}], "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2008-11-26\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Fukuma\"", ",", "\"M.\"", ",", "\"\""}], "}"}],
                     ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Kawai\"", ",", "\"H.\"", ",", "\"\""}], "}"}], 
                    ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Kitazawa\"", ",", "\"Y.\"", ",", "\"\""}], 
                    "}"}], ",", 
