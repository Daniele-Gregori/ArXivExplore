               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On topological recursion for Wilson loops in $\\\\mathcal \
N=4$ SYM at\\n  strong coupling\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"41 pages\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP04(2021)194\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
