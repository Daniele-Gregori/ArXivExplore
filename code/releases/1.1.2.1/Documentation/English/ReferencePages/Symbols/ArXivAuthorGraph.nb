            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/9905111\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Juan Maldacena\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"O. Aharony, S.S. Gubser, J. Maldacena, H. Ooguri, and Y. \
Oz\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Large N Field Theories, String Theory and Gravity\""}]}, {
              
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"261 pages, 42 post-script figures. Please send any \
comment to\\n  jmaldac@fas.harvard.edu. v2: added references and small \
corrections. v3:\\n  minor changes and corrected discussion of \
SU(3)-invariant supergravity\\n  solution\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys.Rept.323:183-386,2000\""}]}, {
               
