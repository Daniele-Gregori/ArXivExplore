                "\"title\"", "\[Rule]", 
                 "\"Mass Deformed ABJM Theory on Three Sphere in Large N \
limit\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"34 pages, 1 figure; v2 :references added, minor changes, \
published\\n  version\""}]}, {
