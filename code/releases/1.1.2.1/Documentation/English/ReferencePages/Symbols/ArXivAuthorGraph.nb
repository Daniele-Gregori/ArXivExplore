               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  A new version of scale analysis and renormalization \
theory has been found on\\nthe non-commutative Moyal space. It could be \
useful for physics beyond the\\nstandard model or for standard physics in \
strong external field. The good news\\nis that quantum field theory is better \
behaved on non-commutative than on\\nordinary space: indeed it has no Landau \
ghost. Noncommutativity might therefore\\nbe an alternative to supersymmetry. \
We review this rapidly growing subject.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 4 May 2007 20:41:02 GMT\""}]}], "}"}], "}"}]}]}, {
              
