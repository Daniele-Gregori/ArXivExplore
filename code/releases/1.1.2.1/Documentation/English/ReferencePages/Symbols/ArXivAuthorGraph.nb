         Annotation[#, 
          
          TableForm[{
           "id" -> "1611.00380", "submitter" -> "Lorenzo Di Pietro", 
            "authors" -> "Lorenzo Di Pietro, Masazumi Honda", "title" -> 
            "Cardy Formula for 4d SUSY Theories and Localization", "comments" -> 
            "43 pages, v2: references added, changed slightly discussion in\n \
 section 5", "journal-ref" -> Null, "doi" -> "10.1007/JHEP04(2017)055", 
            "report-no" -> Null, "categories" -> "hep-th", "license" -> 
            "http://arxiv.org/licenses/nonexclusive-distrib/1.0/", "abstract" -> 
            "  We study 4d $\\mathcal{N}=1$ supersymmetric theories on a \
compact Euclidean\nmanifold of the form $S^1 \\times\\mathcal{M}_3$. \
Partition functions of gauge\ntheories on this background can be computed \
using localization, and explicit\nformulas have been derived for different \
choices of the compact manifold\n$\\mathcal{M}_3$. Taking the limit of \
shrinking $S^1$, we present a general\nformula for the limit of the \
localization integrand, derived by simple\neffective theory considerations, \
generalizing the result of arXiv:1512.03376.\nThe limit is given in terms of \
an effective potential for the holonomies around\nthe $S^1$, whose minima \
determine the asymptotic behavior of the partition\nfunction. If the \
potential is minimized in the origin, where it vanishes, the\npartition \
function has a Cardy-like behavior fixed by $\\mathrm{Tr}(R)$, while a\n\
nontrivial minimum gives a shift in the coefficient. In all the examples that\
\nwe consider, the origin is a minimum if $\\mathrm{Tr}(R) \\leq 0$.\n", 
            "versions" -> {{
              "version" -> "v1", "created" -> 
               "Tue, 1 Nov 2016 20:43:00 GMT"}, {
              "version" -> "v2", "created" -> 
               "Thu, 5 Jan 2017 13:25:19 GMT"}}, "update_date" -> 
            "2017-05-24", 
            "authors_parsed" -> {{"Di Pietro", "Lorenzo", ""}, {
              "Honda", "Masazumi", ""}}}], "Tooltip"]& ], 
