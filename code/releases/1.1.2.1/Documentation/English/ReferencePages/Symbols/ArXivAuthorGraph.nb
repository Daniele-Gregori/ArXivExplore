               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We investigate the equivalence theorem for integrable \
systems using two\\nformulations of the Alday-Arutyunov-Frolov model. We show \
that the S-matrix is\\ninvariant under the field transformation which reduces \
the non-linear Dirac\\nbrackets of one formulation into the standard \
commutation relations in the\\nsecond formulation. We also explain how to \
perform the direct diagonalization\\nof the transformed Hamiltonian by \
constructing the states corresponding to\\nself-adjoint extensions.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
