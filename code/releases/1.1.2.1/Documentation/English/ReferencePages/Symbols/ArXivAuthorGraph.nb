               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"The two-loop dilatation operator of N=4 super Yang-Mills \
theory in the\\n  SO(6) sector\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"16 pages, 5 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP12(2011)075\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
                 "\"HU-EP-11/25, QMUL-PH-11-09, NSF-KITP-11-101\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
