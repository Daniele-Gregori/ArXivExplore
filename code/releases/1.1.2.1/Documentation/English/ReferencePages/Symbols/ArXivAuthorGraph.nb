               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Wrapping interactions at strong coupling -- the giant \
magnon\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"35 pages, 2 figures; v2: comments and references \
added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys.Rev.D76:126008,2007\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1103/PhysRevD.76.126008\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We derive generalized Luscher formulas for finite size \
corrections in a\\ntheory with a general dispersion relation. For the \
AdS_5xS^5 superstring these\\nformulas encode leading wrapping interaction \
effects. We apply the generalized\\nmu-term formula to calculate finite size \
corrections to the dispersion relation\\nof the giant magnon at strong \
coupling. The result exactly agrees with the\\nclassical string computation \
of Arutyunov, Frolov and Zamaklar. The agreement\\ninvolved a Borel \
resummation of all even loop-orders of the BES/BHL dressing\\nfactor thus \
providing a strong consistency check for the choice of the dressing\\nfactor.\
\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
