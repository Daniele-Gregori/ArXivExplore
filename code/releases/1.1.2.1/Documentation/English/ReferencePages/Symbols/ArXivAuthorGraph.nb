                "\"title\"", "\[Rule]", 
                 "\"On the scattering of gluons in the GKP string\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"50 pages, 8 tables, 13 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP02(2016)146\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
