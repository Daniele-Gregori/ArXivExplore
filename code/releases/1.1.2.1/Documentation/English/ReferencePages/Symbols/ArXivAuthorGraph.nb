                    RowBox[{"{", 
                    RowBox[{"\"Bertolini\"", ",", "\"M.\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Di Vecchia\"", ",", "\"P.\"", ",", "\"\""}], 
