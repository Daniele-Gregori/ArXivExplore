               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"A type I defect and new integrable boundary conditions \
for the coupled\\n  nonlinear Schr\\\\\\\"odinger equation\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
