               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0411020\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Louise Dolan\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Louise Dolan and Chiara R. Nappi\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Spin Models and Superconformal Yang-Mills Theory\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"33 pages\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys.B717:361-386,2005\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.nuclphysb.2005.04.006\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th math.QA\""}]}, {
              
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We apply novel techniques in planar superconformal \
Yang-Mills theory which\\nstress the role of the Yangian algebra. We compute \
the first two Casimirs of\\nthe Yangian, which are identified with the first \
two local abelian Hamiltonians\\nwith periodic boundary conditions, and show \
that they annihilate the chiral\\nprimary states. We streamline the \
derivation of the R-matrix in a conventional\\nspin model, and extend this \
computation to the gauge theory. We comment on\\nhigher-loop corrections and \
higher-loop integrability.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 1 Nov 2004 17:22:06 GMT\""}]}], "}"}], "}"}]}]}, {
              
