               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Equivalence of large-$N$ gauge theories on a group \
manifold and its\\n  coset space\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"11 pages, 4 figures, published version\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys. Lett. B 782 (2018) 503\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.physletb.2018.05.065\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
