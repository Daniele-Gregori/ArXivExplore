               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Lunin-Maldacena backgrounds from the classical \
Yang-Baxter equation --\\n  Towards the gravity/CYBE correspondence\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"18 pages, no figure, LaTeX, v2:references and further \
clarifications\\n  added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
