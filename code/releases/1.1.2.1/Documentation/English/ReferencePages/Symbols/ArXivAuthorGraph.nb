                    RowBox[{"\"version\"", "\[Rule]", "\"v3\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 28 Mar 2005 15:01:08 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
