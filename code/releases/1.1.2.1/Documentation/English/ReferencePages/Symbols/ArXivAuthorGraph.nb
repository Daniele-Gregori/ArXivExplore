                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 27 Jun 2007 23:39:15 GMT\""}]}], "}"}], "}"}]}]}, {
