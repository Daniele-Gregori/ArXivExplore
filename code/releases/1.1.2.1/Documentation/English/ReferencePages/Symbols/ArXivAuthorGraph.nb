                    RowBox[{"{", 
                    RowBox[{"\"Kruczenski\"", ",", "\"M.\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Russo\"", ",", "\"J.\"", ",", "\"\""}], "}"}], 
                    ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Tseytlin\"", ",", "\"A. A.\"", ",", "\"\""}], 
