                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 9 Nov 2017 14:16:42 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
