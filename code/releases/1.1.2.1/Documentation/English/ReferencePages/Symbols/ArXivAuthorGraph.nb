               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Vitaly Velizhanin\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"B.A. Kniehl, V.N. Velizhanin\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Nonplanar Four-Loop Anomalous Dimensions of Twist-Two \
Operators in N=4\\n  Super Yang-Mills Theory: Higher Moment, General Result, \
and Cusp Anomalous\\n  Dimension\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"6 pages, 1 figure\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th hep-ph\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We consider the nonplanar universal anomalous dimension \
of twist-two\\noperators at four loops in N=4 supersymmetric Yang-Mills \
theory and push its\\ndirect diagrammatic calculation through Lorentz spin \
j=20, one unit beyond the\\nstate of the art, so as to confirm the \
correctness of the general, all-j result\\nconjectured previously by us [1] \
imposing certain constraints on its analytic\\nform. Thanks to our new \
result, such constraints can be eliminated altogether.\\nBy the same token, \
this allows us to re-derive, in a completely independent\\nway, the nonplanar \
four-loop cusp anomalous dimension by taking the large-j\\nlimit of the \
general result.\\n\""}]}, {
