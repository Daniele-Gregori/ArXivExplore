               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0503159\""}]}, {
               
               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Pierre-Yves Casteill Dr\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"S. Bellucci, P.-Y. Casteill and J.F. Morales\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Superstring sigma models from spin chains: the SU(1,1|1) \
case\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"17 pages, references added, minor corrections\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys. B729 (2005) 163-178\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.nuclphysb.2005.09.012\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We derive the coherent state representation of the \
integrable spin chain\\nHamiltonian with non-compact supersymmetry group \
G=SU(1,1|1). By passing to the\\ncontinuous limit, we find a spin chain sigma \
model describing a string moving\\non the supercoset G/H, H being the \
stabilizer group. The action is written in a\\nmanifestly G-invariant form in \
terms of the Cartan forms and the string\\ncoordinates in the supercoset.\\n  \
The spin chain sigma model is shown to agree with that following from \
the\\nGreen-Schwarz action describing two-charged string spinning on AdS_5 x \
S^5.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
