               RowBox[{"\"id\"", "\[Rule]", "\"1910.05741\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Jung Hun Lee\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Chanyong Park, Jung Hun Lee\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Exotic RG Flow of Entanglement Entropy\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"20 pages, 9 figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys. Rev. D 101, 086008 (2020)\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1103/PhysRevD.101.086008\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  In this paper, we holographically study the \
renormalization group (RG) flow\\nin a three-dimensional Einstein-dilaton \
gravity with a potential permitting\\nseveral types of the RG flow with \
nontrivial beta-functions. By using the\\nintrinsic parameter of the \
potential, we classify possible holographic RG flows\\nand examine their \
physical features. Using the Ryu-Takayanagi formulation,\\nfurthermore, we \
investigate how the $c$-function of the entanglement entropy\\nbehaves along \
the RG flow numerically. We show that the entanglement\\n$c$-function \
monotonically decreases even in the cases with a nontrivial\\nbeta-function. \
For checking the consistency, we also compare the result of \
the\\nentanglement entropy with the $c$-function derived from the holographic\
\\nrenormalization procedure.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Sun, 13 Oct 2019 12:39:43 GMT\""}]}], "}"}], "}"}]}]}, {
