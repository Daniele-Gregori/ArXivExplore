                "\"title\"", "\[Rule]", 
                 "\"Resurgence of the Cusp Anomalous Dimension\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"42 pages, 3 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
