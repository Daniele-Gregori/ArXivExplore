               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0501234\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Burkhard Eden\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"B. Eden\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"A two-loop test for the factorised S-matrix of planar N=4\
\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"18 pages LaTeX, 3 figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys. B738 (2006) 409-424\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.nuclphysb.2006.01.012\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"AEI-2005-015\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We check the recently proposed higher loop Bethe-ansatz \
for the sl(2) sector\\nof N=4 at two loops by a direct perturbative \
calculation using N=2 superfields\\nin supersymmetric dimensional reduction. \
Our method can in principle address\\noperators built from many elementary \
fields and of arbitrary twist. We work out\\nin detail the spin three, twist \
three operator mixing problem at leading order\\nin N and find agreement with \
the prediction based on integrability.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
