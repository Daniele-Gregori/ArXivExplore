            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"2302.12203\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Matheus Fabri\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Matheus Fabri and Gabriel Lefundes\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Hexagons and the classical limit\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"25 pages, 5 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th nlin.SI\""}]}, {
              
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  In planar maximally supersymmetric Yang-Mills, we can \
compute three-point\\nfunctions at weak coupling using the so-called \
hexagonalization formalism. The\\nmain objects in this framework are called \
hexagons. We are interested in two\\nsectors of the theory, spanned by \
operators built entirely from scalar fields,\\nand by spinning operators, \
respectively. By reviewing the analytic properties\\nof these building \
blocks, we find new representations for them at weak coupling\\nwhere the two \
sectors are on equal footing. We compute the classical limit of\\nthe \
hexagons and of correlation functions in both sectors for some choices \
of\\npolarizations and our results match previous predictions in the \
literature.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 23 Feb 2023 17:56:47 GMT\""}]}], "}"}], "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2023-02-24\""}]}, {
