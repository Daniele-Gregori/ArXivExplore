               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"30 pages, v2 references and clarifications added, v3 \
matches\\n  published version\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 05 (2019) 112\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP05(2019)112\""}]}, {
