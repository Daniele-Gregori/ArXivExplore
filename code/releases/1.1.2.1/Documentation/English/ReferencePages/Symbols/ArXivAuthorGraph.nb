               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Algebraic Curves for Long Folded and Circular Winding \
Strings in AdS5xS5\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"19 pages, LaTeX, no figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
