               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"The $T\\\\overline T$ deformation of quantum field theory \
as random\\n  geometry\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"32 pages. Final published version! Solution for t>0 \
clarified\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP10(2018)186\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP10(2018)186\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
