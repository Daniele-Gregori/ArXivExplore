               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Non-integrability and Chaos with Unquenched Flavor\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"34 pages, 6 figures; v2: minor additions, references \
added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
