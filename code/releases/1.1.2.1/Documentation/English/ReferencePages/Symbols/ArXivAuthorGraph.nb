               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Exploring the ground state spectrum of gamma-deformed N=4 \
SYM\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"25 pages, 1 figure\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
