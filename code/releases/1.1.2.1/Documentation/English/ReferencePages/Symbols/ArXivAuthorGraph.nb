               RowBox[{"\"id\"", "\[Rule]", "\"0907.2593\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Takuya Okuda\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Nadav Drukker, David R. Morrison, and Takuya Okuda\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Loop operators and S-duality from curves on Riemann \
surfaces\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"41 pages\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0909:031,2009\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2009/09/031\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
                 "\"HU-EP-09/29, NSF-KITP-09-111\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th math.GT\""}]}, {
              
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We study Wilson-'t Hooft loop operators in a class of \
N=2 superconformal\\nfield theories recently introduced by Gaiotto. In the \
case that the gauge group\\nis a product of SU(2) groups, we classify all \
possible loop operators in terms\\nof their electric and magnetic charges \
subject to the Dirac quantization\\ncondition. We then show that this \
precisely matches Dehn's classification of\\nhomotopy classes of \
non-self-intersecting curves on an associated Riemann\\nsurface--the same \
surface which characterizes the gauge theory. Our analysis\\nprovides an \
explicit prediction for the action of S-duality on loop operators\\nin these \
theories which we check against the known duality transformation in\\nseveral \
examples.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 15 Jul 2009 14:08:52 GMT\""}]}], "}"}], "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2009-10-02\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Drukker\"", ",", "\"Nadav\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Morrison\"", ",", "\"David R.\"", ",", "\"\""}], "}"}],
                     ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Okuda\"", ",", "\"Takuya\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
             Left, ColumnAlignments -> Left], Column], 
