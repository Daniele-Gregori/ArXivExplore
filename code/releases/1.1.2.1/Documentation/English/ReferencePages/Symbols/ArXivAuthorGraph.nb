                    RowBox[{"{", 
                    RowBox[{"\"Miwa\"", ",", "\"Akitsugu\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Sumitomo\"", ",", "\"Yoske\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Yoshida\"", ",", "\"Kentaroh\"", ",", "\"\""}],
                     "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
