               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"I. Chepelev and A.A. Tseytlin\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Interactions of type IIB D-branes from D-instanton matrix \
model\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"17 pages, latex. misprints corrected, to appear in \
NPB\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys.B511:629-646,1998\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1016/S0550-3213(97)00658-5\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
                 "\"ITEP-TH-19/97, Imperial/TP/96-97/47\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We compute long-distance interaction potentials between \
certain 1/2 and 1/4\\nsupersymmetric D-brane configurations of type IIB \
theory, demonstrating\\ndetailed agreement between classical supergravity and \
one-loop instanton matrix\\nmodel results. This confirms the interpretation \
of D-branes as described by\\nclassical matrix model backgrounds as being \
`populated' by large number of\\nD-instantons, i.e. as corresponding to \
non-marginal bound states of branes of\\nlower dimensions. In the process, we \
establish precise relation between matrix\\nmodel expressions and non-abelian \
F^4 terms in the super Yang-Mills effective\\naction.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
