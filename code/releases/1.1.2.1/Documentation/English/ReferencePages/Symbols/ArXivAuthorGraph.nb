                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 26 Jun 2015 20:30:58 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2015-06-30\""}]}, {
