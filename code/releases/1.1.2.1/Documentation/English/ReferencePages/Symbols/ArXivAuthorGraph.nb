                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{"\"Belitsky\"", ",", "\"A. V.\"", ",", "\"\""}], 
                    "}"}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
