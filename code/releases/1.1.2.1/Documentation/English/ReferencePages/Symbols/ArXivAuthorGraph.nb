               RowBox[{"\"id\"", "\[Rule]", "\"1803.04416\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Matthias Wilhelm\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Troels Harmark and Matthias Wilhelm\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"The Hagedorn temperature of AdS5/CFT4 at finite coupling \
via the Quantum\\n  Spectral Curve\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"7 pages; v2: clarifications added, typos corrected\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys.Lett.B 786 (2018) 53-58\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.physletb.2018.09.033\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
