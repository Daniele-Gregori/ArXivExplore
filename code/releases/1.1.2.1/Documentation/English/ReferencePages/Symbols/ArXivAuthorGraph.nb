                "\"comments\"", "\[Rule]", 
                 "\"v1: 68 pages including appendices. v2: published \
version\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP12(2019)147\""}]}, {
               
