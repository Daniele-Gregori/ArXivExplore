               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Quasilocality of joining/splitting strings from coherent \
states\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"17 pages, 7 figures in 11 files\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0712:069,2007\""}]}, {
               
