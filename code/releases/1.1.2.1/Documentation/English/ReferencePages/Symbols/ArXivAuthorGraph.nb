                    "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Trancanelli\"", ",", "\"Diego\"", ",", "\"\""}], "}"}],
                     ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Vescovi\"", ",", "\"Edoardo\"", ",", "\"\""}], 
