                "\"categories\"", "\[Rule]", "\"hep-th math-ph math.MP\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  The noncommutative scalar theory with harmonic term (on \
the Moyal space) has\\na vanishing beta function. In this paper, we prove the \
renormalizability of the\\ncommutative scalar field theory with harmonic term \
to all orders by using\\nmultiscale analysis in the momentum space. Then, we \
consider and compute its\\none-loop beta function, as well as the one on the \
degenerate Moyal space. We\\ncan finally compare both to the vanishing beta \
function of the theory with\\nharmonic term on the Moyal space.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 26 Jul 2012 09:01:51 GMT\""}]}], "}"}], "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2015-01-12\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{"\"de Goursac\"", ",", "\"Axel\"", ",", "\"\""}], 
                    "}"}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
