                "\"comments\"", "\[Rule]", 
                 "\"22 pages,typos corrected, references added, published \
version\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP10(2011)061\""}]}, {
