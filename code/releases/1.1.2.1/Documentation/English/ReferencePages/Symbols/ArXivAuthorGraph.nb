               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  The simplest non commutative renormalizable field \
theory, the $\\\\phi_4^4$\\nmodel on four dimensional Moyal space with \
harmonic potential is asymptotically\\nsafe at one loop, as shown by H. \
Grosse and R. Wulkenhaar. We extend this\\nresult up to three loops. If this \
remains true at any loop, it should allow a\\nfull non perturbative \
construction of this model.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
