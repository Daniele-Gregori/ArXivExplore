                 RowBox[{"{", 
                   RowBox[{"{", 
                    
                    RowBox[{
                    "\"Sakamoto\"", ",", "\"Jun-ichi\"", ",", "\"\""}], "}"}],
                    "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> Left, 
