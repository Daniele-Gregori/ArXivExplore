               RowBox[{"\"id\"", "\[Rule]", "\"1410.1886\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Daniel Thompson\""}]}, {
              
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Konstantinos Sfetsos and Daniel C. Thompson\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Spacetimes for \\\\lambda-deformations\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"35 pages, 1 figure\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP12(2014)164\""}]}, {
