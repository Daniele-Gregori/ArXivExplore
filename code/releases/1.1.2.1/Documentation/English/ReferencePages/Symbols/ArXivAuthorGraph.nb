               RowBox[{"\"submitter\"", "\[Rule]", "\"Aritra Banerjee\""}]}, {
              
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Aritra Banerjee, Sagar Biswas, Kamal L Panigrahi\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On multi-spin classical strings with NS-NS flux\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"22 pages, 4 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP08(2018)053\""}]}, {
