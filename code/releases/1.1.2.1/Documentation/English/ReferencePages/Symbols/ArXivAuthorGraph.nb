                "\"title\"", "\[Rule]", 
                 "\"Thermodynamics of the quantum $su(1,1)$ Landau-Lifshitz \
model\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"10 pages\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1088/1742-5468/2010/06/P06007\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
