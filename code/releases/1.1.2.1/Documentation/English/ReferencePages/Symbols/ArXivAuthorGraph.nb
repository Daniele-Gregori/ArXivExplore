                "\"title\"", "\[Rule]", 
                 "\"The Effective Field Theory of Large Scale Structure at \
Three Loops\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"25 pages, 15 figs\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1475-7516/2019/11/027\""}]}, {
