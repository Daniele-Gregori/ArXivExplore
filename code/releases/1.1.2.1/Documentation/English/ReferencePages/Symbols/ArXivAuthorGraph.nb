                "\"title\"", "\[Rule]", 
                 "\"Magnons, their Solitonic Avatars and the Pohlmeyer \
Reduction\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"52 pages\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0904:060,2009\""}]}, {
               
