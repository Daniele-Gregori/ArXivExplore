               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"The Circular, Elliptic Three Spin String from the SU(3) \
Spin Chain\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"14 pages\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys.Lett. B596 (2004) 265-276\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.physletb.2004.06.099\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"NORDITA-2004-46\""}]}, {
              
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We complete the description of the circular, elliptic \
three spin string on\\nAdS_5 x S^5 having three large angular momenta \
(J_1,J_2,J_3) on S^5 in the\\nlanguage of the integrable SU(3) spin chain. \
First, we recover the string\\nsolution directly from the spin chain sigma \
model and secondly, we identify the\\nappropriate Bethe root configuration in \
the so far unexplored region of\\nparameter space.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
