               RowBox[{"\"submitter\"", "\[Rule]", "\"Simone Giombi\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Nadav Drukker, Simone Giombi, Riccardo Ricci, Diego \
Trancanelli\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On the D3-brane description of some 1/4 BPS Wilson \
loops\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"26 pages, 1 figure; v2: minor changes\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0704:008,2007\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2007/04/008\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
                 "\"HU-EP-06/46, YITP-SB-06-56, Imperial/TP/06/RR/01\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  Recently it has been proposed that Wilson loops in \
high-dimensional\\nrepresentations in N=4 supersymmetric Yang-Mills theory \
(or multiply wrapped\\nloops) are described by D-branes in AdS_5 x S^5, \
rather than by fundamental\\nstrings. Thus far explicit D3-brane solutions \
have been only found in the case\\nof the half-BPS circle or line. Here we \
present D3-brane solutions describing\\nsome 1/4 BPS loops. In one case, \
where the loop is conjectured to be given by a\\nGaussian matrix model, the \
action of the brane correctly reproduces the\\nexpectation value of the \
Wilson loop including all 1/N corrections at large\\n\\\\lambda. As in the \
corresponding string solution, here too we find two\\nclassical solutions, \
one stable and one not. The unstable one contributes\\nexponentially small \
corrections that agree with the matrix model calculation.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 15 Dec 2006 20:07:18 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 26 Mar 2007 14:47:26 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2010-10-27\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
