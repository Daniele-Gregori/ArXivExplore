               RowBox[{"\"authors\"", "\[Rule]", "\"Raphael Benichou\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"The Hirota equation for string theory in AdS5xS5 from the \
fusion of line\\n  operators\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"6 pages, 1 figure, Contribution to the proceedings of the \
\\\"XVII\\n  European Workshop on String Theory 2011\\\", Padova, Italy, 5-9 \
September 2011\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "\"10.1002/prop.201200024\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We present a perturbative derivation of the T-system \
that is believed to\\nencode the exact spectrum of planar N=4 SYM. The \
T-system is understood as an\\noperator identity between some special line \
operators, the quantum transfer\\nmatrices. By computing the quantum \
corrections in the process of fusion of\\ntransfer matrices, we show that the \
T-system holds up to first order in a\\nsemi-classical expansion. This \
derivation does not rely on any assumption. We\\nalso discuss the extension \
of the proof to other theories, including models\\ndescribing string theory \
on various AdS spaces.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 1 Feb 2012 02:29:18 GMT\""}]}], "}"}], "}"}]}]}, {
              
