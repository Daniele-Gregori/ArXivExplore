 Alessandro Torrielli", "title" -> 
            "The Effectiveness of Relativistic Invariance in AdS${}_3$", 
            "comments" -> "24 pages", "journal-ref" -> Null, "doi" -> 
            "10.1007/JHEP07(2019)105", "report-no" -> Null, "categories" -> 
