                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 15 Aug 2012 17:50:56 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
