               RowBox[{"\"authors\"", "\[Rule]", "\"P. Bozhilov\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Neumann and Neumann-Rosochatius integrable systems from \
membranes on\\n  AdS_4xS^7\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"LaTeX, 17 pages, no figures;v2: comments and citations \
added;v3: 20\\n  pages, new subsection, explanations, comments and references \
added; v4: some\\n  typos fixed, to appear in JHEP\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP0708:073,2007\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2007/08/073\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th nlin.SI\""}]}, {
              
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  It is known that large class of classical string \
solutions in the type IIB\\nAdS_5xS^5 background is related to the Neumann \
and Neumann-Rosochatius\\nintegrable systems, including spiky strings and \
giant magnons. It is also\\ninteresting if these integrable systems can be \
associated with some membrane\\nconfigurations in M-theory. We show here that \
this is indeed the case by\\npresenting explicitly several types of membrane \
embedding in AdS_4xS^7 with the\\nsearched properties.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
