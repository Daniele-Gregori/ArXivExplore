               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"The ground state of long-range Schrodinger equations and \
static\\n  $q\\\\bar{q}$ potential\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"30 pages, 1 figure\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP05(2016)040\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
