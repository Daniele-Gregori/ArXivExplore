theories\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"ii+56 pages, 20 figures. v2: references added. v3: \
clarifications and\\n  references added, published version\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"J. High Energ. Phys. 2021, 88 (2021)\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP07(2021)088\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
