                "\"comments\"", "\[Rule]", 
                 "\"1+19 pages; minor corrections, references added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP09(2011)056\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
