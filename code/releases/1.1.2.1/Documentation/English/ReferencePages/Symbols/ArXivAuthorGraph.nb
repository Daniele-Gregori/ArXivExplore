                "\"submitter\"", "\[Rule]", "\"Fedor Levkovich-Maslyuk\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Andrea Cavagli\\\\`a, Nikolay Gromov, Fedor \
Levkovich-Maslyuk\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Quantum Spectral Curve and Structure Constants in N=4 \
SYM: Cusps in the\\n  Ladder Limit\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"v1: 62 pages, lots of pictures; v2: section 9 expanded; \
v3: typos\\n  fixed\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP10(2018)060\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", "\"hep-th math-ph math.MP\""}]}, {
               
