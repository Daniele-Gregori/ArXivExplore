              "Melikyan", "A.", ""}, {"Sato", "Matsuo", ""}}}], "Tooltip"]& ], 
        TagBox[
         TooltipBox[DiskBox[{18.127156878459694`, -4.015064070295532}, 0.],
          TagBox[
           TagBox[
            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0508232\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Nelia Mann\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Nelia Mann and Joe Polchinski\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Bethe Ansatz for a Quantum Supercoset Sigma Model\""}]}, {
              
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"30 pages, 1 figure, v2: references added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys.Rev.D72:086002,2005\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1103/PhysRevD.72.086002\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We study an integrable conformal OSp(2m + 2|2m) \
supercoset model as an analog\\nto the AdS_5 X S^5 superstring world-sheet \
theory. Using the known S-matrix for\\nthis system, we obtain integral \
equations for states of large particle density\\nin an SU(2) sector, which \
are exact in the sigma model coupling constant. As a\\ncheck, we derive as a \
limit the general classical Bethe equation of Kazakov,\\nMarshakov, Minahan, \
and Zarembo. There are two distinct quantum expansions\\naround the \
well-studied classical limit, the lambda^{-1/2} effects and the \
1/J\\neffects. Our approach captures the first type, but not the \
second.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
