               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Exact boundary free energy of the open XXZ chain with \
arbitrary boundary\\n  conditions\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"35 pages, 2 figures; v2 (minor changes, accepted to \
appear in JSTAT)\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1742-5468/aae5a5\""}]}, {
