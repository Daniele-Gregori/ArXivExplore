                "\"authors\"", "\[Rule]", 
                 "\"Yasuyuki Hatsuda, Kazumi Okuyama\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Probing non-perturbative effects in M-theory\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"34 pages\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP10(2014)158\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
