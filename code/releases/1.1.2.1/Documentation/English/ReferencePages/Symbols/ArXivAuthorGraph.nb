                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Klose\"", ",", "\"Thomas\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Plefka\"", ",", "\"Jan\"", ",", "\"\""}], 
