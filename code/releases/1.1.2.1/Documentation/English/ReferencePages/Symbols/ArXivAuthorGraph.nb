              "version" -> "v4", "created" -> 
               "Mon, 29 Jul 2019 16:38:03 GMT"}}, "update_date" -> 
            "2019-07-30", 
            "authors_parsed" -> {{"Genolini", "Pietro Benetti", ""}, {
              "Richmond", "Paul", ""}, {"Sparks", "James", ""}}}], 
