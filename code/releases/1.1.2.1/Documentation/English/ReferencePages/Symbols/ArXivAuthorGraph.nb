                "\"title\"", "\[Rule]", 
                 "\"Integrable sigma models on Riemann surfaces\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"6 pages\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys. Rev. D 107 (2023) 085015\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1103/PhysRevD.107.085015\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
