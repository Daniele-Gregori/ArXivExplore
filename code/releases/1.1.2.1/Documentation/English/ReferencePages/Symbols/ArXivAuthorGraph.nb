               RowBox[{"\"id\"", "\[Rule]", "\"0806.2623\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Arkady Tseytlin\""}]}, {
              
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"M. Grigoriev and A.A. Tseytlin\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On reduced models for superstrings on AdS_n x S^n\""}]}, {
              
               RowBox[{"\"comments\"", "\[Rule]", "\"24 pages\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
