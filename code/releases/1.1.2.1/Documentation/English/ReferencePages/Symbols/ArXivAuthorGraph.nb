                "\"comments\"", "\[Rule]", 
                 "\"24 pages; v2: minor changes, published version\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 1809 (2018) 085\""}]}, {
              
               
