                "\"title\"", "\[Rule]", 
                 "\"8D-spectral triple on 4D-Moyal space and the vacuum of \
noncommutative\\n  gauge theory\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"LaTeX, 23 pages. Preface added which explains the \
mathematical\\n  achievements since v1; these are presented in \
arXiv:1108.2184. Incorrect\\n  section about field equations removed\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"J.Geom.Phys. 62 (2012) 1583-1599\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.geomphys.2012.03.005\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
