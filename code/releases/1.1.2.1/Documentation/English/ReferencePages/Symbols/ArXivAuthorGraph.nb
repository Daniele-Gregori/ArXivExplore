               RowBox[{
                "\"submitter\"", "\[Rule]", "\"S\\\\'ebastien Leurent\""}]}, {
              
               RowBox[{"\"authors\"", "\[Rule]", "\"Sebastien Leurent\""}]}, {
              
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Integrable systems and AdS/CFT duality\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"PhD thesis : 275 pages, including 10 introductory pages \
in french at\\n  the begining (repeated afterwards in english) v2 : typos \
fixed and five\\n  references added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
