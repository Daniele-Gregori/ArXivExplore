                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 29 Jul 2015 10:00:37 GMT\""}]}], "}"}], "}"}]}]}, {
