               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"latex, 2 figures. Expanded version of my talk at \
STRINGS'97, v3: more\\n  typos corrected\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys.Proc.Suppl. 68 (1998) 17-27\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1016/S0920-5632(98)00137-6\""}]}, {
