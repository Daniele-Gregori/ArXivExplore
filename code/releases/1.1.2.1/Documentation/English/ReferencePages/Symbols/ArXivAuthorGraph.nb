               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Worldsheet scattering in AdS(3)/CFT(2)\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"20 pages, 1 figure; v2: Some clarifications in comparison \
to\\n  literature\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP07(2013)007\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"MIFPA-13-08\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
