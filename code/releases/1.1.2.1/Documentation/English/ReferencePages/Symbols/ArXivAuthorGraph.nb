               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Nadav Drukker and Jan Plefka\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"The structure of n-point functions of chiral primary \
operators in N=4\\n  super Yang-Mills at one-loop\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"22 pages, v2: minor corrections and references added, \
version to\\n  appear in JHEP\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0904:001,2009\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2009/04/001\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"HU-EP-08/62\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We develop a compact representation of the one-loop \
n-point functions of all\\nchiral primary operators in planar SU(N), N=4 \
super Yang-Mills theory in terms\\nof tree-level disk correlation functions \
and the scalar one-loop box integral.\\nAs a check, known results for all \
four-point functions and for n-point extremal\\nand near-extremal correlators \
are rederived. The result is then used to\\nevaluate explicitly a selection \
of five and six-point functions. Our findings\\nsuggest that a general \
one-loop five-point function may be represented through\\nthe minimal \
four-point and five-point functions of weight two operators.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
