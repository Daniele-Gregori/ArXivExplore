               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0606287\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Benoit Vicedo\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Nick Dorey and Benoit Vicedo\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"A Symplectic Structure for String Theory on Integrable \
Backgrounds\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"41 pages, 2 figures; added references, corrected typos, \
improved\\n  discussion of Hamiltonian constraints\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0703:045,2007\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2007/03/045\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We define regularised Poisson brackets for the \
monodromy matrix of classical\\nstring theory on R x S^3. The ambiguities \
associated with Non-Ultra Locality\\nare resolved using the symmetrisation \
prescription of Maillet. The resulting\\nbrackets lead to an infinite tower \
of Poisson-commuting conserved charges as\\nexpected in an integrable system. \
The brackets are also used to obtain the\\ncorrect symplectic structure on \
the moduli space of finite-gap solutions and to\\ndefine the corresponding \
action-angle variables. The canonically-normalised\\naction variables are the \
filling fractions associated with each cut in the\\nfinite-gap construction. \
Our results are relevant for the leading-order\\nsemiclassical quantisation \
of string theory on AdS_5 x S^5 and lead to\\ninteger-valued filling \
fractions in this context.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
