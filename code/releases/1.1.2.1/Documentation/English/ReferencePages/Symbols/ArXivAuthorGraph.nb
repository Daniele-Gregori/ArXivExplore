                "\"journal-ref\"", "\[Rule]", 
                 "\"J.Phys.A41:285401,2008\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1088/1751-8113/41/28/285401\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"AEI-2008-017\""}]}, {
