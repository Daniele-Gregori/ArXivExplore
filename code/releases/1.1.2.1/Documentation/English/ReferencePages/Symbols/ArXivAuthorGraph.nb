               RowBox[{"\"id\"", "\[Rule]", "\"1608.02958\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Brian Willett\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Brian Willett\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Localization on three-dimensional manifolds\""}]}, {
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"This is a contribution to the review volume `Localization \
techniques\\n  in quantum field theories' (eds. V. Pestun and M. Zabzine) \
which contains 17\\n  Chapters. The complete volume is summarized in \
arXiv:1608.02952 and it can be\\n  downloaded at \
https://arxiv.org/src/1608.02952/anc/LocQFT.pdf or\\n  \
http://pestun.ihes.fr/pages/LocalizationReview/LocQFT.pdf\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1751-8121/aa612f\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", "\"hep-th math-ph math.MP\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  In this review article we describe the localization of \
three dimensional N=2\\nsupersymmetric theories on compact manifolds, \
including the squashed sphere,\\nS^3_b, the lens space, S^3_b/Z_p, and S^2 x \
S^1. We describe how to write\\nsupersymmetric actions on these spaces, and \
then compute the partition\\nfunctions and other supersymmetric observables \
by employing the localization\\nargument. We briefly survey some applications \
of these computations.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 9 Aug 2016 20:01:43 GMT\""}]}], "}"}], ",", 
