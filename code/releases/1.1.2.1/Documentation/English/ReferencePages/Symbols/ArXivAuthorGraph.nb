               RowBox[{"\"submitter\"", "\[Rule]", "\"Jorge Russo\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Jorge G. Russo\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"N=2 gauge theories and quantum phases\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"23 pages, 4 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP12(2014)169\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"ICCUB-14-065\""}]}, {
