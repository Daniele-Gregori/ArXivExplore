                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 26 Oct 2021 20:23:33 GMT\""}]}], "}"}], "}"}]}]}, {
