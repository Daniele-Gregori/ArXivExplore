                "\"title\"", "\[Rule]", 
                 "\"The low-energy limit of AdS$_3$/CFT$_2$ and its \
TBA\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"47 pages, 5 figures. v2: typos fixed, comments and \
clarifications\\n  added, matches the published version\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP10(2018)177\""}]}, {
