               "Mon, 26 Oct 2009 16:00:44 GMT"}}, "update_date" -> 
            "2014-11-20", 
            "authors_parsed" -> {{"Fredenhagen", "Stefan", ""}, {
              "Gaberdiel", "Matthias R.", ""}, {
              "Schmidt-Colinet", "Cornelius", ""}}}], "Tooltip"]& ], 
