               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Exact results for the six-vertex model with domain wall \
boundary\\n  conditions and a partially reflecting end\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"31 pages\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/s11005-022-01530-5\""}]}, {
