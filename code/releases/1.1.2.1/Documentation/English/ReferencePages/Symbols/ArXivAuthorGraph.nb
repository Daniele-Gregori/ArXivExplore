version\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 2006:115,2020\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP06(2020)115\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
