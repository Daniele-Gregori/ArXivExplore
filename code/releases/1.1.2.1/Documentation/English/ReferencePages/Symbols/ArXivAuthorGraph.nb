               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Towards the exact Bremsstrahlung function of ABJM \
theory\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"46 pages, 15 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
