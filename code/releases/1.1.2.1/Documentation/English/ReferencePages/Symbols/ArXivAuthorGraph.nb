                "\"title\"", "\[Rule]", 
                 "\"Quantum dispersion relations for excitations of long \
folded spinning\\n  superstring in AdS_5 x S^5\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"22 pages, 3 figures. v3: small corrections and a comment \
added in\\n  sec. 4.1\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 1101:128,2011\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP01(2011)128\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
