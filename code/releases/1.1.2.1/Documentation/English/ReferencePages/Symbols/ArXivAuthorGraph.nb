\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Form Factors and Correlation Functions of\\n  \
$\\\\mathrm{T}\\\\overline{\\\\mathrm{T}}$-Deformed Integrable Quantum Field \
Theories\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"29 Pages and 4 Figures. Version 2 contains a minor \
correction to\\n  Section 3. Version 3 contain various additional minor \
corrections\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", 
