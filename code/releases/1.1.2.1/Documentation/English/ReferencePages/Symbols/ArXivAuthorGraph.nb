                "\"title\"", "\[Rule]", 
                 "\"5d AGT correspondence of supergroup gauge theories from \
quantum toroidal\\n  $\\\\mathfrak{gl}_{1}$\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"62+27 pages, 10 figures, v2: fixed typos and added \
references\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP12(2022)157\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
