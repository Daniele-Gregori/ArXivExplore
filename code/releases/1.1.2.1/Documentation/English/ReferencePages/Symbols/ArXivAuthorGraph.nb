               RowBox[{"\"id\"", "\[Rule]", "\"math-ph/0411021\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Daniel Arnaudon\""}]}, {
              
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Daniel Arnaudon (LAPTH), Nicolas Crampe (LAPTH), \
Anastasia Doikou\\n  (LAPTH), Luc Frappat (LAPTH), Eric Ragoucy \
(LAPTH)\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Analytical Bethe Ansatz for closed and open gl(n)-spin \
chains in any\\n  representation\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"J.Stat.Mech.0502:P02007,2005\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1088/1742-5468/2005/02/P02007\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"LAPTH-1069/04\""}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", 
                 "\"math-ph cond-mat.str-el math.MP math.QA\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We present an \\\"algebraic treatment\\\" of the \
analytical Bethe Ansatz. For this\\npurpose, we introduce abstract monodromy \
and transfer matrices which provide an\\nalgebraic framework for the \
analytical Bethe Ansatz. It allows us to deal with\\na generic gl(n)-spin \
chain possessing on each site an arbitrary\\ngl(n)-representation. For open \
spin chains, we use the classification of the\\nreflection matrices to treat \
all the diagonal boundary cases. As a result, we\\nobtain the Bethe equations \
in their full generality for closed and open spin\\nchains. The \
classifications of finite dimensional irreducible representations\\nfor the \
Yangian (closed spin chains) and for the reflection algebras (open \
spin\\nchains) are directly linked to the calculation of the transfer \
matrix\\neigenvalues. As examples, we recover the usual closed and open spin \
chains, we\\ntreat the alternating spin chains and the closed spin chain with \
impurity.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 4 Nov 2004 20:04:50 GMT\""}]}], "}"}], "}"}]}]}, {
              
               RowBox[{"\"update_date\"", "\[Rule]", "\"2011-02-16\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Arnaudon\"", ",", "\"Daniel\"", ",", "\"\"", ",", 
                    "\"LAPTH\""}], "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Crampe\"", ",", "\"Nicolas\"", ",", "\"\"", ",", 
                    "\"LAPTH\""}], "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Doikou\"", ",", "\"Anastasia\"", ",", "\"\"", ",", 
                    "\"LAPTH\""}], "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Frappat\"", ",", "\"Luc\"", ",", "\"\"", ",", 
                    "\"LAPTH\""}], "}"}], ",", 
                    RowBox[{"{", 
                    
