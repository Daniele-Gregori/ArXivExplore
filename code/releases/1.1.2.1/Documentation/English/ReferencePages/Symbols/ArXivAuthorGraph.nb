               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Double-logs, Gribov-Lipatov reciprocity and \
wrapping\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"17 pages, references added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
