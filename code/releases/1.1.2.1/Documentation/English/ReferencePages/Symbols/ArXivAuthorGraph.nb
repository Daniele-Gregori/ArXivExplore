               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Correlators between Wilson loop and chiral operators in \
N=2 conformal\\n  gauge theories\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"37 pages, 10 figures. v2: typo corrected, 3 references \
added. Version\\n  to appear on JHEP\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP03(2018)193\""}]}, {
