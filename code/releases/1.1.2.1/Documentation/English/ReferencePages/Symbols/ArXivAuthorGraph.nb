                    RowBox[{"{", 
                    RowBox[{"\"Baffigo\"", ",", "\"Alberto\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Caselle\"", ",", "\"Michele\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
