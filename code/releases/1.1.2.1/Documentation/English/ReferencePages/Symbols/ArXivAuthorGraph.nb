               RowBox[{"\"id\"", "\[Rule]", "\"1307.7773\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Adi Armoni\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Adi Armoni, Maurizio Piai, Ali Teimouri\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Correlators of Circular Wilson Loops from \
Holography\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"12 pages, RevTex. 10 eps figures. v2,v3: minor \
corrections,\\n  references added. To appear in Phys.Rev.D\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1103/PhysRevD.88.066008\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th hep-lat\""}]}, {
              
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We study the correlators of two circular Wilson loops \
of different radii at\\nstrong coupling. In our setup one Wilson loop is \
located inside the other. We\\nuse holography to calculate the connected \
two-point function. Both an AdS\\nbackground and a confining background are \
considered. As the computation for\\nthe confining case cannot be carried out \
analytically we solve the problem\\nnumerically. In the AdS case our results \
agree with similar holographic\\ncalculations. In the case of a confining \
background we find an asymptotic area\\nlaw, in agreement with the result of \
the lattice strong coupling expansion. We\\nalso elaborate on the subtle \
issue of the interplay between connected and\\ndisconnected string \
worldsheets.\\n\""}]}, {
