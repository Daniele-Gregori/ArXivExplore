                "\"comments\"", "\[Rule]", 
                 "\"20 pages. Revised version accepted for publication in \
Nuclear Physics\\n  B\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nuclear Physics B 973(2021)115612\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
