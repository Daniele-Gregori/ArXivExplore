               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Perturbative solutions of ${\\\\cal N}=1^*$ holography on \
$S^4$\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"v2: 15 pages, 2 figures, added references and discussion \
on gaugino\\n  condensate etc, v3: typos corrected and comments added\""}]}, {
              
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 07 (2019) 169\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP07(2019)169\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
