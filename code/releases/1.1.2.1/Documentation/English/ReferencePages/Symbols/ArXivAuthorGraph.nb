               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"SIGMA 5 (2009), 013, 25 pages\""}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "\"10.3842/SIGMA.2009.013\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
