modifications\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Journal of High Energy Physics 2021.2 (2021): 1-60\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP02(2021)059\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
