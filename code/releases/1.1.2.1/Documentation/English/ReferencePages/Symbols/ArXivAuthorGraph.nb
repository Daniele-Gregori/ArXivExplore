               RowBox[{"\"id\"", "\[Rule]", "\"1506.01718\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Benjamin Assel\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
