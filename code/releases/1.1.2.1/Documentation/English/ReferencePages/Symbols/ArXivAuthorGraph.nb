               RowBox[{"\"id\"", "\[Rule]", "\"1212.5181\""}]}, {
               
               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Konstantin Wiegandt\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", "\"Konstantin Wiegandt\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Perturbative Methods for Superconformal Quantum Field \
Theories in String\\n  - Gauge Theory Dualities\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"phd-thesis of the author\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  This review covers a number of applications of \
conformal field theory methods\\nfor perturbative calculations in N=4 Super \
Yang-Mills and ABJM theory. After\\nmotivating the role of superconformal \
symmetry for elementary particle physics\\nresearch, we review some basic \
facts about conformal symmetry and conformal\\ntransformations of fields in a \
pedagogical manner. The implications for\\nperturbative quantum field theory \
calculations are discussed in terms of Ward\\nidentities. Recent developments \
and relations between amplitudes, correlators\\nand Wilson loops are reviewed \
for N=4 Super Yang-Mills as well as ABJM theory.\\nWe give more details on \
previously published results on light-like polygonal\\nWilson loops in ABJM \
theory as well as the calculation of three-point functions\\nof two BPS and \
one twist-two operator in N=4 Super Yang-Mills theory.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 20 Dec 2012 18:27:30 GMT\""}]}], "}"}], "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2012-12-21\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    
                    RowBox[{
                    "\"Wiegandt\"", ",", "\"Konstantin\"", ",", "\"\""}], 
                    "}"}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
