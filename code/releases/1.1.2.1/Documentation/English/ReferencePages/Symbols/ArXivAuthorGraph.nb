               RowBox[{"\"id\"", "\[Rule]", "\"1405.6087\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Olof Ohlsson Sax\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Andrei Babichenko, Amit Dekel, Olof Ohlsson Sax\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Finite-gap equations for strings on AdS_3 x S^3 x T^4 \
with mixed 3-form\\n  flux\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"44 pages, 3 figures. v2: references and a discussion \
about\\n  perturbative results added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP11(2014)122\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
                 "\"Imperial-TP-OOS-2014-02, UUITP-05/14\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We study superstrings on AdS_3 x S^3 x T^4 supported by \
a combination of\\nRamond-Ramond and Neveu-Schwarz-Neveu-Schwarz three form \
fluxes, and construct\\na set of finite-gap equations that describe the \
classical string spectrum.\\nUsing the recently proposed all-loop S-matrix we \
write down the all-loop Bethe\\nansatz equations for the massive sector. In \
the thermodynamic limit the Bethe\\nansatz reproduces the finite-gap \
equations. As part of this derivation we\\npropose expressions for the \
leading order dressing phases. These phases differ\\nfrom the well-known \
Arutyunov-Frolov-Staudacher phase that appears in the pure\\nRamond-Ramond \
case. We also consider the one-loop quantization of the algebraic\\ncurve and \
determine the one-loop corrections to the dressing phases. Finally \
we\\nconsider some classical string solutions including finite size giant \
magnons\\nand circular strings.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 23 May 2014 15:03:56 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 4 Jun 2014 16:55:33 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
