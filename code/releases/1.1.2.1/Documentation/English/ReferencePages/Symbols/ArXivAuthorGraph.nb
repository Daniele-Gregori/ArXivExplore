               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys. Rev. D 103, 106001 (2021)\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1103/PhysRevD.103.106001\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
