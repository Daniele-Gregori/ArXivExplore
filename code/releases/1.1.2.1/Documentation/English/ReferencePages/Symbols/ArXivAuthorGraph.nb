               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We calculate both at leading weak and strong coupling \
the renormalised\\nMaldacena-Wilson loop for contours formed by consecutive \
passage of two\\ntouching circles. At the touching point both circles should \
have the same\\nnormal direction but form cusps of non-zero opening angle $\\\
\\alpha$. Particular\\nemphasis is put on the behaviour in the limit \
$\\\\alpha\\\\rightarrow 0$ and its\\ncomparison with the spiky situation \
studied in a previous paper, where $\\\\alpha$\\nwas set to zero before \
renormalisation.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
