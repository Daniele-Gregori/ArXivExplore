               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Io Kawaguchi and Kentaroh Yoshida\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Hybrid classical integrability in squashed sigma \
models\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"12 pages, LaTeX, typos corrected and references added, \
further\\n  clarification added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.physletb.2011.09.117\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"KUNS-2350\""}]}, {
               
