                    RowBox[{"{", 
                    RowBox[{"\"Griguolo\"", ",", "\"Luca\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Seminara\"", ",", "\"Domenico\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
