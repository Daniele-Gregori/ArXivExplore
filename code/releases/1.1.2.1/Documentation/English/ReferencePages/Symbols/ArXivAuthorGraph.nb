               RowBox[{"\"id\"", "\[Rule]", "\"2101.10354\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Balazs Pozsgay\""}]}, {
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Tam\\\\'as Gombor, Bal\\\\'azs Pozsgay\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On factorized overlaps: Algebraic Bethe Ansatz, twists, \
and Separation\\n  of Variables\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"34 pages, 3 figures; v2: references added, minor \
modifications, v3:\\n  minor modification\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.nuclphysb.2021.115390\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
