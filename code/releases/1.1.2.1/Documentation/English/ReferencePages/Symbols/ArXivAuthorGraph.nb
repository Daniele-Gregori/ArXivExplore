                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{"\"Georgiou\"", ",", "\"George\"", ",", "\"\""}], 
                    "}"}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
