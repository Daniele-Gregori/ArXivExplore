               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On correlation functions in $J\\\\bar T$-deformed \
CFTs\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"26+7 pp\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1751-8121/ab0ef3\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
