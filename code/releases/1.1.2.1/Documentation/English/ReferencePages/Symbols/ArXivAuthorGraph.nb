            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0611014\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Rafael Hernandez\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Cesar Gomez, Rafael Hernandez\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Integrability and non-perturbative effects in the AdS/CFT \
correspondence\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"8 pages. Latex\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys.Lett.B644:375-378,2007\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.physletb.2006.12.007\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We present a non-perturbative resummation of the \
asymptotic strong-coupling\\nexpansion for the dressing phase factor of the \
AdS_5xS^5 string S-matrix. The\\nnon-perturbative resummation provides a \
general form for the coefficients in\\nthe weak-coupling expansion, in \
agreement with crossing symmetry and\\ntranscendentality. The ambiguities of \
the non-perturbative prescription are\\ndiscussed together with the \
similarities with the non-perturbative definition\\nof the c=1 matrix \
model.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
