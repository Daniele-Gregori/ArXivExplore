                RowBox[{"\"id\"", "\[Rule]", "\"hep-th/9705014\""}]}, {
                RowBox[{"\"submitter\"", "\[Rule]", "\"Leonid Chekhov\""}]}, {
               
                
                RowBox[{
                 "\"authors\"", "\[Rule]", 
                  "\"L. Chekhov and K. Zarembo\""}]}, {
                
                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Effective Action and Measure in Matrix Model of IIB \
Superstrings\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", 
                  "\"9pp., Latex; v2: the discussion of the large N limit of \
the induced\\n  measure is substantially expanded\""}]}, {
                
                RowBox[{
                 "\"journal-ref\"", "\[Rule]", 
                  "\"Mod.Phys.Lett. A12 (1997) 2331-2340\""}]}, {
                
                RowBox[{
                 "\"doi\"", "\[Rule]", "\"10.1142/S0217732397002417\""}]}, {
                RowBox[{"\"report-no\"", "\[Rule]", "\"ITEP-TH-18/97\""}]}, {
                RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
                RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
                
                RowBox[{
                 "\"abstract\"", "\[Rule]", 
                  "\"  We calculate an effective action and measure induced \
by the integration over\\nthe auxiliary field in the matrix model recently \
proposed to describe IIB\\nsuperstrings. It is shown that the measure of \
integration over the auxiliary\\nmatrix is uniquely determined by locality \
and reparametrization invariance of\\nthe resulting effective action. The \
large--$N$ limit of the induced measure for\\nstring coordinates is discussed \
in detail. It is found to be ultralocal and,\\nthus, possibly is irrelevant \
in the continuum limit. The model of the GKM type\\nis considered in relation \
to the effective action problem.\\n\""}]}, {
                RowBox[{"\"versions\"", "\[Rule]", 
                  RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Sun, 4 May 1997 14:25:46 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 15 Jul 1997 12:15:02 GMT\""}]}], "}"}]}], 
                    "}"}]}]}, {
                RowBox[{"\"update_date\"", "\[Rule]", "\"2009-10-30\""}]}, {
                RowBox[{"\"authors_parsed\"", "\[Rule]", 
                  RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Chekhov\"", ",", "\"L.\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Zarembo\"", ",", "\"K.\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
