               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Two Polyakov Loop Correlators from D5-branes at Finite \
Temperature\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"12 pages, 2 figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Prog.Theor.Phys.118:97-107,2007\""}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "\"10.1143/PTP.118.97\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"UT-06-26\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We study two Polyakov loop correlators in large $N$ \
limit of ${\\\\cal{N}}=4$\\nsuper Yang-Mills theory at finite temperature \
using the AdS-Schwarzschild black\\nhole. In the case that one of the two \
loops is of the anti-symmetric\\nrepresentation, we use D5-branes to evaluate \
them. The phase structure of these\\ncorrelators is also examined. A previous \
result, derived in hep-th/9803135 and\\nhep-th/9803137, is realized as a \
limiting case.}\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
