               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Imtak Jeon and Sameer Murthy\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Twisting and localization in supergravity: equivariant \
cohomology of BPS\\n  black holes\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"V2: subsection 4.3 added, typo corrected, accepted \
version in JHEP;\\n  V3: typos corrected; V4: minor typos corrected\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP03(2019)140\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
