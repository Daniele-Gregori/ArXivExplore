                "\"title\"", "\[Rule]", 
                 "\"On the mass of the glueballonium\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"5 pages, 3 figures, talk presented at \\\"HADRON \
2021\\\", needs rmf-d.cls\\n  and rmfbib.sty\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
