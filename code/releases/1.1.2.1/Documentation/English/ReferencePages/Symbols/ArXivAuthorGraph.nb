               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We study compactifications of the 6d E-string theory, \
the theory of a small\\nE_8 instanton, to four dimensions. In particular we \
identify N=1 field theories\\nin four dimensions corresponding to \
compactifications on arbitrary Riemann\\nsurfaces with punctures and with \
arbitrary non-abelian flat connections as well\\nas fluxes for the abelian \
sub-groups of the E_8 flavor symmetry. This sheds\\nlight on emergent \
symmetries in a number of 4d N=1 SCFTs (including the `E7\\nsurprise' theory) \
as well as leads to new predictions for a large number of\\n4-dimensional \
exceptional dualities and symmetries.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 8 Sep 2017 01:17:23 GMT\""}]}], "}"}], "}"}]}]}, {
              
