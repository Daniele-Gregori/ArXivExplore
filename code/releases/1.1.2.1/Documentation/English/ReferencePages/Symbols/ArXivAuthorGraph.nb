                    RowBox[{
                    "\"Calabrese\"", ",", "\"Pasquale\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Bertini\"", ",", "\"Bruno\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
