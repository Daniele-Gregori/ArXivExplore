                "\"title\"", "\[Rule]", 
                 "\"Bubbling geometries for AdS_2 x S^2\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"67 pages. V2: references added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
