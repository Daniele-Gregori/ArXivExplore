               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Hasmik Poghosyan Mrs\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Davide Fioravanti, Hasmik Poghosyan and Rubik \
Poghossian\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"A Young diagram expansion of the hexagonal Wilson loop \
(amplitude) in\\n  ${\\\\cal N}=4$ SYM\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"40 pages, 7 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP10(2021)154\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
