                "\"comments\"", "\[Rule]", "\"53 pages, 1 figure\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP01(2017)101\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
