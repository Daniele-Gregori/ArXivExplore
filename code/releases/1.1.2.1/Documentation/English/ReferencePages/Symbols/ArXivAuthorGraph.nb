               RowBox[{"\"authors\"", "\[Rule]", "\"Axel de Goursac\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Renormalization of the commutative scalar theory with \
harmonic term to\\n  all orders\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"16 pages\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Annales Henri Poincare 14 (2013) 2025-2043\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/s00023-012-0226-4\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
