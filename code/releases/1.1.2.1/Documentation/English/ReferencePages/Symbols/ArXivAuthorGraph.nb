               RowBox[{"\"id\"", "\[Rule]", "\"1601.05679\""}]}, {
               
               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Fedor Levkovich-Maslyuk\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Nikolay Gromov, Fedor Levkovich-Maslyuk\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Quark--anti-quark potential in N=4 SYM\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"31 pages, 1 figure; v2: minor correctons\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 1612 (2016) 122\""}]}, {
              
               
