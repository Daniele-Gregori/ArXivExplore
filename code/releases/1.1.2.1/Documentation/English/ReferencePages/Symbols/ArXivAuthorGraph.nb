               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Master Field on Fuzzy Sphere\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"21 pages, LaTex, no figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys. B543 (1999) 466-484\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1016/S0550-3213(98)00815-3\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"UT-Komaba/98-9\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  The O(N) symmetric vector model is considered on both \
ordinary and fuzzy\\nsphere. It is shown that in both cases master fields \
exist and their explicit\\nforms are presented. They are found to mix the \
internal symmetry and the\\n(fuzzy) space-time symmetry. It is also argued \
that the cutoff brought by the\\nfuzzy sphere plays an essential role in \
constructing the master field.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 6 Apr 1998 10:59:44 GMT\""}]}], "}"}], "}"}]}]}, {
              
