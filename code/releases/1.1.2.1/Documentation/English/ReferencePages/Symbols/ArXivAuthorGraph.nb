               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Michelangelo Preti\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Michelangelo Preti\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"WiLE: a Mathematica package for weak coupling expansion \
of Wilson loops\\n  in ABJ(M) theory\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"35 pages, 4 figures and 1 table, comments added. To \
appear in Comput.\\n  Phys. Commun\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1016/j.cpc.2017.12.011\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We present WiLE, a Mathematica package designed to \
perform the weak coupling\\nexpansion of any Wilson loop in ABJ(M) theory at \
arbitrary perturbative order.\\nFor a given set of fields on the loop and \
internal vertices, the package\\ndisplays all the possible Feynman diagrams \
and their integral representations.\\nThe user can also choose to exclude non \
planar diagrams, tadpoles and\\nself-energies. Through the use of interactive \
input windows, the package should\\nbe easily accessible to users with little \
or no previous experience. The\\npackage manual provides some pedagogical \
examples and the computation of all\\nladder diagrams at three-loop relevant \
for the cusp anomalous dimension in\\nABJ(M). The latter application gives \
also support to some recent results\\ncomputed in different \
contexts.\\n\""}]}, {
