               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Oscillating Strings and Non-Abelian T-dual \
Klebanov-Witten Background\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
