Zafrir\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Rank $Q$ E-string on a torus with flux\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"54 pages, 21 figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"SciPost Phys. 8, 014 (2020)\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.21468/SciPostPhys.8.1.014\""}]}, {
              
