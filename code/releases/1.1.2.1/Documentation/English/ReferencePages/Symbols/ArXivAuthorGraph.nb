                 "\"More on Wilson loops for two touching circles\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"18 pages, 8 figures, references added, text as appeared \
in JHEP\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 07 (2019) 088\""}]}, {
               
