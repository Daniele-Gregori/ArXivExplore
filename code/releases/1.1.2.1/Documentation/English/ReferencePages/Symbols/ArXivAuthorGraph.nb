                 "\"Universal structure of subleading infrared poles at \
strong coupling\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"13 pages\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0907:047,2009\""}]}, {
