               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"The String Landscape, the Swampland, and the Missing \
Corner\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", "\"IFT-UAM/CSIC-17-105\""}]}, {
