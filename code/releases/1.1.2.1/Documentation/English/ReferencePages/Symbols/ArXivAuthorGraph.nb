               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Planar N=4 gauge theory and the Inozemtsev long range \
spin chain\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"31 pages, no figure; v1: one reference added, minor \
changes; v2:\\n  slightly extended discussion of rapidity, references \
added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0406 (2004) 001\""}]}, {
              
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2004/06/001\""}]}, {
               
