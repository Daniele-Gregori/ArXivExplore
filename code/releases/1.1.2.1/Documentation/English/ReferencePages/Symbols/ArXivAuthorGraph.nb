                     ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"van Tongeren\"", ",", "\"Stijn J.\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
