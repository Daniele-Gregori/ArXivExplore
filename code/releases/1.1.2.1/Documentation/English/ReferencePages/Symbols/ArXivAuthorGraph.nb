                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Beisert\"", ",", "\"Niklas\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Eden\"", ",", "\"Burkhard\"", ",", "\"\""}], 
