                "\"submitter\"", "\[Rule]", "\"Martin Kruczenski\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Martin Kruczenski\""}]}, {
              
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"A note on twist two operators in N=4 SYM and Wilson loops \
in Minkowski\\n  signature\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"16 pages, 4 figures, LaTeX. v2: References added. Some \
corrections\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP0212:024,2002\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2002/12/024\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  Recently the anomalous dimension of twist two operators \
in N=4 SYM theory was\\ncomputed by Gubser, Klebanov and Polyakov in the \
limit of large 't Hooft\\ncoupling using semi-classical rotating strings in \
AdS_5. Here we reproduce\\ntheir results for large angular momentum by using \
the cusp anomaly of Wilson\\nloops in Minkowski signature also computed \
within the AdS/CFT correspondence.\\nIn this case the anomalous dimension is \
related to an Euclidean worldsheet\\nwhose properties are completely \
determined by the symmetries of the problem.\\nThis gives support to the \
proposed identification of rotating strings and twist\\ntwo \
operators.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
