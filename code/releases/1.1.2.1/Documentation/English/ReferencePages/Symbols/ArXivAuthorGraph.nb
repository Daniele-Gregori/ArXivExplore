               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Three loop anomalous dimensions of twist-3 gauge \
operators in N=4 SYM\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"20 pages, JHEP style\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0709:023,2007\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2007/09/023\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We propose a closed expression for the three loop \
anomalous dimension of a\\nclass of twist-3 operators built with gauge fields \
and covariant derivatives.\\nTo this aim, we solve the long-range Bethe \
Ansatz equations at finite spin and\\nprovide a consistent analytical formula \
obtained assuming maximal\\ntranscendentality violation as suggested by the \
known one-loop anomalous\\ndimension. The final result reproduces the \
universal cusp anomalous dimension\\nand obeys recursion relations inspired \
by the principle of reciprocity\\ninvariance.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
