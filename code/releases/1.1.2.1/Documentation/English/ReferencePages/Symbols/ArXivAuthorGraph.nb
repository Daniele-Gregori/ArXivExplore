                 "\"Ward identities and consistency relations for the large \
scale structure\\n  with multiple species\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"Published version\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
