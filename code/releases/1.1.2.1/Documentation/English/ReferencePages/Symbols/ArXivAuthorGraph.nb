               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Holographic Thermal Observables and M2-branes\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"22 pages; v2: additional comments included, accepted for \
publication\\n  in JHEP\""}]}, {
