               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"The Anatomy of Gauge/String Duality in Lunin-Maldacena \
Background\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"1+31 pages, 3 figures, references added, typos corrected, \
discussion\\n  on constraints and free parameters in spin-chain analysis \
added and corrected\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP0602:054,2006\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2006/02/054\""}]}, {
