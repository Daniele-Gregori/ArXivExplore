               RowBox[{"\"authors\"", "\[Rule]", "\"Arpad Hegedus\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Lattice approach to finite volume form-factors of the \
Massive\\n  Thirring/Sine-Gordon model\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP08(2017)059\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  In this paper we demonstrate, that the light-cone \
lattice approach for the\\nMassive-Thirring (sine-Gordon) model, through the \
quantum inverse scattering\\nmethod, admits an appropriate framework for \
computing the finite volume\\nform-factors of local operators of the model. \
In this work we compute the\\nfinite volume diagonal matrix elements of the \
$U(1)$ conserved current in the\\npure soliton sector of the theory. Based on \
the systematic large volume\\nexpansion of our results, we conjecture an \
exact expression for the finite\\nvolume expectation values of local \
operators in pure soliton states. At large\\nvolume in leading order these \
expectation values have the same form as in\\npurely elastic scattering \
theories, but exponentially small corrections differ\\nfrom previous \
Thermodynamic Bethe Ansatz conjectures of purely elastic\\nscattering \
theories.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Sun, 30 Apr 2017 14:25:43 GMT\""}]}], "}"}], "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2017-09-13\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{"\"Hegedus\"", ",", "\"Arpad\"", ",", "\"\""}], 
                    "}"}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
             Left, ColumnAlignments -> Left], Column], 
