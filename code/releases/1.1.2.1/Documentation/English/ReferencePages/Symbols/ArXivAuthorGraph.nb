               RowBox[{"\"authors\"", "\[Rule]", "\"David Berenstein\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"A matrix model for a quantum hall droplet with manifest \
particle-hole\\n  symmetry\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"25 pages, uses JHEP format, young.sty (included). v2: \
Updated\\n  references, typos corrected\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys.Rev. D71 (2005) 085001\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1103/PhysRevD.71.085001\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", 
                 "\"hep-th cond-mat.mes-hall\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We find that a gauged matrix model of rectangular \
fermionic matrices (a\\nmatrix version of the fermion harmonic oscillator) \
realizes a quantum hall\\ndroplet with manifest particle-hole symmetry. The \
droplet consists of free\\nfermions on the topology of a sphere. It is also \
possible to deform the\\nHamiltonian by double trace operators, and we argue \
that this device can\\nproduce two body potentials which might lead the \
system to realize a fractional\\nquantum hall state on the sphere. We also \
argue that a single gauged fermionic\\nquantum mechanics of hermitian \
matrices realizes a droplet with an edge that\\nhas $c=1/2$ CFT on \
it.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 10 Sep 2004 19:02:28 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 23 Sep 2004 18:07:40 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2009-11-10\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{"\"Berenstein\"", ",", "\"David\"", ",", "\"\""}],
                     "}"}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
