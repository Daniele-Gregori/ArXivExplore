               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"58 pages, typos corrected, the final version to appear in \
CMP\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Commun.Math.Phys. 377 (2020) 1, 341-385\""}]}, {
               
