               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"D-brane Scattering in IIB String Theory and IIB Matrix \
Model\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"35 pages, Latex, Pictex\""}]}, {
              
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys. B551 (1999) 617-649\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1016/S0550-3213(99)00073-5\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We consider two Dirichlet p-branes with lower \
dimensional brane charges and\\ntheir scattering. We first calculate the \
cylinder amplitude of open string with\\nsuitable boundary conditions. We \
compare this result with that in the IIB\\nmatrix model. We find the \
agreement between them in the long distance, low\\nvelocity, or large field \
limit. We also find a way to investigate more general\\nboundary conditions \
for open string.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
