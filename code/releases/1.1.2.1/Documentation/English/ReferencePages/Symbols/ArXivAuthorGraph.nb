               RowBox[{"\"id\"", "\[Rule]", "\"1706.05364\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"K V Pavan Kumar\""}]}, {
              
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Chethan Krishnan, K.V. Pavan Kumar\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Towards a Finite-$N$ Hologram\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"16 pages\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP10(2017)099\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", 
