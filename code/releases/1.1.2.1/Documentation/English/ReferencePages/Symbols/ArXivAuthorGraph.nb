                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Buchbinder\"", ",", "\"I. L.\"", ",", "\"\""}],
                     "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Ivanov\"", ",", "\"E. A.\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Samsonov\"", ",", "\"I. B.\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
