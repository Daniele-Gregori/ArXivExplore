               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/9906220\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Igor Klebanov\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Igor R. Klebanov\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Tachyon Stabilization in the AdS/CFT \
Correspondence\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"10 pages, harvmac; v2: 1 minor clarification, 1 reference \
added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys.Lett. B466 (1999) 166-170\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1016/S0370-2693(99)01084-9\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"PUPT-1874\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We consider duality between type 0B string theory on \
$AdS_5\\\\times S^5$ and\\nthe planar CFT on $N$ electric D3-branes \
coincident with $N$ magnetic\\nD3-branes. It has been argued that this theory \
is stable up to a critical value\\nof the `t Hooft coupling but is unstable \
beyond that point. We suggest that\\nfrom the gauge theory point of view the \
development of instability is\\nassociated with singularity in the dimension \
of the operator corresponding to\\nthe tachyon field via the AdS/CFT map. \
Such singularities are common in large\\n$N$ theories because summation over \
planar graphs typically has a finite radius\\nof convergence. Hence we expect \
transitions between stability and instability\\nfor string theories in AdS \
backgrounds that are dual to certain large $N$ gauge\\ntheories: if there are \
tachyons for large AdS radius then they may be\\nstabilized by reducing the \
radius below a critical value of order the string\\nscale.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 28 Jun 1999 19:57:11 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 9 Jul 1999 20:52:56 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2009-10-31\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{"\"Klebanov\"", ",", "\"Igor R.\"", ",", "\"\""}],
                     "}"}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
