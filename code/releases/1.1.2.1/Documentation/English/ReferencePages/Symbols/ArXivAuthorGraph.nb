                    RowBox[{"{", 
                    RowBox[{"\"Singh\"", ",", "\"Ashmeet\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Carroll\"", ",", "\"Sean M.\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
