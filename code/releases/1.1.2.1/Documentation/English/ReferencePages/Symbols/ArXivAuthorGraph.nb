               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Petr P. Kulish, Anton M. Zeitlin\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Superconformal Field Theory and SUSY N=1 KdV Hierarchy I: \
Vertex\\n  Operators and Yang-Baxter Equation\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"LaTeX2e, elsart.cls, 11 pages, subm. to Physics Letters B\
\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys.Lett.B597:229-236,2004\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.physletb.2004.07.019\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", "\"hep-th math.QA nlin.SI\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  The supersymmetry invariant integrable structure of \
two-dimensional\\nsuperconformal field theory is considered. The classical \
limit of the\\ncorresponding infinite family of integrals of motion (IM) \
coincide with the\\nfamily of IM of SUSY N=1 KdV hierarchy. The quantum \
version of the monodromy\\nmatrix, generating quantum IM, associated with the \
SUSY N=1 KdV is constructed\\nvia vertex operator representation of the \
quantum R-matrix. The possible\\napplications to the perturbed superconformal \
models are discussed.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
