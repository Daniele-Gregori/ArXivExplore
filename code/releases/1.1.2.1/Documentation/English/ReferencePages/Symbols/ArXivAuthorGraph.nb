            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0603038\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Romuald A. Janik\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Romuald A. Janik\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"The AdS_5xS^5 superstring worldsheet S-matrix and \
crossing symmetry\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"27 pages, no figures; v2: sign typo fixed in (24), \
everything else\\n  unchanged\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys.Rev.D73:086006,2006\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1103/PhysRevD.73.086006\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", 
                 "\"hep-th math-ph math.MP math.QA\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  An S-matrix satisying the Yang-Baxter equation with \
symmetries relevant to\\nthe AdS_5xS^5 superstring has recently been \
determined up to an unknown scalar\\nfactor. Such scalar factors are \
typically fixed using crossing relations,\\nhowever due to the lack of \
conventional relativistic invariance, in this case\\nits determination \
remained an open problem.\\n  In this paper we propose an algebraic way to \
implement crossing relations for\\nthe AdS_5xS^5 superstring worldsheet \
S-matrix. We base our construction on a\\nHopf-algebraic formulation of \
crossing in terms of the antipode and introduce\\ngeneralized rapidities \
living on the universal cover of the parameter space\\nwhich is constructed \
through an auxillary, coupling constant dependent,\\nelliptic curve. We \
determine the crossing transformation and write functional\\nequations for \
the scalar factor of the S-matrix in the generalized \
rapidity\\nplane.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 6 Mar 2006 14:39:12 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 11 Jan 2007 13:56:10 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
