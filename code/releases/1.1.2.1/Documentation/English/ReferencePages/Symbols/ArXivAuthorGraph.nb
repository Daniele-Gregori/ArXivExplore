               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"A correspondence between the quantum K theory and quantum \
cohomology of\\n  Grassmannians\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"36 pages\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
