                    RowBox[{"\"version\"", "\[Rule]", "\"v3\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 21 Mar 2007 19:10:00 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
