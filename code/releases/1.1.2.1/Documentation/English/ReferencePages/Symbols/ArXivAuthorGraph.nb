               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Generalised Born-Infeld models, Lax operators and the $\\\
\\textrm{T}\\n  \\\\bar{\\\\textrm{T}}$ perturbation\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"22 pages, 2 figures, v2: new comments, hyperlinks and \
minor typos\\n  corrected\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP11(2018)007\""}]}, {
