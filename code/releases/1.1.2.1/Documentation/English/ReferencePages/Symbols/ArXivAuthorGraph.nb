                "\"comments\"", "\[Rule]", 
                 "\"Latex, 13 pages, 2 figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0001:042,2000\""}]}, {
               
