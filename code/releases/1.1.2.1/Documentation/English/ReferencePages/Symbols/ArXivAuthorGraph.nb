               "Fri, 20 Sep 2019 18:16:19 GMT"}}, "update_date" -> 
            "2019-09-24", 
            "authors_parsed" -> {{"Hanada", "Masanori", ""}, {
              "Ishiki", "Goro", ""}, {"Watanabe", "Hiromasa", ""}}}], 
          "Tooltip"]& ], 
