               RowBox[{
                "\"authors\"", "\[Rule]", "\"N. Beisert, F. Spill\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"The Classical r-matrix of AdS/CFT and its Lie Bialgebra \
Structure\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"31 pages, v2: added comment on classical double structure \
in 4.5. new\\n  section 5 on relation to other algebras (from old appendix \
and new results).\\n  fixed typos and mathematical inaccuracies, added \
references, v3: improved\\n  mathematical presentation, to appear in \
CMP\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Commun.Math.Phys.285:537-565,2009\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/s00220-008-0578-2\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
                 "\"AEI-2007-116, HU-EP-07/31\""}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", "\"hep-th math.QA nlin.SI\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  In this paper we investigate the algebraic structure of \
AdS/CFT in the\\nstrong-coupling limit. We propose an expression for the \
classical r-matrix with\\n(deformed) u(2|2) symmetry, which leads to a \
quasi-triangular Lie bialgebra as\\nthe underlying symmetry algebra. On the \
fundamental representation our r-matrix\\ncoincides with the classical limit \
of the quantum R-matrix.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 13 Aug 2007 19:54:50 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
