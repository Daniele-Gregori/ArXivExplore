                RowBox[{
                 "\"report-no\"", "\[Rule]", 
                  "\"NBI-HE-96-20, ITEP-TH-15/96, SMI-96-3\""}]}, {
                
                RowBox[{
                 "\"categories\"", "\[Rule]", 
                  "\"cond-mat hep-lat hep-th\""}]}, {
                RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
                
                RowBox[{
                 "\"abstract\"", "\[Rule]", 
                  "\"  We solve a supersymmetric matrix model with a general \
potential. While matrix\\nmodels usually describe surfaces, supersymmetry \
enforces a cancellation of\\nbosonic and fermionic loops and only diagrams \
corresponding to so-called\\nbranched polymers survive. The eigenvalue \
distribution of the random matrices\\nnear the critical point is of a new \
kind.\\n\""}]}, {
                RowBox[{"\"versions\"", "\[Rule]", 
                  RowBox[{"{", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 7 Jun 1996 09:17:36 GMT\""}]}], "}"}], "}"}]}]}, {
               
