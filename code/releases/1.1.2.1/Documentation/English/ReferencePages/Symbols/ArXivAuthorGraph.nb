               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Determinantal Calabi-Yau varieties in Grassmannians and \
the Givental\\n  $I$-functions\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"50 pages\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
