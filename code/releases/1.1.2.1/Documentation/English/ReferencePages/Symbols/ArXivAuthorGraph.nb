                "\"title\"", "\[Rule]", 
                 "\"All-loop Bethe ansatz equations for AdS3/CFT2\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"26 pages, 2 figures. v2: references added. v3: changed \
notation for\\n  the crossing equations, added references. Published \
version\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 1304 (2013) 116\""}]}, {
              
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP04(2013)116\""}]}, {
               
