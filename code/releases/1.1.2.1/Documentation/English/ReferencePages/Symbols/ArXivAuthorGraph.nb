               RowBox[{"\"id\"", "\[Rule]", "\"1808.02040\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Hans Jockers\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Hans Jockers and Peter Mayr\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"A 3d Gauge Theory/Quantum K-Theory Correspondence\""}]}, {
              
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"111 pages, v2: references added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               
