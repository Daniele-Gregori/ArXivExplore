                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Arutyunov\"", ",", "\"G.\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Frolov\"", ",", "\"S.\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
