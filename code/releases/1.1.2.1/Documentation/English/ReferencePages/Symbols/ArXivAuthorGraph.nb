               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Robert Andrew Weston\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Marco Rossi and Robert Weston\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"A Generalized Q-operator for U_q(\\\\hat(sl_2)) Vertex \
Models\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"22 pages, Latex2e. This replacement is a revised version \
that\\n  includes a simple explicit expression for the Q matrix for the \
6-vertex model\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"J.Phys.A35:10015-10032,2002\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/0305-4470/35/47/304\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"EMPG-02-13\""}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", 
                 "\"math-ph cond-mat.stat-mech hep-th math.MP math.QA\""}]}, {
              
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  In this paper, we construct a Q-operator as a trace of \
a representation of\\nthe universal R-matrix of $U_q(\\\\hat{sl}_2)$ over an \
infinite-dimensional\\nauxiliary space. This auxiliary space is a \
four-parameter generalization of the\\nq-oscillator representations used \
previously. We derive generalized T-Q\\nrelations in which 3 of these \
parameters shift. After a suitable restriction of\\nparameters, we give an \
explicit expression for the Q-operator of the 6-vertex\\nmodel and show the \
connection with Baxter's expression for the central block of\\nhis \
corresponding operator.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 1 Jul 2002 14:44:39 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 2 Oct 2002 15:13:19 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
