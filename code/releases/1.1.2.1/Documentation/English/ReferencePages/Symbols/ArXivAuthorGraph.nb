               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Domenico Seminara\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Antonio Bassetto (Padua U., INFN), Luca Griguolo (Parma \
U., INFN),\\n  Fabrizio Pucci (Florence U., INFN) and Domenico Seminara \
(Florence U., INFN)\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Supersymmetric Wilson loops at two loops\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"35 pages, 14 figures, typos corrected, references \
added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0806:083,2008\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2008/06/083\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We study the quantum properties of certain BPS Wilson \
loops in ${\\\\cal N}=4$\\nsupersymmetric Yang-Mills theory. They belong to a \
general family, introduced\\nrecently, in which the addition of particular \
scalar couplings endows generic\\nloops on $S^3$ with a fraction of \
supersymmetry. When restricted to $S^2$,\\ntheir quantum average has been \
further conjectured to be exactly computed by\\nthe matrix model governing \
the zero-instanton sector of YM$_2$ on the sphere.\\nWe perform a complete \
two-loop analysis on a class of cusped Wilson loops lying\\non a \
two-dimensional sphere, finding perfect agreement with the conjecture. \
The\\nperturbative computation reproduces the matrix-model expectation \
through a\\nhighly non-trivial interplay between ladder diagrams and \
self-energies/vertex\\ncontributions, suggesting the existence of a \
localization procedure.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 24 Apr 2008 19:52:32 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
