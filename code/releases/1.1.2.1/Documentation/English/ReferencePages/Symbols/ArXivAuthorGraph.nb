Yassen S. Stanev\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On Operator Mixing in N=4 SYM\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"32 pages, 2 figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys. B646 (2002) 69-101\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1016/S0550-3213(02)00817-9\""}]}, {
