               RowBox[{"\"id\"", "\[Rule]", "\"hep-ph/0105150\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Thomas Schaefer\""}]}, {
              
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"P. F. Bedaque (LBL) and T. Schaefer (SUNY Stony Brook and \
Riken BNL)\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"High Density Quark Matter under Stress\""}]}, {
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"29 pages, 4 figures, minor corrections\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys.A697:802-822,2002\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1016/S0375-9474(01)01272-6\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-ph nucl-th\""}]}, {
              
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We study the effect of SU(3) flavor breaking on high \
density quark matter. We\\ndiscuss, in particular, the effect a non-zero \
electron chemical potential and a\\nfinite strange quark mass. We argue that \
these perturbations trigger pion or\\nkaon condensation. The critical \
chemical potential behaves as $\\\\mu_e\\\\sim\\\\sqrt{m\\nm_s} \
\\\\Delta/p_F$ and the critical strange quark mass as $m_s \\\\sim m^{1/3}\\n\
\\\\Delta^{2/3}$, where $m$ is the light quark mass, $\\\\Delta$ is the gap, \
and\\n$p_F$ is the Fermi momentum. We note that parametrically, both the \
critical\\n$\\\\mu_e$ and $m_s^2/(2p_F)$ are much smaller than the \
gap.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
