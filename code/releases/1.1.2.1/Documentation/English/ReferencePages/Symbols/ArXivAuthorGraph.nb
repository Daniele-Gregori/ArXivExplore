               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"v1: 18 pages; v2 & v3: 19 pages, title changed, sections \
1 and 2\\n  updated, references added, journal-ref added; v4: typos \
corrected, minor\\n  changes to text (published version)\""}]}, {
               
