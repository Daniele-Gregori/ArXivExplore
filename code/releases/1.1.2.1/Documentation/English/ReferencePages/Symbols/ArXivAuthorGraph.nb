            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0603175\""}]}, {
               
               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Joseph A. Minahan\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Joseph A. Minahan\""}]}, {
              
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Strong coupling from the Hubbard model\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"14 pages; v2: 17 pages, 2 figures, appendix and \
references added;\\n  typos fixed, minor changes; v3 fixed figures; v4 more \
references added, minor\\n  correction\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"J.Phys.A39:13083-13094,2006\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/0305-4470/39/41/S16\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"HUTP-06/A0008\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  It was recently observed that the one dimensional \
half-filled Hubbard model\\nreproduces the known part of the perturbative \
spectrum of planar N=4 super\\nYang-Mills in the SU(2) sector. Assuming that \
this identification is valid\\nbeyond perturbation theory, we investigate the \
behavior of this spectrum as the\\n't Hooft parameter \\\\lambda becomes \
large. We show that the full dimension\\n\\\\Delta of the Konishi \
superpartner is the solution of a sixth order polynomial\\nwhile \\\\Delta \
for a bare dimension 5 operator is the solution of a cubic. In\\nboth cases \
the equations can be solved easily as a series expansion for both\\nsmall and \
large \\\\lambda and the equations can be inverted to express \\\\lambda \
as\\nan explicit function of \\\\Delta. We then consider more general \
operators and\\nshow how \\\\Delta depends on \\\\lambda in the strong \
coupling limit. We are also\\nable to distinguish those states in the Hubbard \
model which correspond to the\\ngauge invariant operators for all values of \
\\\\lambda. Finally, we compare our\\nresults with known results for strings \
on AdS_5\\\\times S^5, where we find\\nagreement for a range of R-charges.\\n\
\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 22 Mar 2006 20:31:34 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 28 Mar 2006 18:31:16 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v3\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 29 Mar 2006 16:06:13 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v4\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 3 Apr 2006 18:17:02 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2009-11-11\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    
