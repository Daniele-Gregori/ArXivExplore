                "\"title\"", "\[Rule]", 
                 "\"Structure constants of heavy operators in ABJM/ABJ Theory\
\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"1+22 pages, 3 Figures\""}]}, {
               
