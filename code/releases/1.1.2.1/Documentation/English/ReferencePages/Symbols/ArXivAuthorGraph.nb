               RowBox[{"\"id\"", "\[Rule]", "\"2408.12651\""}]}, {
               
               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Christoph Uhlemann\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Andrea Chaney, Christoph F. Uhlemann\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"BMN-like sectors in 4d $\\\\mathcal N=4$ SYM with \
boundaries and interfaces\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"35 pages, 13 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
