            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0604151\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Edward Witten\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Anton Kapustin and Edward Witten\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Electric-Magnetic Duality And The Geometric Langlands \
Program\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"225 pp; further clarifications\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  The geometric Langlands program can be described in a \
natural way by\\ncompactifying on a Riemann surface C a twisted version of \
N=4 super Yang-Mills\\ntheory in four dimensions. The key ingredients are \
electric-magnetic duality of\\ngauge theory, mirror symmetry of sigma-models, \
branes, Wilson and 't Hooft\\noperators, and topological field theory. \
Seemingly esoteric notions of the\\ngeometric Langlands program, such as \
Hecke eigensheaves and D-modules, arise\\nnaturally from the \
physics.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
