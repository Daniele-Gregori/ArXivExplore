               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On exact overlaps for $\\\\mathfrak{gl}(N)$ symmetric \
spin chains\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"79 pages, accepted version (Nucl.Phys.B)\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.nuclphysb.2022.115909\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
