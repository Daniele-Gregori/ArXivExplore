               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"New integrable non-gauge 4D QFTs from strongly deformed \
planar N=4 SYM\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"6 pages, 3 figures. V3: references added, improvements \
made in the\\n  text, double-wrapping anomalous dimensions included as an \
ancillary file. V2:\\n  references added, typos corrected, statement on the \
conformality of the\\n  theory corrected, equation 9 included as an ancillary \
file\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys. Rev. Lett. 117, 201602 (2016)\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
