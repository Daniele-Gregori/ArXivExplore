               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Dissipative superfluids, from cold atoms to quark \
matter\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 
                 "\"10 pages, Lecture given at \\\"Three Days of Strong \
Interactions\\\",\\n  Wroclaw (Poland) 9. - 11. VII. 2009\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Acta Phys.Polon.Supp.3:621-630,2010\""}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
