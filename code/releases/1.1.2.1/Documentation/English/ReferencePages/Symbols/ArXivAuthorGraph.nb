               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"A review of the AdS/CFT Quantum Spectral Curve\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"31 pages, 4 figures; v2: typos fixed\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1751-8121/ab7137\""}]}, {
