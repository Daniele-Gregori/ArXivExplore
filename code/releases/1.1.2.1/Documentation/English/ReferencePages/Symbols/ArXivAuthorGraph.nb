               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  In this paper we generalize the results of \
arXiv:0806.4758 to non-zero value\\nJ of angular momentum in S^5. We compute \
the 1-loop correction to the energy of\\nthe folded spinning string in AdS_5 \
x S^5 in the particular limit of slow short\\nstring approximation. In this \
limit the string is moving in a near-flat central\\nregion of AdS_5 slowly \
rotating in both AdS_5 and S^5. The one-loop correction\\nshould represent \
the first subleading correction to strong coupling expansion\\nof the \
anomalous dimension of short gauge theory operators of the form Tr D^S\\nZ^J \
in the SL(2) sector.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
