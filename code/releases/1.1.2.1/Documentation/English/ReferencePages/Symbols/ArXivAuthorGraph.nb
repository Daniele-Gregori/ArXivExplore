                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 2 Nov 2017 10:12:58 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
