Caetano\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Universality in dynamical phase transitions of diffusive \
systems\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"11 pages, 3 figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys. Rev. E 98, 052116 (2018)\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1103/PhysRevE.98.052116\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
