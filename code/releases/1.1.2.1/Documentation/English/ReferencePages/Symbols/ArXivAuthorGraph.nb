                "\"title\"", "\[Rule]", 
                 "\"On the Integrable Structure of Super Yang-Mills \
Scattering Amplitudes\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"169 pages, PhD thesis based on the author's \
publications\\n  arXiv:1312.1693, arXiv:1412.8476 and basis for \
arXiv:1811.04949\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "\"10.20386/HUB-43089\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
