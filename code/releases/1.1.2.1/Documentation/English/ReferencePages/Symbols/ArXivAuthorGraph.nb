            "2015-06-03", 
            "authors_parsed" -> {{"Astolfi", "Davide", ""}, {
              "Grignani", "Gianluca", ""}, {"Ser-Giacomi", "Enrico", ""}, {
              "Zayakin", "A. V.", ""}}}], "Tooltip"]& ], 
