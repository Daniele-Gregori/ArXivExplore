                "\"title\"", "\[Rule]", 
                 "\"Solving Mass-deformed Holography Perturbatively\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"20 pages, 2 figures; v2: references added, typos \
corrected; v3: to\\n  appear in JHEP\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 04 (2019) 053\""}]}, {
               
