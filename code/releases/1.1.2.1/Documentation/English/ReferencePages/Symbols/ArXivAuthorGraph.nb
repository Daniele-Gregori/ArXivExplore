               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0003119\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Michele Caselle\""}]}, {
              
               RowBox[{"\"authors\"", "\[Rule]", "\"M. Caselle\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Lattice Gauge Theories and the AdS/CFT \
Correspondence\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"80 pages, 6 figures, lectures delivered at the School of \
Theoretical\\n  Physics (SNFT), Parma,1999\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Int.J.Mod.Phys. A15 (2000) 3901-3966\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1142/S0217751X00002044\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"DFTT 8/2000\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th hep-lat\""}]}, {
              
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  This is the write-up of a set of lectures on the \
comparison between Lattice\\nGauge Theories and AdS/CFT results for the \
non-perturbative behaviour of\\nnon-supersymmetric Yang Mills theories. These \
notes are intended for students\\nwhich are assumed not to be experts in \
L.G.T. For this reason the first part is\\ndevoted to a pedagogical \
introduction to the Lattice regularization of QCD. In\\nthe second part we \
discuss some basic features of the AdS/CFT correspondence\\nand compare the \
results obtained in the non-supersymmetric limit with those\\nobtained on the \
Lattice. We discuss in particular the behaviour of the string\\ntension and \
of the glueball spectrum. Lectures delivered at the School of\\nTheoretical \
Physics (S.N.F.T.), Parma, September 1999.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
