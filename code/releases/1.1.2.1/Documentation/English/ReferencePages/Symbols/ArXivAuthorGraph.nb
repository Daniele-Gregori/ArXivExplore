         Annotation[#, 
          
          TableForm[{
           "id" -> "1612.04839", "submitter" -> "Yiwen Pan", "authors" -> 
            "Yiwen Pan, Wolfger Peelaers", "title" -> 
            "Intersecting Surface Defects and Instanton Partition Functions", 
            "comments" -> "66 pages; v2: minor typos corrected", 
            "journal-ref" -> Null, "doi" -> "10.1007/JHEP07(2017)073", 
            "report-no" -> Null, "categories" -> "hep-th", "license" -> 
            "http://arxiv.org/licenses/nonexclusive-distrib/1.0/", "abstract" -> 
            "  We analyze intersecting surface defects inserted in \
interacting\nfour-dimensional N = 2 supersymmetric quantum field theories. We \
employ the\nrealization of a class of such systems as the infrared fixed \
points of\nrenormalization group flows from larger theories, triggered by \
perturbed\nSeiberg-Witten monopole-like configurations, to compute their \
partition\nfunctions. These results are cast into the form of a partition \
function of\n4d/2d/0d coupled systems. Our computations provide concrete \
expressions for the\ninstanton partition function in the presence of \
intersecting defects and we\nstudy the corresponding ADHM model.\n", 
            "versions" -> {{
              "version" -> "v1", "created" -> 
               "Wed, 14 Dec 2016 21:05:31 GMT"}, {
              "version" -> "v2", "created" -> 
               "Mon, 1 May 2017 18:30:48 GMT"}}, "update_date" -> 
            "2017-08-02", 
            "authors_parsed" -> {{"Pan", "Yiwen", ""}, {
              "Peelaers", "Wolfger", ""}}}], "Tooltip"]& ], 
