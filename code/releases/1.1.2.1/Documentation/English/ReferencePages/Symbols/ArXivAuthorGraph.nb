               RowBox[{
                "\"authors\"", "\[Rule]", "\"Xing Huang, Yang Zhou\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"N = 4 Super-Yang-Mills on Conic Space as Hologram of STU \
Topological\\n  Black Hole\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"1+48 pages, v2:typo fixed+references added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP02(2015)068\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP02(2015)068\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We construct four-dimensional N=4 super-Yang-Mills \
theories on a conic sphere\\nwith various background R-symmetry gauge fields. \
We study free energy and\\nsupersymmetric Renyi entropy using heat kernel \
method as well as localization\\ntechnique. We find that the universal \
contribution to the partition function in\\nthe free field limit is the same \
as that in the strong coupling limit, which\\nimplies that it may be \
protected by supersymmetry. Based on the fact that, the\\nconic sphere can be \
conformally mapped to $S^1\\\\times H^3$ and the R-symmetry\\nbackground \
fields can be supported by the R-charges of black hole, we propose\\nthat the \
holographic dual of these theories are five-dimensional,\\nsupersymmetric STU \
topological black holes. We demonstrate perfect agreement\\nbetween N=4 \
super-Yang-Mills theories in the planar limit and the STU\\ntopological black \
holes.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
