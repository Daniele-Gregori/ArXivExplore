                "\"authors\"", "\[Rule]", 
                 "\"M. Billo, F. Galvagno, A. Lerda\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"BPS Wilson loops in generic conformal N=2 SU(N) SYM \
theories\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"v2: references added and typos fixed; matches the \
published version\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP08(2019)108\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We consider the 1/2 BPS circular Wilson loop in a \
generic N=2 SU(N) SYM\\ntheory with conformal matter content. We study its \
vacuum expectation value,\\nboth at finite $N$ and in the large-N limit, \
using the interacting matrix model\\nprovided by localization results. We \
single out some families of theories for\\nwhich the Wilson loop vacuum \
expectation values approaches the N=4 result in\\nthe large-N limit, in \
agreement with the fact that they possess a simple\\nholographic dual. At \
finite N and in the generic case, we explicitly compare\\nthe matrix model \
result with the field-theory perturbative expansion up to\\norder g^8 for the \
terms proportional to the Riemann value zeta(5), finding\\nperfect agreement. \
Organizing the Feynman diagrams as suggested by the\\nstructure of the matrix \
model turns out to be very convenient for this\\ncomputation.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
