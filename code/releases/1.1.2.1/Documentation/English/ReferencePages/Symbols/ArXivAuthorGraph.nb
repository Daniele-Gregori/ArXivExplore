               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"The quark anti-quark potential and the cusp anomalous \
dimension from a\\n  TBA equation\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"63 pages, 12 figures. v2: references added, typos \
corrected\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP08(2012)134\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
