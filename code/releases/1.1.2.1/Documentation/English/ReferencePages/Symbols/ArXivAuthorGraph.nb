                 "\"Spin Chain for Quantum Strings\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"10 pages, Contribution to RTN and EXT Workshop, \
Kolymbari, Crete,\\n  Greece, 5-10 September 2004, v2: numerical comparision \
with spinning strings\\n  added, coefficient of H4 in Tab. 3 corrected\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Fortsch.Phys.53:852-860,2005\""}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "\"10.1002/prop.200410207\""}]}, {
