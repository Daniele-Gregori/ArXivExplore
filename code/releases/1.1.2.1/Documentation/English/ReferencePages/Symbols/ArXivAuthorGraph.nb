            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0405243\""}]}, {
               
               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Joseph A. Minahan\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Joseph A.Minahan\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Higher Loops Beyond the SU(2) Sector\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"LaTex, 26 pages, 1 figure;v2 misprints corrected; v3 \
misprints\\n  corrected, ref. added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0410:053,2004\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2004/10/053\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
                 "\"UUITP-16-04, CTP-MIT-3496\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We consider the case of coherent gauge invariant \
operators in the SU(3) and\\nSO(4) sectors. We argue that in many cases, \
these sectors can be closed in the\\nthermodynamic limit, even at higher \
loops. We then use a modification of the\\nBethe equations which is a natural \
generalization of a proposal put forward by\\nSerban and Staudacher to make \
gauge theory predictions for the anomalous\\ndimensions for a certain class \
of operators in each sector. We show that the\\npredictions are consistent \
with semiclassical string predictions at two loops\\nbut in general fail to \
agree at three loops. Interestingly, in both cases there\\nis one point in \
the configuration space where the gauge theory and string\\ntheory \
predictions agree. In the SU(3) case it corresponds to a circular \
string\\nwith R-charge assignment (J,J,J).\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 26 May 2004 17:55:06 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 30 Jun 2004 15:26:59 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v3\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 10 Oct 2005 15:47:54 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2010-02-03\""}]}, {
