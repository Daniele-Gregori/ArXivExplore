               RowBox[{"\"id\"", "\[Rule]", "\"2201.00351\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Ilmar Gahramanov\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Ilmar Gahramanov\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Integrability from supersymmetric duality: a short review\
\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"18 pages\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", 
                 "\"hep-th math-ph math.MP nlin.SI\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://creativecommons.org/licenses/by/4.0/\""}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  Integrable models of statistical mechanics play a \
prominent role in modern\\nmathematical physics, especially in conformal \
field theory, knot theory,\\ncombinatorics, topology, etc. In this brief \
review, we discuss a program of\\nconstructing integrable lattice spin models \
with the nearest neighbor\\ninteraction using methods inspired by the \
supersymmetric gauge theory\\ncomputations, called gauge/YBE correspondence. \
After a brief introduction to\\nthe topic, we review some recent examples of \
this correspondence and the role\\nof special functions and symmetries. \
Finally, we discuss future directions of\\nresearch.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Sun, 2 Jan 2022 12:53:35 GMT\""}]}], "}"}], "}"}]}]}, {
              
               RowBox[{"\"update_date\"", "\[Rule]", "\"2022-01-04\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{"\"Gahramanov\"", ",", "\"Ilmar\"", ",", "\"\""}],
                     "}"}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
             Left, ColumnAlignments -> Left], Column], 
