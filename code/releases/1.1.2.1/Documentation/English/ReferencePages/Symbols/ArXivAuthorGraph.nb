                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys.B676:3-42,2004\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.nuclphysb.2003.10.019\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"AEI-2003-056\""}]}, {
