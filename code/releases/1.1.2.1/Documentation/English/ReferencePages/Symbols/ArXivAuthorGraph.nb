                "\"title\"", "\[Rule]", 
                 "\"TBA-like equations and Casimir effect in \
(non-)perturbative AdS/CFT\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"Version 2 with: new exact expression for the Casimir \
energy derived\\n  (beyond the first two loops of the previous version); UV \
theory formulated\\n  and analysed extensively in the Appendix C; origin of \
the O(6) NLSM\\n  scattering clarified; typos correct and references \
added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP12(2012)013\""}]}, {
