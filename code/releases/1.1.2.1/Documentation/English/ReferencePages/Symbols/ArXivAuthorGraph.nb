                    RowBox[{"\"version\"", "\[Rule]", "\"v3\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 27 Oct 2008 16:24:02 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
