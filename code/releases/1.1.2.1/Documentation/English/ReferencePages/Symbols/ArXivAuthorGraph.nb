                 "\"Duality covariant quantum field theory on noncommutative \
Minkowski space\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"32 pages; v2: Typos corrected; v3: Further typos \
corrected - Final\\n  version to appear in JHEP\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0902:031,2009\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2009/02/031\""}]}, {
               
