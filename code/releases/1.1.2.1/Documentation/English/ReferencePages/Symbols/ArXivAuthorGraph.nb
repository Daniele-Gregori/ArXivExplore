               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Geometry of Localized Effective Theories, Exact \
Semi-classical\\n  Approximation and the Algebraic Index\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"43 pages. Comments are welcome\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
