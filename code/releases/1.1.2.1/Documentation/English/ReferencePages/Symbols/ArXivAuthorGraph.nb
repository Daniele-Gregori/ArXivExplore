                "\"title\"", "\[Rule]", 
                 "\"Worldsheet two- and four-point functions at one loop in \
AdS(3) / CFT(2)\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"11 pages, FeynMP. Version 2; footnote added and typos \
fixed,\\n  published version\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
