               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Matrix Quantum Mechanics and Soliton Regularization of \
Noncommutative\\n  Field Theory\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"70 pages, 4 figures; v2: References added and \
updated\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Adv.Theor.Math.Phys.8:1-82,2004\""}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
                 "\"DSF-36-03, HWM-03-30, EMPG-03-22\""}]}, {
               
