                "\"title\"", "\[Rule]", 
                 "\"Lectures on Three-point Functions in N=4 Supersymmetric \
Yang-Mills\\n  Theory\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"58 pages. v2 An appendix added. Typos corrected. \
References added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
