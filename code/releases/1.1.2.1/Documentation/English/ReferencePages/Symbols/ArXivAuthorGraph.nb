                "\"doi\"", "\[Rule]", "\"10.1007/JHEP12(2016)122\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"NORDITA-2016-134\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
