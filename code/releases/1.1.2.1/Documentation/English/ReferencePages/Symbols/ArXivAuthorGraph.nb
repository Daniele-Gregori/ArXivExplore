                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Sun, 2 Sep 2001 19:47:34 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
