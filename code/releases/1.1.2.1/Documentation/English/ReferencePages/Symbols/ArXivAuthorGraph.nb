                "\"comments\"", "\[Rule]", "\"47 pages, 11 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP04(2020)076\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
