               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We use dyonic brane configurations of type 0 string \
theory to study large N\\nnon-supersymmetric 4d gauge theories. The brane \
configurations define theories\\nsimilar to the supersymmetric ones which \
arise in type II. We find the non-SUSY\\nanalogues of N=2 and N=1. In \
particular we suggest new non-SUSY CFT's and a\\nbrane realization of a \
non-SUSY Seiberg duality.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
