            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0506058\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Nadav Drukker\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Nadav Drukker and Bartomeu Fiol\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On the integrability of Wilson loops in AdS_5 x S^5: Some \
periodic\\n  ansatze\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"LaTex, 49 pages, 8 figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0601 (2006) 056\""}]}, {
              
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2006/01/056\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"ITFA-2005-19\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  Wilson loops are calculated within the AdS/CFT \
correspondence by finding a\\nclassical solution to the string equations of \
motion in AdS_5 x S^5 and\\nevaluating its action. An important fact is that \
this sigma-model used to\\nevaluate the Wilson loops is integrable, a feature \
that has gained relevance\\nthrough the study of spinning strings carrying \
large quantum numbers and\\nspin-chains. We apply the same techniques used to \
solve the equations for\\nspinning strings to find the minimal surfaces \
describing a wide class of Wilson\\nloops. We focus on different cases with \
periodic boundary conditions on the\\nAdS_5 and S^5 factors and find a rich \
array of solutions. We examine the\\ndifferent phases that appear in the \
problem and comment on the applicability of\\nintegrability to the general \
problem.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 7 Jun 2005 20:20:11 GMT\""}]}], "}"}], "}"}]}]}, {
              
               RowBox[{"\"update_date\"", "\[Rule]", "\"2009-11-11\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Drukker\"", ",", "\"Nadav\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Fiol\"", ",", "\"Bartomeu\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
