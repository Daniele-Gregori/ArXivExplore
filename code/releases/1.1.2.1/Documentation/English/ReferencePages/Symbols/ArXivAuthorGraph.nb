                 "\"WKB analysis of the linear problem for modified affine \
Toda field\\n  equations\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"42 pages\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP08(2023)007\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP08(2023)007\""}]}, {
