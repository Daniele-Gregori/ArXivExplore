               RowBox[{"\"submitter\"", "\[Rule]", "\"Jan Ambjorn\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"J. Ambjorn, A. Dubin and Y. Makeenko\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Wilson Loops in 2D Noncommutative Euclidean Gauge Theory: \
1.\\n  Perturbative Expansion\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"27 pages, 2 figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0407 (2004) 044\""}]}, {
              
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2004/07/044\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"ITEP-TH-37/03\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We calculate quantum averages of Wilson loops \
(holonomies) in gauge theories\\non the Euclidean noncommutative plane, using \
a path-integral representation of\\nthe star-product. We show how the \
perturbative expansion emerges from a concise\\ngeneral formula and \
demonstrate its anomalous behavior at large parameter of\\nnoncommutativity \
for the simplest nonplanar diagram of genus 1. We discuss\\nvarious UV/IR \
regularizations of the two-dimensional noncommutative gauge\\ntheory in the \
axial gauge and, using the noncommutative loop equation,\\nconstruct a \
consistent regularization.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
