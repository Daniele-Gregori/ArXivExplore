               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"$q$-Poincar\\\\'e supersymmetry in $AdS_5/CFT_4$\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"35 pages. Added discussion on antipode in the presence of \
the phase.\\n  Published version\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.nuclphysb.2018.01.017\""}]}, {
               
