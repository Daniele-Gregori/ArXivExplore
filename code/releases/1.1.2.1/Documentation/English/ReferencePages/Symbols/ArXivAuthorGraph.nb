               RowBox[{
                "\"authors\"", "\[Rule]", "\"A. Melikyan and G. Weber\""}]}, {
              
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On the quantization of continuous non-ultralocal \
integrable systems\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"33 pages, extended version of arXiv:1505.01516\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nuclear Physics B (2016), vol 913C, pp. 716-746\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.nuclphysb.2016.10.009\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th nlin.SI\""}]}, {
              
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We discuss the quantization of non-ultralocal \
integrable models directly in\\nthe continuous case, using the example of the \
Alday-Arutyunov-Frolov model. We\\nshow that by treating fields as \
distributions and regularizing the operator\\nproduct, it is possible to \
avoid all the singularities, and allow to obtain\\nresults consistent with \
perturbative calculations. We illustrate these results\\nby considering the \
reduction to the massive free fermion model and extracting\\nthe quantum \
Hamiltonian as well as other conserved charges directly from \
the\\nregularized trace identities. Moreover, we show that our regularization\
\\nrecovers Maillet's prescription in the classical limit.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 8 Nov 2016 17:33:50 GMT\""}]}], "}"}], "}"}]}]}, {
              
