                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2009/07/047\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th hep-ph\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  Recently a concise expression for the subleading \
infrared singularity of\\ndimensional-regularized gauge theories has been \
proposed. For conformal\\ntheories, such relation involves a universal \
eikonal contribution plus a\\nnon-eikonal contribution, related to the \
subleading term in the anomalous\\ndimension of twist two operators with \
large spin. In this note we make use of\\nthe AdS/CFT correspondence in order \
to check such conjecture at strong coupling\\nfor the case of N=4 \
SYM.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
