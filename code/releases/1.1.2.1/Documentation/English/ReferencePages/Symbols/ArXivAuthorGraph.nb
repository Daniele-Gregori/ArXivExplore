           "id" -> "1604.03575", "submitter" -> "Shota Komatsu", "authors" -> 
            "Yunfeng Jiang, Shota Komatsu, Ivan Kostov, Didina Serban", 
            "title" -> "Clustering and the Three-Point Function", "comments" -> 
            "52 pages + a few appendices; v2 typos corrected", "journal-ref" -> 
