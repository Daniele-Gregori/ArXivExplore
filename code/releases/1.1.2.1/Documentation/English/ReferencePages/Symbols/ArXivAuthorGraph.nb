                 "\"Liouville integrable defects: the non-linear Schrodinger \
paradigm\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"22 pages, Latex. Minor misprints corrected\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 01 (2012) 040\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP01(2012)040\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
