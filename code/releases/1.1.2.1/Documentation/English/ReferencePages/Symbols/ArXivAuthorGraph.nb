Sever, Pedro\\n  Vieira\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"An Operator Product Expansion for Polygonal null Wilson \
Loops\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"48 pages, 12 figures, harvmac. v2 fixed a small issue \
regarding\\n  divergences\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 1104:088,2011\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP04(2011)088\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
