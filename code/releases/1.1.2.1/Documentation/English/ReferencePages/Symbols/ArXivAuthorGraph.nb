               "Mon, 26 Sep 2011 10:40:00 GMT"}}, "update_date" -> 
            "2015-05-20", 
            "authors_parsed" -> {{"Schafer-Nameki", "Sakura", ""}}}], 
          "Tooltip"]& ], 
