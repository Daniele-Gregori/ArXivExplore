               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Tamas Gombor, Zolt\\\\'an Bajnok\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Dual overlaps and finite coupling 't Hooft loops\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"24 pages, 1 figure\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
