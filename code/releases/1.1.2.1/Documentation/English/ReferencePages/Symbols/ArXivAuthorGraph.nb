               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Unitarity methods for scattering in two dimensions\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"Prepared for the Karl Schwarzschild Meeting 2013. 8 \
pages, 1 figure\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
