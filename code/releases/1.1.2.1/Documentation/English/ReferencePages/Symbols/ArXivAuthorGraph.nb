                    RowBox[{"{", 
                    RowBox[{"\"Hoare\"", ",", "\"Ben\"", ",", "\"\""}], "}"}],
                     ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Hollowood\"", ",", "\"Timothy J.\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Miramontes\"", ",", "\"J. Luis\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
