                    RowBox[{"{", 
                    RowBox[{"\"Ishizeki\"", ",", "\"Riei\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Kruczenski\"", ",", "\"Martin\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
