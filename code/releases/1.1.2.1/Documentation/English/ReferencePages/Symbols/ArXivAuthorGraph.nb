                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 1 Jul 2004 19:06:35 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
