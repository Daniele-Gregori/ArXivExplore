               RowBox[{"\"comments\"", "\[Rule]", "\"16 pages\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP11(2011)069\""}]}, {
