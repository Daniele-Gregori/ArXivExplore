               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"BRST Invariance of Non-local Charges and Monodromy Matrix \
of Bosonic\\n  String on AdS(5)xS(5)\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"26. pages\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Int.J.Mod.Phys.A22:2239-2263,2007\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1142/S0217751X07036348\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  Using the generalized Hamiltonian method of Batalin, \
Fradkin and Vilkovsky we\\ndevelop the BRST formalism for the bosonic string \
on AdS(5)xS(5) formulated as\\nprincipal chiral model. Then we show that the \
monodromy matrix and non-local\\ncharges are BRST invariant.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
