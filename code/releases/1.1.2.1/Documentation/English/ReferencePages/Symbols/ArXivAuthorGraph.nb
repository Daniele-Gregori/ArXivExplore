               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Tim Meier, Stijn J. van Tongeren\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Gauge theory on twist-noncommutative spaces\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"62 pages, 11 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"HU-EP-23/11-RTG\""}]}, {
              
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
