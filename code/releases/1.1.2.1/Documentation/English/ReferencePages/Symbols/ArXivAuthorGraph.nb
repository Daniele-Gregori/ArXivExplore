               RowBox[{
                "\"authors\"", "\[Rule]", "\"Osama Khlaif, Taro Kimura\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Virasoro Constraint for Uglov Matrix Model\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"15 pages\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP04(2022)029\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", 
                 "\"hep-th math-ph math.MP math.QA\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://creativecommons.org/licenses/by/4.0/\""}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We study the root of unity limit of $(\\\\textbf{q}, \\\
\\textbf{t})$-deformed\\nVirasoro matrix models, for which we call the \
resulting model Uglov matrix\\nmodel. We derive the associated Virasoro \
constraints on the partition function\\nand find agreement of the central \
charge with the expression obtained from the\\nlevel-rank duality associated \
with the parafermion CFT.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
