               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Current Algebra and Integrability of Principal Chiral \
Model on the\\n  World-sheet with General Metric\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"19 pages, corrected typos\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0704:040,2007\""}]}, {
               
