                "\"title\"", "\[Rule]", 
                 "\"On $AdS_2/CFT_1$ transfer matrices, Bethe ansatz and \
scale invariance\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"30 pages, 1 figure; v2: matching version accepted to J. \
Phys. A\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
