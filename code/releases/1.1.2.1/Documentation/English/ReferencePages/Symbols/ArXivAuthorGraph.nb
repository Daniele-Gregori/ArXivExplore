            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"1003.5414\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Shijong Ryang\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Shijong Ryang\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Spiky Strings with Two Spins in AdS5\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 1005:082,2010\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP05(2010)082\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  Using the reduction of the string sigma model to the \
1-d Neumann integrable\\nmodel we reconstruct the closed string solution with \
two equal spins in AdS_5\\nwhich is specified by the number of round arcs and \
one winding number. From the\\nstring sigma model itself as well as its \
reducion to the Neumann-Rosochatius\\nsystem we construct a spiky string \
solution with two unequal spins in AdS_5\\nwhose ratio is fixed and derive \
its energy-spin relation. The string\\nconfiguration is characterized by the \
number of spikes and two equal winding\\nnumbers associated with the two \
rotating angular directions.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
