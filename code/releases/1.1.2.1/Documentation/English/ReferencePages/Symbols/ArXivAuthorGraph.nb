               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"General Leznov-Savelev solutions for Pohlmeyer reduced \
AdS$_5$ minimal\\n  surfaces\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"29 pages + 7 pages appendices\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 1109:002,2011\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP09(2011)002\""}]}, {
