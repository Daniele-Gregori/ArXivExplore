                "\"journal-ref\"", "\[Rule]", 
                 "\"J.Phys.A42:075204,2009\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1751-8113/42/7/075204\""}]}, {
