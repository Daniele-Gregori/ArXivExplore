               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Correlation Function of Circular Wilson Loops at Strong \
Coupling\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"44 pages, 14 figures. v2: references added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP11(2013)117\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
