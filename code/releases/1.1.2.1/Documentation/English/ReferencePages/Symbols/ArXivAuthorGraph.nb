               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  The form factor equations are solved for an SU(N) \
invariant S-matrix under\\nthe assumption that the anti-particle is \
identified with the bound state of N-1\\nparticles. The solution is obtained \
explicitly in terms of the nested off-shell\\nBethe ansatz where the \
contribution from each level is written in terms of\\nmultiple contour \
integrals.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
