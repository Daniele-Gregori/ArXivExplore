for BAE\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"minor updates\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP03(2018)087\""}]}, {
