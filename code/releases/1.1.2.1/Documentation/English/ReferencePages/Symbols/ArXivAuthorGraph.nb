                RowBox[{
                 "\"submitter\"", "\[Rule]", "\"Davide Fioravanti\""}]}, {
                RowBox[{"\"authors\"", "\[Rule]", "\"Davide Fioravanti\""}]}, {
                
                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Geometrical Loci and CFTs via the Virasoro Symmetry of \
the mKdV-SG\\n  hierarchy: an excursus\""}]}, {
                RowBox[{"\"comments\"", "\[Rule]", "\"LaTex, 9 pages\""}]}, {
                
                RowBox[{
                 "\"journal-ref\"", "\[Rule]", 
                  "\"Phys.Lett. B609 (2005) 173-179\""}]}, {
                
                RowBox[{
                 "\"doi\"", "\[Rule]", 
                  "\"10.1016/j.physletb.2005.01.037\""}]}, {
                RowBox[{"\"report-no\"", "\[Rule]", "\"APCTP 2004-001\""}]}, {
               
                
                RowBox[{
                 "\"categories\"", "\[Rule]", 
                  "\"hep-th math-ph math.MP nlin.SI\""}]}, {
                RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
                
                RowBox[{
                 "\"abstract\"", "\[Rule]", 
                  "\"  We will describe the appearance of specific algebraic \
KdV potentials as a\\nconsequence of a requirement on a integro-differential \
expression. This\\nexpression belongs to a class generated by means of \
Virasoro vector fields\\nacting on the KdV field. The ``almost'' rational KdV \
fields are described in\\nterms of a geometrical locus of complex points. A \
class of solutions of this\\nlocus has recently appeared as a description of \
any conformal Verma module\\nwithout degeneration.\\n\""}]}, {
                RowBox[{"\"versions\"", "\[Rule]", 
                  RowBox[{"{", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 10 Aug 2004 16:23:18 GMT\""}]}], "}"}], "}"}]}]}, {
