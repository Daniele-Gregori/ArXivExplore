                "\"authors\"", "\[Rule]", 
                 "\"Rafael Hernandez, Juan Miguel Nieto, Roberto Ruiz\""}]}, {
              
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Minimal surfaces with mixed three-form flux\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"15 pages. Latex. v2: Title changed together with minor \
updates to\\n  emphasize that minimal area surfaces in the presence of mixed \
fluxes are\\n  found. v3: Published version\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys. Rev. D 99, 086003 (2019)\""}]}, {
               
