        TagBox[
         TooltipBox[
          DiskBox[{7.572956103961149, -6.755669338573982}, 
           0.10102143756118451],
          TagBox[
           TagBox[
            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"1108.0999\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Andrei Belitsky\""}]}, {
              
               
               RowBox[{
                "\"authors\"", "\[Rule]", "\"B. Basso, A.V. Belitsky\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Luescher formula for GKP string\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"78 pages, 8 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.nuclphysb.2012.02.011\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We investigate finite-size corrections to anomalous \
dimensions of large-spin\\ntwist-two operators in the planar maximally \
supersymmetric Yang-Mills theory.\\nWe develop a framework for analysis of \
these corrections, that is complementary\\nto the conventional spin-chain \
approach, by making use of the hole rather than\\nthe magnon picture. From \
the dual string theory perspective where the\\nlarge-spin operator is \
identified with the Gubser-Klebanov-Polyakov (GKP)\\nstring, our approach is \
equivalent to constructing the first Luescher\\ncorrection to the energy of \
the GKP string by incorporating the contribution of\\nvirtual excitations \
propagating on it. It allows us to propose a formula that\\ncontrols a \
particular class of large-spin corrections to the twist-two\\nanomalous \
dimension and holds at any value of the coupling constant. Compared\\nto \
wrapping corrections computed with magnons propagating on the spin \
chain,\\nthe finite-size corrections that are encoded in our formalism start \
at a lower\\nloop level. Our formalism thus calls for modification of the \
asymptotic\\ncontributions which are conventionally incorporated within the \
Asymptotic Bethe\\nAnsatz. An educated guess allows us to remedy this pitfall \
and successfully\\nconfront our predictions with known results up to five \
loop accuracy at weak\\ncoupling. Finally, our formula sheds light on the \
weak-to-strong coupling\\ntransition for the subleading large-spin \
corrections under study and confirms\\nstringy expectations at strong \
coupling where they are found to be identical to\\nthe first Luescher \
correction to the vacuum energy of the O(6) sigma model.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 4 Aug 2011 06:20:44 GMT\""}]}], "}"}], "}"}]}]}, {
              
               RowBox[{"\"update_date\"", "\[Rule]", "\"2015-05-30\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Basso\"", ",", "\"B.\"", ",", "\"\""}], "}"}], 
                    ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Belitsky\"", ",", "\"A. V.\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
             Left, ColumnAlignments -> Left], Column], 
           Function[BoxForm`e$, 
            TableForm[BoxForm`e$]]]],
         Annotation[#, 
          
          TableForm[{
           "id" -> "1108.0999", "submitter" -> "Andrei Belitsky", "authors" -> 
            "B. Basso, A.V. Belitsky", "title" -> 
            "Luescher formula for GKP string", "comments" -> 
            "78 pages, 8 figures", "journal-ref" -> Null, "doi" -> 
            "10.1016/j.nuclphysb.2012.02.011", "report-no" -> Null, 
            "categories" -> "hep-th", "license" -> 
            "http://arxiv.org/licenses/nonexclusive-distrib/1.0/", "abstract" -> 
            "  We investigate finite-size corrections to anomalous dimensions \
of large-spin\ntwist-two operators in the planar maximally supersymmetric \
Yang-Mills theory.\nWe develop a framework for analysis of these corrections, \
that is complementary\nto the conventional spin-chain approach, by making use \
of the hole rather than\nthe magnon picture. From the dual string theory \
perspective where the\nlarge-spin operator is identified with the \
Gubser-Klebanov-Polyakov (GKP)\nstring, our approach is equivalent to \
constructing the first Luescher\ncorrection to the energy of the GKP string \
by incorporating the contribution of\nvirtual excitations propagating on it. \
It allows us to propose a formula that\ncontrols a particular class of \
large-spin corrections to the twist-two\nanomalous dimension and holds at any \
value of the coupling constant. Compared\nto wrapping corrections computed \
with magnons propagating on the spin chain,\nthe finite-size corrections that \
are encoded in our formalism start at a lower\nloop level. Our formalism thus \
calls for modification of the asymptotic\ncontributions which are \
conventionally incorporated within the Asymptotic Bethe\nAnsatz. An educated \
guess allows us to remedy this pitfall and successfully\nconfront our \
predictions with known results up to five loop accuracy at weak\ncoupling. \
Finally, our formula sheds light on the weak-to-strong coupling\ntransition \
for the subleading large-spin corrections under study and confirms\nstringy \
expectations at strong coupling where they are found to be identical to\nthe \
first Luescher correction to the vacuum energy of the O(6) sigma model.\n", 
            "versions" -> {{
              "version" -> "v1", "created" -> 
               "Thu, 4 Aug 2011 06:20:44 GMT"}}, "update_date" -> 
            "2015-05-30", 
            "authors_parsed" -> {{"Basso", "B.", ""}, {
              "Belitsky", "A. V.", ""}}}], "Tooltip"]& ], 
