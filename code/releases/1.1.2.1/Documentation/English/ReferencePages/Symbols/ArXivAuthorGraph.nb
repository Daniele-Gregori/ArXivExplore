               RowBox[{
                "\"title\"", "\[Rule]", "\"The SU(2) sector in AdS/CFT\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"17 Pages, no figures, to appear in the proceedings of the \
RTN\\n  workshop, Kolymbari, Crete, September 2004; v2 refs added, footnote \
changed\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Fortsch.Phys. 53 (2005) 828-838\""}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "\"10.1002/prop.200410204\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
                 "\"UUITP-04-05, CTP-MIT-3610\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  In the large N limit of N=4 Super Yang-Mills, the \
mixing under dilatations of\\nthe SU(2) sector, single trace operators \
composed of L complex scalar fields of\\ntwo types, is closed to all orders \
in perturbation theory. By relying on the\\nAdS/CFT correspondence, and by \
examining the currents for semiclassical\\nstrings, we present evidence which \
implies that there are small mixings that\\ncontradict the closure of the \
SU(2) sector in the strong coupling limit. These\\nmixings first appear to \
second order in the \\\\lambda/L^2 expansion.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 18 Mar 2005 16:39:13 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Sun, 24 Apr 2005 13:11:59 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2009-11-11\""}]}, {
