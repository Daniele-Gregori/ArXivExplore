               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Nonlocal charges from marginal deformations of 2D CFTs: \
Holographic $T\\n  \\\\bar T$, $T \\\\bar J$ and Yang-Baxter \
deformations\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"53 pages, 3 figures; v2: references added; v3: matches \
published\\n  version\""}]}, {
               
