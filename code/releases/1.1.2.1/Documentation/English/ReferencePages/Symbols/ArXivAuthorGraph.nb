               RowBox[{"\"id\"", "\[Rule]", "\"1002.4843\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Alin Tirziu\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", "\"M. Kruczenski, A. Tirziu\""}]}, {
              
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Spiky strings in Bethe Ansatz at strong coupling\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"23 pages, 2 figures; v2: minor changes\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys.Rev.D81:106004,2010\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1103/PhysRevD.81.106004\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
