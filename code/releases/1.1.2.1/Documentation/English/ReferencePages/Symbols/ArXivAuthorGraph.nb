                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 29 Apr 2019 17:19:53 GMT\""}]}], "}"}], "}"}]}]}, {
