               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"G. Arutyunov, A. A. Tseytlin\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On highest-energy state in the su(1|1) sector of N=4 \
super Yang-Mills\\n  theory\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"23 pages, Latex\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0605:033,2006\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2006/05/033\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
                 "\"ITP-UU-06-09, SPIN-06-07, Imperial-TP-AT-6-1\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We consider the highest-energy state in the su(1|1) \
sector of N=4 super\\nYang-Mills theory containing operators of the form \
tr(Z^{L-M} \\\\psi^M) where Z\\nis a complex scalar and \\\\psi is a \
component of gaugino. We show that this state\\ncorresponds to the operator \
tr(\\\\psi^L) and can be viewed as an analogue of the\\nantiferromagnetic \
state in the su(2) sector. We find perturbative expansions of\\nthe energy of \
this state in both weak and strong 't Hooft coupling regimes\\nusing \
asymptotic gauge theory Bethe ansatz equations. We also discuss a\\npossible \
analog of this state in the conjectured string Bethe ansatz \
equations.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
