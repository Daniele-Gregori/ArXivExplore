                "\"title\"", "\[Rule]", 
                 "\"The AdS(5)xS(5) Semi-Symmetric Space Sine-Gordon \
Theory\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"39 pages, references added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 1105:136,2011\""}]}, {
               
