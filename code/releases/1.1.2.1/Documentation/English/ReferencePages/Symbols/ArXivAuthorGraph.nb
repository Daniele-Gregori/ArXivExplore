               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Comments on operators with large spin\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"33 pages, 1 figure,v2:reference to more recent work \
added, minor\\n  corrections\""}]}, {
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP0711:019,2007\""}]}, {
               
