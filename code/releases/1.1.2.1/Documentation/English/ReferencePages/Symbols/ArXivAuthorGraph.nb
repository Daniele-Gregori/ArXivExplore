Macorini\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On wrapping corrections to GKP-like operators\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"37 pages, 6 eps figures\""}]}, {
              
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 1103:001,2011\""}]}, {
               
