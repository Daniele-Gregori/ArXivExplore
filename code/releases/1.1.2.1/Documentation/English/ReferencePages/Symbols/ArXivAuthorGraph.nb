                 "\"Exploring The Lambda Model Of The Hybrid \
Superstring\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"LaTex, 37 pages, references added, match published \
version in Journal\\n  of High Energy Physics, 2016\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP10(2016)151\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
