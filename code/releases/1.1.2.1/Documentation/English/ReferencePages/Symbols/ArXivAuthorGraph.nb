                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{"\"Doikou\"", ",", "\"Anastasia\"", ",", "\"\""}],
                     "}"}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
