               RowBox[{"\"id\"", "\[Rule]", "\"1312.3268\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Thomas Lloyd\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Thomas Lloyd and Bogdan Stefa\\\\'nski jr\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"$AdS_3/CFT_2$, finite-gap equations and massless \
modes\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"38 pages, no figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP04(2014)179\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  It is known that string theory on $AdS_3\\\\times M_7$ \
backgrounds preserving 16\\nsupercharges is classically integrable. This \
integrability has been previously\\nused to write down a set of integral \
equations, known as the finite-gap\\nequations. These equations can be solved \
for the closed string spectrum of the\\ntheory. However, it has been known \
for some time that the $AdS_3\\\\times M_7$\\nfinite-gap equations do not \
capture the dynamics of the massless modes of the\\nclosed string theory. In \
this paper we re-examine the derivation of the\\n$AdS_3\\\\times M_7$ \
finite-gap system. We find that the conditions that had\\npreviously been \
imposed on these integral equations in order to implement the\\nVirasoro \
constraints are too strict, and are in fact not required. We identify\\nthe \
correct implementation of the Virasoro constraints on finite-gap \
equations\\nand show that this new, less restrictive condition captures the \
complete closed\\nstring spectrum on $AdS_3\\\\times M_7$.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 11 Dec 2013 18:19:57 GMT\""}]}], "}"}], "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2015-06-18\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Lloyd\"", ",", "\"Thomas\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Stefa\:0144ski\"", ",", "\"Bogdan\"", ",", "\"jr\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
             Left, ColumnAlignments -> Left], Column], 
           Function[BoxForm`e$, 
            TableForm[BoxForm`e$]]]],
         Annotation[#, 
          
          TableForm[{
           "id" -> "1312.3268", "submitter" -> "Thomas Lloyd", "authors" -> 
            "Thomas Lloyd and Bogdan Stefa\\'nski jr", "title" -> 
            "$AdS_3/CFT_2$, finite-gap equations and massless modes", 
            "comments" -> "38 pages, no figures", "journal-ref" -> Null, 
            "doi" -> "10.1007/JHEP04(2014)179", "report-no" -> Null, 
            "categories" -> "hep-th", "license" -> 
            "http://arxiv.org/licenses/nonexclusive-distrib/1.0/", "abstract" -> 
            "  It is known that string theory on $AdS_3\\times M_7$ \
backgrounds preserving 16\nsupercharges is classically integrable. This \
integrability has been previously\nused to write down a set of integral \
equations, known as the finite-gap\nequations. These equations can be solved \
for the closed string spectrum of the\ntheory. However, it has been known for \
some time that the $AdS_3\\times M_7$\nfinite-gap equations do not capture \
the dynamics of the massless modes of the\nclosed string theory. In this \
paper we re-examine the derivation of the\n$AdS_3\\times M_7$ finite-gap \
system. We find that the conditions that had\npreviously been imposed on \
these integral equations in order to implement the\nVirasoro constraints are \
too strict, and are in fact not required. We identify\nthe correct \
implementation of the Virasoro constraints on finite-gap equations\nand show \
that this new, less restrictive condition captures the complete closed\n\
string spectrum on $AdS_3\\times M_7$.\n", 
            "versions" -> {{
              "version" -> "v1", "created" -> 
               "Wed, 11 Dec 2013 18:19:57 GMT"}}, "update_date" -> 
            "2015-06-18", 
            "authors_parsed" -> {{"Lloyd", "Thomas", ""}, {
              "Stefa\:0144ski", "Bogdan", "jr"}}}], "Tooltip"]& ], 
