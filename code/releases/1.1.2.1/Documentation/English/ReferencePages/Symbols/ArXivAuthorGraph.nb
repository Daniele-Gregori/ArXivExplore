               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Bin Chen, Ya-Li He, Peng Zhang and Xing-Chang Song\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Flat Currents of the Green-Schwarz Superstrings in AdS_5 \
x S^1 and AdS_3\\n  x S^3 backgrounds\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"18 pages, LaTeX file. References added and typos \
corrected\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys.Rev. D71 (2005) 086007\""}]}, {
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1103/PhysRevD.71.086007\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We construct a one-parameter family of flat currents in \
AdS_5 x S^1 and AdS_3\\nx S^3 Green-Schwarz superstrings, which would \
naturally lead to a hierarchy of\\nclassical conserved nonlocal charges. In \
the former case we rewrite the AdS_5 x\\nS^1 string using a new Z_4-graded \
base of the superalgebra su(2,2|2). In both\\ncases the existence of the Z_4 \
grading in the superalgebras plays a key role in\\nthe construction. As a \
result, we find that the flat currents, when formally\\nwritten in terms of \
the G_0-gauge invariant lowercase 1-forms, take the same\\nform as the one in \
AdS_5 x S^5 case.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
