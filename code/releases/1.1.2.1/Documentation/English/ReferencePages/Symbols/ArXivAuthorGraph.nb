               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Harold Steinacker\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Harold Steinacker\""}]}, {
              
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On the Newtonian limit of emergent NC gravity and \
long-distance\\n  corrections\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"35 pages, 4 figures. V2: Minor corrections and discussion \
added,\\n  published version\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0912:024,2009\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2009/12/024\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"UWTHPh-2009-07\""}]}, {
