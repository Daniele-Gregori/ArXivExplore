               RowBox[{"\"submitter\"", "\[Rule]", "\"Jun-Bao Wu\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Bin Chen, Jun-Bao Wu, Meng-Qi Zhu\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Holographical Description of BPS Wilson Loops in Flavored \
ABJM Theory\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"v3, 19 pages, no figures, typoes fixed\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 12 (2014) 143\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP12(2014)143\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
