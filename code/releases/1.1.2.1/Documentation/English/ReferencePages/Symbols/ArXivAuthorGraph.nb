                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 11 Sep 2020 20:25:09 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
