               RowBox[{"\"submitter\"", "\[Rule]", "\"Tomoki Nosaka\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Sanefumi Moriyama, Tomoki Nosaka, Katsuya Yano\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Superconformal Chern-Simons Theories from del Pezzo \
Geometries\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"47 pages; v3: typos corrected, published version\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 1711 (2017) 089\""}]}, {
              
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP11(2017)089\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
                 "\"OCU-PHYS 467, KIAS-P17046\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We present an explicit expression for the grand \
potential of the U(N)^3\\nsuperconformal Chern-Simons theory with the \
Chern-Simons levels being (k,0,-k).\\nFrom the viewpoint of the Newton \
polygon, it is expected that the grand\\npotential is given by the free \
energy of the topological string theory on the\\nlocal D_5 del Pezzo \
geometry, though the explicit identification was a puzzle\\nfor years. We \
show how the expectation is realized explicitly. As a bonus, we\\ncan also \
study the Z_2 orbifold of this theory and find the grand potential is\\nnow \
given in terms of the local E_7 del Pezzo geometry.\\n\""}]}, {
