               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  This review is meant to be an account of the properties \
of the\\ninfinite-dimensional quantum group (specifically, Yangian) symmetry \
lying\\nbehind the integrability of the AdS/CFT spectral problem. In passing, \
the\\nchance is taken to give a concise anthology of basic facts concerning \
Yangians\\nand integrable systems, and to store a series of remarks, \
observations and\\nproofs the author has collected in a five-year span of \
research on the subject.\\nWe hope this exercise will be useful for future \
attempts to study Yangians in\\nfield and string theories, with or without \
supersymmetry.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
