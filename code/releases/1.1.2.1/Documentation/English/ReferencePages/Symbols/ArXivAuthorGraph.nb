               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"The Algebra of Transition Matrices for the AdS_5 x S^5 \
Superstring\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"24 pages, Latex, jhep style; references added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP0412:055,2004\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2004/12/055\""}]}, {
