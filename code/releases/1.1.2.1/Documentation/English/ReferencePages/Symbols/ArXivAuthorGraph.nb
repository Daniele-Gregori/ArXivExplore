               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Martin Hasenbusch\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Martin Hasenbusch\""}]}, {
              
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"A variance reduced estimator of the connected two-point \
function in the\\n  presence of a broken Z_2 symmetry\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"28 pages\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys. Rev. E 93, 032140 (2016)\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1103/PhysRevE.93.032140\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", 
                 "\"cond-mat.stat-mech hep-lat\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  The exchange or geometric cluster algorithm allows us \
to define a variance\\nreduced estimator of the connected two-point function \
in the presence of a\\nbroken Z_2-symmetry. We present first numerical tests \
for the improved\\nBlume-Capel model on the simple cubic lattice. We perform \
simulations for the\\ncritical isotherm, the low temperature phase at \
vanishing external field and,\\nfor comparison, also the high temperature \
phase. For the connected two-point\\nfunction a substantial reduction of the \
variance can be obtained, allowing us\\nto compute the correlation length \
with high precision. Based on these results,\\nestimates for various \
universal amplitude ratios that characterise the\\nuniversality class of the \
three-dimensional Ising model are computed.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 8 Dec 2015 14:47:20 GMT\""}]}], "}"}], "}"}]}]}, {
              
               RowBox[{"\"update_date\"", "\[Rule]", "\"2016-03-30\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    
                    RowBox[{
                    "\"Hasenbusch\"", ",", "\"Martin\"", ",", "\"\""}], "}"}],
                    "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> Left, 
