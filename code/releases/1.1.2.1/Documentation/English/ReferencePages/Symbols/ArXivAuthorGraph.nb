                "\"title\"", "\[Rule]", 
                 "\"Boundary condition for D-brane from Wilson loop, and \
gravitational\\n  interpretation of eigenvalue in matrix model in AdS/CFT \
correspondence\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"40 pages, uses cite.sty; ver. 2, added references and \
footnotes\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys.Rev.D79:126010,2009\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1103/PhysRevD.79.126010\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"UT-KOMABA/08-22\""}]}, {
              
