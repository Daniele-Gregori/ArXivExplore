               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Hierarchy of the low-lying excitations for the \
$(2+1)$-dimensional $q=3$\\n  Potts model in the ordered phase\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl. Phys. B 916, 28 (2017)\""}]}, {
               
