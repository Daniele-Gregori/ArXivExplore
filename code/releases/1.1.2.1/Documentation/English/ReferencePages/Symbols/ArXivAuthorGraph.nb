            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0609007\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Tamiaki Yoneya\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Akitsugu Miwa and Tamiaki Yoneya\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Holography of Wilson-Loop Expectation Values with Local \
Operator\\n  Insertions\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"16 pages, 5 figures, version to be published in JHEP, no \
change from\\n  the previous version, only extraneous figure file is \
removed\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP0612:060,2006\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2006/12/060\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"UT-Komaba 06-8\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We study the expectation values of Wilson-loop \
operators with the\\ninsertionsof local operators Z^J and Zbar^J with large \
R-charge J from the bulk\\nviewpoint of AdS/CFT correspondence. Classical \
solutions of strings attached to\\nsuch deformed Wilson loops at the \
conformal boundary are constructed and are\\napplied to the computation of \
Wilson-loop expectation values. We argue that in\\norder to have such \
solutions for general insertions at finite positions in the\\nbase spacetime \
of the gauge theory, it is crucial to interpret the \
holographic\\ncorrespondence in the semi-classical picture as a tunneling \
phenomenon, as has\\nbeen previously established for holographic computations \
of correlators of BMN\\noperators. This also requires to use the \
Euclideanized AdS background and\\nEuclidean super Yang-Mills \
theory.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
