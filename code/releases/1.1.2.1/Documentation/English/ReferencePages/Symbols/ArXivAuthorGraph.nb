               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We construct the spectral curve of gamma-deformed \
AdS/CFT from the strong\\ncoupling scaling limit of the T-system. As we \
interpret the twisted T-functions\\nin the classical limit as characters of \
the highest weight representations of\\nthe psu(2,2|4) symmetry group, we \
compute the twisted quasimomenta which\\ncharacterize classical integrability \
and analyze their analytic and asymptotic\\nproperties. These twisted \
quasimomenta are compared to Beisert-Roiban Bethe\\nansatz equations and \
classical string solutions.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 16 Jan 2014 14:12:47 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
