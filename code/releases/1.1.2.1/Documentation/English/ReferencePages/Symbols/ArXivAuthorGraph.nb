               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Free Fermions, vertex Hamiltonians, and lower-dimensional \
AdS/CFT\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"51 pages, no figures; v2: typos fixed and comments added; \
v3: 54\\n  pages, typos and errors fixed, added comments, homogenised \
notation, added\\n  appendix\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP02(2021)191\""}]}, {
               
