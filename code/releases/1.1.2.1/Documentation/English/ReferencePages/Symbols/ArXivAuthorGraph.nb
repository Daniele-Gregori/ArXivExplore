                "\"comments\"", "\[Rule]", 
                 "\"40 pages, 11 figures; v2-some formulas corrected, results \
unchanged\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP10(2013)135\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
