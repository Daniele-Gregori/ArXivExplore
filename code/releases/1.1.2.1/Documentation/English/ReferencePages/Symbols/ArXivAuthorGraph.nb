                "\"authors\"", "\[Rule]", "\"Dani\\\\\\\"el Prins\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Supersymmetric gauge theory on curved 7-branes\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"32 pages. v2: Added off-shell formulation. Updated \
references, minor\\n  corrections\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "\"10.1002/prop.201900009\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
