                    RowBox[{
                    "\"Floratos\"", ",", "\"Emmanuel\"", ",", "\"\""}], "}"}],
                     ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Linardopoulos\"", ",", "\"Georgios\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
