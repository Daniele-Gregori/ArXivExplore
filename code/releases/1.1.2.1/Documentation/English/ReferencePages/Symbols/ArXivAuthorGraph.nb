               RowBox[{"\"authors\"", "\[Rule]", "\"Shijong Ryang\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Analytic Bethe Ansatz Solutions for Highest States in the \
su(1|1) and\\n  su(2) Sectors\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"16 pages, LaTeX, no figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0705:101,2007\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2007/05/101\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We construct the integral equations by taking the \
thermodynamic limit of both\\nthe all-loop gauge Bethe ansatz equation and \
the string Bethe ansatz equation\\nfor the highest states in the su(1|1) and \
su(2) sectors of the N=4 super\\nYang-Mills theory. Using the Fourier \
transformation we solve the integral\\nequations iteratively to obtain the \
anomalous dimensions of the highest states\\nin the weak coupling expansion. \
In the su(1|1) sector we analytically study the\\nstrong coupling limit of \
the anomalous dimension for the all-loop gauge Bethe\\nansatz equation by \
means of the Laplace transformation.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
