               RowBox[{"\"submitter\"", "\[Rule]", "\"Edward Walton\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Edward Walton\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Vortex counting and the quantum Hall effect\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"52 pages, 1 figure\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP02(2022)155\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", 
                 "\"hep-th cond-mat.str-el math-ph math.MP\""}]}, {
               
