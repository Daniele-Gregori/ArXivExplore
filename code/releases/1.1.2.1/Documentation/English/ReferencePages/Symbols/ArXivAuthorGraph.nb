                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 7 Jun 2011 11:33:16 GMT\""}]}], "}"}], "}"}]}]}, {
              
