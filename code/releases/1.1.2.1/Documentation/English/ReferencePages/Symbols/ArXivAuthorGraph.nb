               "Mon, 22 Oct 2018 01:16:42 GMT"}}, "update_date" -> 
            "2018-12-26", 
            "authors_parsed" -> {{"Nepomechie", "Rafael I.", ""}, {
              "Retore", "Ana L.", ""}}}], "Tooltip"]& ], 
