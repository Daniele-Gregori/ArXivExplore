               RowBox[{"\"submitter\"", "\[Rule]", "\"Matteo Beccaria\""}]}, {
              
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Matteo Beccaria, Simone Giombi, Arkady A. Tseytlin\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Correlators on non-supersymmetric Wilson line in N=4 SYM \
and\\n  AdS$_2$/CFT$_1$\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"50 pages, 12 figures. v2: minor changes\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP05(2019)122\""}]}, {
               
