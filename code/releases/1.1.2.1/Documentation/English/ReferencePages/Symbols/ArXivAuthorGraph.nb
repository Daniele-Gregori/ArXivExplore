          TagBox[
           TagBox[
            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0310031\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Edward Shuryak\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Edward V. Shuryak and Ismail Zahed\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Spin-Spin and Spin-Orbit Interactions in Strongly Coupled \
Gauge Theories\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys.Lett. B608 (2005) 258-264\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.physletb.2004.12.077\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We evaluate the spin-orbit and spin-spin interaction \
between two fermions in\\nstrongly coupled gauge theories in their Coulomb \
phase. We use the\\nquasi-instantaneous character of Coulomb's law at strong \
coupling to resum a\\nclass of ladder diagrams. For ${\\\\cal N}=4$ SYM we \
derive both weak and strong\\ncoupling limits of the the spin-orbit and \
spin-spin interactions, and find that\\nin the latter case these interactions \
are subleading corrections and do not\\nseriously affect the deeply bound \
Coulomb states with large angular momentum,\\npointed out in our previous \
paper. The results are important for understanding\\nof the regime of \
intermediate coupling, which is the case for QCD somewhat\\nabove the chiral \
transition temperature.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 3 Oct 2003 16:15:30 GMT\""}]}], "}"}], "}"}]}]}, {
              
               RowBox[{"\"update_date\"", "\[Rule]", "\"2009-11-10\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Shuryak\"", ",", "\"Edward V.\"", ",", "\"\""}], "}"}],
                     ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Zahed\"", ",", "\"Ismail\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
