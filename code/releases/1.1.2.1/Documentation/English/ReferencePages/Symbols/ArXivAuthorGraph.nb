Shu\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"ODE/IM correspondence for affine Lie algebras: A \
numerical approach\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"1+63 pages, 6 figures. v2: typos corrected, reference \
added, v3:\\n  title changed, published version\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1751-8121/abd21e\""}]}, {
               
