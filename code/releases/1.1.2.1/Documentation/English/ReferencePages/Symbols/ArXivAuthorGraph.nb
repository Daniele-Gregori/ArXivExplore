               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Partition function methods for the quartic scalar quantum \
field theory\\n  on the Moyal plane\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"PhD thesis\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
