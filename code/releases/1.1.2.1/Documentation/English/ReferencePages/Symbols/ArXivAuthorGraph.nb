                RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
                RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
                
                RowBox[{
                 "\"abstract\"", "\[Rule]", 
                  "\"  We study the AdS_5 x S^5 sigma-model truncated to the \
near-flat-space limit\\nto two-loops in perturbation theory. In addition to \
extending previously known\\none-loop results to the full SU(2|2)^2 S-matrix \
we calculate the two-loop\\ncorrection to the dispersion relation and then \
compute the complete two-loop\\nS-matrix. The result of the perturbative \
calculation can be compared with the\\nappropriate limit of the conjectured \
S-matrix for the full theory and complete\\nagreement is found.\\n\""}]}, {
                RowBox[{"\"versions\"", "\[Rule]", 
                  RowBox[{"{", 
                    RowBox[{"{", 
