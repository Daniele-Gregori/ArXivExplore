                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 6 Feb 2018 19:00:04 GMT\""}]}], "}"}], "}"}]}]}, {
              
