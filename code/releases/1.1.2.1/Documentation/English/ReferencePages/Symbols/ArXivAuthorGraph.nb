               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Phase Transitions of Large N Orbifold Gauge \
Theories\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"31 pages, 4 figures, minor changes, references added, \
typos corrected\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP0612:042,2006\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2006/12/042\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"DESY 06-179\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
