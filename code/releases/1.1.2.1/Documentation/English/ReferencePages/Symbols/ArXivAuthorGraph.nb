          TagBox[
           TagBox[
            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/9708039\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Shinji Hirano\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Shinji Hirano and Mitsuhiro Kato\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", "\"Topological Matrix Model\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"18 pages, LaTeX, no figures, minor corrections and \
modifications,\\n  references added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Prog.Theor.Phys.98:1371-1384,1997\""}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "\"10.1143/PTP.98.1371\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
                 "\"OU-HET 274, UT-Komaba/97-11\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  Starting from the primal principle based on the \
noncommutative nature of\\n(9+1)-dimensional spacetime, we construct a \
topologically twisted version of\\nthe supersymmetric reduced model with a \
certain modification. Our formulation\\nautomatically provides extra 1+1 \
dimensions, thereby the dimensions of\\nspacetime are promoted to 10+2. With \
a suitable gauge choice, we can reduce the\\nmodel with (10+2)-dimensional \
spacetime to the one with (9+1)-dimensions and\\nthus we regard this gauge as \
the light-cone gauge. It is suggested that the\\nmodel so obtained would \
describe the light-cone F-theory. From this viewpoint\\nwe argue the relation \
of the reduced model to the matrix model of M-theory and\\nthe SL(2,Z) \
symmetry of type IIB string theory. We also discuss the general\\ncovariance \
of the matrix model in a broken phase, and make some comments on \
the\\nbackground independence.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 7 Aug 1997 13:16:21 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Sat, 16 Aug 1997 08:05:27 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2014-11-18\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Hirano\"", ",", "\"Shinji\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Kato\"", ",", "\"Mitsuhiro\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
             Left, ColumnAlignments -> Left], Column], 
