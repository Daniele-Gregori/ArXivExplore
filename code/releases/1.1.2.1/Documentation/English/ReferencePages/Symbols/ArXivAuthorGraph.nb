Orsay)\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Parametric representation of \\\"critical\\\" \
noncommutative QFT models\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"30 pages, 12 figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Commun.Math.Phys.279:355-379,2008\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/s00220-008-0437-1\""}]}, {
