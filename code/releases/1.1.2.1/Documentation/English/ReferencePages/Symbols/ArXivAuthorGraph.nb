               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"v3: 34 pages, typos fixed and minor clarifications \
added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys.B826:456-489,2010\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.nuclphysb.2009.08.012\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
