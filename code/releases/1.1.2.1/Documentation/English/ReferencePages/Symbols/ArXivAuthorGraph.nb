               "Fri, 26 Sep 2003 08:13:23 GMT"}}, "update_date" -> 
            "2008-11-26", 
            "authors_parsed" -> {{"Beisert", "Niklas", ""}, {
              "Staudacher", "Matthias", ""}}}], "Tooltip"]& ], 
        TagBox[
         TooltipBox[DiskBox[{17.88488387021958, -2.096285056207016}, 0.],
          TagBox[
           TagBox[
            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0307081\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Burkhard Eden\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Burkhard Eden\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On two fermion BMN operators\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"an error corrected, references added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys. B681 (2004) 195-229\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.nuclphysb.2003.12.036\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"ROM2F/2003/16\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We show how to determine the lowest order mixing of all \
scalar with\\ntwo-fermion two impurity BMN operators in the antisymmetric \
representation of\\nSO(4). Differentiation on harmonic superspace allows one \
to derive two-loop\\nanomalous dimensions of gauge invariant operators from \
this knowledge: the\\nvalue for the second anomalous correction to the \
dimension is essentially the\\nsquare of the two-fermion admixture. The \
method effectively increases the loop\\norder by one. For low J we find \
agreement to all orders in N with results\\nobtained upon diagonalisation of \
the N=4 dilation operator.\\n  We give a formula for the generalised Konishi \
anomaly and display its role in\\nthe mixing. For J=2 we resolve the mixing \
up to order $g^2$ in the singlet\\nrepresentation. The sum of the anomaly and \
the naive variation of the leading\\ntwo-fermion admixtures to the singlets \
is exactly equal to the two-fermion\\nterms in the antisymmetric descendants.\
\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 8 Jul 2003 18:46:53 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 15 Jul 2003 17:13:09 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
