                 "\"title\"", "\[Rule]", 
                  "\"Recent progress in the effective string theory \
description of LGTs\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", 
                  "\"Presented at the 31st International Symposium on Lattice \
Field Theory\\n  (Lattice 2013), 29 July - 3 August 2013, Mainz, \
Germany\""}]}, {
                RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
