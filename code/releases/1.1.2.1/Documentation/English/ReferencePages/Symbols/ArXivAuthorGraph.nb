               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Changrim Ahn, Rafael I. Nepomechie\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Two-loop test of the N=6 Chern-Simons theory \
S-matrix\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"21 pages, no figure; references added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0903:144,2009\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2009/03/144\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"UMTG-262\""}]}, {
