               RowBox[{"\"authors\"", "\[Rule]", "\"Anton Nedelin\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Phase transitions in 5D super Yang-Mills theory\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"49 pages, 17 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"UUITP-06/15\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
