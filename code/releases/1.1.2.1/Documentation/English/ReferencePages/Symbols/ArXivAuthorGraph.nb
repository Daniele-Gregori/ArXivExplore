               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0505071\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Christoph Sieg\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Christoph Sieg and Alessandro Torrielli\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Wrapping interactions and the genus expansion of the \
2-point function of\\n  composite operators\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"41 pages, LaTeX, 12 figures, minor changes, final version \
in NPB\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys. B723 (2005) 3-32\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.nuclphysb.2005.06.011\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
                 "\"MPP-2005-41, HU-EP-05/21\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We perform a systematic analysis of wrapping \
interactions for a general class\\nof theories with color degrees of freedom, \
including N=4 SYM. Wrapping\\ninteractions arise in the genus expansion of \
the 2-point function of composite\\noperators as finite size effects that \
start to appear at a certain order in the\\ncoupling constant at which the \
range of the interaction is equal to the length\\nof the operators. We \
analyze in detail the relevant genus expansions, and\\nintroduce a strategy \
to single out the wrapping contributions, based on adding\\nspectator fields. \
We use a toy model to demonstrate our procedure, performing\\nall \
computations explicitly. Although completely general, our treatment \
should\\nbe particularly useful for applications to the recent problem of \
wrapping\\ncontributions in some checks of the AdS/CFT \
correspondence.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
