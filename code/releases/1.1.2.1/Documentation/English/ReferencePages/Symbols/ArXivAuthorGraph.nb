               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Francesco Galvagno\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Francesco Galvagno\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Wilson loops as defects in N=2 conformal field \
theories\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"214 pages, several figures, PhD thesis based on \
arXiv:1802.09813,\\n  arXiv:1906.07085, arXiv:1910.06332\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
