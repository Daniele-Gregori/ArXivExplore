               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Hexagon POPE: effective particles and tree level \
resummation\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"29 pages, 8 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP01(2017)051\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
