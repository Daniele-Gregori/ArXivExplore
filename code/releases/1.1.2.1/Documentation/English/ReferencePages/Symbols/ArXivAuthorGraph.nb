               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  It is shown that a class of rotating strings in AdS_5 x \
S^5 with SO(6)\\nangular momenta (J,J',J') preserve 1/8-supersymmetry for \
large J,J', in which\\nlimit they are effectively tensionless; when J=0, \
supersymmetry is enhanced to\\n1/4. These results imply that recent checks of \
the AdS/CFT correspondence\\nactually test a nearly-BPS sector.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
