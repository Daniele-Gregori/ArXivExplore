          TagBox[
           TagBox[
            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0511139\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Keisuke Okamura\""}]}, {
              
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Keisuke Okamura, Yastoshi Takayama and Kentaroh \
Yoshida\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Open Spinning Strings and AdS/dCFT Duality\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"1+50 pages, 7 figures, JHEP style, references \
added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP0601:112,2006\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2006/01/112\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We consider open spinning string solutions on an AdS_4 \
x S^2-brane (D5-brane)\\nin the bulk AdS_5 x S^5 background. By taking \
account of the breaking of\\nSO(6)_R to SO(3)_H x SO(3)_V due to the presence \
of the AdS-brane, the open\\nrotating string ansatz is discussed. We \
construct the elliptic folded/circular\\nopen string solutions in the SU(2) \
and the SL(2) sectors, so that they satisfy\\nthe appropriate boundary \
conditions. On the other hand, in the SU(2) sector of\\nthe gauge theory, we \
compute the matrix of anomalous dimension of the defect\\noperator, which \
turns out to be the Hamiltonian of an open integrable spin\\nchain. Then we \
consider the coordinate Bethe ansatz with arbitrary number of\\nimpurities, \
and compare the boundary condition of the Bethe wavefunction with\\nthat of \
the corresponding open string solution. We also discuss the Bethe\\nansatz \
for the open SL(2) spin chain with several supports from the string\\ntheory \
side. Then, in both SU(2) and SL(2) sectors, we analyze the Bethe\\nequations \
in the thermodynamic limit and formulate the `doubling trick' on \
the\\nRiemann surface associated with the gauge theory.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 14 Nov 2005 13:33:25 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 25 Nov 2005 11:24:44 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2009-11-11\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Okamura\"", ",", "\"Keisuke\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Takayama\"", ",", "\"Yastoshi\"", ",", "\"\""}], "}"}],
                     ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Yoshida\"", ",", "\"Kentaroh\"", ",", "\"\""}],
                     "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
             Left, ColumnAlignments -> Left], Column], 
