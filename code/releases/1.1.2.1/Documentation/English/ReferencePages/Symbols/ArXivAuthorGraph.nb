               RowBox[{"\"id\"", "\[Rule]", "\"1410.8860\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Ivan K. Kostov\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
