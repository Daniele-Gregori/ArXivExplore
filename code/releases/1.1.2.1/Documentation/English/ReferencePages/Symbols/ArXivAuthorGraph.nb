               RowBox[{"\"submitter\"", "\[Rule]", "\"Andrei Mikhailov\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Andrei Mikhailov\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"A nonlocal Poisson bracket of the sine-Gordon \
model\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"18 pages, LaTeX, v2,3: added Section 4 and \
references\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"J.Geom.Phys.61:85-94,2011\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.geomphys.2010.05.011\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
                 "\"CALT-68-2581, ITEP-TH-69/05\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th nlin.SI\""}]}, {
              
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  It is well known that the classical string on a \
two-sphere is more or less\\nequivalent to the sine-Gordon model. We consider \
the nonabelian dual of the\\nclassical string on a two-sphere. We show that \
there is a projection map from\\nthe phase space of this model to the phase \
space of the sine-Gordon model. The\\ncorresponding Poisson structure of the \
sine-Gordon model is nonlocal with one\\nintegration.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 7 Nov 2005 00:07:46 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
