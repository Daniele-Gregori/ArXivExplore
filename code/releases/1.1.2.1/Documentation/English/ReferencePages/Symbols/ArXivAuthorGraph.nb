                    RowBox[{"{", 
                    RowBox[{"\"Fabri\"", ",", "\"Matheus\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Lefundes\"", ",", "\"Gabriel\"", ",", "\"\""}],
                     "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
