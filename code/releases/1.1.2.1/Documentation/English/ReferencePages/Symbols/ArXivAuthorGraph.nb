               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Contact terms, symmetries and D-instantons\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"18 pages, Latex\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys. B508 (1997) 133-146\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1016/S0550-3213(97)00507-5\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"DAMTP-97-44\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  The scattering of NS-NS antisymmetric tensor states in \
the presence of\\nD-instantons in type IIB superstring theory is studied. It \
is shown that in\\norder to preserve gauge invariance, spacetime \
supersymmetry and picture\\nchanging symmetry the inclusion of boundary \
contact terms for closed string\\nantisymmetric tensor vertex operators is \
necessary.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
