                "\"title\"", "\[Rule]", 
                 "\"Noncommutative 3-colour scalar quantum field theory model \
in 2D\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"24 pages\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Eur.Phys.J. C78 (2018) no.7, 580\""}]}, {
               
