               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Conformal SO(2,4) Transformations for the Helical AdS \
String Solution\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"16 pages, LaTex, no figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP0805:021,2008\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2008/05/021\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  By applying the conformal SO(2,4) transformations to \
the folded rotating\\nstring configuration with two spins given by a certain \
limit from the helical\\nstring solution in AdS_3 x S^1, we construct new \
string solutions whose\\nenergy-spin relations are characterized by the boost \
parameter. When two\\nSO(2,4) transformations are performed with two boost \
parameters suitably\\nchosen, the straight folded rotating string solution \
with one spin in AdS_3 is\\ntransformed in the long string limit into the \
long spiky string solution whose\\nexpression is given from the helical \
string solution in AdS_3 by making a limit\\nthat the modulus parameter \
becomes unity.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
