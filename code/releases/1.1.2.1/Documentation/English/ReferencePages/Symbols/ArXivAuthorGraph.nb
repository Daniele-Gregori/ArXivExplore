                "\"title\"", "\[Rule]", 
                 "\"Large-Spin Expansions of GKP Strings\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"46 pages, 8 figures; Matches published version; Contains \
equation\\n  (7.3) that gives the finite-size corrections to the dispersion \
relation of\\n  giant magnons at strong coupling\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 03 (2014) 018\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP03(2014)018\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
