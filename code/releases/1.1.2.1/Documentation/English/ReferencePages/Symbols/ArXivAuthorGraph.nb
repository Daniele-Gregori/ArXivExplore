            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"2011.02885\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Matteo Beccaria\""}]}, {
              
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Matteo Beccaria, Arkady A. Tseytlin\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On the structure of non-planar strong coupling \
