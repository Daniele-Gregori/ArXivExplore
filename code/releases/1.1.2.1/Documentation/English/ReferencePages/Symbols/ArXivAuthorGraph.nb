                    "\"Tue, 19 Jun 2001 23:21:59 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 27 Jun 2001 21:25:00 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
