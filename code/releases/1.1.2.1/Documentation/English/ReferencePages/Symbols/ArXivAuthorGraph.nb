               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  One-loop corrections to the energy of semiclassical \
rotating strings contain\\nboth analytic and non-analytic terms in the 't \
Hooft coupling. Analytic\\ncontributions agree with the prediction from the \
string Bethe ansatz based on\\nthe classical S-matrix, but in order to \
include non-analytic contributions\\nquantum corrections are required. We \
find a general expression for the first\\nquantum correction to the string \
Bethe ansatz.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
