               RowBox[{"\"authors\"", "\[Rule]", "\"Rouven Frassek\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Boundary Perimeter Bethe Ansatz\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"21 pages, 10 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1751-8121/aa7278\""}]}, {
