               "Tue, 21 Jun 2022 13:55:22 GMT"}}, "update_date" -> 
            "2022-09-20", 
            "authors_parsed" -> {{"Mauch", "Roman", ""}, {
              "Ruggeri", "Lorenzo", ""}}}], "Tooltip"]& ], 
