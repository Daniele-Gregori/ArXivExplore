                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 5 Sep 2014 15:55:19 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2015-02-12\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
