                    RowBox[{"\"version\"", "\[Rule]", "\"v3\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 16 Apr 2007 13:24:02 GMT\""}]}], "}"}]}], 
