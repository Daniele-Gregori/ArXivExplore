                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 13 May 2008 15:29:04 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
