                "\"submitter\"", "\[Rule]", "\"Alessandro Torrielli\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Andrea Fontanella and Alessandro Torrielli\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Massless sector of AdS_3 superstrings: a geometric \
interpretation\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"REVTeX, 9 pages; no figures; v2: references added; v3: \
typo corrected\""}]}, {
               
