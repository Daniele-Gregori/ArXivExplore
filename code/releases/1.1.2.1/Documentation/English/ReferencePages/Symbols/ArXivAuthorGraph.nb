               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Localization of the four-dimensional N=4 SYM to a \
two-sphere and 1/8 BPS\\n  Wilson loops\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"49 pages; v3: typos corrected\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP12(2012)067\""}]}, {
