               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We propose the generalized Luscher formula for \
multi-magnon states by which\\none can compute the finite-size correction to \
the energy of multi giant magnons\\nat classical and one-loop levels. It is \
shown that the F-term of our formula is\\nconsistent with the exact \
finite-size spectrum of the sinh-Gordon model, and\\nthe mu-term agrees with \
the finite-size energy of magnon boundstate of the\\nasymptotic Bethe Ansatz \
in the su(2) sector at strong coupling. In an appendix,\\nwe evaluate our \
formula at weak coupling under some approximations, and find\\nthat the \
transcendental terms arise from a sum over an infinite tower of \
BPS\\nboundstates.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
