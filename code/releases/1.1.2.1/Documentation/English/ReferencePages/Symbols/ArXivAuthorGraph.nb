                "\"title\"", "\[Rule]", 
                 "\"Replicas, averaging and factorization in the IIB matrix \
model\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"34 pages, 2 figures; this version: discussion on possible \
relation to\\n  AdS/CFT, a few technical points explained in more detail, \
updated references,\\n  corrected typos\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP09 (2022) 136\""}]}, {
               
