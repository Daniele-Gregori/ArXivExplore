                "\"title\"", "\[Rule]", 
                 "\"$T\\\\bar{T}$ Partition Function from Topological Gravity\
\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"21 pages, 1 figure; v2: typos fixed and some notation \
clarified, as\\n  compared to the JHEP version\""}]}, {
