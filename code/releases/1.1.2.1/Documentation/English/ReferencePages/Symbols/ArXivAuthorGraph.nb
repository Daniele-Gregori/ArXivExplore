               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Giant magnons in AdS_4/CFT_3: dispersion, quantization \
and finite--size\\n  corrections\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"v3: some misprints corrected\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
