                "\"title\"", "\[Rule]", 
                 "\"N=2 supersymmetric gauge theory on connected sums of $S^2\
\\\\times S^2$\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"49 pages, refs added, the final version to appear in JHEP\
\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP03(2017)026\""}]}, {
