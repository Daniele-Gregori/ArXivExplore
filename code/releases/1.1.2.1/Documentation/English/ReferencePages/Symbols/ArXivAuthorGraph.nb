               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/9906179\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Ben Craps\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Ben Craps and Frederik Roose\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"NS fivebranes in type 0 string theory\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"LaTeX, 12 pages, no figures; v3: section on S-duality \
revised,\\n  references added, to be published in JHEP\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 9910:007,1999\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/1999/10/007\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"KUL-TF-99/24\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  The massless degrees of freedom of type 0 NS5-branes \
are derived. A\\nnon-chiral, purely bosonic spectrum is found in both type 0A \
and 0B. This\\nnon-chirality is confirmed by a one-loop computation in the \
bulk. Some puzzles\\nconcerning type 0B S-duality are pointed out in this \
context. An interpretation\\nof the spectra in terms of ``type 0 little \
strings'' is proposed.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
