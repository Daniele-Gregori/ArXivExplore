                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v3\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 20 Mar 2015 13:52:45 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
