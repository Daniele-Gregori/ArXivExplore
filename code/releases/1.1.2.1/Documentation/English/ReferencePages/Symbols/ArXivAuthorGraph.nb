               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On non-supersymmetric generalizations of the \
Wilson-Maldacena loops in\\n  N=4 SYM\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"32 pages, 4 figures. v2: typos fixed\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.nuclphysb.2018.07.019\""}]}, {
               
