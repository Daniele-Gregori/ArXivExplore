               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We find a class of new supersymmetric dyonic black \
holes in four-dimensional\\nmaximal gauged supergravity which are asymptotic \
to the ${\\\\rm SU(3)}\\\\times {\\\\rm\\nU(1)}$ invariant AdS$_4$ Warner \
vacuum. These black holes can be embedded in\\neleven-dimensional \
supergravity where they describe the backreaction of\\nM2-branes wrapped on a \
Riemann surface. The holographic dual description of\\nthese supergravity \
backgrounds is given by a partial topological twist on a\\nRiemann surface of \
a three-dimensional $\\\\mathcal{N}=2$ SCFT that is obtained by\\na \
mass-deformation of the ABJM theory. We compute explicitly the \
topologically\\ntwisted index of this SCFT and show that it accounts for the \
entropy of the\\nblack holes.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 9 Jan 2018 20:41:22 GMT\""}]}], "}"}], "}"}]}]}, {
              
               RowBox[{"\"update_date\"", "\[Rule]", "\"2018-04-04\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Bobev\"", ",", "\"Nikolay\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Min\"", ",", "\"Vincent S.\"", ",", "\"\""}], 
                    "}"}], ",", 
