               RowBox[{"\"id\"", "\[Rule]", "\"math-ph/0606069\""}]}, {
               
               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Fabien Vignes-Tourneret\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", "\"Fabien Vignes-Tourneret\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Renormalization of the Orientable Non-commutative \
Gross-Neveu Model\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"45 pages, 5 figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"AnnalesHenriPoincare8:427-474,2007\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/s00023-006-0312-6\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", "\"math-ph hep-th math.MP\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We prove that the non-commutative Gross-Neveu model on \
the two-dimensional\\nMoyal plane is renormalizable to all orders. Despite a \
remaining UV/IR mixing,\\nrenormalizability can be achieved. However, in the \
massive case, this forces us\\nto introduce an additional counterterm of the \
form \\\"psibar i gamma^{0}\\ngamma^{1} psi\\\". The massless case is \
renormalizable without such an addition.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 29 Jun 2006 18:38:20 GMT\""}]}], "}"}], "}"}]}]}, {
