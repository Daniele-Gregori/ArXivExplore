                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Itsios\"", ",", "\"Georgios\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Zoakos\"", ",", "\"Dimitrios\"", ",", "\"\""}],
                     "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
