               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On the Scattering of Magnon Boundstates\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"14 pages\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP0611:035,2006\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2006/11/035\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", "\"DAMTP-06-62, UT-06-16\""}]}, {
