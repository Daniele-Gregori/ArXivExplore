               RowBox[{
                "\"authors\"", "\[Rule]", "\"Z. Bajnok and Zs. Simon\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Solving topological defects via fusion\""}]}, {
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"LaTeX, 24 pages, 34 eps figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys.B802:307-329,2008\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.nuclphysb.2008.04.003\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  Integrable defects in two-dimensional integrable models \
are purely\\ntransmitting thus topological. By fusing them to integrable \
boundaries new\\nintegrable boundary conditions can be generated, and, from \
the comparison of\\nthe two solved boundary theories, explicit solutions of \
defect models can be\\nextracted. This idea is used to determine the \
transmission factors and defect\\nenergies of topological defects in \
sinh-Gordon and Lee-Yang models. The\\ntransmission factors are checked in \
Lagrangian perturbation theory in the\\nsinh-Gordon case, while the defect \
energies are checked against defect\\nthermodynamic Bethe ansatz equations \
derived to describe the ground-state\\nenergy of diagonal defect systems on a \
cylinder. Defect bootstrap equations are\\nalso analyzed and are closed by \
determining the spectrum of defect bound-states\\nin the Lee-Yang \
model.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 27 Dec 2007 23:16:02 GMT\""}]}], "}"}], "}"}]}]}, {
