                "\"title\"", "\[Rule]", 
                 "\"Non-integrability on AdS$_3$ supergravity \
backgrounds\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"22 pages plus appendices. Added references, corrected \
typos,\\n  corrected/added comments, improved title\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
