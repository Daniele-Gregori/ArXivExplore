                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{"\"Nozawa\"", ",", "\"Masato\"", ",", "\"\""}], 
                    "}"}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
