, {
                
                RowBox[{
                 "\"abstract\"", "\[Rule]", 
                  "\"  Previous attempts to match the exact N=4 super \
Yang-Mills expression for the\\nexpectation value of the 1/2-BPS circular \
Wilson loop with the semiclassical\\nAdS(5)xS(5) string theory prediction \
were not successful at the first\\nsubleading order. There was a missing \
prefactor ~ lambda^(-3/4) which could be\\nattributed to the unknown \
normalization of the string path integral measure.\\nHere we resolve this \
problem by computing the ratio of the string partition\\nfunctions \
corresponding to the circular Wilson loop and the \
special\\n1/4-supersymmetric latitude Wilson loop. The fact that the latter \
has a trivial\\nexpectation value in the gauge theory allows us to relate the \
prefactor to the\\ncontribution of the three zero modes of the \\\"transverse\
\\\" fluctuation operator\\nin the 5-sphere directions.\\n\""}]}, {
                RowBox[{"\"versions\"", "\[Rule]", 
                  RowBox[{"{", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 24 Apr 2018 09:36:48 GMT\""}]}], "}"}], "}"}]}]}, {
                RowBox[{"\"update_date\"", "\[Rule]", "\"2018-07-04\""}]}, {
                RowBox[{"\"authors_parsed\"", "\[Rule]", 
                  RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Medina-Rincon\"", ",", "\"Daniel\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Tseytlin\"", ",", "\"Arkady A.\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Zarembo\"", ",", "\"Konstantin\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
