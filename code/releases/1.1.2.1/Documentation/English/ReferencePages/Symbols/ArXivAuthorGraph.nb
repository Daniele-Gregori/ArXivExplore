                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"McLoughlin\"", ",", "\"Tristan\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Swanson\"", ",", "\"Ian\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
