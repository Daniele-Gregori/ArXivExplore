               RowBox[{"\"id\"", "\[Rule]", "\"1803.03078\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Rafael Hernandez\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Rafael Hernandez, Juan Miguel Nieto, Roberto Ruiz\""}]}, {
              
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Pulsating strings with mixed three-form flux\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"10 pages. Latex\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP04(2018)078\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  Circular strings pulsating in $AdS_3 \\\\times S^3 \
\\\\times T^4$ with mixed R-R\\nand NS-NS three-form fluxes can be described \
by an integrable deformation of\\nthe one-dimensional Neumann-Rosochatius \
mechanical model. In this article we\\nfind a general class of pulsating \
solutions to this integrable system that can\\nbe expressed in terms of \
elliptic functions. In the limit of strings moving in\\n$AdS_{3}$ with pure \
NS-NS three-form flux, where the action reduces to \
the\\n$SL(2,\\\\mathbb{R})$ WZW model, we find agreement with the analysis of \
the\\nclassical solutions of the system performed using spectral flow by \
Maldacena\\nand Ooguri. We use our elliptic solutions in $AdS_{3}$ to extend \
the dispersion\\nrelation beyond the limit of pure NS-NS flux.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 8 Mar 2018 13:22:01 GMT\""}]}], "}"}], "}"}]}]}, {
              
               RowBox[{"\"update_date\"", "\[Rule]", "\"2018-05-23\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
