                    RowBox[{"{", 
                    RowBox[{"\"Pajer\"", ",", "\"Enrico\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Zaldarriaga\"", ",", "\"Matias\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
