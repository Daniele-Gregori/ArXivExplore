               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Marius de Leeuw, Tam\\\\'as Gombor, Charlotte \
Kristjansen, Georgios\\n  Linardopoulos, Bal\\\\'azs Pozsgay\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Spin Chain Overlaps and the Twisted Yangian\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"47 pages, misprints corrected\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 01 (2020) 176\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP01(2020)176\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
