               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"On the Origin of the $SO(9) \\\\rightarrow SO(3) \
\\\\times SO(6)$ Symmetry\\n  Breaking in the IKKT Matrix Model\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"11 pages, 3 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
