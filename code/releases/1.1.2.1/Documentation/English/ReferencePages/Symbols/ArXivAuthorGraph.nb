                 "\"J. Ambjorn, Y. Makeenko and A. Sedrakyan\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Effective QCD string beyond Nambu-Goto\""}]}, {
               
