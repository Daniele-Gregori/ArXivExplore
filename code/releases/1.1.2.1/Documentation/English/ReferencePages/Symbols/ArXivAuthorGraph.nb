                    RowBox[{"\"version\"", "\[Rule]", "\"v3\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Sat, 22 Oct 2022 12:21:14 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
