              "Roiban", "R.", ""}, {"Tirziu", "A.", ""}, {
              "Tseytlin", "A. A.", ""}}}], "Tooltip"]& ], 
        TagBox[
         TooltipBox[DiskBox[{17.37376953609006, -3.2850461924037315`}, 0.],
