               RowBox[{"\"authors\"", "\[Rule]", "\"Martin Wolf\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"A Connection between Twistors and Superstring Sigma \
Models on Coset\\n  Superspaces\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"v3: 16 pages, typos fixed and minor clarifications \
added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0909:071,2009\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2009/09/071\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We consider superstring sigma models that are based on \
coset superspaces G/H\\nin which H arises as the fixed point set of an \
order-4 automorphism of G. We\\nshow by means of twistor theory that the \
corresponding first-order system,\\nconsisting of the Maurer-Cartan equations \
and the equations of motion, arises\\nfrom a dimensional reduction of some \
generalised self-dual Yang-Mills equations\\nin eight dimensions. Such a \
relationship might help shed light on the explicit\\nconstruction of \
solutions to the superstring equations including their hidden\\nsymmetry \
structures and thus on the properties of their gauge theory duals.\\n\""}]}, {
              
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
