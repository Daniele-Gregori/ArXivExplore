               RowBox[{"\"id\"", "\[Rule]", "\"0709.3342\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Kazuhiro Sakai\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Kazuhiro Sakai and Yuji Satoh\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Microscopic formulation of the S-matrix in AdS/CFT\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"23 pages, no figures; v2: references and minor \
clarifications added,\\n  version to be published in JHEP\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0712:044,2007\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2007/12/044\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"UTHEP-548\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We develop the derivation we proposed in hep-th/0703177 \
of the dressing phase\\nof the S-matrix in the AdS/CFT correspondence in the \
framework of the\\nunderlying bare integrable model. We elaborate the \
configuration of the Bethe\\nroots describing the physical vacuum, which \
consists of a long Bethe string\\nstretched along the imaginary axis and \
stacks distributed along the real axis.\\nWe determine the distribution of \
all Bethe roots in the thermodynamic limit. We\\nthen directly compute the \
scattering phase of the fundamental excitations over\\nthe physical vacuum \
and reproduce the BHL/BES dressing phase.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 21 Sep 2007 13:51:14 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 4 Dec 2007 08:45:57 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2009-06-10\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Sakai\"", ",", "\"Kazuhiro\"", ",", "\"\""}], 
                    "}"}], ",", 
