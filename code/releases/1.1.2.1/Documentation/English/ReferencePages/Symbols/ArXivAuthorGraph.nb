               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Defect correlators in a $\\\\mathcal{N}=2$ SCFT at strong \
coupling\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"22 pages\""}]}, {
