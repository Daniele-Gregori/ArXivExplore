            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"2204.07542\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Joao A. Silva\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Luis F. Alday, Tobias Hansen and Joao A. Silva\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"AdS Virasoro-Shapiro from dispersive sum rules\""}]}, {
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"32 pages. Published version\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP10(2022)036\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We consider the four-point correlator of the \
stress-energy tensor in ${\\\\cal\\nN}=4$ SYM, to leading order in inverse \
powers of the central charge, but\\nincluding all order corrections in \
$1/\\\\lambda$. This corresponds to the AdS\\nversion of the Virasoro-Shapiro \
amplitude to all orders in the small\\n$\\\\alpha'$/low energy expansion. \
Using dispersion relations in Mellin space, we\\nderive an infinite set of \
sum rules. These sum rules strongly constrain the\\nform of the amplitude, \
and determine all coefficients in the low energy\\nexpansion in terms of the \
CFT data for heavy string operators, in principle\\navailable from \
integrability. For the first set of corrections to the flat\\nspace amplitude \
we find a unique solution consistent with the results from\\nintegrability \
and localisation.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 15 Apr 2022 16:57:30 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
