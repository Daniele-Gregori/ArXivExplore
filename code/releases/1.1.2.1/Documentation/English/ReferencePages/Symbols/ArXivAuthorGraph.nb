                RowBox[{
                 "\"authors\"", "\[Rule]", 
                  "\"Yu. Makeenko and K. Zarembo\""}]}, {
                
                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Adjoint Fermion Matrix Models\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", 
                  "\"20pp., Latex (4 Latex figures), SMI-93-5\""}]}, {
                
                RowBox[{
                 "\"journal-ref\"", "\[Rule]", 
                  "\"Nucl.Phys. B422 (1994) 237-257\""}]}, {
                
                RowBox[{
                 "\"doi\"", "\[Rule]", "\"10.1016/0550-3213(94)00061-1\""}]}, {
                RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
                RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
                RowBox[{
                 "\"abstract\"", "\[Rule]", 
                  "\"  We study fermionic one-matrix, two-matrix and \
$D$-dimensional gauge invariant\\nmatrix models. In all cases we derive loop \
equations which unambiguously\\ndetermine the large-$N$ solution. For the \
one-matrix case the solution is\\nobtained for an arbitrary interaction \
potential and turns out to be equivalent\\nto the one for the Hermitean \
one-matrix model with a logarithmic potential and,\\ntherefore, belongs to \
the same universality class. The explicit solutions for\\nthe fermionic \
two-matrix and $D$-dimensional matrix models are obtained at\\nlarge $N$ (or \
in the spherical approximation) for the quadratic potential.\\n\""}]}, {
                RowBox[{"\"versions\"", "\[Rule]", 
                  RowBox[{"{", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
