                "\"authors\"", "\[Rule]", 
                 "\"R.A. Janik (Saclay & Jagellonian U.), R. Peschanski \
(Saclay)\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"High energy scattering and the AdS/CFT \
correspondence\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"22p, 2 figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Nucl.Phys.B565:193-209,2000\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1016/S0550-3213(99)00651-3\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th hep-ph\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We consider small angle and large impact parameter high \
energy scattering of\\ncolourless states in SYM using the AdS/CFT \
correspondence. The gauge theory\\nscattering amplitude is linked with a \
correlation function of tilted Wilson\\nloops, which can be calculated by the \
exchange of bulk supergravity fields\\nbetween the two corresponding string \
worldsheets. We identify the dominant\\ncontributions, which all correspond \
to real phase shifts. In particular, we\\nfind a contribution of the bulk \
graviton which gives an unexpected\\n`gravity-like' $s^1$ behaviour of the \
gauge theory phase shift in a specific\\nrange of energies and (large) impact \
parameters.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 22 Jul 1999 16:28:22 GMT\""}]}], "}"}], "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2008-11-26\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Janik\"", ",", "\"R. A.\"", ",", "\"\"", ",", 
                    "\"Saclay & Jagellonian U.\""}], "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
