                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 26 Apr 1999 15:34:29 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
