               RowBox[{"\"submitter\"", "\[Rule]", "\"Shai Chester\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Marco Baggio, Nikolay Bobev, Shai M. Chester, Edoardo \
Lauria, and\\n  Silviu S. Pufu\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Decoding a Three-Dimensional Conformal Manifold\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"59 pages, 13 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP02(2018)062\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"PUPT-2544\""}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", 
                 "\"hep-th cond-mat.stat-mech cond-mat.str-el\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We study the one-dimensional complex conformal manifold \
that controls the\\ninfrared dynamics of a three-dimensional \
$\\\\mathcal{N}=2$ supersymmetric theory\\nof three chiral superfields with a \
cubic superpotential. Two special points on\\nthis conformal manifold are the \
well-known XYZ model and three decoupled copies\\nof the critical Wess-Zumino \
model. The conformal manifold enjoys a discrete\\nduality group isomorphic to \
$S_4$ and can be thought of as an orbifold of\\n$\\\\mathbf{CP}^1$. We use \
the $4-\\\\varepsilon$ expansion and the numerical\\nconformal bootstrap to \
calculate the spectrum of conformal dimensions of\\nlow-lying operators and \
their OPE coefficients, and find a very good\\nquantitative agreement between \
the two approaches.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 7 Dec 2017 16:28:23 GMT\""}]}], "}"}], "}"}]}]}, {
              
               RowBox[{"\"update_date\"", "\[Rule]", "\"2018-04-04\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Baggio\"", ",", "\"Marco\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Bobev\"", ",", "\"Nikolay\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Chester\"", ",", "\"Shai M.\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Lauria\"", ",", "\"Edoardo\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Pufu\"", ",", "\"Silviu S.\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
