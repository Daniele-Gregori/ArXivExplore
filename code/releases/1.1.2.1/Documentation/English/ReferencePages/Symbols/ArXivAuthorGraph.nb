        TagBox[
         TooltipBox[DiskBox[{13.00689115995573, -5.074361365747699}, 0.],
          TagBox[
           TagBox[
            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0405288\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Gordon Semenoff\""}]}, {
              
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Gordon W. Semenoff and Donovan Young\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Wavy Wilson Line and AdS/CFT\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Int.J.Mod.Phys. A20 (2005) 2833-2846\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1142/S0217751X0502077X\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  Wilson loops which are small deviations from straight, \
infinite lines, called\\nwavy lines, are considered in the context of the \
AdS/CFT correspondence. A\\nsingle wavy line and the connected correlation \
function of a straight and wavy\\nline are considered. It is argued that, to \
leading order in ``waviness'', the\\nfunctional form of the loop is universal \
and the coefficient, which is a\\nfunction of the 't Hooft coupling, is found \
in weak coupling perturbation\\ntheory and the strong coupling limit using \
the AdS/CFT correspondence.\\nSupersymmetric arguments are used to simplify \
the computation and to show that\\nthe straight line obeys the \
Migdal-Makeenko loop equation.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 31 May 2004 19:38:58 GMT\""}]}], "}"}], "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2009-11-10\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Semenoff\"", ",", "\"Gordon W.\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Young\"", ",", "\"Donovan\"", ",", "\"\""}], 
