Linardopoulos\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Stringy Membranes in AdS/CFT\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"40 pages, 9 figures; published version\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 08 (2013) 089\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP08(2013)089\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
