new integrable\\n  boundary\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"16 pages. Additional information added in section \
4.1\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP08(2014)036\""}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
