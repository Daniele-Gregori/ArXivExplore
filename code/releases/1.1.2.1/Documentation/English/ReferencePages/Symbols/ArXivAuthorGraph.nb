               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We propose a manifestly supersymmetric generalization \
of the solvable $T\\n\\\\overline{T}$ deformation of two-dimensional field \
theories. For theories with\\n$(1,1)$ and $(0,1)$ supersymmetry, the \
deformation is defined by adding a term\\nto the superspace Lagrangian built \
from a superfield containing the\\nsupercurrent. We prove that the energy \
levels of the resulting deformed theory\\nare determined exactly in terms of \
those of the undeformed theory. This\\nsupersymmetric deformation extends to \
higher dimensions, where we conjecture\\nthat it might provide a \
higher-dimensional analogue of $T \\\\overline{T}$,\\nproducing \
supersymmetric Dirac or Dirac-Born-Infeld actions in special cases.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
