                    "\"Semenoff\"", ",", "\"Gordon W.\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Szabo\"", ",", "\"Richard J.\"", ",", "\"\""}],
                     "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
