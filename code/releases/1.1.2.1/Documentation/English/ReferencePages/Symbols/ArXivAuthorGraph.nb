               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Extremal Correlator of Three Vertex Operators for \
Circular Winding\\n  Strings in AdS5xS5\""}]}, {
               RowBox[{
                "\"comments\"", "\[Rule]", "\"15pages,LaTeX,no figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP11(2011)026\""}]}, {
