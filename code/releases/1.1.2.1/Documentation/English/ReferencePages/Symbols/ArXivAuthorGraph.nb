                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Banerjee\"", ",", "\"Sibasish\"", ",", "\"\""}], "}"}],
                     ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Longhi\"", ",", "\"Pietro\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Romo\"", ",", "\"Mauricio\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
