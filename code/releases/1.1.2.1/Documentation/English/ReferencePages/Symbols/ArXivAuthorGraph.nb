                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 25 Jun 2015 05:01:41 GMT\""}]}], "}"}], "}"}]}]}, {
