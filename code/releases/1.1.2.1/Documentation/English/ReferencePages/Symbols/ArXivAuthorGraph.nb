                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 19 Sep 2003 12:09:33 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
