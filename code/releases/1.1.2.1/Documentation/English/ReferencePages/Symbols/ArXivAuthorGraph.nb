               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Quantum integrability from non-simply laced quiver gauge \
theory\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"34 pages\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 1806 (2018) 165\""}]}, {
              
               
