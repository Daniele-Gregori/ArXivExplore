                    RowBox[{"{", 
                    RowBox[{"\"Galakhov\"", ",", "\"Dmitry\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Gavshin\"", ",", "\"Alexei\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Morozov\"", ",", "\"Alexei\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Tselousov\"", ",", "\"Nikita\"", ",", "\"\""}],
                     "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
