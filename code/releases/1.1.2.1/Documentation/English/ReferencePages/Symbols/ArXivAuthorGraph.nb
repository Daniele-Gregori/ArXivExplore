               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0508064\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Nelia Mann\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Theodore G. Erler and Nelia Mann\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Integrable Open Spin Chains and the Doubling Trick in N = \
2 SYM with\\n  Fundamental Matter\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"30 pages, 14 figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP0601:131,2006\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2006/01/131\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We demonstrate that the one-loop anomalous dimension \
matrix in N = 2 SYM with\\na single chiral hypermultiplet of fundamental \
matter, which is dual to AdS_5 X\\nS^5 with a D7-brane filling AdS_5 and \
wrapped around an $^3 in the S^5, is an\\nintegrable open spin chain \
Hamiltonian. We also use the doubling trick to\\nrelate these open spin \
chains to closed spin chains in pure N = 4 SYM. By using\\nthe AdS/CFT \
correspondence, we find a relation between the corresponding open\\nand \
closed strings that differs from a simple doubling trick by terms \
that\\nvanish in the semiclassical limit. We also demonstrate that in some \
cases the\\nclosed string is simpler and easier to study than the \
corresponding open\\nstring, and we speculate on the nature of corrections \
due to the presence of\\nD-branes that this implies.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 9 Aug 2005 19:15:13 GMT\""}]}], "}"}], "}"}]}]}, {
              
