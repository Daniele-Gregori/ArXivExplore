                "\"title\"", "\[Rule]", 
                 "\"Spectral curve for open strings attached to the Y=0 brane\
\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"34 pages, 2 figures; v3: typos corrected, sect.2.2 \
improved\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
