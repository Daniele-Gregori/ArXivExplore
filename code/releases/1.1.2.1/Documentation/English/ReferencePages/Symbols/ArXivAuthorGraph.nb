                "\"authors\"", "\[Rule]", 
                 "\"Yago Cagnacci and Sergio M. Iguri\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Spectral flow and conformal blocks in $AdS_3$\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"24 pages\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
