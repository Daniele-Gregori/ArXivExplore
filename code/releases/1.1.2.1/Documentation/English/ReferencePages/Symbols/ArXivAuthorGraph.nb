                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 4 May 2006 16:43:04 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2016-09-06\""}]}, {
