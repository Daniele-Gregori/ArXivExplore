            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"1801.03838\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Balazs Pozsgay\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"B. Pozsgay\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Overlaps with arbitrary two-site states in the XXZ spin \
chain\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"22 pages, v2: references added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1742-5468/aabbe1\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", 
                 "\"cond-mat.stat-mech nlin.SI\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We present a conjectured exact formula for overlaps \
between the Bethe states\\nof the spin-1/2 XXZ chain and generic two-site \
states. The result takes the\\nsame form as in the previously known cases: it \
involves the same ratio of two\\nGaudin-like determinants, and a product of \
single-particle overlap functions,\\nwhich can be fixed using a combination \
of the Quench Action and Quantum\\nTransfer Matrix methods. Our conjecture is \
confirmed by numerical data from\\nexact diagonalization. For one-site states \
the formula is found to be correct\\neven in chains with odd length, where \
existing methods can not be applied. It\\nis also pointed out, that the ratio \
of the Gaudin-like determinants plays a\\ncrucial role in the overlap sum \
rule: it guarantees that in the thermodynamic\\nlimit there remains no \
$\\\\mathcal{O}(1)$ piece in the Quench Action.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 11 Jan 2018 16:00:12 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 25 Jan 2018 14:03:28 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
