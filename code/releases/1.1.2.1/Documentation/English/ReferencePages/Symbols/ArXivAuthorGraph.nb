               RowBox[{"\"authors\"", "\[Rule]", "\"Vincenzo Alba\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Towards a Generalized Hydrodynamics description of \
R\\\\'enyi entropies in\\n  integrable systems\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"18 pages, 8 figures, similar to published version\""}]}, {
              
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
