                "\"comments\"", "\[Rule]", 
                 "\"77 pages, 3 figures, v2: published version in JHEP\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP06(2023)169\""}]}, {
               
