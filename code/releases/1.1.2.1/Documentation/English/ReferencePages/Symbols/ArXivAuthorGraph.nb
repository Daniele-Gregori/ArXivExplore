               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Anisotropic Landau-Lifshitz sigma models from q-deformed \
AdS_5 x S^5\\n  superstrings\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"38 pages, 1 figure, typos corrected, minor comments and \
references\\n  added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP08(2014)110\""}]}, {
