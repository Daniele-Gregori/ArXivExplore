                "\"title\"", "\[Rule]", 
                 "\"Quantum Spin Systems and Supersymmetric Gauge Theories, I\
\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"76 pages, 3 figures, fix typo\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP03(2021)093\""}]}, {
               
