                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 13 Oct 2005 23:29:42 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
