            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"1710.08415\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Monica Guica\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Monica Guica\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"An integrable Lorentz-breaking deformation of \
two-dimensional CFTs\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"v3: institutional and grant information added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"SciPost Phys. 5, 048 (2018)\""}]}, {
               
