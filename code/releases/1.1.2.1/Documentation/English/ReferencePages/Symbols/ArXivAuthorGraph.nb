                    "\"Fri, 1 Oct 1999 10:04:59 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 6 Oct 1999 07:02:18 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2009-10-31\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
