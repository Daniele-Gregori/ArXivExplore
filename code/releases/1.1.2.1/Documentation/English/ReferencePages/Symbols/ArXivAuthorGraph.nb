                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 23 Nov 2005 13:55:06 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
