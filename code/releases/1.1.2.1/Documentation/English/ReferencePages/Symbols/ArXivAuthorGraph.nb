               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0003235\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Fuchs Ehud\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Ehud Fuchs\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"The U(1)s in the Finite N Limit of Orbifold Field \
Theories\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"2+35 pages, 2 figures, LaTex\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0010 (2000) 028\""}]}, {
              
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2000/10/028\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"TAUP-2624-2000\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We study theories generated by orbifolding the {\\\\cal \
N}=4 super conformal\\nU(N) Yang Mills theory with finite N, focusing on the \
r\\\\^ole of the remnant\\nU(1) gauge symmetries of the orbifold process. It \
is well known that the one\\nloop beta functions of the non abelian SU(N) \
gauge couplings vanish in these\\ntheories. It is also known that in the \
large N limit the beta functions vanish\\nto all order in perturbation \
theory. We show that the beta functions of the non\\nabelian SU(N) gauge \
couplings vanish to two and three loop order even for\\nfinite N. This is the \
result of taking the abelian U(1) of U(N)=SU(N)xU(1) into\\naccount. However, \
the abelian U(1) gauge couplings have a non vanishing beta\\nfunction. Hence, \
those theories are not conformal for finite N. We analyze \
the\\nrenormalization group flow of the orbifold theories, discuss the \
suppression of\\nthe cosmological constant and tackle the hierarchy problem \
in the non\\nsupersymmetric models.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Sun, 26 Mar 2000 17:37:50 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 31 Jul 2000 12:29:42 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
