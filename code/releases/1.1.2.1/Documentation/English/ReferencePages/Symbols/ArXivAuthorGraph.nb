                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 7 Jun 2018 14:48:53 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
