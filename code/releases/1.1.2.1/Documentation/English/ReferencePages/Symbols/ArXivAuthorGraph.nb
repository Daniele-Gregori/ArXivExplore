                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Hollowood\"", ",", "\"Timothy J.\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Miramontes\"", ",", "\"J. Luis\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Schmidtt\"", ",", "\"David M.\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
