                "\"title\"", "\[Rule]", 
                 "\"Surprises in the AdS algebraic curve constructions - \
Wilson loops and\\n  correlation functions\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"36 pages; v2: minor corrections\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
