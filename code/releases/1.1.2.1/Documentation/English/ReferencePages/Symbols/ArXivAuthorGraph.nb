               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Mark G. Alford, Matt Braby and Simin Mahmoodifar\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Shear viscosity from kaon condensation in \
color-flavor-locked quark\\n  matter\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"31 pages, 4 figures minor changes from referees including \
title\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys.Rev.C81:025202,2010\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1103/PhysRevC.81.025202\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"nucl-th\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We calculate the kaonic contribution to the shear \
viscosity of quark matter\\nin the kaon-condensed color-flavor locked phase \
(CFL-K0). This contribution\\ncomes from a light pseudo-Goldstone boson which \
arises from the spontaneous\\nbreaking of the flavor symmetry by the kaon \
condensate. The other contribution,\\nfrom the exactly massless superfluid \
'phonon\\\", has been calculated previously.\\nWe specialize to a particular \
form of the interaction lagrangian, parameterized\\nby a single coupling. We \
find that if we make reasonable guesses for the values\\nof the parameters of \
the effective theory, the kaons have a much smaller shear\\nviscosity than \
the superfluid phonons, but also a much shorter mean free path,\\nso they \
could easily provide the dominant contribution to the shear viscosity\\nof \
CFL-K0 quark matter in a neutron star in the temperature range 0.01 to 1 \
MeV\\n(10^8 to 10^10 K).\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
