               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We study the connected correlator of 1/2 BPS winding \
Wilson loops in\\n$\\\\mathcal{N}=4$ $U(N)$ super Yang-Mills theory, where \
those Wilson loops are on\\ntop of each other along the same circle. We find \
the exact finite $N$\\nexpression of the connected correlator of such Wilson \
loops. We show that the\\n$1/N$ expansion of this exact result is reproduced \
from the topological\\nrecursion of Gaussian matrix model. We also study the \
exact finite $N$\\nexpression of the generating function of 1/2 BPS Wilson \
loops in the symmetric\\nrepresentation.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
