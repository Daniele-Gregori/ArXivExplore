                "\"title\"", "\[Rule]", 
                 "\"$T \\\\bar T$ Deformations, Massive Gravity and \
Non-Critical Strings\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 
                 "\"36 pages, emergence and role of non-zero B-field \
clarified\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP06(2020)050\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", "\"Imperial/TP/2019/AT/01\""}]}, {
              
