               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Ultraviolet behavior of 6D supersymmetric Yang-Mills \
theories and\\n  harmonic superspace\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
