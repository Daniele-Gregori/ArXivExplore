               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Spectral curve for gamma-deformed AdS/CFT\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"14 pages; v2 references added and typos corrected\""}]}, {
              
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys. Lett. B 735, 332 (2014)\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.physletb.2014.06.052\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
