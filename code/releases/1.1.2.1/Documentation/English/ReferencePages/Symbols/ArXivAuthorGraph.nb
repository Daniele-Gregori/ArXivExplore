               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Dimitrios Katsinis\""}]}, {
               RowBox[{"\"authors\"", "\[Rule]", "\"Dimitrios Katsinis\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Novel aspects of integrability for NLSMs in symmetric \
spaces\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"38 pages, v2: added section on the conserved charges \
generated by the\\n  monodromy matrix, matches published version\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys.Rev.D 105 (2022) 12, 126008\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1103/PhysRevD.105.126008\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", 
                 "\"hep-th math-ph math.MP nlin.SI\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://creativecommons.org/licenses/by/4.0/\""}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We obtained the formal solution of the auxiliary system \
of Non Linear Sigma\\nModels, whose target space is a rank 1 symmetric space \
based on the indefinite\\northogonal group O(p,q), corresponding to an \
arbitrary solution of the NLSM.\\nThis class includes Anti-de Sitter, de \
Sitter and Hyperbolic spaces, which are\\nof interest in view of the AdS/CFT \
correspondence. The formal solution is\\nrelated to the Pohlmeyer reduction \
of the NLSM, constituting another link\\nbetween the NLSM and the reduced \
theory. Besides deriving the solution, we also\\nreview the Pohlmeyer \
reduction of such models. Finally, we comment on the\\nimplications for the \
monodromy matrix and its eigenvalues.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 25 Jan 2022 18:58:50 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 20 Jun 2022 01:51:06 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2022-06-22\""}]}, {
