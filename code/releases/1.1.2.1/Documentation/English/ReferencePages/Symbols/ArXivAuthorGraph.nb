              "Pribytok", "Anton", ""}, {"Retore", "Ana L.", ""}, {
              "Ryan", "Paul", ""}}}], "Tooltip"]& ], 
        TagBox[
         TooltipBox[DiskBox[{12.737908341157947`, -6.275058827048526}, 0.],
