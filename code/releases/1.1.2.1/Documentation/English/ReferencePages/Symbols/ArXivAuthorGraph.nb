                 "\"Segmented strings coupled to a B-field\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"6 pages, 3 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
