                "\"comments\"", "\[Rule]", "\"20 pages, 1 figure\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP09(2011)132\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
