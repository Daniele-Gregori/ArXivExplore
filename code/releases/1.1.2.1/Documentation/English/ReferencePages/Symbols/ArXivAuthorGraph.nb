               RowBox[{"\"id\"", "\[Rule]", "\"hep-th/0702036\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Albion Lawrence\""}]}, {
              
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Matthias R. Gaberdiel and Albion Lawrence\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Bulk perturbations of N=2 branes\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"35 pages (30 pages plus title and references), 8 \
figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 0705:087,2007\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1126-6708/2007/05/087\""}]}, {
               
               RowBox[{
                "\"report-no\"", "\[Rule]", 
                 "\"BRX-TH-581, NSF-KITP-06-125\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  The evolution of supersymmetric A-type D-branes under \
the bulk\\nrenormalization group flow between two different N=2 minimal \
models is studied.\\nUsing the Landau-Ginzburg description we show that a \
specific set of branes\\ndecouples from the infrared theory, and we make \
detailed predictions for the\\nbehavior of the remaining branes. The \
Landau-Ginzburg picture is then checked\\nagainst a direct conformal field \
theory analysis. In particular we construct a\\nnatural index pairing which \
is preserved by the RG flow, and show that the\\nbranes that decouple have \
vanishing index with the surviving branes.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 6 Feb 2007 16:02:34 GMT\""}]}], "}"}], "}"}]}]}, {
              
