               RowBox[{"\"id\"", "\[Rule]", "\"2002.08382\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Fei Yan\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Andrew Neitzke and Fei Yan\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"$q$-nonabelianization for line defects\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"71 pages, 77 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP09(2020)153\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", 
                 "\"hep-th math.GT math.QA math.RT\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
