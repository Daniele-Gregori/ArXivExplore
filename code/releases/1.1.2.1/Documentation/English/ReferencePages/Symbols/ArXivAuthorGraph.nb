               RowBox[{"\"submitter\"", "\[Rule]", "\"Manuel Losi\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Nick Dorey and Manuel Losi\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Spiky Strings and Giant Holes\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"36 pages, 9 figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 1012:014,2010\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP12(2010)014\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
