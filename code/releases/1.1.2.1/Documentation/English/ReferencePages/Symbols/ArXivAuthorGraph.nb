                    RowBox[{"{", 
                    RowBox[{"\"Bzowski\"", ",", "\"Adam\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Guica\"", ",", "\"Monica\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
