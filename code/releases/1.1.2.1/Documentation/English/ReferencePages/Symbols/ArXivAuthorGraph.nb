               RowBox[{
                "\"authors\"", "\[Rule]", 
                 
                 "\"Lorenzo Bianchi, Marco S. Bianchi, Alexis Bres, Valentina \
Forini and\\n  Edoardo Vescovi\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Two-loop cusp anomaly in ABJM at strong coupling\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"26 pages, few typos corrected, one footnote added, one \
reference\\n  added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP10(2014)013\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"HU-EP-14/30\""}]}, {
