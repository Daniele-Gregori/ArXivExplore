                "\"title\"", "\[Rule]", 
                 "\"Transport peak in thermal spectral function of ${\\\\cal \
N}=4$\\n  supersymmetric Yang-Mills plasma at intermediate coupling\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"V1: 6 pages, 2 figures, V2: Final version. To appear in \
Physical\\n  Review Letters\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys. Rev. Lett. 121, 191603 (2018)\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1103/PhysRevLett.121.191603\""}]}, {
               
