          TagBox[
           TagBox[
            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"2405.13830\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Paolo Arnaudo\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Paolo Arnaudo, Giulio Bonelli, Alessandro Tanzini\""}]}, {
              
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"One loop effective actions in Kerr-(A)dS Black \
Holes\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"35 pages\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", 
                 "\"hep-th gr-qc math-ph math.MP\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We compute new exact analytic expressions for one-loop \
scalar effective\\nactions in Kerr (A)dS black hole (BH) backgrounds in four \
and five dimensions.\\nThese are computed by the connection coefficients of \
the Heun equation via a\\ngeneralization of the Gelfand-Yaglom formalism to \
second-order linear ODEs with\\nregular singularities. The expressions we \
find are in terms of\\nNekrasov-Shatashvili special functions, making \
explicit the analytic properties\\nof the one-loop effective actions with \
respect to the gravitational parameters\\nand the precise contributions of \
the quasi-normal modes. The latter arise via\\nan associated integrable \
system. In particular, we prove asymptotic formulae\\nfor large angular \
momenta in terms of hypergeometric functions and give a\\nprecise \
mathematical meaning to Rindler-like region contributions. Moreover \
we\\nidentify the leading terms in the large distance expansion as the \
point\\nparticle approximation of the BH and their finite size corrections as \
encoding\\nthe BH tidal response. We also discuss exact properties of the \
thermal version\\nof the BH effective actions. Although we focus on the real \
scalar field in\\ndS-Kerr and (A)dS-Schwarzschild in four and five \
dimensions, similar formulae\\ncan be given for higher spin matter and \
radiation fields in more general\\ngravitational backgrounds.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 22 May 2024 16:58:05 GMT\""}]}], "}"}], "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2024-05-24\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Arnaudo\"", ",", "\"Paolo\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Bonelli\"", ",", "\"Giulio\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Tanzini\"", ",", "\"Alessandro\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
             Left, ColumnAlignments -> Left], Column], 
           Function[BoxForm`e$, 
            TableForm[BoxForm`e$]]]],
         Annotation[#, 
          
          TableForm[{
           "id" -> "2405.13830", "submitter" -> "Paolo Arnaudo", "authors" -> 
            "Paolo Arnaudo, Giulio Bonelli, Alessandro Tanzini", "title" -> 
            "One loop effective actions in Kerr-(A)dS Black Holes", 
            "comments" -> "35 pages", "journal-ref" -> Null, "doi" -> Null, 
            "report-no" -> Null, "categories" -> 
            "hep-th gr-qc math-ph math.MP", "license" -> 
            "http://arxiv.org/licenses/nonexclusive-distrib/1.0/", "abstract" -> 
            "  We compute new exact analytic expressions for one-loop scalar \
effective\nactions in Kerr (A)dS black hole (BH) backgrounds in four and five \
dimensions.\nThese are computed by the connection coefficients of the Heun \
equation via a\ngeneralization of the Gelfand-Yaglom formalism to \
second-order linear ODEs with\nregular singularities. The expressions we find \
are in terms of\nNekrasov-Shatashvili special functions, making explicit the \
analytic properties\nof the one-loop effective actions with respect to the \
gravitational parameters\nand the precise contributions of the quasi-normal \
modes. The latter arise via\nan associated integrable system. In particular, \
we prove asymptotic formulae\nfor large angular momenta in terms of \
hypergeometric functions and give a\nprecise mathematical meaning to \
Rindler-like region contributions. Moreover we\nidentify the leading terms in \
the large distance expansion as the point\nparticle approximation of the BH \
and their finite size corrections as encoding\nthe BH tidal response. We also \
discuss exact properties of the thermal version\nof the BH effective actions. \
Although we focus on the real scalar field in\ndS-Kerr and \
(A)dS-Schwarzschild in four and five dimensions, similar formulae\ncan be \
given for higher spin matter and radiation fields in more general\n\
gravitational backgrounds.\n", 
            "versions" -> {{
              "version" -> "v1", "created" -> 
               "Wed, 22 May 2024 16:58:05 GMT"}}, "update_date" -> 
            "2024-05-24", 
            "authors_parsed" -> {{"Arnaudo", "Paolo", ""}, {
              "Bonelli", "Giulio", ""}, {"Tanzini", "Alessandro", ""}}}], 
          "Tooltip"]& ], 
