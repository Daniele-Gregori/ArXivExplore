 CellID->2033850228,ExpressionUUID->"12a9ef13-0ce3-4eeb-bc12-faec1570af95"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a9e63f1a-399e-41c1-b9f8-314a54af7b1f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ArXivClassifyCategoriesNet",
    BaseStyle->"Link",
    ButtonData->
     "paclet:DanieleGregoriArXivExplore/ref/ArXivClassifyCategoriesNet"], "[", 
   RowBox[{
    StyleBox["cut_Integer", "TI"], ",", 
    StyleBox["dim_Integer", "TI"], ",", 
    StyleBox["drop", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "d3f57a37-18bc-476d-ae8e-c707b668ee42"],
 "\[LineSeparator]gives a net classifying the 'cut' most frequent \
categories,using as all linear layers' dimension 'dim',with dropout ratio \
'drop'; \n",
 Cell["   ", "ModInfo",ExpressionUUID->"1650075b-bdbf-4cbe-8f03-d0764c3cb448"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ArXivClassifyCategoriesNet",
    BaseStyle->"Link",
    ButtonData->
     "paclet:DanieleGregoriArXivExplore/ref/ArXivClassifyCategoriesNet"], "[", 
   RowBox[{
    StyleBox["catL_List", "TI"], ",", 
    StyleBox["dim_Integer", "TI"], ",", 
    StyleBox["drop", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "d58921a2-1801-46b8-a9f6-652480b76caf"],
 "\[LineSeparator]gives a net classifying the 'catL' list of categories, \
using as all linear layers' dimension 'dim', with dropout ratio 'drop'; \n",
 Cell["   ", "ModInfo",ExpressionUUID->"c37b8a86-0968-4e1f-ab61-d21d14a284e3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ArXivClassifyCategoriesNet",
    BaseStyle->"Link",
    ButtonData->
     "paclet:DanieleGregoriArXivExplore/ref/ArXivClassifyCategoriesNet"], "[", 
   RowBox[{
    StyleBox["catL_List", "TI"], ",", 
    StyleBox["dim_List", "TI"], ",", 
    StyleBox["drop", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "84181031-69ac-4b67-9329-1ff01fbb1708"],
 "\[LineSeparator]gives a net classifying the 'catL' list of \
categories,embedding titles in dimension dim[[1]], abstracts in dimension \
dim[[2]],catenate them and later pass them into a linear layer with dimension \
dim[[3]], with dropout ratio 'drop'; \n",
 Cell["   ", "ModInfo",ExpressionUUID->"c1c675fd-f6cd-4b98-a372-8ad2588a6fee"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ArXivClassifyCategoriesNet",
    BaseStyle->"Link",
    ButtonData->
     "paclet:DanieleGregoriArXivExplore/ref/ArXivClassifyCategoriesNet"], "[", 
   RowBox[{
    StyleBox["catL_List", "TI"], ",", 
    StyleBox["dim_List", "TI"], ",", 
    StyleBox["drop", "TI"], ",", 
    StyleBox["idL_List", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "31b563b1-2e7f-4aeb-b11b-7bc00086ea06"],
 "\[LineSeparator]gives a net classifying the 'catL' list of \
categories,embedding titles in dimension dim[[1]], abstracts in dimension \
dim[[2]],introductions of article list 'idL' in dimension dim[[4]] and \
catenate them and later pass them into a linear layer with dimension \
dim[[3]], with dropout ratio 'drop'."
}], "Usage",
 CellChangeTimes->{{3.9420602544430447`*^9, 3.9420602547110577`*^9}},
 CellID->1423572697,ExpressionUUID->"20521f6d-0403-49da-a9f8-d1d78e129168"],

Cell["\<\
This simple recurrent neural network for classifications of ArXiv categories \
uses essentially a pair of LongShortMemoryLayer on titles and abstracts \
embedded with their own vocabularies, with before them a DropoutLayer for \
regularization with default drop ratio set at 0.9. Then a NetGraph combines \
them with CatenateLayer, allow an intermediate LinearLayer and finally output \
the classification probabilities through SoftmaxLayer. \
\>", "ExampleText",
 CellChangeTimes->{{3.931234283362441*^9, 3.931234390544943*^9}, {
  3.931237729727355*^9, 3.931237814300589*^9}},
 CellID->978645619,ExpressionUUID->"83891422-09a9-4577-95b1-6c1cc17f1972"],

Cell["The following options can be given: ", "Notes",
 CellID->871007252,ExpressionUUID->"0fae70f4-557f-4084-8dd1-c55fa64476dd"],

