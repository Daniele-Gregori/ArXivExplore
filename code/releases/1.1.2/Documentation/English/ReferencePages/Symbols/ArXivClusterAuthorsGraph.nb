                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Sat, 12 Mar 2005 15:30:33 GMT\""}]}], "}"}]}], 
                    "}"}]}]}, {
                RowBox[{"\"update_date\"", "\[Rule]", "\"2009-10-07\""}]}, {
                RowBox[{"\"authors_parsed\"", "\[Rule]", 
                  RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Chen\"", ",", "\"W.\"", ",", "\"\""}], "}"}], 
