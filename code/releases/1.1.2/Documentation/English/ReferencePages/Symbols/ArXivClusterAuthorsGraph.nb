                 "\"authors\"", "\[Rule]", 
                  "\"M. Sharif and Kanwal Nazir\""}]}, {
                
                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Study of Static Wormhole Solutions in \
$F(T,T_\\\\mathcal{G})$ Gravity\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", 
                  "\"31 pages, 16 figures, to appear in Ann. Phys\""}]}, {
                
                RowBox[{
                 "\"journal-ref\"", "\[Rule]", 
                  "\"Ann. Phys. 393(2018)145-166\""}]}, {
                
                RowBox[{
                 "\"doi\"", "\[Rule]", "\"10.1016/j.aop.2018.04.003\""}]}, {
                RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
