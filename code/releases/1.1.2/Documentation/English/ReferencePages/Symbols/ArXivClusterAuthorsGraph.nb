                RowBox[{"\"license\"", "\[Rule]", "Null"}]}, {
                
                RowBox[{
                 "\"abstract\"", "\[Rule]", 
                  "\"  We obtain the general solution for non-extremal \
3-charge dilatonic rotating\\nblack holes in the U(1)^3 gauged \
five-dimensional N=2 supergravity coupled to\\ntwo vector multiplets, in the \
case where the two rotation parameters are set\\nequal. These solutions \
encompass all the previously-known extremal solutions,\\nand, by setting the \
three charges equal, the recently-obtained non-extremal\\nsolutions of N=2 \
gauged five-dimensional pure supergravity.\\n\""}]}, {
                RowBox[{"\"versions\"", "\[Rule]", 
