                RowBox[{
                 "\"authors\"", "\[Rule]", "\"M. Sharif, T. Naseer\""}]}, {
                
                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Study of Anisotropic Compact Stars in\\n  \
$f(\\\\mathcal{R},\\\\mathcal{T},\\\\mathcal{R}_{\\\\chi\\\\xi}\\\\mathcal{T}^\
{\\\\chi\\\\xi})$\\n  Gravity\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", "\"28 pages, 8 figures\""}]}, {
                
                RowBox[{
                 "\"journal-ref\"", "\[Rule]", "\"Pramana 96(2022)119\""}]}, {
               
                
                RowBox[{
                 "\"doi\"", "\[Rule]", "\"10.1007/s12043-022-02357-4\""}]}, {
                RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
