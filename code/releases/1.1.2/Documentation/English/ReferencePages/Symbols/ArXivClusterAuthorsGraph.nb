                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"The Conformal Sector of F-theory GUTs\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", 
                  "\"v2: 51 pages, 2 figures, remark added, typos \
corrected\""}]}, {
                
                RowBox[{
                 "\"journal-ref\"", "\[Rule]", "\"JHEP 1107:075,2011\""}]}, {
