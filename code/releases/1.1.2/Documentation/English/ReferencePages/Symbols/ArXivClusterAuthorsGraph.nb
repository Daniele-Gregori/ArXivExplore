                 "\"authors\"", "\[Rule]", 
                  "\"Hai-Shan Liu, H. Lu and C.N. Pope\""}]}, {
                
                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Thermodynamics of Einstein-Proca AdS Black Holes\""}]}, {
               
                
                RowBox[{
                 "\"comments\"", "\[Rule]", 
                  "\"35 pages, Improved discussion of cases with logarithmic \
asymptotic\\n  fall offs\""}]}, {
                RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
                
                RowBox[{
                 "\"doi\"", "\[Rule]", "\"10.1007/JHEP06(2014)109\""}]}, {
                RowBox[{"\"report-no\"", "\[Rule]", "\"MIFPA-14-05\""}]}, {
