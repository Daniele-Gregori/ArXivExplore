 CellID->1216984474,ExpressionUUID->"e992bd4a-5f5f-4797-9d7c-860834b1b25c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3878902d-f0ff-48ae-a611-d4cd57ac52bf"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ArXivClusterAuthorsGraph",
    BaseStyle->"Link",
    ButtonData->
     "paclet:DanieleGregoriArXivExplore/ref/ArXivClusterAuthorsGraph"], "[", 
   RowBox[{
    StyleBox["set_Association", "TI"], ",", 
    StyleBox["k_Integer", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "5daf5b11-84a4-4539-aefb-7317e3496629"],
 "\[LineSeparator]clusters the articles in association 'set' by using a \
feature extractor net trained on authors classification. The clustering is \
done by choosing the 'k' nearest features to each article; \n",
 Cell["   ", "ModInfo",ExpressionUUID->"b1ce7e84-8177-43a1-8dd6-b62805086d64"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ArXivClusterAuthorsGraph",
    BaseStyle->"Link",
    ButtonData->
     "paclet:DanieleGregoriArXivExplore/ref/ArXivClusterAuthorsGraph"], "[", 
   RowBox[{
    StyleBox["net_NetGraph", "TI"], ",", 
    StyleBox["set_Association", "TI"], ",", 
    StyleBox["k_Integer", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "b99d391a-faf8-49f3-a615-c29c9f38b656"],
 "\[LineSeparator]clusters the articles in association 'set' by using a \
feature extractor net 'net' trained on authors classification. The clustering \
is done by choosing the 'k' nearest features to each article."
}], "Usage",
