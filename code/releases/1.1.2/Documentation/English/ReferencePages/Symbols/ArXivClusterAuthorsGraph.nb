                RowBox[{
                 "\"license\"", "\[Rule]", 
                  "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]}\
, {
                
                RowBox[{
                 "\"abstract\"", "\[Rule]", 
                  "\"  We discuss the collapsing and expanding solutions of \
anisotropic charged\\ncylinder in the context of $f(R,T)$ theory ($R$ \
represents the Ricci scalar and\\n$T$ denotes the trace of energy-momentum \
tensor). For this purpose, we take an\\nauxiliary solution of \
Einstein-Maxwell field equations and evaluate expansion\\nscalar whose \
negative values lead to collapse and positive values give\\nexpansion. For \
both cases, the behavior of density, pressure, anisotropic\\nparameter as \
well as mass is explored and the effects of charge as well as\\nmodel \
parameter on these quantities are examined. The energy conditions are\\nfound \
to be satisfied for both solutions.\\n\""}]}, {
                RowBox[{"\"versions\"", "\[Rule]", 
                  RowBox[{"{", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 10 Jan 2019 06:50:13 GMT\""}]}], "}"}], "}"}]}]}, {
                RowBox[{"\"update_date\"", "\[Rule]", "\"2019-02-19\""}]}, {
                RowBox[{"\"authors_parsed\"", "\[Rule]", 
                  RowBox[{"{", 
