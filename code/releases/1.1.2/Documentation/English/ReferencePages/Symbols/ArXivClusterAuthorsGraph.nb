                RowBox[{"\"id\"", "\[Rule]", "\"1110.2115\""}]}, {
                RowBox[{"\"submitter\"", "\[Rule]", "\"Clay Cordova\""}]}, {
                
                RowBox[{
                 "\"authors\"", "\[Rule]", 
                  "\"Sergio Cecotti, Clay Cordova, Cumrun Vafa\""}]}, {
                
                RowBox[{
                 "\"title\"", "\[Rule]", "\"Braids, Walls, and Mirrors\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", "\"142 pages, 59 figures\""}]}, {
                RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
