            "id" -> "2111.00015", "submitter" -> "Irene Valenzuela", 
             "authors" -> 
             "Yuta Hamada, Miguel Montero, Cumrun Vafa, Irene Valenzuela", 
             "title" -> "Finiteness and the Swampland", "comments" -> 
             "1 figure, 23 pages + appendices", "journal-ref" -> Null, "doi" -> 
             "10.1088/1751-8121/ac6404", "report-no" -> Null, "categories" -> 
             "hep-th", "license" -> 
             "http://arxiv.org/licenses/nonexclusive-distrib/1.0/", 
             "abstract" -> 
             "  We view and provide further evidence for a number of \
Swampland criteria,\nincluding the Weak Gravity Conjecture, Distance \
Conjecture and bounds on the\nfiniteness of the quantum gravity vacua from \
the prism of the finiteness of\nblack hole entropy. Furthermore we propose \
that at least all of these Swampland\nstatements may be more fundamentally a \
consequence of the finiteness of quantum\ngravity amplitudes.\n", 
             "versions" -> {{
               "version" -> "v1", "created" -> 
                "Fri, 29 Oct 2021 18:00:00 GMT"}}, "update_date" -> 
             "2022-05-25", 
             "authors_parsed" -> {{"Hamada", "Yuta", ""}, {
               "Montero", "Miguel", ""}, {"Vafa", "Cumrun", ""}, {
               "Valenzuela", "Irene", ""}}}], "Tooltip"]& ], InsetBox[
