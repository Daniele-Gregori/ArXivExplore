Valach\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Freedom near Lightcone and ANEC Saturation\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"38 pages. v3: Minor changes, references added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP05(2023)065\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
               
