               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Aspects of thermal one-point functions and response \
functions in AdS\\n  Black holes\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"v2: references added, minor typos fixed\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
