                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Jia\"", ",", "\"Hewei Frederic\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Rangamani\"", ",", "\"Mukund\"", ",", "\"\""}],
                     "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
