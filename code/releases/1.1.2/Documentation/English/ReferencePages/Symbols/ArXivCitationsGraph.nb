                    RowBox[{"{", 
                    RowBox[{"\"Grewal\"", ",", "\"Manvir\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Law\"", ",", "\"Y. T. Albert\"", ",", "\"\""}],
                     "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
