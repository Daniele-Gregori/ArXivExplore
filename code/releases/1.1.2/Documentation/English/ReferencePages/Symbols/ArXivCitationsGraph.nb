Zhao\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Boundary signature of singularity in the presence of a \
shock wave\""}]}, {
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"55 pages, 9 figures; v2: added references\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"SciPost Phys. 16, 060 (2024)\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.21468/SciPostPhys.16.2.060\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
