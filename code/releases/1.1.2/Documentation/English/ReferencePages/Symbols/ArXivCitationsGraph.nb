                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"A new method for exact results on Quasinormal Modes of \
Black Holes\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", 
                  "\"6 pages, 3 tables (Latex), minor corrections\""}]}, {
                RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
                
