               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Rai\"", ",", "\"Mudit\"", ",", "\"\""}], "}"}],
                     ",", 
