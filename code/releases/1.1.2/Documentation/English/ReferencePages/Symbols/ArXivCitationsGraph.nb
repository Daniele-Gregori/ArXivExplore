               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Topological Defect Lines in bosonized Parafermionic \
CFTs\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"the version accepted by ATMP\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
