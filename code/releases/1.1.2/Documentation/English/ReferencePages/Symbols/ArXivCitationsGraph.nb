               RowBox[{"\"submitter\"", "\[Rule]", "\"Soumodeep Mitra\""}]}, {
              
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Soumodeep Mitra, Sumanta Chakraborty, Rodrigo Vicente, \
and Justin C.\\n  Feng\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Probing the quantum nature of black holes with \
ultra-light boson\\n  environments\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"v2, 15 pages, 2 figures\""}]}, {
              
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"gr-qc hep-th\""}]}, {
               
