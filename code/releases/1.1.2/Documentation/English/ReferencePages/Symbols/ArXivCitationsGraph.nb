                  "\"Nonlinear Quasi-Normal Modes: Uniform \
Approximation\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", 
                  "\"17 pages + appendices, v2: minor improvements, added eq. \
(4.20),\\n  matches journal version\""}]}, {
                RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
                
                RowBox[{
