               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Mukund Rangamani, Julio Virrueta, Shuyan Zhou\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Anomalous hydrodynamics effective actions from holography\
\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"v2: minor improvements (published version)\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
