               RowBox[{"\"id\"", "\[Rule]", "\"2405.09687\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Riccardo Gonzo\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Riccardo Gonzo, Canxin Shi\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Scattering and bound observables for spinning particles \
in Kerr\\n  spacetime with generic spin orientations\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"6 pages + appendices, 1 ancillary file; v2: typos \
corrected,\\n  references added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th gr-qc\""}]}, {
               
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We derive the radial action of a spinning probe \
particle in Kerr spacetime\\nfrom the worldline formalism in the first-order \
form, focusing on linear in\\nspin effects. We then develop a novel covariant \
Dirac bracket formalism to\\ncompute the impulse and the spin kick directly \
from the radial action,\\ngeneralizing some conjectural results in the \
literature and providing\\nready-to-use expressions for amplitude \
calculations with generic spin\\norientations. This allows, for the first \
time, to find new covariant\\nexpressions for scattering observables in the \
probe limit up to\\n$\\\\mathcal{O}(G^6 s_1 s_2^4)$. Finally, we use the \
action-angle representation\\nto compute the fundamental frequencies for \
generic bound orbits, including the\\nintrinsic spin precession, the \
periastron advance and the precession of the\\norbital plane.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
