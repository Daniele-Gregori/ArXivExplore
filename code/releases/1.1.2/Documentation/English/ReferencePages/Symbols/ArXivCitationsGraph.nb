             "versions" -> {{
              "version" -> "v1", "created" -> 
               "Wed, 22 Apr 2020 17:23:44 GMT"}}, "update_date" -> 
            "2020-12-30", 
            "authors_parsed" -> {{"Fioravanti", "Davide", ""}, {
