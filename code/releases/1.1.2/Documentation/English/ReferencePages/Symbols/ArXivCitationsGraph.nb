                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Amplitudes and Polarizations of Quadratic Quasi-Normal \
Modes for a\\n  Schwarzschild Black Hole\""}]}, {
                RowBox[{"\"comments\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
