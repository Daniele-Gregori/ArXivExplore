               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Nonlinear Quasi-Normal Modes: Uniform \
Approximation\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"17 pages + appendices, v2: minor improvements, added eq. \
(4.20),\\n  matches journal version\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP12(2023)048\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
