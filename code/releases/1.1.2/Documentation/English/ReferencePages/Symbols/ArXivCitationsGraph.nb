                RowBox[{"\"id\"", "\[Rule]", "\"2408.07329\""}]}, {
                RowBox[{"\"submitter\"", "\[Rule]", "\"Rodolfo Russo\""}]}, {
                
                RowBox[{
                 "\"authors\"", "\[Rule]", 
                  "\"Francesco Fucito, Jose Francisco Morales and Rodolfo \
Russo\""}]}, {
                
                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Gravitational wave forms for extreme mass ratio \
collisions from\\n  supersymmetric gauge theories\""}]}, {
                RowBox[{"\"comments\"", "\[Rule]", "\"29 pages\""}]}, {
                RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
