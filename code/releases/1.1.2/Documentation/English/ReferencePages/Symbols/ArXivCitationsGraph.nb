               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Duality between Seiberg-Witten Theory and Black Hole \
Superradiance\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"20 pages, 3 tables, 1 figure\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
