                "\"title\"", "\[Rule]", 
                 "\"Scalar quasi-normal modes of accelerating Kerr-Newman-AdS \
black holes\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"22 pages, 5 figures, published in JHEP\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP 02 (2024) 189\""}]}, {
               
