               RowBox[{"\"id\"", "\[Rule]", "\"2303.17233\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Dorin Weissman\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Massimo Bianchi, Maurizio Firrotta, Jacob Sonnenschein, \
Dorin Weissman\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Measuring chaos in string scattering processes\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", 
