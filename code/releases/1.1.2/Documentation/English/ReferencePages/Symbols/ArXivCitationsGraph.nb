               RowBox[{
                "\"authors\"", "\[Rule]", "\"Gang Chen, Tianheng Wang\""}]}, {
              
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Dynamics of Spinning Binary at 2PM\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"16 pages + appendices\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"SNUTP24-002\""}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"hep-th gr-qc\""}]}, {
               
