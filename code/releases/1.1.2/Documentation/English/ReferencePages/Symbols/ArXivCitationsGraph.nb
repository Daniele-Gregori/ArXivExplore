Bin Zhu\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Differential Equations for Carrollian Amplitudes\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"29 pages\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
