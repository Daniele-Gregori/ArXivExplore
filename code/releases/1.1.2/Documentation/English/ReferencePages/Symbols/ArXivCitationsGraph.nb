                 "\"Kazuto Takahashi, Hayato Motohashi\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Iterative extraction of overtones from black hole \
ringdown\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"46 pages, 47 figures; v2 matches published version\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Class. Quantum Grav. 41 (2024) 195023\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1361-6382/ad72c9\""}]}, {
