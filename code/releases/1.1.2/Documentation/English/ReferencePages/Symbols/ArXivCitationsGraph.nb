                "Wed, 9 Aug 2023 09:40:28 GMT"}}, "update_date" -> 
             "2023-08-10", 
             "authors_parsed" -> {{"Fucito", "Francesco", ""}, {
               "Morales", "Jose Francisco", ""}, {
               "Poghossian", "Rubik", ""}}}], "Tooltip"]& ]}, 
