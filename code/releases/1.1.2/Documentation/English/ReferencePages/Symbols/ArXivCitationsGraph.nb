                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Holographic Euclidean thermal correlator\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", 
                  "\"20 pages. Revision requested by JHEP referee\""}]}, {
                RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
