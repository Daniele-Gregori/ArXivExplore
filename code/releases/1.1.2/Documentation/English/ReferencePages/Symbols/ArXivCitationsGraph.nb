                 "\"title\"", "\[Rule]", 
                  "\"Holographic open quantum systems: Toy models and \
analytic properties of\\n  thermal correlators\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", 
                  "\"47 pages. v2: minor improvements, published \
version\""}]}, {
                RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
                
                RowBox[{
