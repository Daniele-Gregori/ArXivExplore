               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"$T$, $Q$ and periods in $SU(3)$ ${\\\\cal N}=2$ \
SYM\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"20 pages, minor corrections, references added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
