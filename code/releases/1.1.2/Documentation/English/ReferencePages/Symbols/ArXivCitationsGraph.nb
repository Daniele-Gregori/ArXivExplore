Gianfranco Bertone\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Dynamical Friction in Gravitational Atoms\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"36 pages, 13 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1088/1475-7516/2023/07/070\""}]}, {
