                "\"title\"", "\[Rule]", 
                 "\"Three-dimensional quantum black holes: a primer\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"Invited review, 97 pages + appendices, multiple figures; \
v2:\\n  references added\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
