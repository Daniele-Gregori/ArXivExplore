               RowBox[{"\"id\"", "\[Rule]", "\"2408.13964\""}]}, {
               
               RowBox[{
                "\"submitter\"", "\[Rule]", "\"Joao Paulo Cavalcante\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Jo\\\\~ao Paulo Cavalcante, Maur\\\\'icio Richartz and \
Bruno Carneiro da\\n  Cunha\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Massive scalar perturbations in Kerr Black Holes: near \
extremal analysis\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"20 pages, 13 graphics, 2 figures, 2 tables\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
