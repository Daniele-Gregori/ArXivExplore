           "id" -> "2407.10868", "submitter" -> "Giorgio Di Russo", "authors" -> 
            "Massimo Bianchi, Donato Bini, Giorgio Di Russo", "title" -> 
            "Scalar perturbations in a Top-Star spacetime", "comments" -> 
