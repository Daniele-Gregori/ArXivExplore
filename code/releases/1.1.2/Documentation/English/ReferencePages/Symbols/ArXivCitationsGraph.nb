                  "\"Holographic thermal propagator for arbitrary scale \
dimensions\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", 
                  "\"23 pages, 4 figures, one important reference added, more \
comparison\\n  with known results, few typos corrected\""}]}, {
                RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
                
                RowBox[{
                 "\"doi\"", "\[Rule]", "\"10.1007/JHEP05(2023)103\""}]}, {
