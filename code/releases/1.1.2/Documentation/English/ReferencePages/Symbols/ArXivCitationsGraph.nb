               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Michele Lenzi and Carlos F. Sopuerta\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Gauge-Independent Metric Reconstruction of Perturbations \
of Vacuum\\n  Spherically-Symmetric Spacetimes\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"27 pages, comments are welcome\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
