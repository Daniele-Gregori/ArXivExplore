                    RowBox[{"{", 
                    RowBox[{"\"Bianchi\"", ",", "\"Massimo\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Dibitetto\"", ",", "\"Giuseppe\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Morales\"", ",", "\"Jose Francisco\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
