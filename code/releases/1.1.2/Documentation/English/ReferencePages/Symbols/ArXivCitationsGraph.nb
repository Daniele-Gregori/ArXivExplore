                    RowBox[{"{", 
                    RowBox[{"\"Tsujimura\"", ",", "\"Jun\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Nambu\"", ",", "\"Yasusada\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
