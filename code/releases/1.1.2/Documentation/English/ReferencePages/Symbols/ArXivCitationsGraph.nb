                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Exact WKB Analysis and TBA Equations for the Stark \
Effect\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", "\"52 pages, 14 figures\""}]}, {
                
                RowBox[{
                 "\"journal-ref\"", "\[Rule]", 
