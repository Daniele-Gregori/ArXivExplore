                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 14 Dec 2023 09:36:05 GMT\""}]}], "}"}]}], 
                   "}"}]}]}, {
