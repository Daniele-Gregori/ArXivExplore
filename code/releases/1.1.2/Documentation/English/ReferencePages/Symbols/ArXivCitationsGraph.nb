            GridBox[{{
               RowBox[{"\"id\"", "\[Rule]", "\"2311.10559\""}]}, {
               RowBox[{"\"submitter\"", "\[Rule]", "\"Yong-Hui Qi\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Bum-Hoon Lee, Wonwoo Lee, and Yong-Hui Qi\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Superradiance in the Kerr-Taub-NUT spacetime\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"42 pages, 2 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", 
                 "\"gr-qc astro-ph.HE hep-th\""}]}, {
               
