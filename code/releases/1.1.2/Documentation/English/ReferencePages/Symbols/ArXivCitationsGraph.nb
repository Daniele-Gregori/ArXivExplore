               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"TBA equations and quantum periods for D-type \
Argyres-Douglas theories\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"41 pages, 39 figures, 3 tables\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"TIT/HEP-704\""}]}, {
