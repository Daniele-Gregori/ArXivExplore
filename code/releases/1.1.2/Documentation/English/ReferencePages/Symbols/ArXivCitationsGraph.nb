                    RowBox[{"\"Cisterna\"", ",", "\"Adolfo\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Diaz\"", ",", "\"Felipe\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Mann\"", ",", "\"Robert B.\"", ",", "\"\""}], 
