                "\"title\"", "\[Rule]", 
                 "\"Spinning waveforms from KMOC at leading order\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"7 pages, 1 figure; v2: minor improvements, references \
added\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"PhysRevD.110.L041502 (2024)\""}]}, {
               
