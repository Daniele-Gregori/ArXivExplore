equation\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"17 pages, 5 figures\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Phys. Lett. B 806 (2020) 135500\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", 
                 "\"10.1016/j.physletb.2020.135500\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"TIT/HEP-679\""}]}, {
               
               RowBox[{
                "\"categories\"", "\[Rule]", 
