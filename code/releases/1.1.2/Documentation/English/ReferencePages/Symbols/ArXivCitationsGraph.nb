                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Tue, 30 Jul 2024 23:00:11 GMT\""}]}], "}"}]}], 
                    "}"}]}]}, {
                RowBox[{"\"update_date\"", "\[Rule]", "\"2024-08-01\""}]}, {
                RowBox[{"\"authors_parsed\"", "\[Rule]", 
                  RowBox[{"{", 
                    RowBox[{
