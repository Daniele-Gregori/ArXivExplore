               RowBox[{
                "\"submitter\"", "\[Rule]", 
                 "\"David Pere\\\\~n\\\\'iguez Dr\""}]}, {
               
               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Gowtham Rishi Mukkamala and David Pere\\\\~niguez\""}]}, {
              
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Decoupled Gravitational Wave Equations in Spherical \
Symmetry from\\n  Curvature Wave Equations\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"12 pages + refs. , no figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"gr-qc hep-th\""}]}, {
               
