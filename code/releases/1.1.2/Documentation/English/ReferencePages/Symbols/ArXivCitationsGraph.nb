               RowBox[{
                "\"authors\"", "\[Rule]", 
                 "\"Katsushi Ito and Hongfei Shu\""}]}, {
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"TBA equations and exact WKB analysis in deformed \
supersymmetric quantum\\n  mechanics\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"31 pages, 1 figure; Published version\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP03(2024)122\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP03(2024)122\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"TIT/HEP- 698\""}]}, {
               
