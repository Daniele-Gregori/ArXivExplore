               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Generalized Free Conformal Field Theories at Infinite \
Temperature -- In\\n  memory of Iwasaki-sensei\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"8 pages\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
