               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  We analyze the amplitudes of one highly excited string \
(HES) state with two\\nor three tachyons in open bosonic string theory. We \
argue that these processes\\nare chaotic by showing that the spacing ratios \
of successive peaks in the\\nangular dependence of the amplitudes are \
distributed as predicted by the\\n$\\\\beta$-ensemble of random matrix theory \
(RMT). We show how the continuous\\nparameter $\\\\beta$ depends on the level \
and helicity of the scattered HES state.\\nWe derive the scattering amplitude \
of an HES and three tachyons and show that\\nit takes the form of the \
Veneziano amplitude times a dressing factor, and that\\nthe dressing is \
chaotic as a function of the scattering angle, in the sense\\nthat its \
spacing ratios match with RMT predictions.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 30 Mar 2023 09:08:04 GMT\""}]}], "}"}], "}"}]}]}, {
               RowBox[{"\"update_date\"", "\[Rule]", "\"2023-03-31\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Bianchi\"", ",", "\"Massimo\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Firrotta\"", ",", "\"Maurizio\"", ",", "\"\""}], "}"}],
                     ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Sonnenschein\"", ",", "\"Jacob\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Weissman\"", ",", "\"Dorin\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
