               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Perturbations of the Vaidya metric in the frequency \
domain: Quasi-normal\\n  modes and tidal response\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"19 pages, 4 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"categories\"", "\[Rule]", "\"gr-qc\""}]}, {
               RowBox[{
                "\"license\"", "\[Rule]", 
                 "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]},\
 {
               
               RowBox[{
                "\"abstract\"", "\[Rule]", 
                 "\"  The mass of a black hole can dynamically evolve due to \
various physical\\nprocesses, such as for instance accretion, Hawking \
radiation, absorption of\\ngravitational/electromagnetic waves, \
superradiance, etc. This evolution can\\nhave an impact on astrophysical \
observables, like the ringdown gravitational\\nsignal. An effective \
description of a spherically symmetric black hole with\\nevolving mass is \
provided by the Vaidya metric. In our investigation, we\\nexplore the \
dynamics of linear perturbations on this background, assuming a\\nconstant \
rate of change for the mass. Despite the time-dependent background, \
a\\njudicious change of coordinates allows us to treat the perturbations in \
the\\nfrequency domain, and to compute explicitly the quasi-normal modes and \
the\\ntidal Love numbers.\\n\""}]}, {
               RowBox[{"\"versions\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Mon, 8 Jul 2024 15:00:48 GMT\""}]}], "}"}], "}"}]}]}, {
              
               RowBox[{"\"update_date\"", "\[Rule]", "\"2024-07-09\""}]}, {
               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Capuano\"", ",", "\"Lodovico\"", ",", "\"\""}],
                     "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Santoni\"", ",", "\"Luca\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Barausse\"", ",", "\"Enrico\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
