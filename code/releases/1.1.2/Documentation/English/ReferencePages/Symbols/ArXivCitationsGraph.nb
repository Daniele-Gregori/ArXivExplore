                "\"authors\"", "\[Rule]", 
                 "\"Kihong Kwon, Juli\\\\'an Barrag\\\\'an Amado, Bogeun Gwak\
\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Absorption cross section in gravity's rainbow from \
confluent Heun\\n  equation\""}]}, {
               RowBox[{"\"comments\"", "\[Rule]", "\"19 pages\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", 
                 "\"Class.Quant.Grav. 41 (2024) 035005\""}]}, {
               
