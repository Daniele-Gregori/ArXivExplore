Cell[BoxData[
 RowBox[{
  RowBox[{"vf1", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"xc_", ",", "yc_"}], "}"}], ",", "name_", ",", 
    RowBox[{"{", 
     RowBox[{"w_", ",", "h_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{"Tooltip", "[", 
    RowBox[{
     RowBox[{"Disk", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xc", ",", "yc"}], "}"}], ",", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"w", "^", "2"}], "+", 
         RowBox[{"h", "^", "2"}]}], "]"}]}], "]"}], ",", 
     RowBox[{"TableForm", "@", 
      RowBox[{"ArXivArticles", "@", "name"}]}]}], "]"}], "}"}]}]], "Input",
 CellChangeTimes->{{3.9385928070488777`*^9, 3.9385928628304977`*^9}, {
  3.9385928958008547`*^9, 3.938592998066601*^9}, {3.938593130640061*^9, 
