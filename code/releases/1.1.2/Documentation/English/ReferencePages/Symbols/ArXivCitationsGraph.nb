               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Tidal resonances for fuzzballs\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", "\"23 pages, 8 figures\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
