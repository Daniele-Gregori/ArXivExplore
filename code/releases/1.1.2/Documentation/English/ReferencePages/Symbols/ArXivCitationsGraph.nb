               RowBox[{"\"authors_parsed\"", "\[Rule]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"Baggioli\"", ",", "\"Matteo\"", ",", "\"\""}], 
                    "}"}], ",", 
