Diaz, Rodrigo Olea\""}]}, {
               
               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Holographic renormalization of Horndeski gravity\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"35 pages. Comments and references added. Accepted for \
publication in\\n  JHEP\""}]}, {
               
               RowBox[{
                "\"journal-ref\"", "\[Rule]", "\"JHEP, 05 (2024) 125\""}]}, {
               
               RowBox[{
                "\"doi\"", "\[Rule]", "\"10.1007/JHEP05(2024)125\""}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
