               RowBox[{
                "\"title\"", "\[Rule]", 
                 "\"Correlation functions of the Bjorken flow in the \
holographic\\n  Schwinger-Keldysh approach\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"59+11 pages; 4 figures; Summary of results in section 1.C \
expanded\\n  and improved, summary of section 5 presented at the beginning of \
this\\n  section, matches journal version\""}]}, {
               
