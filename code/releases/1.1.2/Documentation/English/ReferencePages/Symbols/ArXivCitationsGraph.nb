                "\"title\"", "\[Rule]", 
                 "\"Duality constraints on thermal spectra of 3d CFTs and 4d \
quasinormal\\n  modes\""}]}, {
               
               RowBox[{
                "\"comments\"", "\[Rule]", 
                 "\"7 pages, 1 figure, v2: minor corrections\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
