               RowBox[{"\"comments\"", "\[Rule]", "\"8 pages\""}]}, {
               RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
               RowBox[{"\"report-no\"", "\[Rule]", "\"YITP-24-31\""}]}, {
