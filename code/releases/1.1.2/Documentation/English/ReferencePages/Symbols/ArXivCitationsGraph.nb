                RowBox[{
                 "\"authors\"", "\[Rule]", 
                  "\"Katsushi Ito and Jingjing Yang\""}]}, {
                
                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Exact WKB Analysis and TBA Equations for the Stark \
Effect\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", "\"52 pages, 14 figures\""}]}, {
                
                RowBox[{
                 "\"journal-ref\"", "\[Rule]", 
                  "\"Progress of Theoretical and Experimental Physics, Volume \
2024,\\n  Issue 1, January 2024, 013A02\""}]}, {
                RowBox[{"\"doi\"", "\[Rule]", "\"10.1093/ptep/ptad154\""}]}, {
               
