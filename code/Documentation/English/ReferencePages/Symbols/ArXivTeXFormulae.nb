\\mathcal{L}_{+}+\\mathcal{L}%\n\
_{-}+B_{+}\\,J_{-}+B_{-}\\,J_{+}+B_{+}\\,B_{-}.\n\\end{equation}", 
            "\\begin{equation}\n\\mathcal{L}_{eff}\\left[ A_{\\mu }\\right] \
=-\\frac{1}{4}F^{\\mu \\nu }\\frac{%\n\\left( \\Box +e^{2}/\\pi \\right) \
}{\\Box }F_{\\mu \\nu }.\n\\end{equation}", 
            "\\begin{equation}\nW_+ = \\int d^3x\\left\\lbrack -\\frac 14 F_{\
\\mu\\nu}^2(A) + \\frac{m_+}2\n\
\\epsilon_{\\alpha\\beta\\gamma}A^{\\alpha}\\partial^{\\beta}A^{\\gamma} + \
\\gamma_+\n\
\\epsilon_{\\alpha\\beta\\gamma}J^{\\alpha}\\partial^{\\beta}A^{\\gamma}\n\
\\right\\rbrack  \\label{wmais3}\n\\end{equation}", 
            "\\begin{equation}\nW_- = \\int d^3x\\left\\lbrack -\\frac 14 F_{\
\\mu\\nu}^2(B) - \\frac{m_-}2\n\
\\epsilon_{\\alpha\\beta\\gamma}B^{\\alpha}\\partial^{\\beta}B^{\\gamma} + \
\\gamma_-\n\
\\epsilon_{\\alpha\\beta\\gamma}J^{\\alpha}\\partial^{\\beta}B^{\\gamma}\n\
\\right\\rbrack  \\label{wmenos3}\n\\end{equation}", 
            "\\begin{equation}\n\\delta A_{\\mu} = \\eta_{\\mu} \\quad ; \
\\quad \\delta B_{\\mu} = \\alpha \\eta_{\\mu}\n\\label{13}\n\\end{equation}",
             "\\begin{equation}\n\\delta \\left( W_+ + W_- \\right) = \\int \
d^3 x J_{\\mu\\nu}\n\\partial^{\\mu}\\eta^{\\nu}  \\label{14}\n\
\\end{equation}", 
            "\\begin{equation}\nJ_{\\mu\\nu} = - F_{\\mu\\nu} (A) - \\alpha \
F_{\\mu\\nu} (B) +\n\\epsilon_{\\mu\\nu\\gamma}\\left(m_+ A^{\\gamma} - \
\\alpha m_- B^{\\gamma}\\right)\n + (\\alpha\\gamma_- + \\gamma_+)\\epsilon_{\
\\mu\\nu\\gamma}J^{\\gamma}\n\\label{15}\n\\end{equation}", 
            "\\begin{equation}\n\\delta B_{\\mu\\nu} = - \\partial_{\\mu} \
\\eta_{\\nu}  \\label{15b}\n\\end{equation}", 
            "\\begin{equation}\n\\delta \\left(W_+ + W_- + \\int d^3x B_{\\mu\
\\nu}J^{\\mu\\nu} \\right) = \\delta\n\\left\\lbrack \\frac{(1+\\alpha^2)}2 \
\\int d^3x B_{\\mu\\nu}(B^{\\mu\\nu} -\nB^{\\nu\\mu}) \\right\\rbrack + \\int \
d^3x \\epsilon_{\\mu\\nu\\gamma}(m_+-\\alpha^2\nm_-)\\eta^{\\gamma}  \
\\label{16}\n\\end{equation}", 
            "\\begin{equation}\n\\alpha = \\pm \\sqrt{\\frac {m_+}{m_-}}  \
\\label{17}\n\\end{equation}", 
            "\\begin{equation}\nW_{\\alpha}^{(S)} = W_+ + W_- + \\int d^3x \
\\frac{J^{\\mu\\nu}J_{\\mu\\nu}}{%\n4(1+\\alpha^2)} \\equiv \\int d^3x \
\\mathcal{L}_{\\alpha}^{(S)}  \\label{18}\n\\end{equation}", 
            "\\begin{equation}\n\\mathcal{L}_{\\alpha=1}^{(S)} = - \\frac{F_{\
\\mu\\nu}^2}8 + \\frac{m^2 C^2}4 -\n\\gamma \
\\epsilon_{\\mu\\nu\\gamma}J^{\\mu}\\partial^{\\nu}C^{\\gamma}  \\label{21b}\n\
\\end{equation}", 
            "\\begin{equation}\n\\mathcal{L}_{\\alpha=-1}^{(S)} = - \
\\frac{F_{\\mu\\nu}^2}8 + \\frac{m^2 C^2}4 +\nm\\gamma J\\cdot C + \\gamma^2 \
J^2  \\label{21c}\n\\end{equation}"}, 
          "\\be" -> {
           "\\be \\det \\left(i\\dslash + e \\aaslash \\gamma_5 \\right) = \
\\det \\left(i\\dslash + e\n\\aaslash_+ \\right)  \\det \\left(i\\dslash - e \
\\aaslash_- \\right) \\label{id2} \\ee"}, 
          "\\bea" -> {
           "\\bea\n\\mathcal{L}_{\\alpha }^{(S)} = &-&\\frac{F_{\\mu \\nu \
}^{2}(C)}{4(1+\\alpha ^{2})}+%\n\\frac{(m_{+}-m_-)}{2(1+\\alpha \
^{2})}\\epsilon _{\\mu \\nu \\gamma\n}C^{\\mu\n}\\partial ^{\\nu }C^{\\gamma \
}+\\frac{1}{2(1+ \\alpha^2)}\\left\\lbrack \\alpha m_{-}C_{\\mu }+%\n(\\alpha\
\\gamma _{-} +  \\gamma _{+})\\,J_{\\mu }\\right\\rbrack^{2}\\nn\\\\\n&+& \
\\frac{(\\alpha\\gamma_+ - \\gamma_-)}{1+\\alpha^2}\\epsilon _{\\mu\n\\nu \
\\gamma}J^{\\mu}\\partial^{\\nu}C^{\\gamma}\\label{19} \\eea"}|>, \
$CellContext`i$$], 
        UpTo[100]], 
