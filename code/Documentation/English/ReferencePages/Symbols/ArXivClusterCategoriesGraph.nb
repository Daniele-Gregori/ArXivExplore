                RowBox[{"\"id\"", "\[Rule]", "\"gr-qc/0011016\""}]}, {
                RowBox[{"\"submitter\"", "\[Rule]", "\"Yavuz Nutku\""}]}, {
                
                RowBox[{
                 "\"authors\"", "\[Rule]", "\"A. N. Aliev and Y. Nutku\""}]}, {
                
                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Impulsive spherical gravitational waves\""}]}, {
                RowBox[{"\"comments\"", "\[Rule]", "Null"}]}, {
                
                RowBox[{
                 "\"journal-ref\"", "\[Rule]", 
                  "\"Class.Quant.Grav. 18 (2001) 891-906\""}]}, {
                
