                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Photoluminescence in the temperature range 20-230 K of \
C$_{60}$\\n  fullerite doped with nitrogen molecules\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", "\"7 pages, 2 figures\""}]}, {
                RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
