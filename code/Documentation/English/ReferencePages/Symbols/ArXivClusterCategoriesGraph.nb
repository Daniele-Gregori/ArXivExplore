                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Silhouette based View embeddings for Gait Recognition \
under Multiple\\n  Views\""}]}, {
                RowBox[{"\"comments\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"journal-ref\"", "\[Rule]", "\"ICIP 2021\""}]}, {
                RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
