Katsnelson,\n  Shengjun Yuan", "title" -> 
             "Optical conductivity of a quantum electron gas in a Sierpinski \
carpet", "comments" -> "6 pages, 9 figures", "journal-ref" -> 
             "Phys. Rev. B 96, 235438 (2017)", "doi" -> 
