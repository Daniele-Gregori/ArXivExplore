                 "\"title\"", "\[Rule]", 
                  "\"$d+1$ formalism in Einstein-scalar-Gauss-Bonnet \
gravity\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", 
                  "\"10 pages. v2: fixed references, no changes to the main \
text\""}]}, {
                
