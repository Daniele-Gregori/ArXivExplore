Weinberger\""}]}, {
                
                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Fast Reading Comprehension with ConvNets\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", 
                  "\"15 pages, 10 figures, submitted to ICLR 2018\""}]}, {
                RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
