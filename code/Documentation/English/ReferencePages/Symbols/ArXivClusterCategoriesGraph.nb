                RowBox[{
                 "\"comments\"", "\[Rule]", 
                  "\"8 pages, 1 figure, sprocl.sty, Proceeding for APCTP \
winter school on\\n  Black Hole Astrophysics 2002\""}]}, {
                RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
                
                RowBox[{
                 "\"doi\"", "\[Rule]", "\"10.1142/9789812776761_0019\""}]}, {
