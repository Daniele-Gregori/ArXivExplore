Cell["ArXivClusterCategoriesGraph", "ObjectName",
 CellID->86979887,ExpressionUUID->"b84aa235-9242-4834-95c5-e2465e1000ce"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"66bf2a75-74cb-4a0b-9980-a11b60539ccc"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ArXivClusterCategoriesGraph",
    BaseStyle->"Link",
    ButtonData->
     "paclet:DanieleGregoriArXivExplore/ref/ArXivClusterCategoriesGraph"], 
   "[", 
   RowBox[{
    StyleBox["set_Association", "TI"], ",", 
    StyleBox["k_Integer", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "b7611967-1efc-477a-afd1-d08bc7b4ee5b"],
 "\[LineSeparator]clusters the articles in association 'set' by using a \
feature extractor net trained on category classification. The clustering is \
done by choosing the 'k' nearest features to each article; \n",
 Cell["   ", "ModInfo",ExpressionUUID->"b1a42300-7025-49f6-b15c-5c1378b4d4c2"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ArXivClusterCategoriesGraph",
    BaseStyle->"Link",
    ButtonData->
     "paclet:DanieleGregoriArXivExplore/ref/ArXivClusterCategoriesGraph"], 
   "[", 
   RowBox[{
    StyleBox["net_NetGraph", "TI"], ",", 
    StyleBox["set_Association", "TI"], ",", 
    StyleBox["k_Integer", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "2f057478-44b8-48d1-81e2-92897b06abb2"],
 "\[LineSeparator]clusters the articles in association 'set' by using a \
feature extractor net 'net' trained on category classification. The \
clustering is done by choosing the 'k' nearest features to each article."
}], "Usage",
