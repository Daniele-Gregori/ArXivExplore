                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Evidence for Primal sp2 Defects at the Diamond Surface: \
Candidates for\\n  Electron Trapping and Noise Sources\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", 
                  "\"12 pages, 3 figures; SI: 10 pages, 10 figures\""}]}, {
                RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
