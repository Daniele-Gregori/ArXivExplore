                RowBox[{
                 "\"comments\"", "\[Rule]", 
                  "\"Invited talk at conference on \\\"Solitary Neutron Stars\
\\\", London, 2006\""}]}, {
                RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
