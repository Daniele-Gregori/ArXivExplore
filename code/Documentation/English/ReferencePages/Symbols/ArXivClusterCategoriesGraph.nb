                    "\"Fri, 24 Aug 2018 03:30:50 GMT\""}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v2\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Thu, 6 Sep 2018 09:43:03 GMT\""}]}], "}"}]}], 
                    "}"}]}]}, {
                RowBox[{"\"update_date\"", "\[Rule]", "\"2018-09-07\""}]}, {
