                 "\"authors\"", "\[Rule]", "\"Graham Neubig, Junjie Hu\""}]}, {
                
                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Rapid Adaptation of Neural Machine Translation to New \
Languages\""}]}, {
                RowBox[{"\"comments\"", "\[Rule]", "\"EMNLP 2018\""}]}, {
                RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
