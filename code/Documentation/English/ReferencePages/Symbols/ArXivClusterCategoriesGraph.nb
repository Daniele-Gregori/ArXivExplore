                 "\"authors\"", "\[Rule]", 
                  "\"V.A. Stephanovich, J. Dryzek\""}]}, {
                
                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"The exact solution of the diffusion trapping model of \
defect profiling\\n  with variable energy positrons\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", "\"13 pages, 7 PDF figures\""}]}, {
                RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
                
                RowBox[{
                 "\"doi\"", "\[Rule]", 
                  "\"10.1016/j.physleta.2013.09.024\""}]}, {
                RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
                
                RowBox[{
                 "\"categories\"", "\[Rule]", "\"cond-mat.mtrl-sci\""}]}, {
                
                RowBox[{
                 "\"license\"", "\[Rule]", 
                  "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]}\
, {
                
                RowBox[{
                 "\"abstract\"", "\[Rule]", 
                  "\"  We report an exact analytical solution of so-called \
positron diffusion\\ntrapping model. This model have been widely used for the \
treatment of the\\nexperimental data for defect profiling of the adjoin \
surface layer using the\\nvariable energy positron (VEP) beam technique. \
Hovewer, up to now this model\\ncould be treated only numerically with \
so-called VEPFIT program. The explicit\\nform of the solutions is obtained \
for the realistic cases when defect profile\\nis described by a discreet \
step-like function and continuous exponential-like\\nfunction. Our solutions \
allow to derive the analytical expressions for typical\\npositron \
annihilation characteristics including the positron lifetime \
spectrum.\\nLatter quantity could be measured using the pulsed, slow positron \
beam. Our\\nanalytical results are in good coincidence with both the VEPFIT \
numerics and\\nexperimental data. The presented solutions are easily \
generalizable for defect\\nprofiles of other shapes and can be well used for \
much more precise treatment\\nof above experimental data.\\n\""}]}, {
                RowBox[{"\"versions\"", "\[Rule]", 
                  RowBox[{"{", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Sat, 3 Aug 2013 11:34:05 GMT\""}]}], "}"}], "}"}]}]}, {
               
