                RowBox[{
                 "\"authors\"", "\[Rule]", 
                  "\"Atsushi Noguchi, Alto Osada, Shumpei Masuda, Shingo \
Kono, Kentaro\\n  Heya, Samuel Piotr Wolski, Hiroki Takahashi, Takanori \
Sugiyama, Dany\\n  Lachance-Quirion, Yasunobu Nakamura\""}]}, {
                
                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Fast parametric two-qubit gates with suppressed residual \
interaction\\n  using a parity-violated superconducting qubit\""}]}, {
                RowBox[{"\"comments\"", "\[Rule]", "Null"}]}, {
                
                RowBox[{
                 "\"journal-ref\"", "\[Rule]", 
                  "\"Phys. Rev. A 102, 062408 (2020)\""}]}, {
                
                RowBox[{
                 "\"doi\"", "\[Rule]", "\"10.1103/PhysRevA.102.062408\""}]}, {
               
                RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"categories\"", "\[Rule]", "\"quant-ph\""}]}, {
                
                RowBox[{
                 "\"license\"", "\[Rule]", 
                  "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]}\
, {
                
                RowBox[{
                 "\"abstract\"", "\[Rule]", 
                  "\"  We demonstrate fast two-qubit gates using a \
parity-violated superconducting\\nqubit consisting of a capacitively-shunted \
asymmetric Josephson-junction loop\\nunder a finite magnetic flux bias. The \
second-order nonlinearity manifesting in\\nthe qubit enables the interaction \
with a neighboring single-junction transmon\\nqubit via first-order \
inter-qubit sideband transitions with Rabi frequencies up\\nto 30~MHz. \
Simultaneously, the unwanted static longitudinal~(ZZ) interaction \
is\\neliminated with ac Stark shifts induced by a continuous microwave \
drive\\nnear-resonant to the sideband transitions. The average fidelities of \
the\\ntwo-qubit gates are evaluated with randomized benchmarking as 0.967, \
0.951,\\n0.956 for CZ, iSWAP and SWAP gates, respectively.\\n\""}]}, {
                RowBox[{"\"versions\"", "\[Rule]", 
