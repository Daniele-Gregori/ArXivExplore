                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 16 Mar 2016 19:27:45 GMT\""}]}], "}"}], "}"}]}]}, {
