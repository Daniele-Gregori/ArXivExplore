                RowBox[{"\"authors\"", "\[Rule]", "\"Anca Tureanu\""}]}, {
                
                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Can Oscillating Neutrino States Be Formulated \
Universally?\""}]}, {
                RowBox[{"\"comments\"", "\[Rule]", "\"17 pages\""}]}, {
                RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
                
                RowBox[{
                 "\"doi\"", "\[Rule]", 
                  "\"10.1140/epjc/s10052-020-7628-0\""}]}, {
