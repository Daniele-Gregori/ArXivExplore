                RowBox[{
                 "\"authors\"", "\[Rule]", 
                  "\"Killian Wood, Alec M. Dunton, Amanda Muyskens, Benjamin \
W. Priest\""}]}, {
                
                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Scalable Gaussian Process Hyperparameter Optimization \
via Coverage\\n  Regularization\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", 
                  "\"4 pages content, 3 figures, 6 tables\""}]}, {
                RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
                
