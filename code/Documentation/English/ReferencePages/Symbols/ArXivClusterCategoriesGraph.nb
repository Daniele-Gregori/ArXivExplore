                 "\"title\"", "\[Rule]", 
                  "\"Correct Me If You Can: Learning from Error Corrections \
and Markings\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", 
                  "\"To appear at EAMT 2020 (Research Track)\""}]}, {
                RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
