                RowBox[{"\"submitter\"", "\[Rule]", "\"James Dynes\""}]}, {
                
                RowBox[{
                 "\"authors\"", "\[Rule]", 
                  "\"J. F. Dynes, Z. L. Yuan, A. W. Sharpe, O. Thomas and A. \
J. Shields\""}]}, {
                
                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Probing higher order correlations of the photon field \
with photon number\\n  resolving avalanche photodiodes\""}]}, {
                RowBox[{"\"comments\"", "\[Rule]", "Null"}]}, {
                
                RowBox[{
                 "\"journal-ref\"", "\[Rule]", 
                  "\"Optics Express, Vol. 19, Issue 14, pp. 13268-13276 \
(2011)\""}]}, {
                RowBox[{"\"doi\"", "\[Rule]", "\"10.1364/OE.19.013268\""}]}, {
               
                RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"categories\"", "\[Rule]", "\"quant-ph\""}]}, {
                
                RowBox[{
                 "\"license\"", "\[Rule]", 
                  "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]}\
, {
                
                RowBox[{
                 "\"abstract\"", "\[Rule]", 
                  "\"  We demonstrate the use of two high speed avalanche \
photodiodes in exploring\\nhigher order photon correlations. By employing the \
photon number resolving\\ncapability of the photodiodes the response to \
higher order photon coincidences\\ncan be measured. As an example we show \
experimentally the sensitivity to higher\\norder correlations for three types \
of photon sources with distinct photon\\nstatistics. This higher order \
correlation technique could be used as a low cost\\nand compact tool for \
quantifying the degree of correlation of photon sources\\nemployed in quantum \
information science.\\n\""}]}, {
                RowBox[{"\"versions\"", "\[Rule]", 
                  RowBox[{"{", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
