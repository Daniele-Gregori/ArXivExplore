                RowBox[{"\"id\"", "\[Rule]", "\"2301.01810\""}]}, {
                
                RowBox[{
                 "\"submitter\"", "\[Rule]", "\"Charlotte  Sleight\""}]}, {
                
                RowBox[{
                 "\"authors\"", "\[Rule]", 
                  "\"Charlotte Sleight and Massimo Taronna\""}]}, {
                
                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Celestial Holography Revisited\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", 
                  "\"17 pages + appendices, 2 figures\""}]}, {
                RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"doi\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
                RowBox[{"\"categories\"", "\[Rule]", "\"hep-th\""}]}, {
                
                RowBox[{
                 "\"license\"", "\[Rule]", 
                  "\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\""}]}\
, {
                
                RowBox[{
                 "\"abstract\"", "\[Rule]", 
                  "\"  We revisit the prescription commonly used to define \
holographic Celestial\\nCorrelators as an integral transform of flat space \
scattering amplitudes. We\\npropose a new prescription according to which \
holographic Celestial Correlators\\nare a Mellin transform of Minkowski \
time-ordered correlators extrapolated to\\nthe conformal boundary, which is \
analogous to the extrapolate definition of\\nholographic correlators in \
AdS/CFT. Our proposal is motivated by an ambiguity\\nin the standard \
prescription for Celestial Correlators owing the presence of a\\ndivergent \
integral in the definition of conformal primary wave functions. We\\nshow \
that perturbative Celestial Correlators defined in this new way \
are\\nmanifestly recast in terms of corresponding Witten diagrams in \
Euclidean\\nanti-de Sitter space. We also discuss the possibility of using \
this definition\\nof Celestial Correlators in terms of bulk correlation \
functions to explore the\\nnon-perturbative properties of Celestial \
Correlators dual to Conformal Field\\nTheories in Minkowski space.\\n\""}]}, {
               
                RowBox[{"\"versions\"", "\[Rule]", 
                  RowBox[{"{", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"version\"", "\[Rule]", "\"v1\""}], ",", 
                    
                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Wed, 4 Jan 2023 20:14:45 GMT\""}]}], "}"}], "}"}]}]}, {
               
                RowBox[{"\"update_date\"", "\[Rule]", "\"2023-01-06\""}]}, {
                RowBox[{"\"authors_parsed\"", "\[Rule]", 
                  RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Sleight\"", ",", "\"Charlotte\"", ",", "\"\""}], "}"}],
                     ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Taronna\"", ",", "\"Massimo\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
              Left, ColumnAlignments -> Left], Column], 
            Function[BoxForm`e$, 
             TableForm[BoxForm`e$]]]],
          Annotation[#, 
           
           TableForm[{
            "id" -> "2301.01810", "submitter" -> "Charlotte  Sleight", 
             "authors" -> "Charlotte Sleight and Massimo Taronna", "title" -> 
             "Celestial Holography Revisited", "comments" -> 
             "17 pages + appendices, 2 figures", "journal-ref" -> Null, "doi" -> 
             Null, "report-no" -> Null, "categories" -> "hep-th", "license" -> 
             "http://arxiv.org/licenses/nonexclusive-distrib/1.0/", 
             "abstract" -> 
             "  We revisit the prescription commonly used to define \
holographic Celestial\nCorrelators as an integral transform of flat space \
scattering amplitudes. We\npropose a new prescription according to which \
holographic Celestial Correlators\nare a Mellin transform of Minkowski \
time-ordered correlators extrapolated to\nthe conformal boundary, which is \
analogous to the extrapolate definition of\nholographic correlators in \
AdS/CFT. Our proposal is motivated by an ambiguity\nin the standard \
prescription for Celestial Correlators owing the presence of a\ndivergent \
integral in the definition of conformal primary wave functions. We\nshow that \
perturbative Celestial Correlators defined in this new way are\nmanifestly \
recast in terms of corresponding Witten diagrams in Euclidean\nanti-de Sitter \
space. We also discuss the possibility of using this definition\nof Celestial \
Correlators in terms of bulk correlation functions to explore the\n\
non-perturbative properties of Celestial Correlators dual to Conformal Field\n\
Theories in Minkowski space.\n", 
             "versions" -> {{
               "version" -> "v1", "created" -> 
                "Wed, 4 Jan 2023 20:14:45 GMT"}}, "update_date" -> 
