                RowBox[{
                 "\"authors\"", "\[Rule]", 
                  "\"A. Ashoorioon, U. Danielsson and M.M. \
Sheikh-Jabbari\""}]}, {
                
                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"1/N Resolution to Inflationary eta-Problem\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", "\"1+13 pages, 3 figures\""}]}, {
                
                RowBox[{
                 "\"journal-ref\"", "\[Rule]", 
                  "\"Phys.Lett. B713 (2012) 353-357\""}]}, {
                
                RowBox[{
                 "\"doi\"", "\[Rule]", 
                  "\"10.1016/j.physletb.2012.06.034\""}]}, {
                
