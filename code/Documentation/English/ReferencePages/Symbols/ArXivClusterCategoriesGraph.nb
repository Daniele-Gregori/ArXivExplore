                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Random Aharonov-Bohm vortices and some funny families of \
integrals\""}]}, {
                RowBox[{"\"comments\"", "\[Rule]", "\"10 pages\""}]}, {
                RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
                
