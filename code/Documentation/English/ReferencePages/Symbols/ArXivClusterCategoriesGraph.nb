                    RowBox[{"\"Danielsson\"", ",", "\"U.\"", ",", "\"\""}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\"Sheikh-Jabbari\"", ",", "\"M. M.\"", ",", "\"\""}], 
                    "}"}]}], "}"}]}]}}, RowSpacings -> 1, ColumnAlignments -> 
              Left, ColumnAlignments -> Left], Column], 
            Function[BoxForm`e$, 
             TableForm[BoxForm`e$]]]],
          Annotation[#, 
           
           TableForm[{
            "id" -> "1112.2272", "submitter" -> "Amjad Ashoorioon", "authors" -> 
             "A. Ashoorioon, U. Danielsson and M.M. Sheikh-Jabbari", "title" -> 
             "1/N Resolution to Inflationary eta-Problem", "comments" -> 
             "1+13 pages, 3 figures", "journal-ref" -> 
             "Phys.Lett. B713 (2012) 353-357", "doi" -> 
