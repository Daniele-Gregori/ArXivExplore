                RowBox[{"\"id\"", "\[Rule]", "\"2209.09193\""}]}, {
                
                RowBox[{
                 "\"submitter\"", "\[Rule]", "\"Sahar Almahfouz Nasser\""}]}, {
                
                RowBox[{
                 "\"authors\"", "\[Rule]", 
