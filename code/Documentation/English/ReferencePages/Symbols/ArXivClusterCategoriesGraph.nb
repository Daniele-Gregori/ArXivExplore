                 "\"journal-ref\"", "\[Rule]", 
                  "\"Nat. Phys. 12, 62-66 (2016)\""}]}, {
                RowBox[{"\"doi\"", "\[Rule]", "\"10.1038/NPHYS3506\""}]}, {
                RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
                
