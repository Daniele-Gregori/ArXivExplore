                RowBox[{
                 "\"authors\"", "\[Rule]", 
                  "\"William N. Plick, Petr M. Anisimov, Jonathan P. Dowling, \
Hwang Lee,\\n  and Girish S. Agarwal\""}]}, {
                
                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Parity Detection in Quantum Optical Metrology Without \
Number Resolving\\n  Detectors\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", 
                  "\"12 pages, 4 figures, comments welcome\""}]}, {
                
                RowBox[{
                 "\"journal-ref\"", "\[Rule]", 
                  "\"New Journal of Physics 12, 113025 (2010)\""}]}, {
                
                RowBox[{
                 "\"doi\"", "\[Rule]", 
