                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Reformulation of a likelihood approach to fake-lepton \
estimation in the\\n  framework of Bayesian inference\""}]}, {
                RowBox[{"\"comments\"", "\[Rule]", "Null"}]}, {
                
                RowBox[{
                 "\"journal-ref\"", "\[Rule]", 
                  "\"Nucl.Instrum.Meth.A 1021 (2022) 165939\""}]}, {
