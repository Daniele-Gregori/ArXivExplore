                    RowBox[{
                    "\"created\"", "\[Rule]", 
                    "\"Fri, 10 Jan 1997 18:00:09 GMT\""}]}], "}"}]}], 
                    "}"}]}]}, {
                RowBox[{"\"update_date\"", "\[Rule]", "\"2009-10-30\""}]}, {
