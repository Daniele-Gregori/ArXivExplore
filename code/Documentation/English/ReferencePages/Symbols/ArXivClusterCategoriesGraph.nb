                  "\"V. B. Bezerra, I. P. Lobo, H. F. Mota and C. R. \
Muniz\""}]}, {
                
                RowBox[{
                 "\"title\"", "\[Rule]", 
                  "\"Landau Levels in the Presence of a Cosmic String in \
Rainbow Gravity\""}]}, {
                
                RowBox[{
                 "\"comments\"", "\[Rule]", 
                  "\"21 pages, 6 figures. Accepted for publication in Annals \
of Physics\""}]}, {
                RowBox[{"\"journal-ref\"", "\[Rule]", "Null"}]}, {
                
                RowBox[{
                 "\"doi\"", "\[Rule]", "\"10.1016/j.aop.2019.01.004\""}]}, {
                RowBox[{"\"report-no\"", "\[Rule]", "Null"}]}, {
