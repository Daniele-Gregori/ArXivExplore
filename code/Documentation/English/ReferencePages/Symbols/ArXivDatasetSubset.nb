Francisco Morales\"\>"}], ",", 
    RowBox[{"\<\"title\"\>", 
     "\[Rule]", "\<\"More on the SW-QNM correspondence\"\>"}], ",", 
    RowBox[{"\<\"comments\"\>", 
     "\[Rule]", "\<\"33 pages plus appendices and 4 figures\"\>"}], ",", 
    RowBox[{"\<\"journal-ref\"\>", "\[Rule]", "Null"}], ",", 
