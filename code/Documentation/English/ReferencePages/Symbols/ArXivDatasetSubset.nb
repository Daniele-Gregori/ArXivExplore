version\"\>"}], ",", 
    RowBox[{"\<\"journal-ref\"\>", "\[Rule]", "Null"}], ",", 
    RowBox[{"\<\"doi\"\>", 
     "\[Rule]", "\<\"10.1016/j.nuclphysb.2022.115788\"\>"}], ",", 
