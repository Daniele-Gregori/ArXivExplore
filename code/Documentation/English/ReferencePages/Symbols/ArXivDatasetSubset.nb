       RowBox[{"{", 
        RowBox[{"\<\"Arnaudo\"\>", ",", "\<\"Paolo\"\>", ",", "\<\"\"\>"}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\<\"Bonelli\"\>", ",", "\<\"Giulio\"\>", ",", "\<\"\"\>"}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\<\"Tanzini\"\>", ",", "\<\"Alessandro\"\>", 
         ",", "\<\"\"\>"}], "}"}]}], "}"}]}]}], "}"}]}, {31,"31"->
