   RowBox[{
    RowBox[{"\<\"id\"\>", "\[Rule]", "\<\"2401.03766\"\>"}], ",", 
    RowBox[{"\<\"submitter\"\>", "\[Rule]", "\<\"Hongfei Shu\"\>"}], ",", 
    RowBox[{"\<\"authors\"\>", 
     "\[Rule]", "\<\"Katsushi Ito and Hongfei Shu\"\>"}], ",", 
    RowBox[{"\<\"title\"\>", 
     "\[Rule]", "\<\"TBA equations and exact WKB analysis in deformed \
supersymmetric quantum\\n  mechanics\"\>"}], ",", 
    RowBox[{"\<\"comments\"\>", 
     "\[Rule]", "\<\"31 pages, 1 figure; Published version\"\>"}], ",", 
    RowBox[{"\<\"journal-ref\"\>", "\[Rule]", "\<\"JHEP03(2024)122\"\>"}], 
    ",", 
    RowBox[{"\<\"doi\"\>", "\[Rule]", "\<\"10.1007/JHEP03(2024)122\"\>"}], 
    ",", 
    RowBox[{"\<\"report-no\"\>", "\[Rule]", "\<\"TIT/HEP- 698\"\>"}], ",", 
    RowBox[{"\<\"categories\"\>", 
     "\[Rule]", "\<\"hep-th math-ph math.MP\"\>"}], ",", 
    RowBox[{"\<\"license\"\>", 
     "\[Rule]", \
"\<\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\"\>"}], ",", 
    RowBox[{"\<\"abstract\"\>", 
     "\[Rule]", "\<\"  We study the spectral problem in deformed \
supersymmetric quantum mechanics\\nwith polynomial superpotential by using \
the exact WKB method and the TBA\\nequations. We apply the ODE/IM \
correspondence to the Schr\\\\\\\"odinger equation\\nwith an effective \
potential deformed by integrating out the fermions, which\\nadmits a \
continuous deformation parameter. We find that the TBA equations \
are\\ndescribed by the ${\\\\mathbb Z}_4$-extended ones. For cubic \
superpotential\\ncorresponding to the symmetric double-well potential, the \
TBA system splits\\ninto the two $D_3$-type TBA equations. We investigate in \
detail this example\\nbased on the TBA equations and their analytic \
continuation as well as the\\nmassless limit. We find that the energy \
spectrum obtained from the exact\\nquantization condition is in good \
agreement with the diagonalization approach\\nof the Hamiltonian.\\n\"\>"}], 
    ",", 
    RowBox[{"\<\"versions\"\>", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\<\"version\"\>", "\[Rule]", "\<\"v1\"\>"}], ",", 
         RowBox[{"\<\"created\"\>", 
          "\[Rule]", "\<\"Mon, 8 Jan 2024 09:42:59 GMT\"\>"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\<\"version\"\>", "\[Rule]", "\<\"v2\"\>"}], ",", 
         RowBox[{"\<\"created\"\>", 
          "\[Rule]", "\<\"Fri, 22 Mar 2024 06:15:13 GMT\"\>"}]}], "}"}]}], 
      "}"}]}], ",", 
    RowBox[{"\<\"update_date\"\>", "\[Rule]", "\<\"2024-03-25\"\>"}], ",", 
    RowBox[{"\<\"authors_parsed\"\>", "\[Rule]", 
     RowBox[{"{", 
