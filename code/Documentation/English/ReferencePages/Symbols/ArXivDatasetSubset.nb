    RowBox[{"\<\"title\"\>", 
     "\[Rule]", "\<\"Recursion relation for instanton counting for $SU(2)$ ${\
\\\\cal N}=2$ SYM\\n  in NS limit of $\\\\Omega$ background\"\>"}], ",", 
    RowBox[{"\<\"comments\"\>", 
     "\[Rule]", "\<\"28 pages, 6 figures, some clarifications and citations \
added,\\n  published version\"\>"}], ",", 
    RowBox[{"\<\"journal-ref\"\>", "\[Rule]", "Null"}], ",", 
