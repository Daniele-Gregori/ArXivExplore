     "\[Rule]", "\<\"Exact conditions for Quasi-normal modes of extremal \
M5-branes and Exact\\n  WKB analysis\"\>"}], ",", 
    RowBox[{"\<\"comments\"\>", "\[Rule]", "\<\"25 pages, 8 figures\"\>"}], 
    ",", 
    RowBox[{"\<\"journal-ref\"\>", "\[Rule]", "Null"}], ",", 
