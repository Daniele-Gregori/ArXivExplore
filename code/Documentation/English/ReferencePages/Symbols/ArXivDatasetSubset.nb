    RowBox[{"\<\"title\"\>", 
     "\[Rule]", "\<\"The threefold way to quantum periods: WKB, TBA equations \
and\\n  q-Painlev\\\\'e\"\>"}], ",", 
    RowBox[{"\<\"comments\"\>", 
     "\[Rule]", "\<\"39 Pages + 2 Appendices, 11 Figures v2: Added a new \
stability\\n  condition and consequent several changes to Sections 2 and 5 \
and addition of\\n  Figure 5. Sharpened and revised the conclusions. Fixed \
some typos\"\>"}], ",", 
    RowBox[{"\<\"journal-ref\"\>", "\[Rule]", "Null"}], ",", 
    RowBox[{"\<\"doi\"\>", "\[Rule]", "Null"}], ",", 
