  RowBox[{"{", 
   RowBox[{
    RowBox[{"\<\"id\"\>", "\[Rule]", "\<\"2001.08891\"\>"}], ",", 
    RowBox[{"\<\"submitter\"\>", "\[Rule]", "\<\"Saki Koizumi\"\>"}], ",", 
    RowBox[{"\<\"authors\"\>", 
     "\[Rule]", "\<\"Katsushi Ito, Saki Koizumi and Takafumi Okubo\"\>"}], 
    ",", 
    RowBox[{"\<\"title\"\>", 
     "\[Rule]", "\<\"Quantum Seiberg-Witten periods for $\\\\mathcal{N}=2$ \
$SU(N_c)$ SQCD around\\n  the superconformal point\"\>"}], ",", 
    RowBox[{"\<\"comments\"\>", "\[Rule]", "\<\"33 pages\"\>"}], ",", 
    RowBox[{"\<\"journal-ref\"\>", "\[Rule]", "Null"}], ",", 
    RowBox[{"\<\"doi\"\>", 
     "\[Rule]", "\<\"10.1016/j.nuclphysb.2020.115004\"\>"}], ",", 
    RowBox[{"\<\"report-no\"\>", "\[Rule]", "\<\"TIT/HEP-678\"\>"}], ",", 
    RowBox[{"\<\"categories\"\>", "\[Rule]", "\<\"hep-th\"\>"}], ",", 
    RowBox[{"\<\"license\"\>", 
     "\[Rule]", \
"\<\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\"\>"}], ",", 
    RowBox[{"\<\"abstract\"\>", 
     "\[Rule]", "\<\"  We study the quantum Seiberg-Witten periods of \
${\\\\cal N}=2$ superconformal\\nfield theories which are obtained by taking \
the scaling limit of ${\\\\cal N}=2$\\n$SU(N_c)$ SQCD around the \
superconformal fixed point. The quantum\\nSeiberg-Witten curves of these \
superconformal field theories are shown to be\\nclassified into the \
Schr\\\\\\\"odinger type and the SQCD type, which depend on\\nflavor symmetry \
at the fixed point. We study the quantum periods and compute\\nthe \
differential operators which relate the quantum periods to the \
classical\\nones up to the fourth-order in the deformation \
parameter.\\n\"\>"}], ",", 
    RowBox[{"\<\"versions\"\>", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\<\"version\"\>", "\[Rule]", "\<\"v1\"\>"}], ",", 
        RowBox[{"\<\"created\"\>", 
         "\[Rule]", "\<\"Fri, 24 Jan 2020 05:51:21 GMT\"\>"}]}], "}"}], 
      "}"}]}], ",", 
    RowBox[{"\<\"update_date\"\>", "\[Rule]", "\<\"2020-04-22\"\>"}], ",", 
    RowBox[{"\<\"authors_parsed\"\>", "\[Rule]", 
     RowBox[{"{", 
