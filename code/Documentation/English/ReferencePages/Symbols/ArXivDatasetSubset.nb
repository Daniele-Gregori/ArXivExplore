     "\[Rule]", "\<\"Anisotropic Kondo line defect and ODE/IM \
correspondence\"\>"}], ",", 
    RowBox[{"\<\"comments\"\>", 
     "\[Rule]", "\<\"34 pages, 5 figures; v2: added references and a \
discussion on the\\n  relation with the transfer matrix; v3: typos \
fixed\"\>"}], ",", 
    RowBox[{"\<\"journal-ref\"\>", 
     "\[Rule]", "\<\"SciPost Phys. 15, 248 (2023)\"\>"}], ",", 
    RowBox[{"\<\"doi\"\>", 
     "\[Rule]", "\<\"10.21468/SciPostPhys.15.6.248\"\>"}], ",", 
    RowBox[{"\<\"report-no\"\>", "\[Rule]", "Null"}], ",", 
