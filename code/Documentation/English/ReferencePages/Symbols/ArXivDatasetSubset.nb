    RowBox[{"\<\"authors\"\>", 
     "\[Rule]", "\<\"Giulio Bonelli, Fabrizio Del Monte, Alessandro Tanzini\"\
\>"}], ",", 
    RowBox[{"\<\"title\"\>", 
     "\[Rule]", "\<\"BPS quivers of five-dimensional SCFTs, Topological \
Strings and\\n  q-Painlev\\\\'e equations\"\>"}], ",", 
    RowBox[{"\<\"comments\"\>", "\[Rule]", "\<\"52 pages, 14 figures\"\>"}], 
    ",", 
    RowBox[{"\<\"journal-ref\"\>", "\[Rule]", "Null"}], ",", 
    RowBox[{"\<\"doi\"\>", "\[Rule]", "\<\"10.1007/s00023-021-01034-3\"\>"}], 
    ",", 
    RowBox[{"\<\"report-no\"\>", "\[Rule]", "Null"}], ",", 
    RowBox[{"\<\"categories\"\>", 
     "\[Rule]", "\<\"hep-th math-ph math.MP nlin.SI\"\>"}], ",", 
    RowBox[{"\<\"license\"\>", 
     "\[Rule]", \
"\<\"http://arxiv.org/licenses/nonexclusive-distrib/1.0/\"\>"}], ",", 
    RowBox[{"\<\"abstract\"\>", 
     "\[Rule]", "\<\"  We study the discrete flows generated by the symmetry \
group of the BPS\\nquivers for Calabi-Yau geometries describing five \
dimensional superconformal\\nquantum field theories on a circle. These flows \
naturally describe the BPS\\nparticle spectrum of such theories and at the \
same time generate bilinear\\nequations of q-difference type which, in the \
rank one case, are q-Painlev\\\\'e\\nequations. The solutions of these \
equations are shown to be given by grand\\ncanonical topological string \
partition functions which we identify with\\n$\\\\tau$-functions of the \
cluster algebra associated to the quiver. We exemplify\\nour construction in \
the case corresponding to five dimensional $SU(2)$ pure\\nSuper Yang-Mills \
and $N_f = 2$ on a circle.\\n\"\>"}], ",", 
    RowBox[{"\<\"versions\"\>", "\[Rule]", 
