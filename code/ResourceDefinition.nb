Cell["\<\
and then let us visualize the most and less frequent title words:\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.931218065613209*^9, 3.931218083094662*^9}, {
  3.936770503153345*^9, 3.936770503518238*^9}},
 CellID->2134150036,ExpressionUUID->"baa408e2-7cfc-4c8c-831c-76aa594b64f0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"cat", "=", 
      RowBox[{"{", 
       RowBox[{"\"\<cs\>\"", ",", "All"}], "}"}]}], ",", "tabs", ",", 
     "colrules", ",", "tabskey", ",", "compl", ",", 
     RowBox[{"cut", "=", "160"}], ",", 
     RowBox[{"res", "=", "10"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"colrules", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<learning\>\"", "->", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<learning\>\"", ",", "Purple", ",", "Bold"}], "]"}]}], ",", 
       RowBox[{"\"\<using\>\"", "->", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<using\>\"", ",", "Purple", ",", "Bold"}], "]"}]}], ",", 
       
       RowBox[{"\"\<theory\>\"", "->", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<theory\>\"", ",", "Red", ",", "Bold"}], "]"}]}], ",", 
       RowBox[{"\"\<understanding\>\"", "->", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<understanding\>\"", ",", "Red", ",", "Bold"}], 
         "]"}]}]}], "}"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"tabs", "=", 
     RowBox[{
      RowBox[{"MapAt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Apply", "[", 
          RowBox[{"Sequence", ",", "#"}], "]"}], "&"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"MapIndexed", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Partition", "[", 
            RowBox[{
             RowBox[{"Riffle", "[", 
              RowBox[{
               RowBox[{"Map", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Style", "[", 
                   RowBox[{"#", ",", "Bold"}], "]"}], "&"}], ",", 
                 RowBox[{"Range", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"res", "*", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"First", "[", "#2", "]"}], "-", "1"}], ")"}]}], "+",
                     "1"}], ",", 
                   RowBox[{"res", "*", 
                    RowBox[{"First", "[", "#2", "]"}]}]}], "]"}]}], "]"}], ",",
                "#"}], "]"}], ",", "2"}], "]"}], "&"}], ",", 
          RowBox[{"Partition", "[", 
           RowBox[{
            RowBox[{"Normal", "@", 
             RowBox[{"ArXivTopTitles", "[", 
              RowBox[{"cat", ",", "cut"}], "]"}]}], ",", 
            RowBox[{"UpTo", "@", "res"}]}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"All", ",", "All", ",", "2"}], "}"}]}], "]"}], "/.", 
      "colrules"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"tabskey", "=", 
     RowBox[{"Cases", "[", 
      RowBox[{"tabs", ",", 
       RowBox[{"_List", "?", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"Alternatives", "[", 
              RowBox[{"\"\<theory\>\"", ",", "\"\<understanding\>\""}], "]"}],
              "/.", "colrules"}]}], "]"}], "&"}], ")"}]}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"compl", "=", 
     RowBox[{"Text", "[", 
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"\"\<... \>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"Round", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"First", "@", 
              RowBox[{"tabskey", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1", ",", "1"}], "]"}], "]"}]}], "-", "1"}],
             ",", "10"}], "]"}], "]"}], 
         "<>", "\"\<+\\n\nwords more\\n\npopular than\\n\n\\\"understanding\\\
\"\\n\nor \\\"theory\\\"\\n\nin CS !\>\""}], ",", "Bold", ",", "9", ",", 
        RowBox[{"TextAlignment", "\[Rule]", "Center"}]}], "]"}], "]"}]}], ";",
     "\[IndentingNewLine]", 
    RowBox[{"GraphicsRow", "[", 
     RowBox[{
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"TextGrid", "@", 
           RowBox[{"tabs", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", "compl"}], "}"}], ",", 
        RowBox[{"TextGrid", "/@", "tabskey"}]}], "]"}], ",", 
      RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}]}], "]"}]], "Input",
 TaggingRules->{},
