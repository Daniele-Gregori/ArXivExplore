Cell[BoxData[
 TagBox[
  RowBox[{"\<\"{Introduction \\\\vspace{.15cm}}\\n\\n\\nThe recent paper \
\\\\cite{CFRS} by Figalli, Ros-Oton, Serra, and the author established the \
H\\\\\\\"older regularity of stable solutions to semilinear elliptic \
equations in the optimal range of dimensions $n\\\\leq 9$. It concerned the \
semilinear elliptic \
equation\\n\\\\begin{equation}\\\\label{eq:PDE}\\n-\\\\Delta u=f(u) \\\\qquad \
\\\\text{in }\\\\Omega\\\\\"\>", 
   "\[Ellipsis]", "\<\"espect to the variable \
$\\\\lambda$.\\n\\n\\\\bigskip\\n\\n\\\\noindent\\n{\\\\bf Plan of the \
paper.} In Section~2 we prove our interior estimate, Theorem \\\\ref{thm:3}. \
Section~3 is devoted to the boundary bound, Theorem \\\\ref{thm:3bdry}. The \
paper contains also two Appendices (the first one includes a new \
interpolation inequality), with results that are needed in Section \
3.\\n\\n\\n\\n\"\>"}],
  Short[#, 10]& ]], "Output",
 TaggingRules->{},
 CellChangeTimes->{3.931242911612763*^9, 3.93124296414209*^9, 
  3.931242995243696*^9},
 CellLabel->"Out[12]//Short=",
 CellID->87167904,ExpressionUUID->"05e6e419-0dc8-4fd8-b751-b31953100459"]
}, Open  ]],

