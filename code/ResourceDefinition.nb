Cell[CellGroupData[{

Cell[TextData[{
 "Author Notes",
 Cell[BoxData[
  PaneSelectorBox[{True->
   TemplateBox[{"Author Notes", 
     Cell[
      BoxData[
       FrameBox[
        Cell[
        "This section, when used, will appear near the bottom of the \
published resource. Content displayed in this section can include background, \
possible improvements, additional information and/or implementation details \
that are otherwise beyond the scope of the paclet documentation.", 
         "MoreInfoText"], Background -> GrayLevel[0.95], FrameMargins -> 20, 
        FrameStyle -> GrayLevel[0.9], RoundingRadius -> 5, ImageSize -> {
          Scaled[0.65], Automatic}]], "MoreInfoText", Deletable -> True, 
      CellTags -> {"SectionMoreInfoAuthorNotes"}, 
      CellMargins -> {{66, 66}, {15, 15}}]},
    "MoreInfoOpenerButtonTemplate"]}, Dynamic[
    CurrentValue[
     EvaluationNotebook[], {TaggingRules, "ResourceCreateNotebook"}]],
   ImageSize->Automatic]],ExpressionUUID->
  "9a1d5880-97cf-419a-9334-643b590aed74"]
}], "Section",
 Editable->False,
 Deletable->False,
 TaggingRules->{"TemplateGroupName" -> "Author Notes"},
 DefaultNewCellStyle->"Text",
 CellTags->{"Author Notes", "TemplateCellGroup"},
 CellID->427099699,ExpressionUUID->"9ccedfc8-f92a-4b6f-9e7a-50aed6fbb398"],

Cell[TextData[{
 "Some features, especially ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"T", 
     AdjustmentBox["E",
      BoxBaselineShift->0.5,
      BoxMargins->{{-0.3, 0}, {0, 0}}], "X"}],
    SingleLetterItalics->False], TraditionalForm]],ExpressionUUID->
  "d0f6f9ed-0f88-4374-8a9b-b49faeda7167"],
 " scraping and citation functionality are not always accurate, so I plan to \
improve them in later versions of the paclet."
}], "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.931155026029607*^9, 3.931155075920753*^9}, {
  3.931155144748219*^9, 3.931155145790785*^9}},
 CellID->949369588,ExpressionUUID->"c629a0aa-ebf6-496a-a342-e1af42ba6c00"],

Cell["\<\
In general I plan to improve the function definitions, algorithms and to \
introduce better error management functionality, documentation and, of \
course, update the dataset periodically.\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.9311789539324903`*^9, 3.931178980627358*^9}, {
  3.931338287545588*^9, 3.9313382894635477`*^9}, {3.931428208539978*^9, 
  3.931428276310336*^9}},
 CellID->1953138074,ExpressionUUID->"1c6556ef-f951-4b68-ad87-82217c0a0a44"],

Cell["\<\
There are clearly unlimited explorations and applications possible with this \
paclet, as well as further developments and improvements.\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.931178986490975*^9, 3.931179022315288*^9}, {
  3.931338295891431*^9, 3.931338317511588*^9}, {3.931427663198734*^9, 
  3.931427665775704*^9}, {3.93142773042899*^9, 3.931427739702299*^9}, {
  3.9314282859670553`*^9, 3.931428341215275*^9}},
 CellID->1762186162,ExpressionUUID->"49b51c73-9e4a-4a41-ae5a-cfbd841acab1"],

Cell["Therefore, any suggestion is welcome!", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.931155109666101*^9, 3.931155161659253*^9}, {
  3.931179035477807*^9, 3.931179038944053*^9}, {3.931349160695011*^9, 
  3.931349161417232*^9}, {3.931427689238326*^9, 3.93142768989454*^9}, {
  3.9361925099747267`*^9, 3.93619251034788*^9}},
 CellID->291612146,ExpressionUUID->"49ef22c6-9652-4298-b3c9-6a1b01f724ee"]
}, Open  ]]
}, Open  ]]
},
